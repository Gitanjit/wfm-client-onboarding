+    """Greedy week schedule. With `break_cover_passes` > 0 (client config), the week is re-planned
+    that many times, each pass asking for one more agent in every interval the previous pass left
+    short once breaks were taken out; the pass with the best worst-queue attainment within the
+    `max_hours_ratio` efficiency bound (if set) is kept."""
+    passes = int(cfg.get("break_cover_passes") or 0)
+    if passes <= 0:
+        return _schedule(req, cfg, agents, week)
+    required = {q: dict(zip(g["interval_start_utc"], g["required"])) for q, g in req.groupby("queue")}
+    req_hours = float(req["required"].sum()) * cfg["interval_minutes"] / 60.0
+    ratio = cfg.get("max_hours_ratio")
+    extra = {q: defaultdict(int) for q in required}
+    best, best_key = None, None
+    for _ in range(passes + 1):
