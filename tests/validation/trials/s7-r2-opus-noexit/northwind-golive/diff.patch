@@ -0,0 +1,273 @@
+"""Local search over a greedy week schedule (client config `improve: true`).
+
+The greedy places shifts one at a time and never revisits them. This pass does: it changes a shift's
+template or queue, removes shifts and adds shifts, keeping a move when it lowers the score
+
+    score = sum over queues of (short_weight x short_q + miss_weight x max(0, short_q - allowed_q)) + hours
+
+where `short_q` counts the queue's operating intervals whose agents net of breaks are below the
+requirement, `allowed_q` is what the weekly attainment target (`sla_target`) still allows, and
+`hours` is total scheduled elapsed hours. Every move keeps the hard rules: skills, one shift per
+agent per local day, weekly hours, consecutive days, minimum rest, split-shift contracts, `min_cover`
+floors, and the `max_hours_ratio` efficiency bound. Breaks are re-placed with the scheduler's own
+rule after every change, so what is scored is what is written.
+
+Deterministic: moves are tried in a fixed order.
+"""
+from __future__ import annotations
+
+import math
+from collections import defaultdict
+from datetime import date, timedelta
+from zoneinfo import ZoneInfo
+
+import pandas as pd
+
+from wfm import constraints
+from wfm.roster import Agent
+from wfm.scheduler.greedy import Shift, _covered, place_breaks, place_breaks_surplus
+from wfm.scheduler.templates import eligible, templates_for
+from wfm.staffing.required import in_hours
+
+
+class _Week:
+    def __init__(self, req: pd.DataFrame, cfg: dict, agents: list[Agent], shifts: list[Shift]):
+        self.cfg = cfg
+        self.z = ZoneInfo(cfg["tz"])
+        self.step = timedelta(minutes=cfg["interval_minutes"])
+        # plain datetimes as interval keys: hashing pandas Timestamps dominates the run time otherwise
+        self.required = {q: {t.to_pydatetime(): int(n) for t, n in zip(g["interval_start_utc"], g["required"])}
+                         for q, g in req.groupby("queue")}
+        self.queues = list(self.required)
+        grid = sorted({t.to_pydatetime() for t in req["interval_start_utc"]})
+        self.days = sorted({t.astimezone(self.z).date() for t in grid})
+        self.day_grid = {d: [t for t in grid if t.astimezone(self.z).date() == d] for d in self.days}
+        self.ops = {(q, d): [t for t in self.day_grid[d] if in_hours(q, t, cfg)] for q in self.queues for d in self.days}
+        self.floors = {(q, d): [(t, constraints.floor(q, t, cfg)) for t in self.day_grid[d]] for q in self.queues
+                       for d in self.days}
+        self.templates = templates_for(cfg)
+        self.agents = {a.agent_id: a for a in agents}
+        self.caps = cfg["weekly_hours"]
+        self.max_run = cfg["max_consecutive_days"]
+        self.rest = cfg.get("min_rest_hours")
+        n_ops = {q: sum(len(self.ops[(q, d)]) for d in self.days) for q in self.queues}
+        target = float(cfg.get("sla_target") or 0.0)
+        margin = float(cfg.get("improve_margin", 0.0))
+        self.allowed = {q: max(0, math.floor(n_ops[q] * (1 - min(1.0, target + margin)) + 1e-9)) for q in self.queues}
+        self.short_w = float(cfg.get("improve_short_weight", 4.0))
+        self.miss_w = float(cfg.get("improve_miss_weight", 200.0))
+        req_hours = float(req["required"].sum()) * cfg["interval_minutes"] / 60.0
+        ratio = cfg.get("max_hours_ratio")
+        self.max_hours = ratio * req_hours if ratio else float("inf")
+        # state
+        self.by_qd: dict[tuple, list[Shift]] = defaultdict(list)
+        self.by_agent: dict[str, dict[date, Shift]] = defaultdict(dict)
+        for sh in shifts:
+            sh.intervals = [t.to_pydatetime() if hasattr(t, "to_pydatetime") else t for t in sh.intervals]
+            sh.__dict__.pop("_break_fits", None)
+            self.by_qd[(sh.queue, sh.day)].append(sh)
+            self.by_agent[sh.agent_id][sh.day] = sh
+        self.short = {}
+        for k in self.ops:
+            v = self._short(k, self.by_qd[k])
+            self.short[k] = 1000 if v is None else v      # a broken floor: only a move that mends it is kept
+        self.hours = sum(sh.hours for sh in shifts)
+        self.hours_of = defaultdict(float)
+        for sh in shifts:
+            self.hours_of[sh.agent_id] += sh.hours
+        self._seg_cache = {}
+
+    # --- evaluation ---------------------------------------------------------------------------
+    def _place(self, shifts: list[Shift]) -> None:
+        for sh in shifts:
+            sh.break_start, sh.break_minutes = None, 0
+        if self.cfg["break"].get("placement", "midpoint") == "surplus":
+            place_breaks_surplus(shifts, self.cfg, self.required)
+        else:
+            place_breaks(shifts, self.cfg)
+
+    def _short(self, key, shifts: list[Shift]) -> int | None:
+        """Short operating intervals on a queue-day (None if a floor is broken)."""
+        q, d = key
+        self._place(shifts)
+        gross, net = defaultdict(int), defaultdict(int)
+        for sh in shifts:
+            bs = sh.break_start
+            if bs is None:
+                for t in sh.intervals:
+                    gross[t] += 1
+                    net[t] += 1
+                continue
+            be = bs + timedelta(minutes=sh.break_minutes)
+            for t in sh.intervals:
+                gross[t] += 1
+                if not (bs < t + self.step and t < be):
+                    net[t] += 1
+        if any(gross[t] < f for t, f in self.floors[key] if f):
+            return None
+        return sum(1 for t in self.ops[key] if net[t] < self.required[q].get(t, 0))
+
+    def _queue_short(self, overrides: dict) -> dict:
+        tot = defaultdict(int)
+        for k, v in self.short.items():
+            tot[k[0]] += overrides.get(k, v)
+        return tot
+
+    def score(self, overrides: dict | None = None, hours: float | None = None) -> float:
+        tot = self._queue_short(overrides or {})
+        s = sum(self.short_w * tot[q] + self.miss_w * max(0, tot[q] - self.allowed[q]) for q in self.queues)
+        return s + (self.hours if hours is None else hours)
+
+    # --- rules --------------------------------------------------------------------------------
+    def segs(self, tpl, day):
+        k = (tpl.id, day)
+        if k not in self._seg_cache:
+            segs = tpl.segments_utc(day, self.cfg["tz"])
+            self._seg_cache[k] = (segs, _covered(segs, self.day_grid[day]),
+                                  sum((e - s).total_seconds() for s, e in segs) / 3600.0)
+        return self._seg_cache[k]
+
+    def allowed_for(self, aid: str, day: date, segs, hours: float, replacing: Shift | None) -> bool:
+        a = self.agents[aid]
+        mine = self.by_agent[aid]
+        if replacing is None and day in mine:
+            return False
+        h = self.hours_of[aid] - (replacing.hours if replacing else 0.0) + hours
+        if h > self.caps[a.contract] + 1e-9:
+            return False
