+        for key in sorted(self.ops, key=lambda k: (k[1], k[0])):
+            q, day = key
+            while self.short[key] > 0:
+                pool = [aid for aid in sorted(self.agents, key=lambda i: (len(self.agents[i].skills), self.hours_of[i], i))
