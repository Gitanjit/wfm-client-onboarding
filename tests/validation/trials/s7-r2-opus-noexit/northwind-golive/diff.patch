+                    v = self._short(key, self.by_qd[key] + [probe])
+                    self._place(self.by_qd[key])
+                    if v is not None and v < self.short[key]:
+                        trials.append((self.score({key: v}, self.hours + h), h, tpl.id, tpl, segs, ivs))
+                placed = False
+                for _s, h, _id, tpl, segs, ivs in sorted(trials, key=lambda x: x[:3]):
+                    for aid in pool:
+                        a = self.agents[aid]
+                        if not eligible(tpl, a.contract, self.cfg) or not self.allowed_for(aid, day, segs, h, None):
+                            continue
+                        new_sh = Shift(aid, q, tpl, day, segs, ivs)
+                        ok, new = self._try({key: self.by_qd[key] + [new_sh]}, h)
+                        if ok:
+                            self._apply({key: self.by_qd[key] + [new_sh]}, new, h, [lambda n=new_sh: self._add(n)])
+                            improved = placed = True
+                        break
+                    if placed:
