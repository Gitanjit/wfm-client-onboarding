+# Northwind Traders — local-time export with an explicit UTC offset per row (data/northwind/README.txt),
+# 30-minute grain, US Central time. Contract: docs/NORTHWIND_SOW.md (effective 2026-W44).
+name: Northwind Traders
+interval_minutes: 30                 # SOW 1.5
+tz: America/Chicago
+operating_hours: [6, 24]             # SOW 1.4
+queues: [priority, standard, vip]    # SOW 1.1
+queue_hours: {vip: [8, 20]}          # SOW 1.4: vip operating intervals; no requirement outside a queue's hours
+full_week_grid: true                 # every interval of the week's elapsed length, whatever the file holds
+
+# SOW 1.2-1.3: Erlang C (no abandonment) on each interval's own volume and AHT, occupancy cap 0.85.
+queueing: erlang
+aht_smoothing: interval
+occupancy_cap: 0.85
+sla:
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 20}
+  vip: {target: 0.90, seconds: 20}
+sla_target: 0.95                     # SOW 1.6: weekly attainment per queue
+attainment_basis: service_level
+attainment_intervals: operating      # SOW 1.6: fraction of operating intervals, zero-volume ones included
+max_hours_ratio: 1.57                # SOW 1.6: scheduled hours <= 1.57 x required hours
+
+# SOW 2.6: one agent on vip 06:00-24:00 whatever the volume; a person counts once, on their own queue.
+min_cover: {vip: {agents: 1, hours: [6, 24]}}
