+
+    def _drop(self, sh: Shift) -> None:
+        del self.by_agent[sh.agent_id][sh.day]
+        self.hours_of[sh.agent_id] -= sh.hours
+
+    def _add(self, sh: Shift) -> None:
+        self.by_agent[sh.agent_id][sh.day] = sh
+        self.hours_of[sh.agent_id] += sh.hours
+
+    def shifts(self) -> list[Shift]:
+        out = [sh for k in sorted(self.by_qd, key=lambda k: (k[1], k[0])) for sh in self.by_qd[k]]
+        for k in self.by_qd:
+            self._place(self.by_qd[k])
+        return sorted(out, key=lambda s: (s.day, s.segments[0][0], s.agent_id))
+
+
+def improve(shifts: list[Shift], req: pd.DataFrame, cfg: dict, agents: list[Agent]) -> list[Shift]:
+    w = _Week(req, cfg, agents, shifts)
+    for _ in range(int(cfg.get("improve_rounds", 8))):
+        if not w.round():
+            break
+    return w.shifts()
