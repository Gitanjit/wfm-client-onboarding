+"""Week-level template scheduling by seeded local search (`scheduler: search` in a client config).
+
+Written for contracts whose rules the per-day greedy cannot see (Northwind, docs/NORTHWIND_SOW.md):
+
+- rest: at least `min_rest_hours` elapsed between one shift's end and the agent's next start;
+- split shifts only for the contracts in `split_shift_contracts`;
+- breaks placed by rule (`break.placement: max_surplus`): one break per shift of `break.min_shift_hours`
+  or more, starting `break.window_hours` after the shift starts, in the interval of the window where the
+  queue's gross surplus (agents on the queue ignoring breaks, minus required) is largest; among tied
+  intervals the one with the most net slack is taken;
+- floors (`min_cover`) counted on the queue itself, net of breaks;
+- weekly-hour caps, consecutive local days, skills, one template per local day.
+
+The search state is one (template, queue) or nothing per agent per local day. Every candidate state
+obeys the rules above; the cost weighs intervals below requirement (net of breaks, over each queue's
+operating intervals), floor gaps and scheduled hours against the efficiency bound
+(`efficiency_cap` x required agent-hours, planned to `efficiency_margin` of it).
+
+Deterministic (docs/adr/0003): a fixed seed, a fixed iteration count, lists sorted by agent id and
+template order; no set or dict iteration that depends on hashing.
+"""
+from __future__ import annotations
+
+import math
+import random
+from dataclasses import dataclass
+from datetime import datetime, timedelta, timezone
+from zoneinfo import ZoneInfo
+
+import pandas as pd
+
+from wfm import constraints
+from wfm.ingest.loader import local_days
+from wfm.roster import Agent
+from wfm.scheduler.greedy import Shift
+from wfm.scheduler.templates import Template, eligible, templates_for
+from wfm.staffing.required import queue_hours
+
+# cost weights (per interval, per hour)
+W_EXCESS_FAIL = 60.0    # an interval below requirement beyond the attainment allowance
+W_FAIL = 6.0            # any interval below requirement
+W_SHORT = 1.5           # per agent missing in an interval (gives the search a gradient)
+W_FLOOR = 400.0         # floor gap ignoring breaks
+W_FLOOR_NET = 200.0     # floor gap once breaks are taken (staged, see run)
+W_EDGE = 25.0           # (staged, see run) a break whose only max-surplus slot starts exactly at the window's far edge
+W_OVER_BUDGET = 60.0    # per hour above the planned efficiency budget
+W_HOUR = 0.5            # per scheduled hour
+
+
+@dataclass(frozen=True)
+class Option:
+    """A template on a local day: its segments, grid slots and break window."""
+    tpl: Template
+    day_i: int
+    segments: tuple[tuple[datetime, datetime], ...]
+    ivs: tuple[int, ...]
+    hours: float
+    break_cands: tuple[int, ...]   # empty when the shift needs no break
+    break_edge: bool = False       # the last candidate starts exactly at the window's far edge
+
+    @property
+    def start(self) -> datetime:
+        return self.segments[0][0]
+
+    @property
+    def end(self) -> datetime:
+        return self.segments[-1][1]
+
+
+class Search:
+    def __init__(self, req: pd.DataFrame, cfg: dict, agents: list[Agent], week: str, seed: int):
+        self.cfg = cfg
+        self.rng = random.Random(seed)
+        tz = cfg["tz"]
+        z = ZoneInfo(tz)
+        self.days = local_days(week, tz)
+        self.grid = [t.to_pydatetime() for t in sorted(set(req["interval_start_utc"]))]
+        idx = {t: i for i, t in enumerate(self.grid)}
+        n = len(self.grid)
+        self.grain_h = cfg["interval_minutes"] / 60.0
+        self.queues = list(cfg.get("queues") or dict.fromkeys(req["queue"]))
+        self.req = {q: [0] * n for q in self.queues}
+        for r in req.itertuples(index=False):
+            self.req[r.queue][idx[r.interval_start_utc.to_pydatetime()]] = int(r.required)
+        self.req_hours = sum(sum(v) for v in self.req.values()) * self.grain_h
+
+        loc_h = [(t.astimezone(z).hour + t.astimezone(z).minute / 60) for t in self.grid]
+        self.ops = {}
+        for q in self.queues:
+            lo, hi = queue_hours(q, cfg)
+            self.ops[q] = [lo <= h < hi for h in loc_h]
+        self.floor = {q: [constraints.floor(q, t, cfg) for t in self.grid] for q in self.queues}
+        target = float(cfg.get("sla_target", 0.95)) + float(cfg.get("search_attainment_margin", 0.01))
+        self.allow = {q: math.floor((1 - min(target, 1.0)) * sum(self.ops[q]) + 1e-9) for q in self.queues}
+        self.budget = (float(cfg.get("efficiency_cap", math.inf)) * float(cfg.get("efficiency_margin", 1.0))
+                       * self.req_hours)
+
+        # rules
+        self.caps = {k: float(v) for k, v in cfg["weekly_hours"].items()}
+        self.max_run = int(cfg["max_consecutive_days"])
+        self.rest = timedelta(hours=float(cfg.get("min_rest_hours", 0)))
+        self.split_ok = cfg.get("split_shift_contracts")
+        brk = cfg["break"]
+        self.brk_len = timedelta(minutes=int(brk["minutes"]))
+        w0, w1 = (timedelta(hours=float(h)) for h in brk["window_hours"])
+
+        # options per day
+        day_slots = [[i for i, t in enumerate(self.grid) if t.astimezone(z).date() == d] for d in self.days]
+        self.options: list[list[Option]] = []
+        for di, d in enumerate(self.days):
+            opts = []
+            for tpl in templates_for(cfg):
+                segs = tuple(tpl.segments_utc(d, tz))
+                ivs = tuple(i for i in day_slots[di] if any(s <= self.grid[i] < e for s, e in segs))
+                hours = sum((e - s).total_seconds() for s, e in segs) / 3600.0
+                cands: tuple[int, ...] = ()
+                if hours >= float(brk["min_shift_hours"]) - 1e-9:
+                    st = segs[0][0]
+                    cands = tuple(i for i in ivs if st + w0 <= self.grid[i] <= st + w1
+                                  and any(s <= self.grid[i] and self.grid[i] + self.brk_len <= e for s, e in segs))
+                edge = bool(cands) and self.grid[cands[-1]] == segs[0][0] + w1
+                opts.append(Option(tpl, di, segs, ivs, hours, cands, edge))
+            self.options.append(opts)
+
+        self.agents = sorted(agents, key=lambda a: a.agent_id)
+        self.skills = [sorted(q for q in a.skills if q in self.queues) for a in self.agents]
+        self.by_queue = {q: [ai for ai, sk in enumerate(self.skills) if q in sk] for q in self.queues}
+        # state
+        self.plan: list[list[tuple[Option, str] | None]] = [[None] * len(self.days) for _ in self.agents]
+        self.hours = [0.0] * len(self.agents)
+        self.gross = {q: [0] * n for q in self.queues}
+        self.on_q: dict[str, dict[tuple[int, int], Option]] = {q: {} for q in self.queues}
+        self.total_hours = 0.0
+        self.edge = {q: 0 for q in self.queues}
+        self.stage = 1.0   # scale on the staged penalties; run() raises it from small to 1
+        self.qcost = {q: self._queue_eval(q)[0] for q in self.queues}
+
+    # ---- rules -------------------------------------------------------------------------------
+    def _option_ok(self, ai: int, opt: Option, q: str) -> bool:
+        a = self.agents[ai]
+        if q not in self.skills[ai]:
+            return False
+        if opt.tpl.is_split:
+            return a.contract in self.split_ok if self.split_ok is not None else eligible(opt.tpl, a.contract)
+        return eligible(opt.tpl, a.contract)
+
+    def _agent_ok(self, ai: int) -> bool:
+        p = self.plan[ai]
+        if self.hours[ai] > self.caps[self.agents[ai].contract] + 1e-9:
+            return False
+        run = 0
+        for x in p:
+            run = run + 1 if x else 0
+            if run > self.max_run:
+                return False
+        for d in range(len(p) - 1):
+            if p[d] and p[d + 1] and p[d + 1][0].start - p[d][0].end < self.rest:
+                return False
+        return True
+
+    # ---- state changes -----------------------------------------------------------------------
+    def _add(self, ai: int, opt: Option, q: str) -> None:
+        self.plan[ai][opt.day_i] = (opt, q)
+        self.hours[ai] += opt.hours
+        self.total_hours += opt.hours
+        g = self.gross[q]
+        for i in opt.ivs:
+            g[i] += 1
+        self.on_q[q][(ai, opt.day_i)] = opt
+
+    def _remove(self, ai: int, di: int) -> tuple[Option, str]:
+        opt, q = self.plan[ai][di]
+        self.plan[ai][di] = None
+        self.hours[ai] -= opt.hours
+        self.total_hours -= opt.hours
+        g = self.gross[q]
+        for i in opt.ivs:
+            g[i] -= 1
+        del self.on_q[q][(ai, di)]
+        return opt, q
+
+    # ---- evaluation --------------------------------------------------------------------------
+    def _breaks(self, q: str) -> tuple[dict[tuple[int, int], int], list[int]]:
+        """Break slot per shift on `q` under the max-surplus rule, and the net cover."""
+        gross, req = self.gross[q], self.req[q]
+        net = list(gross)
+        jobs = []
+        for key in sorted(self.on_q[q]):
+            opt = self.on_q[q][key]
+            if not opt.break_cands:
+                continue
+            best = max(gross[i] - req[i] for i in opt.break_cands)
+            tied = [i for i in opt.break_cands if gross[i] - req[i] == best]
+            # a slot starting exactly at the window's far edge (start + 5 h) is only used when it is the
+            # sole maximum, and that shift is then counted in `edge` so the search steers away from it
+            inner = [i for i in tied if i != opt.break_cands[-1] or not opt.break_edge]
+            jobs.append((key, inner or tied))
+        jobs.sort(key=lambda j: (len(j[1]), j[0]))
+        fl = self.floor[q]
+        out = {}
+        self.edge[q] = sum(1 for key, tied in jobs if self.on_q[q][key].break_edge and tied == [self.on_q[q][key].break_cands[-1]])
+        for key, tied in jobs:
+            # among tied slots: most net slack, then the floor, then the earliest
+            i = max(tied, key=lambda i: (net[i] - req[i], net[i] - fl[i], -i))
+            net[i] -= 1
+            out[key] = i
+        return out, net
+
+    def _queue_eval(self, q: str) -> tuple[float, int, int, int]:
+        _, net = self._breaks(q)
+        gross, req, ops, fl = self.gross[q], self.req[q], self.ops[q], self.floor[q]
+        fails = sum(1 for i in range(len(req)) if ops[i] and net[i] < req[i])
+        floor_g = sum(1 for i in range(len(req)) if gross[i] < fl[i])
+        floor_n = sum(1 for i in range(len(req)) if net[i] < fl[i])
+        short = sum(req[i] - net[i] for i in range(len(req)) if ops[i] and net[i] < req[i])
+        cost = (W_EXCESS_FAIL * max(0, fails - self.allow[q]) + W_FAIL * fails + W_SHORT * short
+                + W_FLOOR * floor_g + self.stage * (W_FLOOR_NET * floor_n + W_EDGE * self.edge[q]))
+        return cost, fails, floor_g, floor_n
+
+    def _hours_cost(self) -> float:
+        return W_HOUR * self.total_hours + W_OVER_BUDGET * max(0.0, self.total_hours - self.budget)
+
+    def cost(self) -> float:
+        return sum(self.qcost.values()) + self._hours_cost()
+
+    # ---- moves -------------------------------------------------------------------------------
+    def _try(self, removes: list[tuple[int, int]], adds: list[tuple[int, Option, str]], temp: float) -> bool:
+        """Apply removes then adds; keep if the rules hold and the annealing test passes."""
+        before = self.cost()
+        undone = [(ai, di, *self._remove(ai, di)) for ai, di in removes]
+        for ai, opt, q in adds:
+            self._add(ai, opt, q)
+        touched_agents = sorted({ai for ai, _ in removes} | {ai for ai, _, _ in adds})
+        ok = all(self._agent_ok(ai) for ai in touched_agents)
+        if ok:
+            touched_q = sorted({q for _, _, _, q in undone} | {q for _, _, q in adds}, key=self.queues.index)
+            old = {q: self.qcost[q] for q in touched_q}
+            for q in touched_q:
+                self.qcost[q] = self._queue_eval(q)[0]
+            delta = self.cost() - before
+            if delta <= 0 or (temp > 0 and self.rng.random() < math.exp(-delta / temp)):
+                return True
+            self.qcost.update(old)
+        for ai, opt, q in reversed(adds):
+            self._remove(ai, opt.day_i)
+        for ai, di, opt, q in reversed(undone):
+            self._add(ai, opt, q)
+        return False
+
+    def _shifts(self) -> list[tuple[int, int]]:
+        return [(ai, di) for ai in range(len(self.agents)) for di in range(len(self.days)) if self.plan[ai][di]]
+
+    def _problem_slot(self, q: str) -> int | None:
+        _, net = self._breaks(q)
+        bad = [i for i in range(len(self.grid))
+               if (self.ops[q][i] and net[i] < self.req[q][i]) or net[i] < self.floor[q][i]]
+        return self.rng.choice(bad) if bad else None
+
+    def _move_add(self, temp: float) -> None:
+        q = self.rng.choice(self.queues)
+        slot = self._problem_slot(q)
+        if slot is not None:
+            opts = [o for opts in self.options for o in opts if slot in o.ivs]
+        else:
+            opts = self.options[self.rng.randrange(len(self.days))]
+        if not opts:
+            return
+        opt = self.rng.choice(opts)
+        cands = [ai for ai in self.by_queue[q] if self.plan[ai][opt.day_i] is None and self._option_ok(ai, opt, q)]
+        self.rng.shuffle(cands)
+        for ai in cands[:4]:
+            if self._try([], [(ai, opt, q)], temp):
+                return
+        if slot is None or not cands:
+            return
+        # relocate: the agent gives up one of its other shifts (hours, rest or run) to take this one
+        ai = cands[0]
+        mine = [d for d in range(len(self.days)) if self.plan[ai][d]]
+        self.rng.shuffle(mine)
+        for d in mine[:3]:
+            if self._try([(ai, d)], [(ai, opt, q)], temp):
+                return
+
+    def _move(self, temp: float) -> None:
+        r = self.rng.random()
+        if r < 0.30:
+            return self._move_add(temp)
+        shifts = self._shifts()
+        if not shifts:
+            return self._move_add(temp)
+        ai, di = self.rng.choice(shifts)
+        opt, q = self.plan[ai][di]
+        if r < 0.45:   # drop a shift
+            self._try([(ai, di)], [], temp)
+        elif r < 0.65:   # another template, same agent, day and queue
+            new = self.rng.choice(self.options[di])
+            if new is not opt and self._option_ok(ai, new, q):
+                self._try([(ai, di)], [(ai, new, q)], temp)
+        elif r < 0.75:   # another queue for the same agent
+            others = [x for x in self.skills[ai] if x != q]
+            if others:
+                self._try([(ai, di)], [(ai, opt, self.rng.choice(others))], temp)
+        elif r < 0.87:   # another agent takes the shift
+            cands = [bj for bj in self.by_queue[q]
+                     if bj != ai and self.plan[bj][di] is None and self._option_ok(bj, opt, q)]
+            if cands:
+                self._try([(ai, di)], [(self.rng.choice(cands), opt, q)], temp)
+        elif r < 0.94:   # same agent, another day
+            free = [d for d in range(len(self.days)) if self.plan[ai][d] is None]
+            if free:
+                d2 = self.rng.choice(free)
+                new = next(o for o in self.options[d2] if o.tpl.id == opt.tpl.id)
+                self._try([(ai, di)], [(ai, new, q)], temp)
+        else:   # two agents on the same day swap shifts
+            other = [(bj, self.plan[bj][di]) for bj in range(len(self.agents)) if bj != ai and self.plan[bj][di]]
+            if other:
+                bj, (opt2, q2) = self.rng.choice(other)
+                if self._option_ok(ai, opt2, q2) and self._option_ok(bj, opt, q):
+                    self._try([(ai, di), (bj, di)], [(ai, opt2, q2), (bj, opt, q)], temp)
+
+    def _seed_greedy(self) -> None:
+        """Start from a rule-abiding greedy cover: repeatedly add the shift that lowers cost most."""
+        while True:
+            base = self.cost()
+            best = None
+            for q in self.queues:
+                for di in range(len(self.days)):
+                    for opt in self.options[di]:
+                        if not any(max(self.req[q][i], self.floor[q][i]) > self.gross[q][i] for i in opt.ivs):
+                            continue
+                        for ai in sorted(self.by_queue[q], key=lambda a: (len(self.skills[a]), self.hours[a], a)):
+                            if self.plan[ai][di] is None and self._option_ok(ai, opt, q):
+                                self._add(ai, opt, q)
+                                if self._agent_ok(ai):
+                                    c = sum(self._queue_eval(x)[0] if x == q else self.qcost[x]
+                                            for x in self.queues) + self._hours_cost()
+                                    if best is None or c < best[0] - 1e-9:
+                                        best = (c, ai, opt, q)
+                                    self._remove(ai, di)
+                                    break
+                                self._remove(ai, di)
+            if best is None or best[0] >= base - 1e-9:
+                return
+            _, ai, opt, q = best
+            self._add(ai, opt, q)
+            self.qcost[q] = self._queue_eval(q)[0]
+
+    def _polish(self) -> None:
+        """Deterministic clean-up: drop or shorten any shift whose removal does not raise the cost."""
+        improved = True
+        while improved:
+            improved = False
+            for ai, di in self._shifts():
+                if self.plan[ai][di] is None:
+                    continue
+                opt, q = self.plan[ai][di]
+                if self._try([(ai, di)], [], 0.0):
+                    improved = True
+                    continue
+                for new in sorted(self.options[di], key=lambda o: o.hours):
+                    if new.hours < opt.hours and self._option_ok(ai, new, q) and self._try([(ai, di)], [(ai, new, q)], 0.0):
+                        improved = True
+                        break
+
+    def _descent(self, passes: int = 3) -> None:
+        """Deterministic steepest-first descent over single changes: every shift's other (template,
+        queue) on its day, its removal, and every free agent-day's options. Stops when a pass finds
+        nothing that lowers the cost."""
+        for _ in range(passes):
+            improved = False
+            for ai in range(len(self.agents)):
+                for di in range(len(self.days)):
+                    cur = self.plan[ai][di]
+                    alts = [(o, q) for o in self.options[di] for q in self.skills[ai] if self._option_ok(ai, o, q)]
+                    for o, q in alts:
+                        cur = self.plan[ai][di]
+                        if cur is not None and cur[0] is o and cur[1] == q:
+                            continue
+                        removes = [(ai, di)] if cur is not None else []
+                        if self._try(removes, [(ai, o, q)], 0.0) and self.cost() < self._last - 1e-9:
+                            improved = True
+                        self._last = self.cost()
+                    if self.plan[ai][di] is not None:
+                        before = self.cost()
+                        if self._try([(ai, di)], [], 0.0) and self.cost() < before - 1e-9:
+                            improved = True
+                    self._last = self.cost()
+            if not improved:
+                return
+
+    def run(self, iterations: int, stages: int = 6) -> None:
+        """Greedy start, then annealing in stages. The staged penalties (net floor gaps, breaks at the
+        window edge) start soft so the search can pass through such states and end at full weight;
+        the best plan of the last stage is kept and polished."""
+        self.stage = 1.0 / 64
+        self.qcost = {q: self._queue_eval(q)[0] for q in self.queues}
+        self._seed_greedy()
+        t0, t1 = 6.0, 0.05
+        per = max(1, iterations // stages)
+        for st in range(stages):
+            self.stage = 64.0 ** (st / max(1, stages - 1) - 1)
+            self.qcost = {q: self._queue_eval(q)[0] for q in self.queues}
+            best_cost, best_plan = self.cost(), [list(p) for p in self.plan]
+            hot = t0 if st == 0 else t0 / 3
+            for k in range(per):
+                temp = hot * (t1 / hot) ** (k / max(1, per - 1))
+                self._move(temp)
+                c = self.cost()
+                if c < best_cost - 1e-9:
+                    best_cost, best_plan = c, [list(p) for p in self.plan]
+            self._load(best_plan)
+        self._last = self.cost()
+        self._descent()
+        self._polish()
+
+    def _load(self, plan) -> None:
+        for ai, di in self._shifts():
+            self._remove(ai, di)
+        for ai, row in enumerate(plan):
+            for x in row:
+                if x:
+                    self._add(ai, x[0], x[1])
+        self.qcost = {q: self._queue_eval(q)[0] for q in self.queues}
+
+    def shifts(self) -> list[Shift]:
+        out = []
+        breaks = {q: self._breaks(q)[0] for q in self.queues}
+        for ai, di in self._shifts():
+            opt, q = self.plan[ai][di]
+            sh = Shift(self.agents[ai].agent_id, q, opt.tpl, self.days[di], list(opt.segments),
+                       [self.grid[i] for i in opt.ivs])
+            b = breaks[q].get((ai, di))
+            if b is not None:
+                sh.break_start = self.grid[b]
+                sh.break_minutes = int(self.brk_len.total_seconds() // 60)
+            out.append(sh)
+        return out
+
+
+def schedule_week(req: pd.DataFrame, cfg: dict, agents: list[Agent], week: str) -> list[Shift]:
+    """Best of a fixed list of seeded runs (lowest cost; the earlier seed on a tie)."""
+    best = None
+    for seed in cfg.get("search_seeds", [44, 45, 46]):
+        s = Search(req, cfg, agents, week, seed=int(seed))
+        s.run(int(cfg.get("search_iterations", 40000)))
+        if best is None or s.cost() < best.cost() - 1e-9:
+            best = s
+    return best.shifts()
