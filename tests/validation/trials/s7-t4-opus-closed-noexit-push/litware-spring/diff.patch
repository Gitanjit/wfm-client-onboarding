+# Litware Support — local-time export stamped with the END of each 20-minute interval, plus a UTC
+# offset per row, Europe/London. Contract: docs/LITWARE_SOW.md (go-live 2027-W11).
+# Every value below is what the SOW requires; nothing here relaxes a contract figure.
+name: Litware
+interval_minutes: 20                 # SOW 1.5
+tz: Europe/London                    # SOW 1.4
+operating_hours: [7, 21]             # SOW 1.4 (templates must fit inside: D8, L8, P6a, P6b, P4, S44)
+queues: [priority, standard, email]  # SOW 1.1
+full_week_grid: true                 # every 20-minute interval of the local ISO week
+export_stamp: end                    # SOW 1.5 / data/litware/README.txt: rows stamped with the interval END
+
+sla:                                 # SOW 1.2
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 30}
+  email:    {target: 0.80, seconds: 300}
+occupancy_cap: 0.85                  # SOW 1.3
+aht_smoothing: interval              # SOW 1.2: the interval's own average handle time
+queueing: erlang                     # SOW 1.2: Erlang C, no abandonment
+attainment_basis: service_level      # SOW 1.2
+attainment_intervals: operating      # SOW 1.6: fraction of operating intervals (07:00-21:00)
+exclude_exceptions: true             # SOW 1.6/2.6: intervals listed under Exceptions are left out
+sla_target: 0.95                     # SOW 1.6: weekly attainment per queue
+max_hours_ratio: 1.45                # SOW 1.6: scheduled hours <= 1.45 x required hours
+
+min_cover: {priority: {agents: 2, hours: [7, 21]}}   # SOW 2.4
+min_cover_net: true                  # SOW 2.4 "breaks aside": kept net of breaks as well as gross
+cross_skill_weight: 0                # SOW 1.2/2.4: only agents scheduled on the queue count
+queue_start: {email: 9}              # SOW 2.5: nobody on email before 09:00 local
+
+scheduler: week                      # wfm/scheduler/week.py: rules enforced while placing
+min_rest_hours: 11                   # SOW 2.1
+split_shift_contracts: [PT]          # SOW 2.2
+break:                               # SOW 2.3
+  min_shift_hours: 6
+  minutes: 20
+  window_hours: [2, 5]
+  placement: max_surplus
+weekly_hours: {FT: 40, PT: 24}       # SOW 2.9 (same as the service defaults)
+max_consecutive_days: 5              # SOW 2.9
+runbook: true                        # SOW 3: write out/litware/RUNBOOK.md with each run
+hours_margin: 0.999
