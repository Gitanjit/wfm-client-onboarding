+"""Litware onboarding (docs/LITWARE_SOW.md): end-stamped 20-minute export, SOW staffing, §2 rules, §2.6."""
+import pandas as pd
+import pytest
+
+from wfm.config import load_config
+from wfm.evaluate.metrics import evaluate
+from wfm.exceptions import infeasible
+from wfm.ingest.loader import load_week
+from wfm.roster import load_agents
+from wfm.scheduler import week as week_scheduler
+from wfm.scheduler.greedy import to_frame
+from wfm.staffing.erlang import required_agents
+from wfm.staffing.required import add_required
+
+
+@pytest.fixture(scope="module")
+def w11():
+    cfg = load_config("litware")
+    req = add_required(load_week(cfg, "2027-W11"), cfg)
+    agents = load_agents("litware")
+    sched = to_frame(week_scheduler.schedule_week(req, cfg, agents, "2027-W11"))
+    return cfg, req, agents, sched
+
+
+def test_end_stamped_rows_cover_the_twenty_minutes_before(w11):
+    _, req, _, _ = w11
+    assert req["interval_start_utc"].nunique() == 504 and set(req["queue"]) == {"priority", "standard", "email"}
+    # the first row with volume is stamped 07:20 local (GMT): it covers 07:00-07:20
+    first = req[req["volume"] > 0]["interval_start_utc"].min()
+    assert first == pd.Timestamp("2027-03-15T07:00Z")
+
+
+def test_required_uses_interval_aht_and_cap(w11):
+    _, req, _, _ = w11
+    r = req[(req["queue"] == "email") & (req["volume"] > 0)].iloc[5]
+    assert r["required"] == required_agents(r["volume"], 1200, r["aht_sec"], 0.80, 300, 0.85)
+
+
+def test_exceptions_are_email_before_nine(w11):
+    cfg, req, agents, _ = w11
+    exc = infeasible(req, cfg, agents)
+    assert exc and all(q == "email" and t.tz_convert("Europe/London").hour < 9 for q, t in exc)
+
+
+def test_schedule_keeps_every_rule_and_the_hours_bound(w11):
+    cfg, req, agents, sched = w11
+    res = evaluate(req, sched, cfg, agents, "2027-W11")
+    assert all(n == 0 for n in res["violations"].values()), res["violations"]
+    assert res["within_hours_ratio"]
+    assert all(v >= 0.95 for v in res["sla"].values()), res["sla"]
+    starts = pd.to_datetime(sched.loc[sched["queue"] == "email", "segment_start_utc"], utc=True)
+    assert all(t.tz_convert("Europe/London").hour >= 9 for t in starts)
