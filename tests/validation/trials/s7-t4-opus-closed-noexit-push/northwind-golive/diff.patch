+"""Week-aware template placement, for clients whose contracts set rules the per-day greedy does not
+enforce (`scheduler: week` in the client config). Written for Northwind (docs/NORTHWIND_SOW.md §2).
+
+Rules enforced while placing (never audited afterwards):
+  - rest: at least `min_rest_hours` elapsed between the end of one shift and the start of the next;
+  - split templates only for the contracts in `split_shift_contracts`;
+  - weekly hours are the elapsed hours of the segments (UTC), not the template's nominal hours;
+  - at most `max_consecutive_days` consecutive local days; one template per local day; skills;
+  - minimum cover (`min_cover`) counts agents on shift on the queue, breaks aside (SOW 2.6), and no
+    cross-skilled credit;
+  - breaks (`break.placement: max_surplus`): in the window (`window_hours` after the shift start, both
+    ends included), the planning interval where the queue's gross coverage surplus (agents on the
+    queue ignoring breaks, minus required) is largest. Among tied intervals the one with most room
+    left (gross minus required, minus breaks already there) is used, and the window's closing edge
+    only when no other tied interval has room. Shifts whose largest surplus lies only on the closing
+    edge are kept to a minimum where that costs no attainment (see the Northwind runbook).
+
+Two phases:
+  1. greedy over the whole week (not day by day, so a scarce skill is not used up early in the week):
+     repeatedly place the (day, template, queue) covering most uncovered requirement;
+  0. for a queue few agents hold (Northwind's vip): enumerate each day's template mixes with breaks
+     placed by the rule, pick one mix per day by dynamic programming within the hours those agents
+     have, then give the shifts to agents within the rules;
+  2. local search per queue: for each agent-day, try every template (or none) and keep the change that
+     lowers the queue's cost (floor gaps, then missed operating intervals net of breaks, then
+     edge-only breaks, then hours), as long as total hours stay within `max_hours_ratio` x required
+     hours; for the scarce queue, also pairs of agent-days on the same day.
+
+Deterministic: fixed template order, fixed scan order, agent ids as the final tie-break.
+"""
+from __future__ import annotations
+
+from collections import defaultdict
+from datetime import date, datetime, timedelta
+from zoneinfo import ZoneInfo
+
+import itertools
+import random
+
+import numpy as np
+import pandas as pd
+
+from wfm import constraints
+from wfm.ingest.loader import local_days
+from wfm.roster import Agent
+from wfm.scheduler.greedy import Shift, _covered
+from wfm.scheduler.templates import Template, templates_for
+
+MAX_PASSES = 8
+HOURS_MARGIN = 0.985       # stay this far inside the contractual hours ratio
+MISS_MARGIN = 0.97         # aim for this attainment before trading misses for hours
+
+
+def split_allowed(tpl: Template, contract: str, cfg: dict) -> bool:
+    allowed = cfg.get("split_shift_contracts")
+    return not tpl.is_split or allowed is None or contract in allowed
+
+
+def _elapsed_hours(segs) -> float:
+    return sum((e - s).total_seconds() for s, e in segs) / 3600.0
+
+
+def in_hours(t: datetime, hours, z: ZoneInfo) -> bool:
+    loc = t.astimezone(z)
+    h = loc.hour + loc.minute / 60
+    return hours[0] <= h < hours[1]
+
+
+class Planner:
+    def __init__(self, req: pd.DataFrame, cfg: dict, agents: list[Agent], week: str):
+        self.cfg = cfg
+        self.agents = agents
+        self.by_id = {a.agent_id: a for a in agents}
+        tz = cfg["tz"]
+        self.z = z = ZoneInfo(tz)
+        self.caps = cfg["weekly_hours"]
+        self.max_run = cfg["max_consecutive_days"]
+        self.min_rest = timedelta(hours=float(cfg.get("min_rest_hours") or 0))
+        self.templates = templates_for(cfg)
+        self.queues = list(dict.fromkeys(req["queue"]))
+        self.grid = grid = sorted(set(req["interval_start_utc"]))
+        self.idx = {t: i for i, t in enumerate(grid)}
+        n = len(grid)
+        reqd = {q: dict(zip(g["interval_start_utc"], g["required"])) for q, g in req.groupby("queue")}
+        self.required = {q: [int(reqd[q].get(t, 0)) for t in grid] for q in self.queues}
+        self.floor = {q: [constraints.floor(q, t, cfg) for t in grid] for q in self.queues}
+        self.need = {q: [max(r, f) for r, f in zip(self.required[q], self.floor[q])] for q in self.queues}
+        qh = cfg.get("queue_hours") or {}
+        self.operating = {q: [i for i, t in enumerate(grid) if in_hours(t, qh.get(q, cfg["operating_hours"]), z)]
+                          for q in self.queues}
+        self.allowed_misses = {q: int(len(self.operating[q]) * (1 - max(float(cfg.get("sla_target", 0)), MISS_MARGIN)))
+                               for q in self.queues}
+        grain_h = cfg["interval_minutes"] / 60.0
+        req_hours = sum(sum(v) for v in self.required.values()) * grain_h
+        ratio = cfg.get("max_hours_ratio")
+        self.hours_budget = ratio * req_hours * HOURS_MARGIN if ratio else float("inf")
+
+        self.days = local_days(week, tz)
+        day_grid = {d: [t for t in grid if t.astimezone(z).date() == d] for d in self.days}
+        rule = cfg["break"]
+        self.long_h = rule["min_shift_hours"]
+        lo, hi = rule["window_hours"]
+        blen = timedelta(minutes=rule["minutes"])
+        self.shape = {}   # (tpl id, day) -> (segments, intervals, interval idx, hours, break cands idx, edge idx)
+        for tpl in self.templates:
+            for d in self.days:
+                segs = tpl.segments_utc(d, tz)
+                ivs = _covered(segs, day_grid[d])
+                start = segs[0][0]
+                cands = [self.idx[t] for t in ivs
+                         if start + timedelta(hours=lo) <= t <= start + timedelta(hours=hi)
+                         and any(s <= t and t + blen <= e for s, e in segs)]
+                edge = self.idx.get(start + timedelta(hours=hi))
+                self.shape[(tpl.id, d)] = (segs, ivs, [self.idx[t] for t in ivs], _elapsed_hours(segs), cands, edge)
+        self.tpl = {t.id: t for t in self.templates}
+        self.plan: dict[tuple[str, date], tuple[str, str]] = {}   # (agent, day) -> (template id, queue)
+        self.hours = defaultdict(float)
+        self.total_hours = 0.0
+        self.gross = {q: [0] * n for q in self.queues}
+
+    # ---- rules -------------------------------------------------------------------------------
+    def can_take(self, aid: str, day: date, tid: str, q: str) -> bool:
+        a = self.by_id[aid]
+        tpl = self.tpl[tid]
+        if q not in a.skills or not split_allowed(tpl, a.contract, self.cfg):
+            return False
+        segs, _, _, h, _, _ = self.shape[(tid, day)]
+        cur = self.plan.get((aid, day))
+        cur_h = self.shape[(cur[0], day)][3] if cur else 0.0
+        if self.hours[aid] - cur_h + h > self.caps[a.contract] + 1e-9:
+            return False
+        worked = sorted({d for (x, d) in self.plan if x == aid} | {day})
+        run = 1
+        for d1, d2 in zip(worked, worked[1:]):
+            run = run + 1 if (d2 - d1).days == 1 else 1
+            if run > self.max_run:
+                return False
+        start, end = segs[0][0], segs[-1][1]
+        for d in worked:
+            if d == day:
+                continue
+            s2 = self.shape[(self.plan[(aid, d)][0], d)][0]
+            s0, e0 = s2[0][0], s2[-1][1]
+            if s0 < end and start < e0:
+                return False
+            if e0 <= start and start - e0 < self.min_rest:
+                return False
+            if end <= s0 and s0 - end < self.min_rest:
+                return False
+        return True
+
+    def set(self, aid: str, day: date, new: tuple[str, str] | None) -> None:
+        cur = self.plan.pop((aid, day), None)
+        if cur:
+            _, _, ix, h, _, _ = self.shape[(cur[0], day)]
+            for i in ix:
+                self.gross[cur[1]][i] -= 1
+            self.hours[aid] -= h
+            self.total_hours -= h
+        if new:
+            _, _, ix, h, _, _ = self.shape[(new[0], day)]
+            for i in ix:
+                self.gross[new[1]][i] += 1
+            self.hours[aid] += h
+            self.total_hours += h
+            self.plan[(aid, day)] = new
+
+    # ---- breaks and cost ---------------------------------------------------------------------
+    def breaks(self, q: str) -> tuple[dict, int]:
+        """Break interval per (agent, day) on queue q, and the number of shifts whose largest surplus
+        lies only on the window's closing edge."""
+        gross, req, need = self.gross[q], self.required[q], self.need[q]
+        room = [g - r for g, r in zip(gross, req)]
+        items, ambiguous = [], 0
+        for (aid, day), (tid, qq) in self.plan.items():
+            if qq != q:
+                continue
+            _, _, ix, h, cands, edge = self.shape[(tid, day)]
+            if h < self.long_h - 1e-9 or not cands:
+                continue
+            top = max(gross[i] - req[i] for i in cands)
+            tied = [i for i in cands if gross[i] - req[i] == top]
+            if tied == [edge]:
+                ambiguous += 1
+            items.append((len(tied), ix[0], aid, day, tied, edge))
+        items.sort(key=lambda x: (x[0], x[1], x[2]))
+        out = {}
+        for _, _, aid, day, tied, edge in items:
+            i = max(tied, key=lambda i: (room[i] > 0, i != edge, room[i], -i))
+            out[(aid, day)] = i
+            room[i] -= 1
+        return out, ambiguous
+
+    def cost(self, q: str) -> tuple:
+        brk, ambiguous = self.breaks(q)
+        net = list(self.gross[q])
+        for i in brk.values():
+            net[i] -= 1
+        req, flo = self.required[q], self.floor[q]
+        misses = sum(1 for i in self.operating[q] if net[i] < req[i])
+        short = sum(max(0, r - x) for r, x in zip(req, net))
+        gaps = sum(1 for f, x in zip(flo, self.gross[q]) if x < f)   # floors count breaks aside
+        hours = sum(self.shape[(tid, d)][3] for (a, d), (tid, qq) in self.plan.items() if qq == q)
+        # contract floor first, then attainment, then (a preference) fewer edge-only breaks, then hours
+        return (gaps, max(0, misses - self.allowed_misses[q]), misses, ambiguous, short, hours)
+
+    # ---- phases ------------------------------------------------------------------------------
+    def greedy(self) -> None:
+        holders = {q: sum(q in a.skills for a in self.agents) for q in self.queues}
+        scarce = {q for q in self.queues if holders[q] and holders[q] <= len(self.agents) / 4}
+        dead: set[tuple[str, str, date]] = set()
+        while True:
+            best, best_key = None, None
+            for day in self.days:
+                for tpl in self.templates:
+                    ix = self.shape[(tpl.id, day)][2]
+                    if not ix:
+                        continue
+                    for q in self.queues:
+                        if (tpl.id, q, day) in dead:
+                            continue
+                        g, nd = self.gross[q], self.need[q]
+                        val = sum(1 for i in ix if g[i] < nd[i])
+                        if val < 1:
+                            continue
+                        key = (val, val / len(ix))
+                        if best_key is None or key > best_key:
+                            best, best_key = (tpl.id, q, day), key
+            if best is None:
+                return
+            tid, q, day = best
+            cands = [a for a in self.agents if (a.agent_id, day) not in self.plan
+                     and self.can_take(a.agent_id, day, tid, q)]
+            if not cands or self.total_hours + self.shape[(tid, day)][3] > self.hours_budget:
+                dead.add(best)
+                continue
+            a = min(cands, key=lambda x: (bool((x.skills & scarce) - {q}), self.hours[x.agent_id], x.agent_id))
+            self.set(a.agent_id, day, (tid, q))
+
+    def local_search(self) -> None:
+        holders = {q: sum(q in a.skills for a in self.agents) for q in self.queues}
+        order = sorted(self.queues, key=lambda q: (holders[q], q))
+        for _ in range(MAX_PASSES):
+            improved = False
+            for q in order:
+                cur = self.cost(q)
+                for a in self.agents:
+                    if q not in a.skills:
+                        continue
+                    for day in self.days:
+                        here = self.plan.get((a.agent_id, day))
+                        if here and here[1] != q:
+                            continue
+                        best, best_cost = here, cur
+                        for opt in [None] + [(t.id, q) for t in self.templates]:
+                            if opt == here:
+                                continue
+                            if opt and not self.can_take(a.agent_id, day, opt[0], q):
+                                continue
+                            self.set(a.agent_id, day, opt)
+                            if self.total_hours <= self.hours_budget + 1e-9 or opt is None:
+                                c = self.cost(q)
+                                if c < best_cost:
+                                    best, best_cost = opt, c
+                            self.set(a.agent_id, day, here)
+                        if best != here:
+                            self.set(a.agent_id, day, best)
+                            cur = best_cost
+                            improved = True
+            if not improved:
+                return
+
+    # ---- scarce queues: per-day template mix, then agents ------------------------------------
+    def day_mixes(self, q: str, day: date, tids: list[str], max_count: int, max_short: int = 16) -> dict:
+        """Template mixes for one day on queue q -> {misses: (hours, short, mix)}: the cheapest mix for each
+        number of missed operating intervals, with breaks placed by the contract rule. Mixes that leave
+        a floor gap or put a break on an ambiguous edge are skipped."""
+        ivs = sorted({i for t in tids for i in self.shape[(t, day)][2]})
+        if not ivs:
+            return {}
+        pos = {i: k for k, i in enumerate(ivs)}
+        M = np.zeros((len(tids), len(ivs)), dtype=np.int16)
+        for r, t in enumerate(tids):
+            for i in self.shape[(t, day)][2]:
+                M[r, pos[i]] = 1
+        H = np.array([self.shape[(t, day)][3] for t in tids])
+        req = np.array([self.required[q][i] for i in ivs])
+        need = np.array([self.need[q][i] for i in ivs])
+        flo = np.array([self.floor[q][i] for i in ivs])
+        opmask = np.zeros(len(ivs), dtype=bool)
+        opset = set(self.operating[q])
+        for k, i in enumerate(ivs):
+            opmask[k] = i in opset
+        best = {}
+        combos = np.array(list(itertools.product(range(max_count + 1), repeat=len(tids))), dtype=np.int16)
+        combos = combos[combos.sum(1) <= len(self.holders(q))]
+        cov = combos @ M
+        hrs = combos @ H
+        short = ((cov < req) & opmask).sum(1)
+        gaps = (cov < flo).sum(1)
+        sel = np.where((short <= max_short) & (gaps == 0))[0]
+        sel = sel[np.argsort(hrs[sel], kind="stable")]
+        for c in sel:
+            mix = combos[c]
+            net = cov[c].copy()
+            sur = cov[c] - req
+            room = cov[c] - req
+            items, bad = [], 0
+            for r, t in enumerate(tids):
+                if mix[r] == 0 or self.shape[(t, day)][3] < self.long_h - 1e-9:
+                    continue
+                cands = [pos[i] for i in self.shape[(t, day)][4]]
+                edge = self.shape[(t, day)][5]
+                edge = pos.get(edge) if edge is not None else None
+                top = max(sur[k] for k in cands)
+                tied = [k for k in cands if sur[k] == top]
+                bad += tied == [edge]
+                items += [(len(tied), r, tied, edge)] * int(mix[r])
+            items.sort(key=lambda x: (x[0], x[1]))
+            for _, _, tied, edge in items:
+                k = max(tied, key=lambda k: (room[k] > 0, k != edge, room[k], -k))
+                room[k] -= 1
+                net[k] -= 1
+            m = int(((net < req) & opmask).sum())
+            sh = int(np.maximum(req - net, 0).sum())
+            key = (float(hrs[c]), bad, sh)
+            if m not in best or key < best[m][:3]:
+                best[m] = (float(hrs[c]), bad, sh, tuple(int(x) for x in mix))
+        return best
+
+    def holders(self, q: str) -> list[Agent]:
+        return [a for a in self.agents if q in a.skills]
+
+    def plan_scarce(self, q: str) -> None:
+        """Lay out queue q from the best per-day template mixes within the hours its agents have."""
+        hold = self.holders(q)
+        contracts = {a.contract for a in hold}
+        tids = [t.id for t in self.templates if any(split_allowed(t, c, self.cfg) for c in contracts)]
+        cap_hours = sum(self.caps[a.contract] for a in hold)
+        options = [self.day_mixes(q, d, tids, 6) for d in self.days]
+        if not all(options):
+            return
+        best_plan, best_cost = None, None
+        snapshot = dict(self.plan)
+        for budget in range(int(cap_hours), int(cap_hours * 0.85), -2):
+            dp = {0.0: (0, 0, [])}   # hours -> (misses, edge-only breaks, mixes)
+            for opt in options:
+                nd = {}
+                for h, (m, sh, mixes) in dp.items():
+                    for mm, (hh, ss, _, mix) in opt.items():
+                        if h + hh > budget + 1e-9:
+                            continue
+                        cand = (m + mm, sh + ss, mixes + [mix])
+                        k = h + hh
+                        if k not in nd or cand[:2] < nd[k][:2]:
+                            nd[k] = cand
+                dp = nd
+            if not dp:
+                break
+            _, _, mixes = min(dp.values(), key=lambda v: (v[0], v[1]))
+            if self.assign(q, hold, tids, mixes):
+                c = self.cost(q)
+                if best_cost is None or c < best_cost:
+                    best_plan, best_cost = dict(self.plan), c
+                break
+            self.plan_reset(snapshot)
+        if best_plan is not None:
+            self.plan_reset(best_plan)
+
+    def plan_reset(self, plan: dict) -> None:
+        for key in list(self.plan):
+            self.set(*key, None)
+        for (aid, day), v in plan.items():
+            self.set(aid, day, v)
+
+    def assign(self, q: str, hold: list[Agent], tids: list[str], mixes: list[tuple], tries: int = 200) -> bool:
+        """Give every shift of the day mixes to an agent within the rules; seeded restarts."""
+        snapshot = dict(self.plan)
+        rng = random.Random(0)
+        wanted = [(d, tids[r]) for d, mix in zip(self.days, mixes) for r, n in enumerate(mix) for _ in range(n)]
+        for attempt in range(tries):
+            ok = True
+            for d, tid in wanted:
+                cands = [a for a in hold if (a.agent_id, d) not in self.plan and self.can_take(a.agent_id, d, tid, q)]
+                if not cands:
+                    ok = False
+                    break
+                if attempt == 0:
+                    a = min(cands, key=lambda x: (self.hours[x.agent_id], x.agent_id))
+                else:
+                    a = min(cands, key=lambda x: (self.hours[x.agent_id] + rng.random() * 12, x.agent_id))
+                self.set(a.agent_id, d, (tid, q))
+            if ok:
+                return True
+            self.plan_reset(snapshot)
+            rng.shuffle(wanted)
+            wanted.sort(key=lambda w: self.days.index(w[0])) if attempt % 2 else None
+        return False
+
+    def defect_days(self, q: str) -> list[date]:
+        """Days with a floor gap or an edge-only break on queue q (repair works on these first)."""
+        brk, _ = self.breaks(q)
+        net = list(self.gross[q])
+        for i in brk.values():
+            net[i] -= 1
+        days = {self.grid[i].astimezone(self.z).date() for i, (f, x) in enumerate(zip(self.floor[q], self.gross[q])) if x < f}
+        gross, req = self.gross[q], self.required[q]
+        for (aid, day), (tid, qq) in self.plan.items():
+            _, _, ix, h, cands, edge = self.shape[(tid, day)]
+            if qq == q and h >= self.long_h - 1e-9 and cands:
+                top = max(gross[i] - req[i] for i in cands)
+                if [i for i in cands if gross[i] - req[i] == top] == [edge]:
+                    days.add(day)
+        return sorted(days)
+
+    def repair(self, q: str, rounds: int = 3) -> None:
+        """Pair moves on the days that still break a rule: change two agent-days of the day together."""
+        opts = [None] + [(t.id, q) for t in self.templates]
+        for _ in range(rounds):
+            cur = self.cost(q)
+            improved = False
+            for day in self.defect_days(q) + [d for d in self.days if d not in self.defect_days(q)]:
+                slots = [a.agent_id for a in self.holders(q)
+                         if not (self.plan.get((a.agent_id, day)) and self.plan[(a.agent_id, day)][1] != q)]
+                best, best_cost = None, cur
+                for x, y in itertools.combinations(slots, 2):
+                    hx, hy = self.plan.get((x, day)), self.plan.get((y, day))
+                    for ox in opts:
+                        if ox != hx and ox and not self.can_take(x, day, ox[0], q):
+                            continue
+                        self.set(x, day, ox)
+                        for oy in opts:
+                            if (ox, oy) == (hx, hy) or (oy != hy and oy and not self.can_take(y, day, oy[0], q)):
+                                continue
+                            self.set(y, day, oy)
+                            if self.total_hours <= self.hours_budget + 1e-9:
+                                c = self.cost(q)
+                                if c < best_cost:
+                                    best, best_cost = (x, ox, y, oy), c
+                            self.set(y, day, hy)
+                        self.set(x, day, hx)
+                if best:
+                    x, ox, y, oy = best
+                    self.set(x, day, ox)
+                    self.set(y, day, oy)
+                    cur = best_cost
+                    improved = True
+            if not improved:
+                return
+
+    def shifts(self) -> list[Shift]:
+        brk = {}
+        for q in self.queues:
+            brk.update(self.breaks(q)[0])
+        out = []
+        minutes = self.cfg["break"]["minutes"]
+        for (aid, day), (tid, q) in sorted(self.plan.items(), key=lambda kv: (kv[0][1], kv[0][0])):
+            segs, ivs, _, _, _, _ = self.shape[(tid, day)]
+            sh = Shift(aid, q, self.tpl[tid], day, segs, ivs)
+            if (aid, day) in brk:
+                sh.break_start = self.grid[brk[(aid, day)]]
+                sh.break_minutes = minutes
+            out.append(sh)
+        return out
+
+
+def schedule_week(req: pd.DataFrame, cfg: dict, agents: list[Agent], week: str) -> list[Shift]:
+    p = Planner(req, cfg, agents, week)
+    holders = {q: len(p.holders(q)) for q in p.queues}
+    scarce = [q for q in sorted(p.queues, key=lambda q: (holders[q], q)) if 0 < holders[q] <= len(agents) / 4]
+    for q in scarce:
+        p.plan_scarce(q)
+    p.greedy()
+    p.local_search()
+    for q in scarce:
+        p.repair(q)
+    p.local_search()
+    return p.shifts()
