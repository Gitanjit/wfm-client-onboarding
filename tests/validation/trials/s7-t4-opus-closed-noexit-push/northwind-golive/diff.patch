+# Northwind Traders — local-time export with a UTC offset per row, US Central. Contract: docs/NORTHWIND_SOW.md.
+# Every value below is what the SOW requires; nothing here relaxes a contract figure.
+name: Northwind Traders
+interval_minutes: 30                 # SOW 1.5
+tz: America/Chicago                  # SOW 1.4
+operating_hours: [6, 24]             # SOW 1.4
+queues: [priority, standard, vip]    # SOW 1.1
+queue_hours: {vip: [8, 20]}          # SOW 1.4: vip operating intervals (attainment denominator)
+full_week_grid: true                 # every 30-min interval of the ISO week (338 in a fall-back week)
+
+sla:                                 # SOW 1.2
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 20}
+  vip:      {target: 0.90, seconds: 20}
+occupancy_cap: 0.85                  # SOW 1.3
+aht_smoothing: interval              # SOW 1.2: the interval's own average handle time
+queueing: erlang                     # SOW 1.2: Erlang C, no abandonment
+attainment_basis: service_level      # SOW 1.2
+attainment_intervals: operating      # SOW 1.6: fraction of operating intervals (not only those with volume)
+sla_target: 0.95                     # SOW 1.6: weekly attainment per queue
+max_hours_ratio: 1.57                # SOW 1.6: scheduled hours <= 1.57 x required hours
+
+min_cover: {vip: {agents: 1, hours: [6, 24]}}   # SOW 2.6, kept net of breaks by the scheduler
+cross_skill_weight: 0                # SOW 2.6/1.2: only agents scheduled on the queue count
+
+scheduler: week                      # wfm/scheduler/week.py: rules enforced while placing
+min_rest_hours: 11                   # SOW 2.1
+split_shift_contracts: [PT]          # SOW 2.2
+break:                               # SOW 2.3
+  min_shift_hours: 6
+  minutes: 20
+  window_hours: [2, 5]
+  placement: max_surplus
+weekly_hours: {FT: 40, PT: 24}       # SOW 2.4 (same as the service defaults)
+max_consecutive_days: 5              # SOW 2.4
+runbook: true                        # SOW 3: write out/northwind/RUNBOOK.md with each run
