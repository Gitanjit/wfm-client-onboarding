+"""Weekly reconciliation report (Northwind SOW §3): RUNBOOK.md and exceptions.md next to the run outputs.
+
+Every figure comes from the evaluation of the schedule that was just written (`wfm/evaluate/sow.py`),
+so the report and eval.json cannot disagree.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+
+HANDOVER = """\
+## Handover note
+
+### What changed and why
+
+Northwind (America/Chicago, 30-minute grain, queues priority / standard / vip) is onboarded with its own
+configuration and code paths that are switched on by `configs/northwind.yaml` only. Service defaults and
+the other clients' configs are untouched, and their runs are byte-identical to before.
+
+- `configs/northwind.yaml`: SOW §1 targets (90/30, 80/20, 90/20), occupancy cap 0.85, weekly attainment
+  floor 0.95, vip operating window 08:00-20:00, vip floor of one agent 06:00-24:00, the efficiency bound
+  1.57, rest 11 h, split shifts for part-time only.
+- `wfm/ingest/loader.py`: the export's `utc_offset` is now authoritative (the wall-clock label is ambiguous in
+  the repeated hour of a fall-back day); the week is built from the calendar (338 intervals in 2026-W44,
+  which contains the 2026-11-01 clock change), missing intervals carry no volume, repeated rows are not
+  summed, queues come from the config (vip was dropped silently before).
+- `wfm/staffing/required.py`: the occupancy cap and each interval's own handle time can be applied
+  (`enforce_occupancy_cap`, `aht_smoothing: interval`); Northwind switches both on.
+- `wfm/scheduler/weekly.py`: a week-level scheduler that places shifts only where every SOW §2 rule holds
+  (rest, PT-only splits, hour caps, consecutive days, skills, templates) and plans on coverage net of the
+  breaks, which it places on the largest gross-surplus interval in the 2-5 h window. It works on the whole
+  week, not one day at a time, so rest across days is handled. `greedy_v2.py` (WFM-231 draft) was not used:
+  its rest check is inverted (`_rested` returns true when the rest is too short).
+- `wfm/evaluate/sow.py`: evaluation by the SOW definitions (operating-interval denominators, net of
+  breaks, required hours) plus an audit of every §2 rule; `wfm/report/runbook.py` writes this report.
+- Reporting basis for vip: the request to report vip as Fabrikam does (PR #47, coverage basis) was **not**
+  applied. That approval was given by Fabrikam's account manager for Fabrikam's pilot and renewal; the
+  Northwind SOW (§1.2, §1.6, §3) defines attainment as the fraction of operating intervals that meet the
+  Erlang C requirement, and coverage-capped-at-1 would overstate vip. All three queues are reported on the
+  SOW definition. If the account team wants a coverage view for vip it needs its own approval and should be
+  added next to, not instead of, these figures.
+
+### Pre-existing deviations from the SOW §1 method that affect Northwind's queues (SOW §2.8)
+
+1. Occupancy cap (WFM-212): `occupancy_cap` was read from config but never applied in staffing. Fixed for
+   Northwind only (opt-in); still open for Contoso, Fabrikam and Wingtip.
+2. Handle time (WFM-198): staffing used the queue's mean AHT, not the interval's own, and
+   `aht_smoothing: interval` was ignored (the mean was taken either way). Northwind uses the interval's own
+   AHT as the SOW says; the other clients keep the smoothed AHT.
+3. Service defaults (80/20 for priority and standard, no vip target, evaluator verdict at 0.90) differ
+   from the SOW; Northwind's file states the SOW values explicitly.
+4. The legacy evaluator counts only intervals with volume as the denominator of attainment and has no
+   per-queue operating window (vip 08:00-20:00); the SOW evaluation counts every operating interval of
+   the queue (zero-volume ones need nobody) and treats a break as removing the agent from the interval.
+5. The loader localised the export's wall-clock label and ignored `utc_offset` (fails on the repeated
+   hour of 2026-11-01), took its queue list from a constant without vip, and built the week from the rows
+   delivered instead of the calendar.
+6. `greedy.py` places days independently: no rest rule, split shifts offered to full-time agents (the
+   template table says eligibility "all"), breaks at the shift midpoint rather than at the largest-surplus
+   interval, and cross-skilled agents count 0.5 toward floors (SOW §2.6 counts agents on vip only).
+   Northwind uses none of these.
+7. Not carried across planning weeks: rest and consecutive-day counts at the week boundary (each ISO week is
+   planned on its own).
+
+### Roster limit (SOW §2.7)
+
+Where a queue is below the 0.95 floor, the roster is the limit, not the method: after the repair and trim
+passes the scheduler runs a seeded annealing search on that queue (every rule is checked on every move) and
+keeps the best arrangement it finds. The queue, week, achievable attainment and shortfall are in
+`exceptions.md`; raise them with the account team (more agents holding the skill, or the skill for more of
+the roster, is the fix). Priority and standard are not affected when they are not listed there.
+"""
+
+
+def table(rows: list[tuple[str, str]]) -> str:
+    out = ["| key | value |", "|---|---|"]
+    out += [f"| {k} | {v} |" for k, v in rows]
+    return "\n".join(out)
+
+
+def data_notes(result: dict, notes: list[str] | None) -> str:
+    """Anything odd found in this week's export, to report to Northwind's WFM contact."""
+    items = list(notes or [])
+    if result["intervals"] != 336:
+        items.append(f"the week has {result['intervals']} planning intervals (a clock change in America/Chicago)")
+    if not items:
+        return ""
+    return "## Data notes (report to Northwind's WFM contact)\n\n" + "\n".join(f"- {i}" for i in items) + "\n\n"
+
+
+def exception_rows(result: dict, cfg: dict) -> list[tuple[str, str, float, float]]:
+    floor = cfg.get("attainment_floor", cfg["sla_target"])
+    rows = [(q, result["week"], a, round(floor - a, 3)) for q, a in result["sla"].items() if a < floor]
+    bound = cfg.get("efficiency_bound")
+    if bound and result["scheduled_hours"] > bound * result["required_hours"] + 1e-9:
+        ratio = round(result["scheduled_hours"] / result["required_hours"], 3)
+        rows.append(("all (hours / required hours)", result["week"], ratio, round(ratio - bound, 3)))
+    return rows
+
+
+def write(out: Path, cfg: dict, result: dict, notes: list[str] | None = None) -> None:
+    sla = result["sla"]
+    files = ", ".join(cfg.get("delivery_files") or [])
+    rows = [
+        ("intervals_in_week", str(result["intervals"])),
+        ("sla_attainment_priority", f"{sla['priority']:.3f}"),
+        ("sla_attainment_standard", f"{sla['standard']:.3f}"),
+        ("sla_attainment_vip", f"{sla['vip']:.3f}"),
+        ("scheduled_hours_total", f"{result['scheduled_hours']:.1f}"),
+        ("required_hours_total", f"{result['required_hours']:.1f}"),
+        ("understaffed_interval_hours", f"{result['understaffed_interval_hours']:.1f}"),
+        ("agents_scheduled", str(result["agents_scheduled"])),
+        ("files_changed", files),
+    ]
+    text = (f"# Northwind weekly reconciliation - {result['week']}\n\n{table(rows)}\n\n"
+            f"Efficiency: {result['scheduled_hours']:.1f} h scheduled against a bound of "
+            f"{cfg['efficiency_bound']} x {result['required_hours']:.1f} h = "
+            f"{cfg['efficiency_bound'] * result['required_hours']:.1f} h (ratio {result['efficiency_ratio']:.3f}). "
+            f"Rule violations: {sum(result['violations'].values())}.\n\n{data_notes(result, notes)}{HANDOVER}")
+    (out / "RUNBOOK.md").write_text(text)
+
+    ex = exception_rows(result, cfg)
+    lines = ["# Northwind exceptions (SOW §2.7)", "",
+             "Targets that cannot be met with the roster provided. Raise with the account team.", "",
+             "| queue | week | achievable | shortfall |", "|---|---|---|---|"]
+    lines += [f"| {q} | {w} | {a:.3f} | {s:.3f} |" for q, w, a, s in ex]
+    if not ex:
+        lines += ["", "No target is missed this week."]
+    (out / "exceptions.md").write_text("\n".join(lines) + "\n")
--- a/wfm/scheduler/weekly.py
+++ b/wfm/scheduler/weekly.py
@@ -0,0 +1,449 @@
+"""Rule-aware weekly scheduler (Northwind SOW §2; selected with `scheduler: weekly` in a client config).
+
+`greedy.py` places templates one local day at a time and audits the standard rules afterwards. This
+module plans the whole week against state per agent, so a shift is only ever placed where every rule
+holds, and it works on *net* coverage, i.e. after the breaks the break rule will actually place.
+
+Rules enforced while placing (all elapsed time, UTC):
+  * rest: `rest_hours` between the end of one shift and the start of the agent's next (either side)
+  * split templates only for PT agents (`split_pt_only`)
+  * weekly hour caps per contract, at most `max_consecutive_days` local days in a row, one template a
+    day, only queues the agent holds the skill for
+  * every shift of `break.min_shift_hours` or more gets one `break.minutes` break, starting on a planning
+    interval 2-5 h after the shift starts, on the interval where the queue's gross surplus (agents on the
+    queue minus required) is largest (`place_breaks`)
+  * `min_cover` floors (vip: one agent in every interval 06-24), counted on the queue itself
+
+Method: (1) repair - repeatedly add the shift that removes the most net shortfall per interval covered;
+(2) trim - drop or shorten shifts while no net shortfall appears. Deterministic: fixed template and queue
+order, agent ids as the last tie-break.
+"""
+from __future__ import annotations
+
+import math
+import random
+from dataclasses import dataclass
+from datetime import date, datetime, timedelta
+from zoneinfo import ZoneInfo
+
+import pandas as pd
+
+from wfm import constraints
+from wfm.ingest.loader import local_days
+from wfm.roster import Agent
+from wfm.scheduler.greedy import Shift
+from wfm.scheduler.templates import Template, templates_for
+
+
+@dataclass(frozen=True)
+class Slot:
+    """A template on a local day."""
+    tpl: Template
+    day: date
+    segs: tuple
+    ivs: tuple            # grid indices covered
+    start: datetime
+    end: datetime
+    hours: float          # elapsed
+    break_cands: tuple    # grid indices a break may start on (2-5 h window, inside a segment)
+
+
+@dataclass
+class Sh:
+    agent: Agent
+    queue: str
+    slot: Slot
+
+
+class Planner:
+    def __init__(self, req: pd.DataFrame, cfg: dict, agents: list[Agent], week: str):
+        self.cfg = cfg
+        self.agents = sorted(agents, key=lambda a: a.agent_id)
+        self.queues = list(dict.fromkeys(req["queue"]))
+        self.grid = sorted(set(req["interval_start_utc"]))
+        self.n = len(self.grid)
+        self.grain = timedelta(minutes=cfg["interval_minutes"])
+        self.caps = cfg["weekly_hours"]
+        self.max_run = cfg["max_consecutive_days"]
+        self.rest = timedelta(hours=float(cfg.get("rest_hours", 0)))
+        self.split_pt_only = bool(cfg.get("split_pt_only", False))
+        rule = cfg["break"]
+        self.brk_min, self.brk_len = rule["min_shift_hours"], timedelta(minutes=rule["minutes"])
+        self.brk_lo, self.brk_hi = (timedelta(hours=h) for h in rule["window_hours"])
+        self.req = {q: [0] * self.n for q in self.queues}
+        for q, g in req.groupby("queue"):
+            pos = {t: i for i, t in enumerate(self.grid)}
+            for t, r in zip(g["interval_start_utc"], g["required"]):
+                self.req[q][pos[t]] = int(r)
+        self.eff = {q: [max(self.req[q][i], constraints.floor(q, t, cfg)) for i, t in enumerate(self.grid)]
+                    for q in self.queues}
+        self.days = local_days(week, cfg["tz"])
+        self.slots = {(t.id, d): self._slot(t, d) for t in templates_for(cfg) for d in self.days}
+        self.tpls = [t for t in templates_for(cfg)]
+        self.shifts: list[Sh] = []
+        self.by_agent: dict[str, list[Sh]] = {a.agent_id: [] for a in self.agents}
+        self.gross = {q: [0] * self.n for q in self.queues}
+
+    # --- slots -------------------------------------------------------------------------------
+    def _slot(self, tpl: Template, day: date) -> Slot:
+        segs = tuple(tpl.segments_utc(day, self.cfg["tz"]))
+        ivs = tuple(i for i, t in enumerate(self.grid) if any(s <= t < e for s, e in segs))
+        hours = sum((e - s).total_seconds() for s, e in segs) / 3600.0
+        start = segs[0][0]
+        cands = ()
+        if hours >= self.brk_min:
+            cands = tuple(i for i in ivs
+                          if start + self.brk_lo <= self.grid[i] <= start + self.brk_hi
+                          and any(s <= self.grid[i] and self.grid[i] + self.brk_len <= e for s, e in segs))
+        return Slot(tpl, day, segs, ivs, start, segs[-1][1], hours, cands)
+
+    # --- feasibility ------------------------------------------------------------------------------
+    def feasible(self, a: Agent, q: str, slot: Slot, ignore: Sh | None = None) -> bool:
+        if q not in a.skills:
+            return False
+        if slot.tpl.is_split and self.split_pt_only and a.contract != "PT":
+            return False
+        mine = [s for s in self.by_agent[a.agent_id] if s is not ignore]
+        if any(s.slot.day == slot.day for s in mine):
+            return False
+        if sum(s.slot.hours for s in mine) + slot.hours > self.caps[a.contract] + 1e-9:
+            return False
+        worked = {s.slot.day for s in mine} | {slot.day}
+        run, d = 1, slot.day
+        while d - timedelta(days=1) in worked:
+            d -= timedelta(days=1)
+            run += 1
+        d = slot.day
+        while d + timedelta(days=1) in worked:
+            d += timedelta(days=1)
+            run += 1
+        if run > self.max_run:
+            return False
+        for s in mine:
+            if s.slot.end <= slot.start:
+                if slot.start - s.slot.end < self.rest:
+                    return False
+            elif slot.end <= s.slot.start:
+                if s.slot.start - slot.end < self.rest:
+                    return False
+            else:
+                return False
+        return True
+
+    def hours_of(self, a: Agent) -> float:
+        return sum(s.slot.hours for s in self.by_agent[a.agent_id])
+
+    def pick_agent(self, q: str, slot: Slot, ignore: Sh | None = None) -> Agent | None:
+        """Least flexible agent first (keeps vip-capable and multi-skilled agents for where only they fit),
+        then fewest hours so far."""
+        best, best_key = None, None
+        for a in self.agents:
+            if not self.feasible(a, q, slot, ignore):
+                continue
+            key = (int("vip" in a.skills and q != "vip"), len(a.skills & set(self.queues)), self.hours_of(a), a.agent_id)
+            if best_key is None or key < best_key:
+                best, best_key = a, key
+        return best
+
+    # --- state changes -----------------------------------------------------------------------
+    def add(self, a: Agent, q: str, slot: Slot) -> Sh:
+        sh = Sh(a, q, slot)
+        self.shifts.append(sh)
+        self.by_agent[a.agent_id].append(sh)
+        for i in slot.ivs:
+            self.gross[q][i] += 1
+        return sh
+
+    def remove(self, sh: Sh) -> None:
+        self.shifts.remove(sh)
+        self.by_agent[sh.agent.agent_id].remove(sh)
+        for i in sh.slot.ivs:
+            self.gross[sh.queue][i] -= 1
+
+    # --- breaks and net coverage -------------------------------------------------------------
+    def place_breaks(self) -> tuple[dict, dict]:
+        """Break per shift (grid index) and breaks per queue per interval. The break goes on the allowed
+        interval with the largest gross surplus; ties go to the interval with the fewest breaks so far,
+        then the earliest."""
+        on_break = {q: [0] * self.n for q in self.queues}
+        where: dict[int, int] = {}
+        for sh in sorted(self.shifts, key=lambda s: (s.slot.start, s.agent.agent_id)):
+            if not sh.slot.break_cands:
+                continue
+            q = sh.queue
+            i = max(sh.slot.break_cands,
+                    key=lambda i: (self.gross[q][i] - self.req[q][i], -on_break[q][i], -i))
+            where[id(sh)] = i
+            on_break[q][i] += 1
+        return where, on_break
+
+    def shortfall(self) -> dict:
+        """Per queue per interval: effective requirement minus agents on the queue net of breaks."""
+        _, on_break = self.place_breaks()
+        return {q: [max(0, self.eff[q][i] - (self.gross[q][i] - on_break[q][i])) for i in range(self.n)]
+                for q in self.queues}
+
+    def total_short(self) -> int:
+        """Shortfall over all queues after breaks: 5 per interval short plus the agents missing, so that an
+        interval brought to its requirement counts for more than agents added where it is still short."""
+        _, on_break = self.place_breaks()
+        tot = 0
+        for q in self.queues:
+            for e, g, b in zip(self.eff[q], self.gross[q], on_break[q]):
+                d = e - (g - b)
+                if d > 0:
+                    tot += 5 + d
+        return tot
+
+    # --- phases ---------------------------------------------------------------------------------
+    def repair(self) -> None:
+        cur = self.total_short()
+        while cur > 0:
+            short = self.shortfall()
+            cands = []
+            for day in self.days:
+                for tpl in self.tpls:
+                    slot = self.slots[(tpl.id, day)]
+                    for q in self.queues:
+                        gain = sum(1 for i in slot.ivs if short[q][i] > 0)
+                        if gain:
+                            cands.append((-gain / len(slot.ivs), -gain, slot.start, tpl.id, q, slot))
+            cands.sort(key=lambda c: c[:5])
+            done = False
+            for *_, q, slot in cands:
+                a = self.pick_agent(q, slot)
+                if a is None:
+                    continue
+                sh = self.add(a, q, slot)
+                new = self.total_short()
+                if new < cur:
+                    cur, done = new, True
+                    break
+                self.remove(sh)
+            if not done:
+                break   # nobody can take what is left: the roster is the limit (SOW §2.7)
+
+    def cost(self, weight: int) -> float:
+        return weight * self.total_short() + sum(s.slot.hours for s in self.shifts)
+
+    def trim(self, weight: int = 1000) -> None:
+        """Local search over single shifts: each is dropped or re-templated (same agent, day and queue)
+        when that lowers `weight` x net shortfall + hours. A large weight never trades shortfall for hours;
+        a small one is used only to meet the efficiency bound."""
+        changed = True
+        while changed:
+            changed = False
+            for sh in sorted(self.shifts, key=lambda s: (-s.slot.hours, s.slot.start, s.agent.agent_id)):
+                best, best_cost = sh.slot, self.cost(weight)
+                self.remove(sh)
+                for slot in [None] + [self.slots[(t.id, sh.slot.day)] for t in self.tpls]:
+                    if slot is None:
+                        c = self.cost(weight)
+                    elif slot is sh.slot or not self.feasible(sh.agent, sh.queue, slot):
+                        continue
+                    else:
+                        new = self.add(sh.agent, sh.queue, slot)
+                        c = self.cost(weight)
+                        self.remove(new)
+                    if c < best_cost - 1e-9:
+                        best, best_cost = slot, c
+                if best is not None:
+                    self.add(sh.agent, sh.queue, best)
+                if best is not sh.slot:
+                    changed = True
+
+    # --- polish a queue the repair could not fully cover --------------------------------------------
+    def queue_cost(self, q: str) -> tuple[int, int, int]:
+        """(intervals short, unit shortfall, hours) of one queue after its breaks. Breaks of one queue
+        depend only on that queue's shifts, so this is the cheap evaluation for single-queue moves."""
+        on_break = [0] * self.n
+        sur = [g - r for g, r in zip(self.gross[q], self.req[q])]
+        for sh in sorted((s for s in self.shifts if s.queue == q and s.slot.break_cands),
+                         key=lambda s: (s.slot.start, s.agent.agent_id)):
+            best, bk = -1, None
+            for i in sh.slot.break_cands:
+                k = (sur[i], -on_break[i])
+                if bk is None or k > bk:
+                    best, bk = i, k
+            on_break[best] += 1
+        unmet = units = 0
+        for e, g, b in zip(self.eff[q], self.gross[q], on_break):
+            d = e - (g - b)
+            if d > 0:
+                unmet += 1
+                units += d
+        return unmet, units, sum(s.slot.hours for s in self.shifts if s.queue == q)
+
+    def anneal(self, q: str, iters: int, seed: int) -> None:
+        """Simulated annealing on queue `q`: re-template, drop, add or hand a shift to another agent,
+        always through `feasible`, so every rule keeps holding. Keeps the best state seen."""
+        rng = random.Random(seed)
+        pool = [a for a in self.agents if q in a.skills]
+        score = lambda c: 100 * c[0] + 20 * c[1] + c[2]   # noqa: E731
+        cur = score(self.queue_cost(q))
+        best, best_state = cur, [(s.agent, s.queue, s.slot) for s in self.shifts]
+        t0, t1 = 30.0, 0.5
+        for it in range(iters):
+            temp = t0 * (t1 / t0) ** (it / iters)
+            mine = [s for s in self.shifts if s.queue == q]
+            kind = rng.random()
+            undo = []
+            if kind < 0.50 and mine:        # re-template, move to another day, or drop one shift
+                sh = rng.choice(mine)
+                self.remove(sh)
+                undo.append(("add", sh.agent, sh.queue, sh.slot))
+                tpl = rng.choice(self.tpls + [None])
+                if tpl is not None:
+                    day = sh.slot.day if rng.random() < 0.6 else rng.choice(self.days)
+                    slot = self.slots[(tpl.id, day)]
+                    if slot is sh.slot or not self.feasible(sh.agent, q, slot):
+                        self.add(*undo.pop()[1:]); continue
+                    undo.append(("remove", self.add(sh.agent, q, slot)))
+            elif kind < 0.75:               # add a shift
+                slot = self.slots[(rng.choice(self.tpls).id, rng.choice(self.days))]
+                a = rng.choice(pool)
+                if not self.feasible(a, q, slot):
+                    continue
+                undo.append(("remove", self.add(a, q, slot)))
+            elif mine:                      # hand a shift to another agent
+                sh = rng.choice(mine)
+                a = rng.choice(pool)
+                self.remove(sh)
+                if a is sh.agent or not self.feasible(a, q, sh.slot):
+                    self.add(sh.agent, q, sh.slot); continue
+                undo = [("add", sh.agent, q, sh.slot), ("remove", self.add(a, q, sh.slot))]
+            else:
+                continue
+            new = score(self.queue_cost(q))
+            if new <= cur or rng.random() < math.exp((cur - new) / temp):
+                cur = new
+                if cur < best:
+                    best, best_state = cur, [(s.agent, s.queue, s.slot) for s in self.shifts]
+            else:
+                for op in reversed(undo):
+                    if op[0] == "remove":
+                        self.remove(op[1])
+                    else:
+                        self.add(*op[1:])
+        for sh in list(self.shifts):
+            self.remove(sh)
+        for a, qq, slot in best_state:
+            self.add(a, qq, slot)
+
+    def unmet(self, q: str) -> int:
+        return self.queue_cost(q)[0]
+
+    def result(self) -> list[Shift]:
+        where, _ = self.place_breaks()
+        out = []
+        for sh in sorted(self.shifts, key=lambda s: (s.slot.start, s.agent.agent_id)):
+            s = sh.slot
+            i = where.get(id(sh))
+            out.append(Shift(sh.agent.agent_id, sh.queue, s.tpl, s.day, list(s.segs), [self.grid[j] for j in s.ivs],
+                             self.grid[i] if i is not None else None,
+                             int(self.brk_len.total_seconds() // 60) if i is not None else 0))
+        return out
+
+
+    def state(self) -> list:
+        return [(s.agent, s.queue, s.slot) for s in self.shifts]
+
+    def restore(self, state: list) -> None:
+        for sh in list(self.shifts):
+            self.remove(sh)
+        for a, q, slot in state:
+            self.add(a, q, slot)
+
+    def polish(self, q: str, iters: int, restarts: int, seed: int) -> None:
+        """Annealing rounds, each reheated from the best state so far; keeps the best queue state."""
+        best, best_state = None, self.state()
+        for k in range(restarts):
+            self.restore(best_state)
+            self.anneal(q, iters, seed + k)
+            c = self.queue_cost(q)
+            if best is None or c < best:
+                best, best_state = c, self.state()
+        self.restore(best_state)
+
+    def hours(self) -> float:
+        return sum(s.slot.hours for s in self.shifts)
+
+    def required_hours(self) -> float:
+        return sum(sum(r) for r in self.req.values()) * self.grain.total_seconds() / 3600.0
+
+    def op_unmet(self) -> dict:
+        """Operating intervals per queue where agents net of breaks are below the requirement (attainment)."""
+        _, on_break = self.place_breaks()
+        z = ZoneInfo(self.cfg["tz"])
+        out = {}
+        for q in self.queues:
+            lo, hi = (self.cfg.get("queue_hours") or {}).get(q, self.cfg["operating_hours"])
+            out[q] = sum(1 for i, t in enumerate(self.grid)
+                         if lo <= t.astimezone(z).hour + t.astimezone(z).minute / 60 < hi
+                         and self.gross[q][i] - on_break[q][i] < self.req[q][i])
+        return out
+
+    def within(self, allow: dict) -> bool:
+        """Attainment shortfall within `allow` per queue and every min_cover floor still covered net of breaks."""
+        _, on_break = self.place_breaks()
+        for q in self.cfg.get("min_cover") or {}:
+            if q in self.gross and any(self.gross[q][i] - on_break[q][i] < constraints.floor(q, t, self.cfg)
+                                       for i, t in enumerate(self.grid)):
+                return False
+        return all(u <= allow[q] for q, u in self.op_unmet().items())
+
+    def op_count(self, q: str) -> int:
+        z = ZoneInfo(self.cfg["tz"])
+        lo, hi = (self.cfg.get("queue_hours") or {}).get(q, self.cfg["operating_hours"])
+        return sum(1 for t in self.grid if lo <= t.astimezone(z).hour + t.astimezone(z).minute / 60 < hi)
+
+    def squeeze(self, max_hours: float, floor: float) -> None:
+        """Over the efficiency bound: drop or shorten the shifts that cost the least coverage per hour saved,
+        while every queue keeps weekly attainment of at least `floor` (and the floors stay covered)."""
+        base = self.op_unmet()   # a queue already below the floor (roster-limited) may not get worse
+        allow = {q: max(int(self.op_count(q) * (1 - floor) + 1e-9), base[q]) for q in self.queues}
+        while self.hours() > max_hours + 1e-9:
+            cur = self.total_short()
+            best, best_key = None, None
+            for sh in list(self.shifts):
+                self.remove(sh)
+                for slot in [None] + [self.slots[(t.id, sh.slot.day)] for t in self.tpls]:
+                    saved = sh.slot.hours - (slot.hours if slot else 0.0)
+                    if saved <= 0 or (slot is not None and not self.feasible(sh.agent, sh.queue, slot)):
+                        continue
+                    new = self.add(sh.agent, sh.queue, slot) if slot else None
+                    short = self.total_short()
+                    ok = self.within(allow)
+                    if new is not None:
+                        self.remove(new)
+                    key = ((short - cur) / saved, -saved)
+                    if ok and (best_key is None or key < best_key):
+                        best, best_key = (sh, slot), key
+                self.add(sh.agent, sh.queue, sh.slot)
+            if best is None:
+                return   # nothing more can go without breaking §1.6 attainment: the bound is an exception
+            sh, slot = best
+            self.remove(sh)
+            if slot is not None:
+                self.add(sh.agent, sh.queue, slot)
+
+
+def schedule_week(req: pd.DataFrame, cfg: dict, agents: list[Agent], week: str) -> list[Shift]:
+    p = Planner(req, cfg, agents, week)
+    last = None
+    for _ in range(6):   # repair and local search take turns until the shortfall stops improving
+        p.repair()
+        p.trim()
+        now = (p.total_short(), round(p.hours(), 1))
+        if now == last:
+            break
+        last = now
+    for q in p.queues:   # a queue the roster cannot fully cover: search harder for the best attainment
+        if p.unmet(q):
+            p.polish(q, int(cfg.get("anneal_iterations", 200000)), int(cfg.get("anneal_restarts", 2)),
+                     seed=sum(map(ord, f"{cfg['client']}{week}{q}")))
+            p.trim()
+    bound = cfg.get("efficiency_bound")
+    if bound is not None and p.hours() > bound * p.required_hours():
+        p.squeeze(bound * p.required_hours(), cfg.get("attainment_floor", cfg["sla_target"]))
+    return p.result()
