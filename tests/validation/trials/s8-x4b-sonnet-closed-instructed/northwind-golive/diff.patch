+# Northwind Traders — contract: docs/NORTHWIND_SOW.md. Flat (schema 1) file. Everything the contract
+# fixes is stated here explicitly instead of being inherited from defaults.yaml.
+name: Northwind Traders
+interval_minutes: 30
+tz: America/Chicago
+operating_hours: [6, 24]
+queues: [priority, standard, vip]
+full_week_grid: true            # build the week from the calendar (a fall-back week has 338 intervals)
+
+# SOW §1.2: service level per queue, per interval
+sla:
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 20}
+  vip: {target: 0.90, seconds: 20}
+sla_target: 0.95                # SOW §1.6: weekly attainment per queue
+attainment_basis: service_level # strict §1.2 interval test; not Fabrikam's coverage basis (PR #47), see RUNBOOK
+occupancy_cap: 0.85             # SOW §1.3
+enforce_occupancy_cap: true     # WFM-212 stays open for the other clients
+aht_smoothing: interval         # SOW §1.2: the interval's own average handle time
+queueing: erlang
+
+# SOW §1.4: vip contacts arrive 08:00-20:00, those are its operating intervals
+queue_hours:
+  vip: [8, 20]
+# SOW §2.6: one agent on vip in every interval 06:00-24:00, counted on vip itself
+min_cover:
+  vip: {agents: 1, hours: [6, 24]}
+cross_skill_weight: 0
+
+# SOW §2: rules enforced while placing shifts (wfm/scheduler/weekly.py) and audited in eval.json
+scheduler: weekly
+evaluation: sow
+rest_hours: 11                  # §2.1 elapsed hours between shifts
+split_pt_only: true             # §2.2
+break_placement: max_surplus    # §2.3
+efficiency_bound: 1.57          # §1.6 scheduled hours <= bound x required hours
+attainment_floor: 0.95          # §1.6
+runbook: true                   # write RUNBOOK.md and exceptions.md (SOW §3) next to the run outputs
+delivery_files:                 # SOW §3 files_changed
+  - configs/northwind.yaml
+  - wfm/cli.py
+  - wfm/ingest/loader.py
+  - wfm/staffing/required.py
+  - wfm/evaluate/metrics.py
