+# --- earliest start per queue (Litware SOW §2.5) and the intervals it makes infeasible (§2.6) ----------
+
+def local_hour(t: datetime, cfg: dict) -> float:
+    loc = t.astimezone(ZoneInfo(cfg["tz"]))
+    return loc.hour + loc.minute / 60
+
+
+def earliest(queue: str, cfg: dict) -> float | None:
+    """Local hour before which nobody may be scheduled on `queue` (`queue_earliest`), if any."""
+    return (cfg.get("queue_earliest") or {}).get(queue)
+
+
+def infeasible(queue: str, t: datetime, required: int, cfg: dict) -> bool:
+    """True when the scheduling rules make this interval's target impossible to meet: the queue has
+    demand (`required` > 0) in an interval before its earliest allowed start. Such intervals are
+    reported as exceptions (SOW §2.6) rather than covered by breaking the rule."""
+    e = earliest(queue, cfg)
+    return bool(e is not None and required > 0 and local_hour(t, cfg) < e)
+
+
+def gross_floor(cfg: dict) -> bool:
+    """`min_cover_basis: gross` - a floor counts agents on shift, breaks aside (Litware §2.4). The default
+    (and Northwind) counts them net of breaks."""
+    return cfg.get("min_cover_basis", "net") == "gross"
