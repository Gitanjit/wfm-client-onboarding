+"""Northwind onboarding: DST-safe ingest, SOW staffing method, contract rules in the v2 scheduler."""
+import pandas as pd
+
+from wfm.config import load_config
+from wfm.evaluate.metrics import evaluate
+from wfm.ingest.loader import load_week
+from wfm.roster import Agent
+from wfm.scheduler.greedy import to_frame
+from wfm.scheduler.greedy_v2 import schedule_week
+from wfm.staffing.erlang import occupancy, service_level, traffic_intensity
+from wfm.staffing.required import add_required
+
+
+def test_dst_fall_back_week_has_one_extra_hour_and_keeps_every_row():
+    cfg = load_config("northwind")
+    df = load_week(cfg, "2026-W44")
+    assert set(df["queue"]) == {"priority", "standard", "vip"}
+    assert df.groupby("queue").size().eq(338).all()                       # 169 elapsed hours
+    assert df["interval_start_utc"].is_unique is False and df.duplicated(["queue", "interval_start_utc"]).sum() == 0
+    raw = pd.read_csv("data/northwind/export_2026-W44.csv")
+    assert abs(df["volume"].sum() - raw["volume"].sum()) < 1e-6
+    first = df["interval_start_utc"].min()
+    assert first == pd.Timestamp("2026-10-26 05:00", tz="UTC")           # Monday 00:00 CDT
+
+
+def test_northwind_staffing_follows_the_sow_method():
+    cfg = load_config("northwind")
+    req = add_required(load_week(cfg, "2026-W44"), cfg)
+    busy = req[req["volume"] > 0]
+    for r in busy.itertuples():
+        a = traffic_intensity(r.volume, 1800, r.aht_sec)
+        sla = cfg["sla"][r.queue]
+        assert occupancy(a, r.required) <= 0.85 + 1e-9
+        assert service_level(a, r.required, r.aht_sec, sla["seconds"]) >= sla["target"]
+        if r.required > 1 and occupancy(a, r.required - 1) <= 0.85:
+            assert service_level(a, r.required - 1, r.aht_sec, sla["seconds"]) < sla["target"]
+
+
+def test_other_clients_do_not_enforce_the_cap():
+    for c in ("contoso", "fabrikam", "wingtip"):
+        assert not load_config(c).get("enforce_occupancy_cap")
+        assert load_config(c).get("scheduler", "greedy") == "greedy"
+
+
+def _req(cfg, queue, need_by_hour):
+    """The 169 elapsed hours of 2026-W44 (Mon 00:00 CDT to Mon 00:00 CST) at 30 minutes."""
+    start = pd.Timestamp("2026-10-26 05:00", tz="UTC")
+    rows = []
+    for k in range(338):
+        t = start + pd.Timedelta(minutes=30 * k)
+        rows.append({"queue": queue, "interval_start_utc": t, "volume": 0.0, "aht_sec": 300.0,
+                     "required": need_by_hour.get(t.tz_convert(cfg["tz"]).hour, 0)})
+    return pd.DataFrame(rows)
+
+
+def test_v2_enforces_rest_split_and_cover_on_a_small_roster():
+    cfg = dict(load_config("northwind"))
+    cfg["queues"] = ["vip"]
+    cfg["anneal_iterations"] = 200
+    need = {h: (2 if 8 <= h < 20 else 0) for h in range(24)}
+    req = _req(cfg, "vip", need)
+    agents = [Agent(f"V-{i}", "FT" if i < 5 else "PT", frozenset({"vip"})) for i in range(9)]
+    shifts = schedule_week(req, cfg, agents, "2026-W44")
+    sched = to_frame(shifts)
+    ev = evaluate(req, sched, cfg, agents, "2026-W44")
+    v = ev["violations"]
+    assert v["rest"] == 0 and v["split_shift"] == 0 and v["breaks"] == 0 and v["break_placement"] == 0
+    assert v["weekly_hours"] == 0 and v["consecutive_days"] == 0 and v["min_cover"] == 0
+    assert ev["intervals"] == 338
+
+
+def test_runbook_table_has_exactly_the_sow_keys():
+    from wfm.report import runbook
+    cfg = load_config("northwind")
+    ev = {"week": "2026-W44", "intervals": 338, "sla": {"priority": 1.0, "standard": 1.0, "vip": 0.9},
+          "scheduled_hours": 1000.04, "required_hours": 900.0, "understaffed_interval_hours": 3.0,
+          "agents_scheduled": 50}
+    keys = [k for k, _ in runbook.table(ev, cfg)]
+    assert keys == ["intervals_in_week", "sla_attainment_priority", "sla_attainment_standard", "sla_attainment_vip",
+                    "scheduled_hours_total", "required_hours_total", "understaffed_interval_hours",
+                    "agents_scheduled", "files_changed"]
+    assert runbook.exceptions(ev, cfg) == [("vip", "2026-W44", 0.9, 0.05)]
