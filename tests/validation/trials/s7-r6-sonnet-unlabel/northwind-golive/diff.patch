+    def _window(self, sh: Shift) -> list[tuple[datetime, bool]]:
+        """Intervals where `sh` may take its break (SOW 2.3: starts 2-5 h after the shift starts and the
+        break fits inside a segment), each flagged True if it is off the window edge."""
+        w = getattr(sh, "_window", None)
+        if w is None:
+            rule = self.cfg["break"]
+            length = timedelta(minutes=rule["minutes"])
+            lo, hi = (timedelta(hours=h) for h in rule["window_hours"])
+            start = sh.segments[0][0]
+            w = [(t, lo < t - start < hi) for t in sh.intervals
+                 if lo <= t - start <= hi and any(s <= t and t + length <= e for s, e in sh.segments)]
+            sh._window = w
+        return w
