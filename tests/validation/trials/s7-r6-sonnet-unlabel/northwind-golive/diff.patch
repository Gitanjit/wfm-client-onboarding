+def _try(plan: _Plan, removes: list[Shift], adds: list[tuple]) -> tuple | None:
+    """Apply removes then adds (agent, queue, template, day), if every add is feasible. Returns the score
+    delta and the added shifts with the plan left changed; None (plan untouched) if infeasible."""
+    groups = {(sh.day, sh.queue) for sh in removes} | {(d, q) for _, q, _, d in adds}
+    before = [plan.group_score(d, q) for d, q in groups]
+    for sh in removes:
+        plan.remove(sh)
+    added: list[Shift] = []
+    for a, q, tpl, day in adds:
+        segs = tpl.segments_utc(day, plan.tz)
+        if not plan.feasible(a, tpl, day, segs):
