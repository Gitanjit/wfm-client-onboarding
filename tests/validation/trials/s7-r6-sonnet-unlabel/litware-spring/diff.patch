+"""Litware onboarding: end-stamped export, SOW staffing method, earliest start and SOW 2.6 exceptions."""
+import pandas as pd
+
+from wfm import constraints
+from wfm.config import load_config
+from wfm.evaluate.metrics import evaluate
+from wfm.ingest.loader import load_week
+from wfm.roster import Agent
+from wfm.scheduler.greedy import to_frame
+from wfm.scheduler.greedy_v2 import schedule_week
+from wfm.scheduler.templates import templates_for
+from wfm.staffing.erlang import occupancy, service_level, traffic_intensity
+from wfm.staffing.required import add_required
+
+
+def test_export_rows_are_stamped_with_interval_ends():
+    cfg = load_config("litware")
+    df = load_week(cfg, "2027-W11")
+    assert set(df["queue"]) == {"priority", "standard", "email"}
+    assert df.groupby("queue").size().eq(504).all()
+    assert df["interval_start_utc"].min() == pd.Timestamp("2027-03-15 00:00", tz="UTC")
+    assert df["interval_start_utc"].max() == pd.Timestamp("2027-03-21 23:40", tz="UTC")
+    raw = pd.read_csv("data/litware/export_2027-W11.csv")
+    row = raw[(raw.interval_end_local == "2027-03-15 07:20") & (raw.queue == "email")].iloc[0]
+    got = df[(df.queue == "email") & (df.interval_start_utc == pd.Timestamp("2027-03-15 07:00", tz="UTC"))].iloc[0]
+    assert got.volume == row.volume                       # the 07:20 row is the 07:00-07:20 interval
+
+
+def test_staffing_follows_the_sow_method():
+    cfg = load_config("litware")
+    req = add_required(load_week(cfg, "2027-W11"), cfg)
+    for r in req[req["volume"] > 0].itertuples():
+        a = traffic_intensity(r.volume, 1200, r.aht_sec)
+        sla = cfg["sla"][r.queue]
+        assert occupancy(a, r.required) <= 0.85 + 1e-9
+        assert service_level(a, r.required, r.aht_sec, sla["seconds"]) >= sla["target"]
+        if r.required > 1 and occupancy(a, r.required - 1) <= 0.85:
+            assert service_level(a, r.required - 1, r.aht_sec, sla["seconds"]) < sla["target"]
+
+
+def test_email_before_nine_is_an_sow_26_exception_not_a_requirement_the_scheduler_chases():
+    cfg = load_config("litware")
+    req = add_required(load_week(cfg, "2027-W11"), cfg)
+    exc = constraints.infeasible(req, cfg)
+    assert len(exc) == 42 and {q for q, _ in exc} == {"email"}
+    z = cfg["tz"]
+    assert all(7 <= t.tz_convert(z).hour < 9 for _, t in exc)
+    assert not any(constraints.template_allowed("email", t, cfg) for t in templates_for(cfg) if t.id in ("P6a", "E8"))
+    assert all(t.id != "S44" for t in templates_for(cfg))
+
+
+def test_the_other_clients_have_no_earliest_start_or_exclusions():
+    for c in ("contoso", "fabrikam", "wingtip", "northwind"):
+        cfg = load_config(c)
+        assert not cfg.get("queue_earliest_start") and not cfg.get("exclude_templates") and not cfg.get("anneal_hours")
+
+
+def test_small_roster_keeps_email_off_the_morning_and_two_on_priority():
+    cfg = dict(load_config("litware"))
+    cfg["anneal_joint_iterations"] = 300
+    cfg["anneal_iterations"] = 100
+    demand = load_week(cfg, "2027-W11")
+    demand = demand[demand["interval_start_utc"] < pd.Timestamp("2027-03-17", tz="UTC")]   # Monday and Tuesday
+    req = add_required(demand, cfg)
+    agents = [Agent(f"P{i}", "FT", frozenset({"priority", "standard"})) for i in range(8)] + \
+             [Agent(f"E{i}", "FT", frozenset({"email", "standard"})) for i in range(3)]
+    sched = to_frame(schedule_week(req, cfg, agents, "2027-W11"))
+    res = evaluate(req, sched, cfg, agents, "2027-W11")
+    assert res["violations"]["queue_start"] == 0 and res["violations"]["min_cover"] == 0
+    assert res["violations"]["rest"] == 0 and res["violations"]["breaks"] == 0 and res["violations"]["break_placement"] == 0
+    assert res["exception_intervals"] == 12
