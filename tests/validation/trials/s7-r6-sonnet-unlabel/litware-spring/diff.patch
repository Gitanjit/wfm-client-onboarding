+
+
+def earliest_start(queue: str, cfg: dict) -> float | None:
+    """Local hour before which nobody may be scheduled on `queue` (`queue_earliest_start`), if it has one."""
+    v = (cfg.get("queue_earliest_start") or {}).get(queue)
+    return None if v is None else float(v)
+
+
+def template_allowed(queue: str, template, cfg: dict) -> bool:
+    """A shift template may be worked on `queue` only if every segment starts at or after the queue's earliest start."""
+    lo = earliest_start(queue, cfg)
+    return lo is None or all(s >= lo for s, _ in template.segments)
+
+
+def _local_hour(t, cfg: dict) -> float:
+    loc = t.astimezone(ZoneInfo(cfg["tz"]))
+    return loc.hour + loc.minute / 60
+
+
+def infeasible(req, cfg: dict) -> set:
+    """{(queue, interval start)} whose target the contract rules make impossible to meet (Litware SOW 2.6):
+    the queue has demand in an operating interval that starts before its earliest start, when nobody may be
+    scheduled on it. Such intervals are reported as exceptions and left out of attainment; no rule is broken
+    to cover them."""
+    out = set()
+    for q in cfg.get("queue_earliest_start") or {}:
+        lo = earliest_start(q, cfg)
+        qlo, qhi = (cfg.get("queue_hours") or {}).get(q, cfg["operating_hours"])
+        for r in req[req["queue"] == q].itertuples(index=False):
+            h = _local_hour(r.interval_start_utc, cfg)
+            if r.required > 0 and qlo <= h < qhi and h < lo:
+                out.add((q, r.interval_start_utc))
+    return out
