+# Litware Support — go-live 2027-W11. Targets and rules come from docs/LITWARE_SOW.md, not from the
+# service defaults. Local-time export (Europe/London) stamped with the END of each 20-minute interval and
+# an authoritative UTC offset per row.
+name: Litware Support
+interval_minutes: 20              # SOW 1.5
+tz: Europe/London
+operating_hours: [7, 21]          # SOW 1.4
+queues: [priority, standard, email]
+queue_hours:                      # SOW 1.4: email contacts arrive 07:00-19:00; those are its operating intervals
+  email: [7, 19]
+queue_earliest_start:             # SOW 2.5: nobody on email before 09:00 local (SOW 2.6 intervals follow from it)
+  email: 9
+
+sla:                              # SOW 1.2
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 30}
+  email: {target: 0.80, seconds: 300}
+sla_target: 0.95                  # SOW 1.6: weekly attainment per queue
+attainment_basis: service_level   # an interval meets target when net-of-break agents >= Erlang C requirement
+attainment_intervals: operating   # denominator: every operating interval of the queue (less SOW 2.6 intervals)
+efficiency_bound: 1.45            # SOW 1.6: scheduled hours <= bound x required hours
+
+queueing: erlang                  # SOW 1.2: Erlang C without abandonment
+aht_smoothing: interval           # SOW 1.2: the interval's own handle time (not the WFM-198 queue mean)
+occupancy_cap: 0.85               # SOW 1.3
+enforce_occupancy_cap: true       # WFM-212 is open for the other clients; Litware needs it applied
+
+min_cover:                        # SOW 2.4: two agents on priority in every operating interval
+  priority: {agents: 2, hours: [7, 21]}
+cross_skill_weight: 0             # SOW 1.2: a person counts once, on the queue they are scheduled on
+
+weekly_hours: {FT: 40, PT: 24}    # SOW 2.9 (elapsed hours)
+max_consecutive_days: 5
+min_rest_hours: 11                # SOW 2.1
+split_shift_contracts: [PT]       # SOW 2.2
+break_placement: surplus          # SOW 2.3
+scheduler: v2
+
+runbook: true                     # SOW 3: write RUNBOOK.md (and exceptions.md, SOW 2.7) next to the outputs
+
+anneal_hours: true                # SOW 1.6 bound is tight: search attainment and scheduled hours together
+anneal_joint_iterations: 100000
+exclude_templates: [S44]          # no split shifts (SOW 2.2 allows them for PT; the roster does not need them)
+delivery_base: dfed0fd1ddce5f10a86a15e276d4f461b90d8f79   # refs/wfm/litware-base: the working tree when Litware onboarding began; RUNBOOK files_changed is relative to it
