+def _read_end_stamped_export(df: pd.DataFrame, cfg: dict) -> pd.DataFrame:
+    """An export whose rows are stamped with the END of the interval (`interval_end_local`, Litware): the
+    label plus `utc_offset` (the offset in effect at that moment) gives the UTC end instant; the interval
+    starts one grain earlier. Going through UTC keeps a row that ends on a DST change right."""
+    stamp = df["interval_end_local"].astype(str).str.strip() + df["utc_offset"].astype(str).str.strip()
+    end = pd.to_datetime(stamp, format="%Y-%m-%d %H:%M%z", utc=True)
+    df["interval_start_utc"] = end - pd.Timedelta(minutes=int(cfg["interval_minutes"]))
+    return df[["queue", "interval_start_utc", "volume", "aht_sec"]]
+
+
