+def litware_data_notes(cfg: dict, week: str) -> str:
+    """Oddities in the week's raw export (end-stamped rows, `interval_end_local`)."""
+    from wfm.config import DATA_DIR
+    from wfm.ingest.loader import week_grid
+    path = DATA_DIR / cfg["client"] / f"export_{week}.csv"
+    if not path.exists():
+        return "no raw export to inspect."
+    df = pd.read_csv(path)
+    grain = cfg["interval_minutes"]
+    notes = []
+    expected = len(week_grid(week, cfg["tz"], grain)) * len(cfg["queues"])
+    if len(df) != expected:
+        notes.append(f"{len(df)} rows against {expected} expected for the calendar week")
+    dup = int(df.duplicated(["interval_end_local", "queue"]).sum())
+    if dup:
+        notes.append(f"{dup} duplicated row(s)")
+    minutes = pd.to_datetime(df["interval_end_local"]).dt.minute
+    off = df[minutes % grain != 0]
+    if len(off):
+        notes.append(f"{len(off)} row(s) not on a {grain}-minute boundary")
+    if not notes:
+        return (f"nothing unusual found ({len(df)} rows, one per queue per {grain}-minute interval, stamped with the "
+                f"interval end; utc_offset used as given).")
+    return "; ".join(notes) + ". Please confirm with Litware's WFM contact."
+
