+# Litware Support — docs/LITWARE_SOW.md. Local-time export (Europe/London, DST) stamped with the END of each
+# 20-minute interval plus a UTC offset per row, three queues. Everything here comes from the SOW, not from
+# what the service did before: service defaults are left alone.
+schema: 2
+name: Litware Support
+service:
+  interval_minutes: 20            # SOW 1.5
+  tz: Europe/London
+  operating_hours: [7, 21]        # SOW 1.4
+  queues: [priority, standard, email]   # SOW 1.1
+  queue_hours: {email: [7, 19]}   # SOW 1.4: email contacts arrive 07:00-19:00
+  calendar_grid: true             # the week's intervals from the calendar: 167 h in the spring-forward week
+targets:
+  sla:                            # SOW 1.2
+    priority: {target: 0.90, seconds: 30}
+    standard: {target: 0.80, seconds: 30}
+    email: {target: 0.80, seconds: 300}
+  sla_target: 0.95                # SOW 1.6: weekly attainment per queue
+  attainment_basis: service_level
+  attainment_intervals: operating # SOW 1.6: the fraction of operating intervals, not of those with volume
+staffing:
+  queueing: erlang                # SOW 1.2: Erlang C, no abandonment
+  occupancy_cap: 0.85             # SOW 1.3
+  apply_occupancy_cap: true       # WFM-212: not applied by default
+  aht_smoothing: interval         # SOW 1.2: the interval's own handle time (WFM-198 smoothing off)
+scheduling:
+  weekly_hours: {FT: 40, PT: 24}  # SOW 2.9
+  max_consecutive_days: 5
+  break: {min_shift_hours: 6, minutes: 20, window_hours: [2, 5]}   # SOW 2.3
+  break_rule: surplus             # SOW 2.3: largest gross coverage surplus inside the window
+  min_rest_hours: 11              # SOW 2.1
+  split_contracts: [PT]           # SOW 2.2
+  min_cover: {priority: {agents: 2, hours: [7, 21]}}   # SOW 2.4: two on priority in every operating interval
+  cross_skill_weight: 0           # SOW 1.2: a person counts once, on the queue they are scheduled on
+  queue_start: {email: 9}         # SOW 2.5: nobody on email before 09:00 local
+  scheduler: weekly
+  max_hours_ratio: 1.45           # SOW 1.6
+reporting:
+  sow_reports: true
