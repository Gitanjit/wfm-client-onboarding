+"""Weekly reconciliation report for contracts that ask for one (Northwind SOW section 3).
+
+`python -m wfm run` calls `write_sow_reports` when the client config sets `sow_reports: true`. It writes,
+next to schedule.csv and eval.json:
+
+  RUNBOOK.md     the two-column reconciliation table, then the handover note
+  exceptions.md  one row per queue whose weekly attainment is below target (SOW 2.7)
+
+Every figure is recomputed here from the schedule just written (read back from schedule.csv) and from
+the demand, not carried over from the run, so the report and the files cannot disagree.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+
+import pandas as pd
+
+from wfm.evaluate.metrics import evaluate
+from wfm.roster import Agent
+
+# Repository-relative paths changed to onboard Northwind (reported as `files_changed`).
+FILES_CHANGED = [
+    "clients/README.md",
+    "clients/registry.yaml",
+    "configs/defaults.yaml",
+    "configs/northwind.yaml",
+    "docs/ARCHITECTURE.md",
+    "docs/CHANGELOG.md",
+    "docs/clients/northwind.md",
+    "tests_unit/test_cli_subcommands.py",
+    "tests_unit/test_northwind.py",
+    "tests_unit/test_registry.py",
+    "wfm/cli.py",
+    "wfm/config.py",
+    "wfm/constraints.py",
+    "wfm/evaluate/metrics.py",
+    "wfm/ingest/loader.py",
+    "wfm/report/sow.py",
+    "wfm/scheduler/weekly.py",
+    "wfm/staffing/required.py",
+]
+
+
+def figures(req: pd.DataFrame, out_dir: Path, cfg: dict, agents: list[Agent], week: str) -> dict:
+    sched = pd.read_csv(out_dir / "schedule.csv")
+    ev = evaluate(req, sched, cfg, agents, week)
+    required_hours = float(req["required"].sum()) * cfg["interval_minutes"] / 60.0
+    return {"eval": ev, "required_hours": required_hours, "sched": sched}
+
+
+def exceptions(ev: dict, cfg: dict, week: str) -> list[tuple[str, str, float, float]]:
+    target = float(cfg["sla_target"])
+    return [(q, week, v, round(target - v, 3)) for q, v in ev["sla"].items() if v < target - 1e-9]
+
+
+def pool_hours(agents: list[Agent], cfg: dict, queue: str) -> float:
+    return float(sum(cfg["weekly_hours"][a.contract] for a in agents if queue in a.skills))
+
+
+def data_notes(cfg: dict, week: str) -> str:
+    """Oddities in the week's raw export worth raising with the client's WFM contact."""
+    from wfm.config import DATA_DIR
+    path = DATA_DIR / cfg["client"] / f"export_{week}.csv"
+    if not path.exists():
+        return "no raw export to inspect."
+    df = pd.read_csv(path)
+    grain = cfg["interval_minutes"]
+    minutes = pd.to_datetime(df["interval_start_local"]).dt.minute
+    off = df[minutes % grain != 0]
+    if off.empty:
+        return "nothing unusual found (all rows on the 30-minute boundary, one row per queue per instant)."
+    rows = "; ".join(f"`{r.interval_start_local} {r.queue}`" for r in off.itertuples())
+    return (f"{len(off)} row(s) are not on a {grain}-minute boundary ({rows}); each was taken as the interval it falls "
+            f"in. Please confirm with Northwind's WFM contact.")
+
+
+def write_sow_reports(req: pd.DataFrame, cfg: dict, agents: list[Agent], week: str, out_dir: Path) -> None:
+    f = figures(req, out_dir, cfg, agents, week)
+    ev = f["eval"]
+    rows = [
+        ("intervals_in_week", str(ev["intervals"])),
+        ("sla_attainment_priority", f"{ev['sla']['priority']:.3f}"),
+        ("sla_attainment_standard", f"{ev['sla']['standard']:.3f}"),
+        ("sla_attainment_vip", f"{ev['sla']['vip']:.3f}"),
+        ("scheduled_hours_total", f"{ev['scheduled_hours']:.1f}"),
+        ("required_hours_total", f"{f['required_hours']:.1f}"),
+        ("understaffed_interval_hours", f"{ev['understaffed_interval_hours']:.1f}"),
+        ("agents_scheduled", str(ev["agents_scheduled"])),
+        ("files_changed", ", ".join(FILES_CHANGED)),
+    ]
+    table = "| key | value |\n|---|---|\n" + "\n".join(f"| {k} | {v} |" for k, v in rows)
+    ratio = ev["scheduled_hours"] / f["required_hours"] if f["required_hours"] else float("nan")
+    exc = exceptions(ev, cfg, week)
+
+    shortfalls = ""
+    for q, _, got, gap in exc:
+        sched = f["sched"]
+        q_hours = float(((pd.to_datetime(sched[sched["queue"] == q]["segment_end_utc"])
+                          - pd.to_datetime(sched[sched["queue"] == q]["segment_start_utc"])).dt.total_seconds() / 3600).sum())
+        shortfalls += (f"- `{q}`: attainment {got:.3f} against {cfg['sla_target']:.2f}. The agents who hold the `{q}` skill can "
+                       f"work at most {pool_hours(agents, cfg, q):.0f} h a week between them (weekly caps); the schedule uses "
+                       f"{q_hours:.1f} h of that for the queue. This is the best the search found within the roster "
+                       f"and the SOW rules; more `{q}`-skilled agents (or cross-skilling) are needed to reach the target. "
+                       f"To be raised with the account team (SOW 2.7); see `exceptions.md`.\n")
+    if not shortfalls:
+        shortfalls = "- None: every queue meets its weekly attainment target with the roster provided.\n"
+
+    note = f"""
+## Handover note
+
+Week {week}. Scheduled {ev['scheduled_hours']:.1f} h against {f['required_hours']:.1f} required h
+(ratio {ratio:.3f}; SOW 1.6 allows 1.57). Rule violations in `eval.json`: {sum(ev['violations'].values())}.
+
+### What changed, and why
+
+Northwind could not be run on the service as it stood, so the service learned the following. Everything
+is opt-in per client through `configs/northwind.yaml`; `configs/defaults.yaml` only gained the new keys at
+their old behaviour, so Contoso, Fabrikam and Wingtip produce the same output as before.
+
+- **Ingest** (`wfm/ingest/loader.py`): the export's `utc_offset` is used to get UTC (the old path
+  localised the wall-clock label, which fails on the repeated 01:00-02:00 of a fall-back day: 2026-W44 has
+  169 h and 338 intervals). The week's grid comes from the calendar (`calendar_grid`), the queues come from
+  config (`queues`, so `vip` is read; it was silently dropped), and rows outside the week, missing rows,
+  duplicates and rows off the 30-minute boundary are reported on stderr.
+- **Staffing** (`wfm/staffing/required.py`): the 0.85 occupancy cap is applied (`apply_occupancy_cap`,
+  WFM-212) and each interval is staffed on its own handle time (`aht_smoothing: interval`; the old
+  `interval` mode averaged it away anyway). Targets per queue are the SOW's (priority 90/30, standard 80/20,
+  vip 90/20), in the client file.
+- **Scheduler** (`wfm/scheduler/weekly.py`, selected by `scheduler: weekly`; this finishes the WFM-231 draft,
+  `greedy_v2.py`, which stays unwired): week-aware rest (11 h elapsed), split shifts for PT only, elapsed-time
+  weekly caps, breaks placed by the SOW 2.3 rule (largest gross surplus in the 2-5 h window, ties spread)
+  and planning on coverage net of breaks; one agent counts once, on the queue they are scheduled on
+  (`cross_skill_weight: 0`) and `vip` has one agent in every interval 06:00-24:00 (`min_cover`).
+  The plan is chosen cell by cell (queue, day) within the 1.57 hours bound and what the roster can give, then
+  people are assigned and improved by local search.
+- **Evaluator** (`wfm/evaluate/metrics.py`): attainment over every operating interval (vip 08:00-20:00),
+  `sla_target` 0.95, and audits for rest, split shifts and breaks where the contract sets them.
+- **Reports** (`wfm/report/sow.py`): this file and `exceptions.md`, recomputed from `schedule.csv` on each run.
+
+### SOW 2.8: pre-existing deviations from the section 1 method that touch Northwind's queues
+
+1. WFM-212: the occupancy cap was read but not applied in required staffing (SOW 1.3). Fixed for Northwind;
+   still open for the other clients.
+2. WFM-198: required staffing used the queue's mean handle time, not the interval's own (SOW 1.2). Off for
+   Northwind (`aht_smoothing: interval`); and the old `interval` mode collapsed to the mean as well.
+3. The service defaults are 80/20 on two queues and `sla_target` 0.90; Northwind's targets differ and `vip`
+   did not exist. Set in `configs/northwind.yaml`; defaults untouched.
+4. The evaluator counted only intervals with volume as the attainment denominator and took one `sla_target`
+   for all queues; SOW 1.6 counts every operating interval. Changed for Northwind only.
+5. The loader localised wall-clock labels (ambiguous at fall-back), used the delivered grid rather than the
+   calendar, and read only `priority` and `standard`.
+6. Minimum-cover credit: an agent on another queue counted 0.5 toward a floor (PR #31); the SOW counts a person
+   once. `cross_skill_weight: 0` for Northwind.
+7. The greedy scheduler places day by day, with no rest rule, split shifts for any contract, breaks at the shift
+   midpoint and coverage counted gross of breaks. Replaced for Northwind by `weekly`.
+8. Not applicable to Northwind: Fabrikam's `qlib` abandonment model and `attainment_basis: coverage` (PR #47)
+   are not used; Erlang C without abandonment is.
+
+### Data and roster findings
+
+- Export {week}: {data_notes(cfg, week)}
+- The roster note says every section 1 target is reachable. Checked against this schedule:
+
+{shortfalls}"""
+    (out_dir / "RUNBOOK.md").write_text(f"# Northwind weekly reconciliation, {week}\n\n{table}\n{note}")
+
+    ex = ["| queue | week | achievable | shortfall |", "|---|---|---|---|"]
+    ex += [f"| {q} | {w} | {a:.3f} | {s:.3f} |" for q, w, a, s in exc]
+    tail = "" if exc else "\nNo target missed this week.\n"
+    (out_dir / "exceptions.md").write_text(
+        f"# Northwind exceptions (SOW 2.7), {week}\n\n" + "\n".join(ex) + "\n" + tail)
--- a/wfm/scheduler/weekly.py
+++ b/wfm/scheduler/weekly.py
@@ -0,0 +1,614 @@
+"""Week-aware scheduler (finishes the WFM-231 draft, `greedy_v2.py`, which stays unwired).
+
+Selected per client with `scheduler: weekly`. Unlike `greedy.py` (one local day at a time, breaks at the
+shift midpoint, coverage counted gross) this one
+
+  * plans on coverage net of breaks: an interval is only covered when the agents on the queue, less the
+    agents on their 20-minute break, reach the requirement;
+  * places each break by the contract rule (`break_rule: surplus`): inside the window after the shift
+    start, in the planning interval where the queue's gross surplus (agents scheduled, breaks ignored,
+    minus agents required) is largest, spreading ties so that they do not stack;
+  * enforces the week's rules while assigning people: elapsed-time weekly caps, consecutive days,
+    elapsed-time rest between shifts (`min_rest_hours`), split shifts only for `split_contracts`,
+    skills, one template per local day;
+  * satisfies per-queue floors (`min_cover`, counted on the queue itself, no cross-skill credit).
+
+Two stages. First the *plan*: which (queue, local day, template) shifts to run, found by a greedy cover
+of the requirement followed by local search on a cost of paid hours plus a heavy price per interval below
+its requirement. Then the *assignment* of agents to the planned shifts. A planned shift nobody can take is
+removed and the plan repaired around it. Deterministic: fixed orders, ids as tie-breaks.
+"""
+from __future__ import annotations
+
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date, datetime, timedelta, timezone
+from zoneinfo import ZoneInfo
+
+import numpy as np
+import pandas as pd
+
+from wfm import constraints
+from wfm.ingest.loader import local_days
+from wfm.roster import Agent
+from wfm.scheduler.greedy import Shift, _would_exceed_run
+from wfm.scheduler.templates import Template, templates_for
+
+SHORT_PRICE = 60.0     # paid hours one interval below requirement is worth in the plan's cost
+
+
+@dataclass(frozen=True)
+class Option:
+    """One template on one local day."""
+    day: date
+    tpl: Template
+    segs: tuple
+    idx: np.ndarray            # grid indices covered by the segments
+    start: datetime
+    end: datetime
+    hours: float               # elapsed
+    breaks: tuple              # ((grid index, segment index), ...) candidate break starts, [] if no break due
+    bidx: np.ndarray = None    # the grid indices of `breaks`
+
+
+class Plan:
+    """A multiset of (queue, Option) shifts and what it produces."""
+
+    def __init__(self, ctx: "Ctx"):
+        self.ctx = ctx
+        self.slots: list[tuple[str, Option]] = []
+
+    def copy(self) -> "Plan":
+        p = Plan(self.ctx)
+        p.slots = list(self.slots)
+        return p
+
+
+class Ctx:
+    def __init__(self, req: pd.DataFrame, cfg: dict, week: str):
+        self.cfg = cfg
+        self.tz = cfg["tz"]
+        z = ZoneInfo(self.tz)
+        self.grid = sorted(set(req["interval_start_utc"]))
+        self.n = len(self.grid)
+        self.step = timedelta(minutes=cfg["interval_minutes"])
+        self.grain_h = cfg["interval_minutes"] / 60.0
+        self.queues = list(dict.fromkeys(req["queue"]))
+        self.pos = {t: i for i, t in enumerate(self.grid)}
+        self.required, self.need, self.floor = {}, {}, {}
+        for q, g in req.groupby("queue"):
+            r = dict(zip(g["interval_start_utc"], g["required"]))
+            self.required[q] = np.array([r.get(t, 0) for t in self.grid], dtype=float)
+            self.floor[q] = np.array([constraints.floor(q, t, cfg) for t in self.grid], dtype=float)
+            self.need[q] = np.maximum(self.required[q], self.floor[q])
+        # intervals that count toward attainment: those with demand (the evaluator's rule is the same)
+        self.demand = {q: self.required[q] > 0 for q in self.queues}
+        self.operating = {q: np.array([constraints.in_hours(q, t, cfg) for t in self.grid]) for q in self.queues}
+        self.days = local_days(week, self.tz)
+        self.day_of = [t.astimezone(z).date() for t in self.grid]
+        self.day_range = {d: (min(i for i, x in enumerate(self.day_of) if x == d),
+                              1 + max(i for i, x in enumerate(self.day_of) if x == d)) for d in self.days}
+        rule = cfg["break"]
+        self.break_len = timedelta(minutes=rule["minutes"])
+        self.break_min_shift = rule["min_shift_hours"]
+        self.window = rule["window_hours"]
+        self.options: dict[date, list[Option]] = {d: self._options(d) for d in self.days}
+
+    def _options(self, day: date) -> list[Option]:
+        out = []
+        for tpl in templates_for(self.cfg):
+            segs = tuple(tpl.segments_utc(day, self.tz))
+            idx = np.array([i for i, t in enumerate(self.grid) if any(s <= t < e for s, e in segs)], dtype=int)
+            if not len(idx):
+                continue
+            hours = sum((e - s).total_seconds() for s, e in segs) / 3600
+            start = segs[0][0]
+            brk = []
+            if hours >= self.break_min_shift:
+                lo, hi = self.window
+                for i in idx:
+                    t = self.grid[i]
+                    for k, (s, e) in enumerate(segs):
+                        if s <= t and t + self.break_len <= e and timedelta(hours=lo) <= t - start <= timedelta(hours=hi):
+                            brk.append((int(i), k))
+            out.append(Option(day, tpl, segs, idx, start, segs[-1][1], hours, tuple(brk),
+                              np.array(sorted({b[0] for b in brk}), dtype=int)))
+        return out
+
+
+def place_breaks(ctx: Ctx, slots: list[tuple[str, Option]], rule: str):
+    """Break start (grid index) for each slot, and gross / on-break counts per queue."""
+    gross = {q: np.zeros(ctx.n) for q in ctx.queues}
+    for q, o in slots:
+        gross[q][o.idx] += 1
+    brk = np.zeros((len(ctx.queues), ctx.n))
+    qi = {q: i for i, q in enumerate(ctx.queues)}
+    chosen: list = [None] * len(slots)
+    surplus = {q: gross[q] - ctx.required[q] for q in ctx.queues}
+    order = sorted(range(len(slots)), key=lambda i: (slots[i][1].start, slots[i][0], slots[i][1].tpl.id))
+    for i in order:
+        q, o = slots[i]
+        if not o.breaks:
+            continue
+        s, k = surplus[q], brk[qi[q]]
+        if rule == "midpoint":
+            mid = o.start + timedelta(hours=o.hours / 2)
+            pick = min(o.breaks, key=lambda b: (abs((ctx.grid[b[0]] - mid).total_seconds()), b[0]))
+        else:
+            best = max(s[b[0]] for b in o.breaks)
+            tied = [b for b in o.breaks if s[b[0]] == best]
+            pick = min(tied, key=lambda b: (k[b[0]], b[0]))     # ties: spread, fewest breaks already there
+        chosen[i] = pick
+        brk[qi[q], pick[0]] += 1
+    return chosen, gross, {q: brk[qi[q]] for q in ctx.queues}
+
+
+def evaluate_plan(ctx: Ctx, slots, rule: str) -> tuple[float, dict]:
+    chosen, gross, brk = place_breaks(ctx, slots, rule)
+    hours = sum(o.hours for _, o in slots)
+    short = {}
+    miss = 0.0
+    for q in ctx.queues:
+        net = gross[q] - brk[q]
+        d = np.maximum(0.0, ctx.required[q] - net)
+        n_short = int(((d > 0) & ctx.demand[q]).sum())
+        floor_gap = np.maximum(0.0, ctx.floor[q] - gross[q])
+        short[q] = n_short
+        miss += float(d[ctx.demand[q]].sum()) + 3.0 * float(floor_gap.sum())
+    cost = hours + SHORT_PRICE * miss
+    return cost, {"hours": hours, "short": short, "gross": gross, "brk": brk, "chosen": chosen}
+
+
+# --- plan construction ---------------------------------------------------------------------------------
+#
+# Shifts of different queues or days do not interact in the plan (a break is placed inside its own
+# shift, against its own queue's surplus), so the plan is solved cell by cell, a cell being one queue on
+# one local day, and the cells are tied together by one price `lam` per interval left below requirement.
+
+def cell_eval(ctx: Ctx, q: str, opts: list[Option], lam: float, rule: str, day: date):
+    """Cost of running the shifts `opts` on queue q on `day`: paid hours, `lam` per interval below
+    requirement (net of breaks), a little per agent short, and a heavy price on a gap below the queue's
+    floor. Only the day's own intervals are looked at (a shift never leaves its local day)."""
+    key = (q, day, rule, tuple(sorted(o.tpl.id for o in opts)))
+    memo = ctx.__dict__.setdefault("cell_memo", {})
+    got = memo.get(key)
+    if got is None:
+        got = memo[key] = _cell_stats(ctx, q, opts, rule, day)
+    hours, miss, dsum, gap, d = got
+    return hours + lam * miss + 0.5 * dsum + 200.0 * gap, hours, miss, d
+
+
+def _cell_stats(ctx: Ctx, q: str, opts: list[Option], rule: str, day: date):
+    lo, hi = ctx.day_range[day]
+    gross = np.zeros(hi - lo)
+    for o in opts:
+        gross[o.idx - lo] += 1
+    req = ctx.required[q][lo:hi]
+    k = np.zeros(hi - lo)
+    s = gross - req
+    chosen = [None] * len(opts)
+    order = sorted(range(len(opts)), key=lambda i: (opts[i].start, opts[i].tpl.id))
+    for i in order:
+        o = opts[i]
+        if not o.breaks:
+            continue
+        if rule == "midpoint":
+            mid = o.start + timedelta(hours=o.hours / 2)
+            pick = min(o.breaks, key=lambda b: (abs((ctx.grid[b[0]] - mid).total_seconds()), b[0]))
+        else:
+            loc = o.bidx - lo
+            sb = s[loc]
+            tied = loc[sb == sb.max()]
+            pick = (int(tied[np.argmin(k[tied])]) + lo, 0)       # ties: fewest breaks already there, earliest
+        chosen[i] = pick
+        k[pick[0] - lo] += 1
+    d = np.maximum(0.0, req - (gross - k))
+    miss = int(((d > 0) & ctx.demand[q][lo:hi]).sum())
+    gap = float(np.maximum(0.0, ctx.floor[q][lo:hi] - gross).sum())
+    hours = sum(o.hours for o in opts)
+    return hours, miss, float(d.sum()), gap, d
+
+
+def greedy_cell(ctx: Ctx, q: str, day: date, target: np.ndarray) -> list[Option]:
+    have = np.zeros(ctx.n)
+    out = []
+    while True:
+        unmet = np.maximum(0.0, target - have)
+        best, best_score = None, 0.0
+        for o in ctx.options[day]:
+            u = float(np.minimum(1.0, unmet[o.idx]).sum())
+            if u > 0 and u / len(o.idx) + 1e-3 * u > best_score + 1e-12:
+                best, best_score = o, u / len(o.idx) + 1e-3 * u
+        if best is None:
+            return out
+        out.append(best)
+        have[best.idx] += 1
+
+
+def solve_cell(ctx: Ctx, q: str, day: date, lam: float, banned: set):
+    rule = ctx.cfg.get("break_rule", "midpoint")
+    allowed = [o for o in ctx.options[day] if (q, day, o.tpl.id) not in banned]
+    bump = np.zeros(ctx.n)
+    start = []
+    best_c = float("inf")
+    for _ in range(4):                       # inflate the target where breaks left the cell short
+        cand = [o for o in greedy_cell(ctx, q, day, ctx.need[q] + bump) if o in allowed] 
+        c, _, _, short = cell_eval(ctx, q, cand, lam, rule, day)
+        if c < best_c:
+            start, best_c = cand, c
+        bump[ctx.day_range[day][0]:ctx.day_range[day][1]] += short
+    cur, cost = list(start), best_c
+    while True:
+        best = (cost, None)
+        n = len(cur)
+        for stage in (1, 2):
+            trials = []
+            if stage == 1:                       # single moves: drop, swap, add
+                for i in range(n):
+                    trials.append(cur[:i] + cur[i + 1:])
+                    for o in allowed:
+                        if o is not cur[i]:
+                            trials.append(cur[:i] + [o] + cur[i + 1:])
+                for o in allowed:
+                    trials.append(cur + [o])
+            else:                                # pair moves: two -> one, one -> two
+                for i in range(n):
+                    for j in range(i + 1, n):
+                        for o in allowed:
+                            trials.append([x for k, x in enumerate(cur) if k not in (i, j)] + [o])
+                    for o in allowed:
+                        for o2 in allowed:
+                            trials.append(cur[:i] + cur[i + 1:] + [o, o2])
+            for t in trials:
+                c = cell_eval(ctx, q, t, lam, rule, day)[0]
+                if c < best[0] - 1e-9:
+                    best = (c, t)
+        if best[1] is None:
+            break
+        cost, cur = best
+    return cur
+
+
+LAMBDAS = (60.0, 30.0, 20.0, 14.0, 10.0, 8.0, 7.0, 6.0, 5.5, 5.0, 4.5, 4.0, 3.5, 3.0, 2.5, 2.0, 1.5, 1.0, 0.5)
+
+
+def pool_violations(ctx: Ctx, hours: dict, agents: list[Agent]) -> list[tuple]:
+    """Queue sets whose planned hours exceed what the agents able to work them can give in a week
+    (Hall's condition on weekly caps). Returns [(queue set, planned, capacity)]."""
+    from itertools import combinations
+    caps = ctx.cfg["weekly_hours"]
+    out = []
+    for r in range(1, len(ctx.queues) + 1):
+        for qs in combinations(ctx.queues, r):
+            cap = sum(caps[a.contract] for a in agents if a.skills & set(qs))
+            need = sum(hours[q] for q in qs)
+            if need > cap + 1e-9:
+                out.append((qs, need, cap))
+    return out
+
+
+def plan_week(ctx: Ctx, banned: set | None = None, hours_cap: float | None = None, max_miss: dict | None = None,
+              agents: list[Agent] | None = None, start_budget: dict | None = None):
+    """Pick a price per missed interval for each queue: the highest at which the plan fits what the
+    roster can work, the contract's paid-hours cap, and each queue's allowance of intervals below
+    requirement. When they cannot all hold, the roster and the hours cap win and intervals are left
+    short (reported by the evaluator and in exceptions.md)."""
+    banned = banned or set()
+    max_miss = max_miss or {}
+    rule = ctx.cfg.get("break_rule", "midpoint")
+    cache: dict = ctx.__dict__.setdefault("cell_cache", {})
+    ban_key = frozenset(banned)
+
+    def cell(q, day, lam):
+        key = (q, day, lam, ban_key)
+        if key not in cache:
+            cache[key] = solve_cell(ctx, q, day, lam, banned)
+        return cache[key]
+
+    fcache: dict = {}
+
+    def frontier(q, day):
+        """Distinct (hours, intervals short, shifts) over the price ladder, best price first."""
+        if (q, day) in fcache:
+            return fcache[(q, day)]
+        seen, out = set(), []
+        for lam in LAMBDAS:
+            opts = cell(q, day, lam)
+            _, h, m, _d = cell_eval(ctx, q, opts, lam, rule, day)
+            if (h, m) not in seen:
+                seen.add((h, m))
+                out.append((h, m, opts))
+        fcache[(q, day)] = out
+        return out
+
+    def choose(q, budget):
+        """One option per day: fewest intervals short within `budget` paid hours, then fewest hours."""
+        states = {0.0: (0, [])}
+        for day in ctx.days:
+            nxt: dict = {}
+            for h0, (m0, pick) in states.items():
+                for h, m, opts in frontier(q, day):
+                    h1 = h0 + h
+                    if budget is not None and h1 > budget + 1e-9:
+                        continue
+                    if h1 not in nxt or m0 + m < nxt[h1][0]:
+                        nxt[h1] = (m0 + m, pick + [opts])
+            if not nxt:      # even the cheapest options exceed the budget: take the cheapest per day
+                nxt = {h0 + min(h for h, _, _ in frontier(q, day)): (m0, pick + [min(frontier(q, day), key=lambda f: f[0])[2]])
+                       for h0, (m0, pick) in states.items()}
+            # keep the Pareto set (hours, misses)
+            best, keep = 10 ** 9, {}
+            for h in sorted(nxt):
+                if nxt[h][0] < best:
+                    best = nxt[h][0]
+                    keep[h] = nxt[h]
+            states = keep
+        h, (m, pick) = min(states.items(), key=lambda kv: (kv[1][0], kv[0]))
+        return [o for opts in pick for o in opts], h, m
+
+    budget = {q: (start_budget or {}).get(q) for q in ctx.queues}
+    for _ in range(200):
+        parts = {q: choose(q, budget[q]) for q in ctx.queues}
+        hours = {q: parts[q][1] for q in ctx.queues}
+        short = {q: parts[q][2] for q in ctx.queues}
+        total = sum(hours.values())
+        spare = {q: max_miss.get(q, 10 ** 9) - short[q] for q in ctx.queues}
+        relax = set()
+        for qs, _, _ in (pool_violations(ctx, hours, agents) if agents else []):
+            relax.add(max(qs, key=lambda q: (spare[q], hours[q])))
+        if not relax and hours_cap is not None and total > hours_cap:
+            relax.add(max(ctx.queues, key=lambda q: (spare[q], hours[q])))
+        if not relax:
+            break
+        for q in relax:
+            budget[q] = hours[q] - 2.0
+    return [(q, o) for q in ctx.queues for o in parts[q][0]]
+
+
+# --- assignment ----------------------------------------------------------------------------------------
+
+def assign(ctx: Ctx, slots, agents: list[Agent], tries: int = 12):
+    """Best of a few deterministic attempts (the scarcest-first order, then seeded shuffles of it)."""
+    import random
+    best = None
+    for k in range(tries):
+        got, left = _assign_once(ctx, slots, agents, seed=None if k == 0 else k, depth=3 if k < 4 else 4)
+        if best is None or len(left) < len(best[1]):
+            best = (got, left)
+        if not left:
+            break
+    return best
+
+
+def assign_with_repair(ctx: Ctx, slots: list, agents: list[Agent]):
+    """`assign`, and for a planned shift nobody can take, the same queue and day with another template
+    (cheapest on the cell's cost first). Returns (assigned, unassigned, slots as finally planned)."""
+    rule = ctx.cfg.get("break_rule", "midpoint")
+    slots = list(slots)
+    got, left = assign(ctx, slots, agents)
+    for _ in range(len(slots)):
+        if not left:
+            break
+        i = left[0]
+        q, o = slots[i]
+        cell = [x for qq, x in slots if qq == q and x.day == o.day and x is not o]
+        alts = sorted((a for a in ctx.options[o.day] if a.tpl.id != o.tpl.id),
+                      key=lambda a: cell_eval(ctx, q, cell + [a], 60.0, rule, o.day)[0])[:4]
+        for alt in alts:
+            trial = slots[:i] + [(q, alt)] + slots[i + 1:]
+            g2, l2 = assign(ctx, trial, agents, tries=4)
+            if len(l2) < len(left):
+                slots, got, left = trial, g2, l2
+                break
+        else:
+            break
+    return got, left, slots
+
+
+def _assign_once(ctx: Ctx, slots, agents: list[Agent], seed: int | None = None, depth: int = 3):
+    """Give each planned shift an agent. Greedy first (scarcest shifts first, fewest hours so far), then
+    for each shift left over an ejection search: put it on an agent by moving one of that agent's shifts
+    to someone else, up to `depth` links. Returns (assigned: [(slot index, agent)], unassigned: [slot index])."""
+    cfg = ctx.cfg
+    mine: dict[str, dict] = {a.agent_id: {} for a in agents}      # agent -> {day: (queue, Option, slot index)}
+    by_id = {a.agent_id: a for a in agents}
+    n_skill = {q: sum(q in a.skills for a in agents) for q in ctx.queues}
+    order = sorted(range(len(slots)), key=lambda i: (slots[i][1].day, not slots[i][1].tpl.is_split,
+                                                    n_skill[slots[i][0]], slots[i][1].start, slots[i][0], i))
+
+    def hours(aid):
+        return sum(o.hours for _, o, _ in mine[aid].values())
+
+    def fits(a: Agent, day, item) -> bool:
+        trial = dict(mine[a.agent_id])
+        trial[day] = item
+        return _week_ok(cfg, a, trial)
+
+    def place(i: int, left: int, busy: frozenset) -> bool:
+        q, o = slots[i]
+        item = (q, o, i)
+        skilled = [a for a in agents if q in a.skills]
+        free = [a for a in skilled if o.day not in mine[a.agent_id] and fits(a, o.day, item)]
+        if free:
+            a = min(free, key=lambda x: (hours(x.agent_id), x.agent_id))
+            mine[a.agent_id][o.day] = item
+            return True
+        if left == 0:
+            return False
+        for a in sorted(skilled, key=lambda x: (hours(x.agent_id), x.agent_id)):
+            aid = a.agent_id
+            if aid in busy:
+                continue
+            for d, old in sorted(mine[aid].items(), key=lambda kv: (kv[1][1].tpl.id != o.tpl.id, kv[0])):
+                trial = {k: v for k, v in mine[aid].items() if k != d}
+                if o.day in trial:          # that day is already taken by a shift we are not moving
+                    continue
+                trial[o.day] = item
+                if not _week_ok(cfg, a, trial):
+                    continue
+                saved = dict(mine[aid])
+                mine[aid] = trial
+                if place(old[2], left - 1, busy | {aid}):
+                    return True
+                mine[aid] = saved
+        return False
+
+    if seed is not None:        # keep day order, shuffle within a day
+        import random
+        rng = random.Random(seed)
+        order = sorted(order, key=lambda i: (slots[i][1].day, rng.random()))
+    left = [i for i in order if not place(i, depth, frozenset())]
+    got = [(it[2], by_id[aid]) for aid, wk in mine.items() for it in wk.values()]
+    return got, left
+
+
+def budget(ctx: Ctx) -> tuple[float | None, dict]:
+    """Paid-hours cap and per-queue count of intervals that may stay below requirement, from the contract
+    keys `max_hours_ratio` (scheduled over required hours) and `sla_target` (weekly attainment per queue).
+    Both are kept a little inside the contract so that rounding and a re-measure do not tip a week over."""
+    cfg = ctx.cfg
+    ratio = cfg.get("max_hours_ratio")
+    req_hours = float(sum(ctx.required[q].sum() for q in ctx.queues)) * ctx.grain_h
+    cap = ratio * req_hours * 0.99 if ratio else None
+    max_miss = {}
+    for q in ctx.queues:
+        ops = int(ctx.operating[q].sum())
+        max_miss[q] = max(0, int((1.0 - float(cfg["sla_target"])) * ops) - 1)
+    return cap, max_miss
+
+
+def _week_ok(cfg: dict, agent: Agent, week_plan: dict) -> bool:
+    """Is one agent's week (local day -> (queue, Option)) inside the rules: skills, split shifts, elapsed
+    weekly cap, consecutive days, elapsed rest between consecutive shifts?"""
+    caps, max_run = cfg["weekly_hours"], cfg["max_consecutive_days"]
+    rest = timedelta(hours=float(cfg["min_rest_hours"])) if cfg.get("min_rest_hours") else timedelta(0)
+    split_ok = cfg.get("split_contracts")
+    if sum(v[1].hours for v in week_plan.values()) > caps[agent.contract] + 1e-9:
+        return False
+    days = sorted(week_plan)
+    run, prev = 0, None
+    for d in days:
+        q, o = week_plan[d][:2]
+        if q not in agent.skills or (o.tpl.is_split and split_ok is not None and agent.contract not in split_ok):
+            return False
+        run = run + 1 if prev is not None and (d - prev).days == 1 else 1
+        if run > max_run:
+            return False
+        if prev is not None and o.start - week_plan[prev][1].end < rest:
+            return False
+        prev = d
+    return True
+
+
+def refine(ctx: Ctx, agents: list[Agent], mine: dict, hours_cap: float | None, lam: float = 60.0, max_pass: int = 12):
+    """Local search over people: change one agent's shift on one day (another template, another queue they
+    can work, or none) while the agent's week stays inside the rules, keeping any change that lowers the
+    cost of the cells it touches. `mine`: {agent_id: {day: (queue, Option)}}."""
+    rule = ctx.cfg.get("break_rule", "midpoint")
+    by_id = {a.agent_id: a for a in agents}
+    cells: dict = defaultdict(list)
+    for aid, wk in mine.items():
+        for d, (q, o) in wk.items():
+            cells[(q, d)].append(o)
+    cost = {}
+
+    def c(q, d, opts):
+        return cell_eval(ctx, q, opts, lam, rule, d)[0]
+
+    for q in ctx.queues:
+        for d in ctx.days:
+            cost[(q, d)] = c(q, d, cells[(q, d)])
+    total_hours = sum(o.hours for wk in mine.values() for _, o in wk.values())
+    for _ in range(max_pass):
+        changed = False
+        for a in agents:
+            wk = mine.setdefault(a.agent_id, {})
+            for d in ctx.days:
+                cur = wk.get(d)
+                best, best_gain = None, 1e-9
+                choices = [None] + [(q, o) for q in ctx.queues if q in a.skills for o in ctx.options[d]]
+                for ch in choices:
+                    if ch == cur or (ch is not None and cur is not None and ch[0] == cur[0] and ch[1] is cur[1]):
+                        continue
+                    new_h = total_hours - (cur[1].hours if cur else 0) + (ch[1].hours if ch else 0)
+                    if hours_cap is not None and new_h > hours_cap and new_h > total_hours:
+                        continue
+                    trial = dict(wk)
+                    if ch is None:
+                        trial.pop(d, None)
+                    else:
+                        trial[d] = ch
+                    if not _week_ok(ctx.cfg, a, trial):
+                        continue
+                    delta = 0.0
+                    touched = {}
+                    if cur is not None:
+                        lst = list(cells[(cur[0], d)])
+                        lst.remove(cur[1])
+                        touched[(cur[0], d)] = lst
+                    if ch is not None:
+                        lst = list(touched.get((ch[0], d), cells[(ch[0], d)]))
+                        lst.append(ch[1])
+                        touched[(ch[0], d)] = lst
+                    for key, lst in touched.items():
+                        delta += cost[key] - c(key[0], key[1], lst)
+                    if delta > best_gain:
+                        best, best_gain = (ch, touched), delta
+                if best is not None:
+                    ch, touched = best
+                    for key, lst in touched.items():
+                        cells[key] = lst
+                        cost[key] = c(key[0], key[1], lst)
+                    total_hours += (ch[1].hours if ch else 0) - (cur[1].hours if cur else 0)
+                    if ch is None:
+                        wk.pop(d, None)
+                    else:
+                        wk[d] = ch
+                    changed = True
+        if not changed:
+            break
+    return mine
+
+
+def schedule_week(req: pd.DataFrame, cfg: dict, agents: list[Agent], week: str) -> list[Shift]:
+    if constraints.weight(cfg) and cfg.get("min_cover"):
+        raise SystemExit("scheduler 'weekly' counts an agent once, on the queue they are scheduled on: "
+                         "set cross_skill_weight: 0 with min_cover")
+    ctx = Ctx(req, cfg, week)
+    rule = cfg.get("break_rule", "midpoint")
+    hours_cap, max_miss = budget(ctx)
+    # a split shift needs somebody on the queue who may work one
+    split_ok = cfg.get("split_contracts")
+    banned = {(q, d, o.tpl.id) for q in ctx.queues for d in ctx.days for o in ctx.options[d]
+              if o.tpl.is_split and split_ok is not None
+              and not any(q in a.skills and a.contract in split_ok for a in agents)}
+    start_budget: dict = {}
+    for _ in range(16):
+        slots = plan_week(ctx, banned, hours_cap, max_miss, agents, start_budget)
+        got, left, slots = assign_with_repair(ctx, slots, agents)
+        if not left:
+            break
+        for q in ctx.queues:
+            planned = sum(o.hours for qq, o in slots if qq == q)
+            lost = sum(slots[i][1].hours for i in left if slots[i][0] == q)
+            if lost:
+                start_budget[q] = planned - 2.0     # a plan that packs worse than the pool allows: ask for less
+    mine: dict = defaultdict(dict)
+    for i, a in got:
+        q, o = slots[i]
+        mine[a.agent_id][o.day] = (q, o)
+    mine = refine(ctx, agents, mine, hours_cap)
+    slots_done, owners = [], []
+    for aid in sorted(mine):
+        for d in sorted(mine[aid]):
+            slots_done.append(mine[aid][d])
+            owners.append(aid)
+    cost, info = evaluate_plan(ctx, slots_done, rule)
+    shifts = []
+    for (q, o), aid, ch in zip(slots_done, owners, info["chosen"]):
+        sh = Shift(aid, q, o.tpl, o.day, list(o.segs), [ctx.grid[i] for i in o.idx])
+        if ch is not None:
+            sh.break_start = ctx.grid[ch[0]]
+            sh.break_minutes = int(cfg["break"]["minutes"])
+        shifts.append(sh)
+    return shifts
