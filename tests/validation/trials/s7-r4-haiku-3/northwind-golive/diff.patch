+    """Place the shifts, then the breaks. With `net_of_breaks`, an interval that a break leaves short
+    of its requirement gets one more agent to cover it, and the week is placed again, until coverage
+    holds net of breaks (SOW §1.2) or the rounds run out. Floor queues are planned first and are not
+    repaired this way: a floor they cannot hold is reported, not chased."""
+    floor_qs = [q for q in dict.fromkeys(req["queue"]) if (cfg.get("min_cover") or {}).get(q)] \
+        if cfg.get("floor_first") else []
+    extra: dict[tuple[str, datetime], int] = defaultdict(int)
+    for _ in range(MAX_REPAIR_ROUNDS):
+        shifts = _schedule_once(req, cfg, agents, week, extra, floor_qs)
