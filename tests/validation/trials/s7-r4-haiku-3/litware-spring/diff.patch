+# Litware Support — 20-minute export in Europe/London; each row is stamped with the END of its interval
+# (data/litware/README.txt). Config schema 2. Each value below is a term of docs/LITWARE_SOW.md (section in
+# the comment). The export's utc_offset column is authoritative. Service defaults stay as they are for everyone else.
+schema: 2
+name: Litware Support
+service:
+  interval_minutes: 20                      # §1.5
+  tz: Europe/London                         # §1.4
+  operating_hours: [7, 21]                  # §1.4: 07:00-21:00 local, seven days
+  queue_operating_hours: {email: [7, 19]}   # §1.4: email contacts arrive 07:00-19:00
+targets:
+  sla:                                      # §1.2: fraction answered within seconds, per queue
+    priority: {target: 0.90, seconds: 30}
+    standard: {target: 0.80, seconds: 30}
+    email: {target: 0.80, seconds: 300}
+  sla_target: 0.95                          # §1.6: weekly attainment on each queue
+  attainment_basis: service_level           # §1.2: met when scheduled (net of breaks) >= required
+  sla_denominator: operating                # §1.6: operating intervals, §2.6 intervals left out
+staffing:
+  occupancy_cap: 0.85                       # §1.3
+  apply_occupancy_cap: true                 # §1.3 applies to Litware's required staffing
+  aht_smoothing: interval                   # §1.2: the interval's own average handle time
+scheduling:
+  weekly_hours: {FT: 40, PT: 24}            # §2.9, elapsed hours per planning week
+  max_consecutive_days: 5                   # §2.9
+  break:                                    # §2.3
+    min_shift_hours: 6
+    minutes: 20
+    window_hours: [2, 5]
+    placement: surplus
+  min_cover:                                # §2.4: at least two agents on priority in every operating interval
+    priority: {agents: 2, hours: [7, 21]}
+  cross_skill_weight: 0                     # §1.2, §2.4: an agent counts once, on the queue they are scheduled on
+  min_rest_hours: 11                        # §2.1
+  split_contracts: [PT]                     # §2.2
+  queue_start_hours: {email: 9}             # §2.5: no agent on email before 09:00 local
+  net_of_breaks: true                       # §1.2: coverage holds after breaks
+  trim_surplus: true                        # §1.6: drop shifts the week does not need
+  floor_first: true                         # §2.4: plan priority (the floor queue) for the whole week first
+  plan_first: [email]                       # email has five skilled agents: plan it for the week before standard
