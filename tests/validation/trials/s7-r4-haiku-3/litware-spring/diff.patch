+def earliest(queue: str, cfg: dict) -> int:
+    """Earliest local hour an agent may start a shift on `queue` (0 when no rule applies)."""
+    return int((cfg.get("queue_start_hours") or {}).get(queue, 0))
+
+
+def unstaffable(queue: str, t: datetime, cfg: dict) -> bool:
+    """True when the rules leave the interval starting at `t` with no agent who may cover it on `queue`:
+    it starts before the queue's earliest start hour (SOW §2.5). Such an interval is an exception (§2.6)."""
+    loc = t.astimezone(ZoneInfo(cfg["tz"]))
+    return loc.hour + loc.minute / 60 < earliest(queue, cfg)
