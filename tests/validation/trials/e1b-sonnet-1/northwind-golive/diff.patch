+"""Week-aware scheduler (clients with `scheduler: weekly`, e.g. Northwind; SOW sections 1.6 and 2).
+
+Same template vocabulary as `greedy.py`, but the rules that the older contracts audit afterwards are
+enforced while placing, with the whole week in view:
+
+  * rest between shifts (`min_rest_hours`, elapsed time, both neighbours of a day)
+  * split templates only for the contract named in `split_shifts` (PT)
+  * weekly hour caps (elapsed), at most `max_consecutive_days` local days in a row, skills, one shift a day
+  * minimum cover floors (`min_cover`, wfm/constraints.py), counted on the queue itself
+  * one break per shift of `break.min_shift_hours` or more, in the 30-minute interval of its window where
+    the queue's gross coverage surplus (agents on the queue, breaks ignored, minus required) is largest
+
+A day-by-day greedy builds the base plan, then a repair loop adds shifts where the plan -- net of the
+breaks that the rule above puts down -- is still short of the requirement, within the hours budget
+(`hours_budget_ratio` x required hours). Deterministic: fixed template order, stable ties by agent id.
+"""
+from __future__ import annotations
+
+import math
+import random
+from collections import defaultdict
+from datetime import date, datetime, timedelta
+from zoneinfo import ZoneInfo
+
+import numpy as np
+import pandas as pd
+
+from wfm import constraints
+from wfm.ingest.loader import local_days
+from wfm.roster import Agent
+from wfm.scheduler.greedy import Shift
+from wfm.scheduler.templates import Template, templates_for
+
+WASTE_WEIGHT = 0.4          # greedy: value of a covered slot is 1, a slot beyond the requirement costs this much
+MIN_GREEDY_RATIO = 0.5      # greedy: stop placing a template that is useful in less than this share of its slots
+REPAIR_TOP_K = 8            # repair: candidates evaluated in full per round
+
+
+def queue_hours(cfg: dict, queue: str) -> tuple[float, float]:
+    """Local operating hours of a queue: `queue_hours` override, else the client's operating hours."""
+    lo, hi = (cfg.get("queue_hours") or {}).get(queue, cfg["operating_hours"])
+    return float(lo), float(hi)
+
+
+def operating_mask(grid, cfg: dict, queue: str) -> np.ndarray:
+    z = ZoneInfo(cfg["tz"])
+    lo, hi = queue_hours(cfg, queue)
+    out = np.zeros(len(grid), dtype=bool)
+    for i, t in enumerate(grid):
+        loc = t.astimezone(z)
+        h = loc.hour + loc.minute / 60
+        out[i] = lo <= h < hi
+    return out
+
+
+class _Plan:
+    """Mutable week plan: the shifts and the per-agent state needed to test a new shift."""
+
+    def __init__(self, cfg: dict, agents: list[Agent], grid):
+        self.cfg = cfg
+        self.agents = agents
+        self.grid = grid
+        self.index = {t: i for i, t in enumerate(grid)}
+        self.min_rest = timedelta(hours=float(cfg.get("min_rest_hours") or 0))
+        self.caps = cfg["weekly_hours"]
+        self.max_run = cfg["max_consecutive_days"]
+        self.split_ok = cfg.get("split_shifts", "all")
+        self.hours: dict[str, float] = defaultdict(float)
+        self.by_day: dict[str, dict[date, Shift]] = defaultdict(dict)
+        self.shifts: list[Shift] = []
+        self.total = 0.0
+
+    # -- rule checks -------------------------------------------------------------------------
+    def can_take(self, a: Agent, q: str, tpl: Template, day: date, segs) -> bool:
+        if q not in a.skills or day in self.by_day[a.agent_id]:
+            return False
+        if tpl.is_split and self.split_ok not in ("all", a.contract):
+            return False
+        hrs = sum((e - s).total_seconds() for s, e in segs) / 3600.0
+        if self.hours[a.agent_id] + hrs > self.caps[a.contract] + 1e-9:
+            return False
+        worked = self.by_day[a.agent_id]
+        run = 1
+        d = day - timedelta(days=1)
+        while d in worked:
+            run, d = run + 1, d - timedelta(days=1)
+        d = day + timedelta(days=1)
+        while d in worked:
+            run, d = run + 1, d + timedelta(days=1)
+        if run > self.max_run:
+            return False
+        prev = worked.get(day - timedelta(days=1))
+        if prev is not None and segs[0][0] - prev.segments[-1][1] < self.min_rest:
+            return False
+        nxt = worked.get(day + timedelta(days=1))
+        if nxt is not None and nxt.segments[0][0] - segs[-1][1] < self.min_rest:
+            return False
+        return True
+
+    def add(self, a: Agent, q: str, tpl: Template, day: date, segs, ivs) -> Shift:
+        sh = Shift(a.agent_id, q, tpl, day, segs, ivs)
+        self.add_back(sh)
+        return sh
+
+    def remove(self, sh: Shift) -> None:
+        self.shifts.remove(sh)
+        self.hours[sh.agent_id] -= sh.hours
+        self.total -= sh.hours
+        del self.by_day[sh.agent_id][sh.day]
+
+    def reset(self, shifts: list[Shift]) -> None:
+        self.shifts, self.total = [], 0.0
+        self.hours, self.by_day = defaultdict(float), defaultdict(dict)
+        for sh in shifts:
+            self.add_back(sh)
+
+    def add_back(self, sh: Shift) -> None:
+        self.shifts.append(sh)
+        self.hours[sh.agent_id] += sh.hours
+        self.total += sh.hours
+        self.by_day[sh.agent_id][sh.day] = sh
+
+
+def _slots(segs, grid_by_day) -> list[datetime]:
+    return [t for s, e in segs for t in grid_by_day if s <= t < e]
+
+
+def _break_candidates(sh: Shift, cfg: dict) -> list[datetime]:
+    """Interval starts at which the shift's break may start: 2-5 h after the shift start, whole break inside a segment."""
+    rule = cfg["break"]
+    length = timedelta(minutes=rule["minutes"])
+    lo, hi = rule["window_hours"]
+    start = sh.segments[0][0]
+    return [t for t in sh.intervals
+            if start + timedelta(hours=lo) <= t <= start + timedelta(hours=hi)
+            and any(s <= t and t + length <= e for s, e in sh.segments)]
+
+
+def _prep(sh: Shift, cfg: dict, index: dict) -> Shift:
+    """Cache the grid indexes of a shift's slots and of its possible break starts."""
+    sh.ix = np.array([index[t] for t in sh.intervals], dtype=int)
+    sh.bc = [index[t] for t in _break_candidates(sh, cfg)] if sh.hours >= cfg["break"]["min_shift_hours"] else []
+    return sh
+
+
+def place_breaks(shifts: list[Shift], cfg: dict, surplus: dict[str, np.ndarray], grid: list) -> None:
+    """SOW 2.3: each shift's break goes in the window interval with the largest gross coverage surplus on its
+    queue. Ties (any is allowed) go to the interval with the fewest breaks so far, then the earliest."""
+    minutes = cfg["break"]["minutes"]
+    taken: dict[tuple[str, int], int] = defaultdict(int)
+    for sh in sorted(shifts, key=lambda s: (s.segments[0][0], s.agent_id)):
+        sh.break_start, sh.break_minutes = None, 0
+        if not sh.bc:
+            continue
+        sur = surplus[sh.queue]
+        i = max(sh.bc, key=lambda i: (sur[i], -taken[(sh.queue, i)], -i))
+        sh.break_start, sh.break_minutes = grid[i], minutes
+        taken[(sh.queue, i)] += 1
+
+
+class _Ctx:
+    """Requirement arrays and the evaluation of a plan: gross cover, breaks by the SOW rule, net cover."""
+
+    def __init__(self, cfg, grid, queues, required, floors, masks):
+        self.cfg, self.grid, self.queues = cfg, grid, queues
+        self.required, self.floors, self.masks = required, floors, masks
+        self.n = len(grid)
+        self.index = {t: i for i, t in enumerate(grid)}
+
+    def simulate(self, shifts: list[Shift]):
+        """Returns (net, unmet intervals per queue, deficit in agent-intervals); breaks are placed on the shifts."""
+        q_ = self.queues
+        gross = {q: np.zeros(self.n, dtype=int) for q in q_}
+        for sh in shifts:
+            gross[sh.queue][sh.ix] += 1
+        place_breaks(shifts, self.cfg, {q: gross[q] - self.required[q] for q in q_}, self.grid)
+        net = {q: gross[q].copy() for q in q_}
+        idx = self.index
+        for sh in shifts:
+            if sh.break_start is not None:
+                net[sh.queue][idx[sh.break_start]] -= 1
+        unmet = {q: np.flatnonzero(self.masks[q] & (net[q] < self.required[q])) for q in q_}
+        deficit = sum(int(np.maximum(0, self.required[q] - net[q])[self.masks[q]].sum()) for q in q_)
+        return gross, net, unmet, deficit
+
+    def floor_gaps(self, gross) -> int:
+        return sum(int(np.sum(gross[q] < self.floors[q])) for q in self.queues)
+
+    def score(self, plan) -> tuple:
+        gross, net, unmet, deficit = self.simulate(plan.shifts)
+        return (sum(len(u) for u in unmet.values()) + self.floor_gaps(gross), deficit, plan.total), net, unmet
+
+
+def schedule_week(req: pd.DataFrame, cfg: dict, agents: list[Agent], week: str) -> list[Shift]:
+    tz = cfg["tz"]
+    z = ZoneInfo(tz)
+    grain_h = cfg["interval_minutes"] / 60.0
+    templates = templates_for(cfg)
+    queues = list(dict.fromkeys(req["queue"]))
+    grid = sorted(set(req["interval_start_utc"]))
+    grid = [t.to_pydatetime() if hasattr(t, "to_pydatetime") else t for t in grid]
+    n = len(grid)
+    plan = _Plan(cfg, agents, grid)
+    index = plan.index
+
+    required = {q: np.zeros(n, dtype=int) for q in queues}
+    for q, g in req.groupby("queue"):
+        for t, r in zip(g["interval_start_utc"], g["required"]):
+            required[q][index[t.to_pydatetime()]] = int(r)
+    floors = {q: np.array([constraints.floor(q, t, cfg) for t in grid]) for q in queues}
+    need = {q: np.maximum(required[q], floors[q]) for q in queues}   # floor counts on the queue itself
+    masks = {q: operating_mask(grid, cfg, q) for q in queues}
+    cover = {q: np.zeros(n, dtype=int) for q in queues}
+    nsk = {a.agent_id: len(a.skills & set(queues)) for a in agents}
+    ctx = _Ctx(cfg, grid, queues, required, floors, masks)
+    plan.ctx = ctx
+
+    budget = float(cfg.get("hours_budget_ratio", 1e9)) * required_hours(req, grain_h)
+    days = local_days(week, tz)
+    day_grid = {d: [t for t in grid if t.astimezone(z).date() == d] for d in days}
+
+    # ---- base plan: day by day ---------------------------------------------------------
+    for day in days:
+        dead: set[tuple[str, str]] = set()
+        while True:
+            best, best_val = None, 0.0
+            for tpl in templates:
+                segs = tpl.segments_utc(day, tz)
+                ivs = _slots(segs, day_grid[day])
+                if not ivs:
+                    continue
+                ix = np.array([index[t] for t in ivs])
+                for q in queues:
+                    if (tpl.id, q) in dead:
+                        continue
+                    useful = int(np.sum(cover[q][ix] < need[q][ix]))
+                    val = useful - WASTE_WEIGHT * (len(ivs) - useful)
+                    if useful >= MIN_GREEDY_RATIO * len(ivs) and val > best_val + 1e-9:
+                        best, best_val = (tpl, q, segs, ivs, ix), val
+            if best is None:
+                break
+            tpl, q, segs, ivs, ix = best
+            cands = [a for a in agents if plan.can_take(a, q, tpl, day, segs)]
+            if not cands:
+                dead.add((tpl.id, q))
+                continue
+            a = min(cands, key=lambda x: (plan.hours[x.agent_id], nsk[x.agent_id], x.agent_id))
+            _prep(plan.add(a, q, tpl, day, segs, ivs), cfg, index)
+            cover[q][ix] += 1
+
+    search = _Search(plan, ctx, cfg, agents, templates, days, day_grid, nsk, budget)
+    search.repair()
+    search.improve()
+    search.anneal()
+    search.improve()
+    search.trim()
+    ctx.simulate(plan.shifts)       # leaves the final breaks on the shifts
+    return plan.shifts
+
+
+def required_hours(req: pd.DataFrame, grain_h: float) -> float:
+    return float(req["required"].sum()) * grain_h
+
+
+class _Search:
+    """Repair and local search on a week plan. Objective, lexicographic: intervals short of requirement (plus floor
+    gaps), then agent-interval deficit, then hours -- all net of the breaks the SOW rule places."""
+
+    MAX_SWEEPS = 8
+    ANNEAL_ITERS = 70000
+    SEED = 20261102
+    T0, T1 = 4.0, 0.3
+
+    def __init__(self, plan, ctx, cfg, agents, templates, days, day_grid, nsk, budget):
+        self.plan, self.ctx, self.cfg = plan, ctx, cfg
+        self.agents, self.templates, self.days, self.day_grid = agents, templates, days, day_grid
+        self.nsk, self.budget = nsk, budget
+        z = ZoneInfo(cfg["tz"])
+        self.day_of = [t.astimezone(z).date() for t in ctx.grid]
+        self.seg = {(d, tpl.id): tpl.segments_utc(d, cfg["tz"]) for d in days for tpl in templates}
+        self.slots = {k: _slots(v, day_grid[k[0]]) for k, v in self.seg.items()}
+
+    def _add(self, a, q, tpl, d):
+        return _prep(self.plan.add(a, q, tpl, d, self.seg[(d, tpl.id)], self.slots[(d, tpl.id)]), self.cfg, self.ctx.index)
+
+    def repair(self) -> None:
+        """Add the shift that most reduces the shortfall, until none does (or the hours budget is reached)."""
+        plan, ctx = self.plan, self.ctx
+        cur, net, unmet = ctx.score(plan)
+        while cur[0] > 0:
+            cands = {}
+            for q in ctx.queues:
+                short = {int(i): int(ctx.required[q][i] - net[q][i]) for i in unmet[q]}
+                for i in list(short)[:60]:
+                    d = self.day_of[i]
+                    for tpl in self.templates:
+                        if plan.total + tpl.hours > self.budget + 1e-9 or (d, tpl.id, q) in cands:
+                            continue
+                        ix = [ctx.index[t] for t in self.slots[(d, tpl.id)]]
+                        if i not in ix:
+                            continue
+                        hit = sum(1 for j in ix if j in short)
+                        cands[(d, tpl.id, q)] = ((hit + 0.1 * sum(short[j] for j in ix if j in short)) / tpl.hours, tpl)
+            ranked = sorted(cands.items(), key=lambda kv: (-kv[1][0], kv[0]))
+            best, tried = None, 0
+            for (d, _, q), (_, tpl) in ranked:
+                if tried >= REPAIR_TOP_K:
+                    break
+                ok = [a for a in self.agents if plan.can_take(a, q, tpl, d, self.seg[(d, tpl.id)])]
+                if not ok:
+                    continue
+                tried += 1
+                a = min(ok, key=lambda x: (self.nsk[x.agent_id], plan.hours[x.agent_id], x.agent_id))
+                sh = self._add(a, q, tpl, d)
+                sc = ctx.score(plan)[0]
+                plan.remove(sh)
+                if sc[:2] < (best[0][:2] if best else cur[:2]):
+                    best = (sc, a, q, tpl, d)
+            if best is None:
+                break
+            _, a, q, tpl, d = best
+            self._add(a, q, tpl, d)
+            cur, net, unmet = ctx.score(plan)
+
+    def improve(self) -> None:
+        """First-improvement local search on (agent, day) cells: each cell may go off or take any template on any
+        queue the agent holds. First the agents who can serve queues still short, then a prune over everybody."""
+        plan, ctx = self.plan, self.ctx
+        for _ in range(self.MAX_SWEEPS):
+            cur, net, unmet = ctx.score(plan)
+            short_q = {q for q in ctx.queues if len(unmet[q])}
+            if not short_q or not self._sweep([a for a in self.agents if a.skills & short_q], cur):
+                break
+        for _ in range(self.MAX_SWEEPS):
+            if not self._sweep(self.agents, ctx.score(plan)[0]):
+                break
+
+    def anneal(self) -> None:
+        """Simulated annealing over the cells of the agents who can serve queues still short (fixed seed, so runs
+        repeat byte for byte). Escapes what first-improvement cannot: e.g. a queue whose few agents are all at their
+        weekly cap, where only re-timing their shifts helps. The best plan seen is kept."""
+        plan, ctx = self.plan, self.ctx
+        cur, net, unmet = ctx.score(plan)
+        short_q = {q for q in ctx.queues if len(unmet[q])}
+        if not short_q or self.ANNEAL_ITERS <= 0:
+            return
+
+        def energy(sc):
+            return 10.0 * sc[0] + sc[1] + 0.01 * sc[2]
+
+        rng = random.Random(self.SEED)
+        pool = [a for a in self.agents if a.skills & short_q]
+        e_cur = energy(cur)
+        best, e_best, snap = cur, e_cur, list(plan.shifts)
+        for it in range(self.ANNEAL_ITERS):
+            temp = self.T0 * (self.T1 / self.T0) ** (it / self.ANNEAL_ITERS)
+            move = self._propose(rng, pool)
+            if move is None:
+                continue
+            removes, adds = move
+            done = self._apply(removes, adds)
+            if done is None:
+                continue
+            sc = ctx.score(plan)[0]
+            e_new = energy(sc)
+            if e_new <= e_cur or rng.random() < math.exp((e_cur - e_new) / temp):
+                e_cur = e_new
+                if e_new < e_best - 1e-9:
+                    best, e_best, snap = sc, e_new, list(plan.shifts)
+            else:
+                for sh in done:
+                    plan.remove(sh)
+                for sh in removes:
+                    plan.add_back(sh)
+        plan.reset(snap)
+
+    def _propose(self, rng, pool):
+        """A random move: re-time one cell (60%), swap two agents' shifts on a day (25%), or move a shift to another
+        day (15%). Returns (shifts to remove, [(agent, queue, template, day)] to add), or None for a no-op."""
+        plan, ctx = self.plan, self.ctx
+        r = rng.random()
+        a = pool[rng.randrange(len(pool))]
+        d = self.days[rng.randrange(len(self.days))]
+        old = plan.by_day[a.agent_id].get(d)
+        if r < 0.60:
+            qs = sorted(a.skills & set(ctx.queues))
+            k = rng.randrange(1 + len(qs) * len(self.templates))
+            if k == 0:
+                return ([old], []) if old is not None else None
+            tpl, q = self.templates[(k - 1) % len(self.templates)], qs[(k - 1) // len(self.templates)]
+            if old is not None and (old.template.id, old.queue) == (tpl.id, q):
+                return None
+            return ([old] if old is not None else []), [(a, q, tpl, d)]
+        if r < 0.85:
+            b = pool[rng.randrange(len(pool))]
+            other = plan.by_day[b.agent_id].get(d)
+            if b is a or (old is None and other is None):
+                return None
+            removes = [x for x in (old, other) if x is not None]
+            adds = []
+            if other is not None:
+                adds.append((a, other.queue, other.template, d))
+            if old is not None:
+                adds.append((b, old.queue, old.template, d))
+            return removes, adds
+        if old is None:
+            return None
+        d2 = self.days[rng.randrange(len(self.days))]
+        if d2 == d:
+            return None
+        return [old], [(a, old.queue, old.template, d2)]
+
+    def _apply(self, removes, adds):
+        """Apply a move; returns the shifts added, or None (and leaves the plan as it was) if a rule or the
+        hours budget forbids it."""
+        plan = self.plan
+        for sh in removes:
+            plan.remove(sh)
+        done = []
+        for a, q, tpl, d in adds:
+            if plan.total + tpl.hours <= self.budget + 1e-9 and plan.can_take(a, q, tpl, d, self.seg[(d, tpl.id)]):
+                done.append(self._add(a, q, tpl, d))
+                continue
+            for sh in done:
+                plan.remove(sh)
+            for sh in removes:
+                plan.add_back(sh)
+            return None
+        return done
+
+    def trim(self) -> None:
+        """Hours budget (SOW 1.6) is a hard bound: while over it, drop the shift whose loss costs least."""
+        plan, ctx = self.plan, self.ctx
+        while plan.total > self.budget + 1e-9 and plan.shifts:
+            best = None
+            for sh in sorted(plan.shifts, key=lambda s: (s.segments[0][0], s.agent_id)):
+                plan.remove(sh)
+                sc = ctx.score(plan)[0]
+                plan.add_back(sh)
+                if best is None or sc[:2] < best[0][:2]:
+                    best = (sc, sh)
+            plan.remove(best[1])
+
+    def _sweep(self, pool, cur) -> bool:
+        plan, ctx = self.plan, self.ctx
+        changed = False
+        for a in pool:
+            for d in self.days:
+                old = plan.by_day[a.agent_id].get(d)
+                options = [None] + [(tpl, q) for q in sorted(a.skills & set(ctx.queues)) for tpl in self.templates]
+                for opt in options:
+                    same = (old is None and opt is None) or (
+                        old is not None and opt is not None and (opt[0].id, opt[1]) == (old.template.id, old.queue))
+                    if same:
+                        continue
+                    if old is not None:
+                        plan.remove(old)
+                    new = None
+                    if opt is not None:
+                        tpl, q = opt
+                        if plan.can_take(a, q, tpl, d, self.seg[(d, tpl.id)]) and plan.total + tpl.hours <= self.budget + 1e-9:
+                            new = self._add(a, q, tpl, d)
+                    if opt is None or new is not None:
+                        sc = ctx.score(plan)[0]
+                        if sc < cur:
+                            cur, old, changed = sc, new, True
+                            continue
+                        if new is not None:
+                            plan.remove(new)
+                    if old is not None:
+                        plan.add_back(old)
+        return changed
