+# Northwind Traders — local-time export with a UTC offset per row (America/Chicago), 30-minute grain.
+# Targets and rules come from docs/NORTHWIND_SOW.md, not from the service defaults.
+name: Northwind Traders
+interval_minutes: 30
+tz: America/Chicago
+operating_hours: [6, 24]
+queues: [priority, standard, vip]
+sla:                                   # SOW 1.2
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 20}
+  vip: {target: 0.90, seconds: 20}
+queue_hours:                           # SOW 1.4: vip contacts arrive 08:00-20:00, which are its operating intervals
+  vip: [8, 20]
+occupancy_cap: 0.85                    # SOW 1.3
+enforce_occupancy_cap: true            # WFM-212: apply the cap in the requirement (off for the older clients)
+aht_smoothing: interval                # SOW 1.2: the interval's own handle time
+queueing: erlang                       # SOW 1.2: Erlang C, no abandonment
+sla_target: 0.95                       # SOW 1.6: weekly attainment per queue
+attainment_basis: service_level
+attainment_intervals: operating        # SOW 1.6: every operating interval counts, with or without volume
+min_cover:                             # SOW 2.6: one vip agent in every interval 06:00-24:00
+  vip: {agents: 1, hours: [6, 24]}
+cross_skill_weight: 0.0                # no partial credit: an agent counts once, on the queue they are scheduled on
+scheduler: weekly                      # week-aware scheduler (rest, PT-only splits, breaks by surplus)
+min_rest_hours: 11                     # SOW 2.1
+split_shifts: PT                       # SOW 2.2: contract allowed a split shift
+hours_budget_ratio: 1.57               # SOW 1.6: scheduled hours <= ratio x required hours
+break:
+  min_shift_hours: 6
+  minutes: 20
+  window_hours: [2, 5]
+  placement: max_surplus               # SOW 2.3
+reconciliation: true                   # SOW 3: write RUNBOOK.md and exceptions.md with every run
+handover_file: docs/clients/northwind_handover.md
+runbook_files_changed:                 # repository-relative paths changed to deliver Northwind
+  - configs/northwind.yaml
+  - wfm/ingest/loader.py
+  - wfm/staffing/required.py
+  - wfm/scheduler/weekly.py
+  - wfm/evaluate/metrics.py
+  - wfm/report/reconcile.py
+  - wfm/cli.py
+  - clients/registry.yaml
+  - clients/README.md
+  - docs/clients/northwind.md
+  - docs/clients/northwind_handover.md
+  - docs/ARCHITECTURE.md
+  - docs/CHANGELOG.md
+  - tests_unit/test_northwind.py
+  - tests_unit/test_registry.py
+  - tests_unit/test_cli_subcommands.py
