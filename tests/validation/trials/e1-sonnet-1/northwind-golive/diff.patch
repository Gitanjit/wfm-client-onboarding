+                continue
+            sol.add(b, d, k, q)
+            undo += [("rm", b, d), ("add", a, d, k, q)]
+        elif r < 0.85 and sol.roster:
+            # two agents exchange their shifts on one day (changes rest/run feasibility on neighbouring days)
+            (a, d) = rng.choice(list(sol.roster))
+            same = [b for (b, dd) in sol.roster if dd == d and b != a]
+            if not same:
+                continue
+            b = rng.choice(same)
+            k1, q1 = sol.roster[(a, d)]
+            k2, q2 = sol.roster[(b, d)]
+            sol.remove(a, d)
+            sol.remove(b, d)
+            if sol.feasible(a, d, k2, q2) and sol.feasible(b, d, k1, q1):
+                sol.add(a, d, k2, q2)
+                sol.add(b, d, k1, q1)
+                undo += [("rm", b, d), ("rm", a, d), ("add", a, d, k1, q1), ("add", b, d, k2, q2)]
+            else:
+                sol.add(a, d, k1, q1)
+                sol.add(b, d, k2, q2)
+                continue
+        elif r < 0.90 and sol.roster:
+            # move the shift to another day for the same agent
+            (a, d) = rng.choice(list(sol.roster))
+            k, q = sol.roster[(a, d)]
+            d2 = rng.randrange(nD)
+            if d2 == d:
+                continue
+            sol.remove(a, d)
+            if not sol.feasible(a, d2, k, q):
+                sol.add(a, d, k, q)
+                continue
+            sol.add(a, d2, k, q)
+            undo += [("rm", a, d2), ("add", a, d, k, q)]
+        elif sol.roster:
+            # switch the queue of a multi-skilled agent's shift
+            (a, d) = rng.choice(list(sol.roster))
+            k, q = sol.roster[(a, d)]
+            others = [x for x in prob.agents[a].skills if x != q and x in prob.qi]
+            if not others:
+                continue
+            q2 = rng.choice(others)
+            sol.remove(a, d)
+            sol.add(a, d, k, q2)
+            undo += [("rm", a, d), ("add", a, d, k, q)]
+        else:
+            continue
+        new, ninfo = sol.cost()
+        if new <= cur or rng.random() < math.exp((cur - new) / temp):
+            cur, info = new, ninfo
+            if cur < best_cost - 1e-9:
+                best_cost, best_roster = cur, dict(sol.roster)
+        else:
+            for op in undo:
+                if op[0] == "rm":
+                    sol.remove(op[1], op[2])
+                else:
+                    sol.add(op[1], op[2], op[3], op[4])
+    final = Solution(prob)
+    for (a, d), (k, q) in best_roster.items():
+        final.add(a, d, k, q)
+    return final.shifts()
+
+
+_JOB: tuple = ()
+
+
+def _run(seed: int):
+    shifts, req, cfg, agents, week, iters = _JOB
+    return improve(shifts, req, cfg, agents, week, iters, seed)
+
+
+def improve_all(shifts, req, cfg, agents, week, iters: int = ITER, seeds=SEEDS) -> list[list[Shift]]:
+    """One improved roster per seed, in seed order (parallel where the platform forks; same result either way)."""
+    global _JOB
+    _JOB = (shifts, req, cfg, agents, week, iters)
+    try:
+        import multiprocessing as mp
+        ctx = mp.get_context("fork")
+        with ctx.Pool(min(len(seeds), max(1, mp.cpu_count()))) as pool:
+            return pool.map(_run, list(seeds))
+    except (ValueError, OSError, ImportError):
+        return [_run(s) for s in seeds]
