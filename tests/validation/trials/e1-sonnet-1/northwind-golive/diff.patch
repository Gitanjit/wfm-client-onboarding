+# Northwind Customer Care — SOW: docs/NORTHWIND_SOW.md (live from 2026-W44).
+# The service-level targets, occupancy cap and rules below are the contract's (SOW §1-§2), not the
+# service's defaults. Nothing here changes configs/defaults.yaml.
+name: Northwind
+interval_minutes: 30           # SOW 1.5
+tz: America/Chicago            # SOW 1.4; the export carries an explicit UTC offset per row
+operating_hours: [6, 24]       # SOW 1.4
+queues: [priority, standard, vip]   # SOW 1.1
+queue_hours: {vip: [8, 20]}    # vip contacts arrive 08:00-20:00; those are vip's operating intervals
+
+sla:                           # SOW 1.2
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 20}
+  vip: {target: 0.90, seconds: 20}
+sla_target: 0.95               # SOW 1.6: weekly attainment on each queue
+attainment_basis: service_level
+attainment_denominator: operating   # operating intervals of the queue, volume or not (SOW 1.6)
+
+occupancy_cap: 0.85            # SOW 1.3
+enforce_occupancy_cap: true    # WFM-212: the service only applies the cap when a client asks for it
+aht_smoothing: interval        # SOW 1.2: the interval's own handle time
+queueing: erlang               # SOW 1.2: Erlang C, no abandonment
+
+min_cover:                     # SOW 2.6
+  vip: {agents: 1, hours: [6, 24]}
+cross_skill_weight: 0          # SOW 2.2/1.2: an agent counts once, on the queue they are scheduled on
+
+scheduler: weekly              # wfm/scheduler/weekly.py: week state, rest, contract rules, SOW break rule
+min_rest_hours: 11             # SOW 2.1
+split_contracts: [PT]          # SOW 2.2: split shifts only for these contracts
+templates: [E8, D8, L8, N8, P6a, P6b, P4, S44]
+break_rule: surplus            # SOW 2.3: largest gross coverage surplus inside the break window
+max_efficiency: 1.57           # SOW 1.6: scheduled hours / required hours
+
+reports: sow                   # write RUNBOOK.md and exceptions.md next to the schedule (SOW 3, 2.7)
