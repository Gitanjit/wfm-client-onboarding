+def contract_audit(sched: pd.DataFrame, req: pd.DataFrame, cfg: dict, agents: list[Agent]) -> dict[str, int]:
+    """Violations of the rules a client's contract adds to the standard ones (only those the config
+    switches on): `min_rest_hours`, `split_contracts`, `break_rule: surplus`."""
+    v: dict[str, int] = {}
+    z = ZoneInfo(cfg["tz"])
+    by_id = {a.agent_id: a for a in agents}
+    s = sched.sort_values(["agent_id", "segment_start_utc", "segment_idx"]).copy()
+    s["_day"] = s["segment_start_utc"].map(lambda t: t.astimezone(z).date())
+    # a shift = one agent's segments on one local day
+    shifts = []
+    for (aid, day), g in s.groupby(["agent_id", "_day"], sort=True):
+        shifts.append((aid, day, g))
+    if cfg.get("min_rest_hours"):
+        need = timedelta(hours=float(cfg["min_rest_hours"]))
+        n = 0
+        for aid, g in s.groupby("agent_id"):
+            sh = [(gg["segment_start_utc"].min(), gg["segment_end_utc"].max()) for _, gg in g.groupby("_day")]
+            sh.sort()
+            n += sum(1 for (_, e1), (s2, _) in zip(sh, sh[1:]) if s2 - e1 < need)
+        v["rest"] = n
+    if cfg.get("split_contracts"):
+        v["split_contract"] = sum(1 for aid, _, g in shifts if len(g) > 1
+                                  and by_id[aid].contract not in cfg["split_contracts"])
+    if cfg.get("break_rule") == "surplus":
+        rule = cfg["break"]
+        step = timedelta(minutes=cfg["interval_minutes"])
+        grid = sorted(set(req["interval_start_utc"]))
+        required = {q: dict(zip(g["interval_start_utc"], g["required"])) for q, g in req.groupby("queue")}
+        gross = defaultdict(lambda: defaultdict(int))
+        for r in sched.itertuples(index=False):
+            for t in grid:
+                if r.segment_start_utc <= t < r.segment_end_utc:
+                    gross[r.queue][t] += 1
+        count = window = surplus = 0
+        for aid, _, g in shifts:
+            hours = ((g["segment_end_utc"] - g["segment_start_utc"]).dt.total_seconds() / 3600).sum()
+            brk = g[g["break_minutes"] > 0]
+            want = 1 if hours >= rule["min_shift_hours"] else 0
+            if len(brk) != want or (want and int(brk["break_minutes"].iloc[0]) != rule["minutes"]):
+                count += 1
+                continue
+            if not want:
+                continue
+            q = g["queue"].iloc[0]
+            start = g["segment_start_utc"].min()
+            b = brk["break_start_utc"].iloc[0]
+            lo, hi = rule["window_hours"]
+            length = timedelta(minutes=rule["minutes"])
+            if not (start + timedelta(hours=lo) <= b <= start + timedelta(hours=hi)) or \
+                    not any(r.segment_start_utc <= b and b + length <= r.segment_end_utc for r in g.itertuples()):
+                window += 1
+                continue
+            slot = b.floor(f"{cfg['interval_minutes']}min")
+            cands = [t for t in grid if start + timedelta(hours=lo) <= t <= start + timedelta(hours=hi)
+                     and any(r.segment_start_utc <= t and t + length <= r.segment_end_utc for r in g.itertuples())]
+            best = max(gross[q][t] - required[q].get(t, 0) for t in cands)
+            if gross[q][slot] - required[q].get(slot, 0) < best:
+                surplus += 1
+        v.update({"break_count": count, "break_window": window, "break_surplus": surplus})
+    return v
