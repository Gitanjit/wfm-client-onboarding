+            # add a shift where cover is short
+            q, i = rng.choice(shorts)
+            d = day_of[i]
+            ks = covers.get((d, i))
+            if not ks:
+                continue
+            k = rng.choice(ks)
+            cand = [a for a in range(nA) if q in prob.agents[a].skills and (a, d) not in sol.roster]
+            rng.shuffle(cand)
+            done = False
+            for a in cand[:12]:
+                if sol.feasible(a, d, k, q):
+                    sol.add(a, d, k, q)
+                    undo.append(("rm", a, d))
+                    done = True
+                    break
+            if not done:
+                continue
