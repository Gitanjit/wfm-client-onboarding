+    if snapped.any():
+        print(f"wfm: {label}: {int(snapped.sum())} rows not on a {grain_min}-minute boundary, "
+              f"moved to the interval they fall in", file=sys.stderr)
+        df = df.assign(interval_start_utc=df["interval_start_utc"].dt.floor(f"{grain_min}min"))
+    df = df.drop_duplicates()
+    df = df.drop_duplicates(["queue", "interval_start_utc"], keep="last")
+    if len(df) != n:
+        print(f"wfm: {label}: dropped {n - len(df)} duplicated rows", file=sys.stderr)
+    bad = df["volume"].isna() | (df["volume"] < 0)
+    if bad.any():
+        print(f"wfm: {label}: {int(bad.sum())} negative/missing volumes set to 0", file=sys.stderr)
+        df = df.assign(volume=df["volume"].where(~bad, 0.0))
+    return df
 
 
