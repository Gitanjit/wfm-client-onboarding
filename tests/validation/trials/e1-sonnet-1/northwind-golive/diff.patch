+    lines = [f"# Northwind weekly reconciliation - {result['week']}", "", "| key | value |", "|---|---|"]
+    lines += [f"| {k} | {v} |" for k, v in table]
+    lines += ["", HANDOVER]
+    tight = [(q, v) for q, v in sla.items() if 0 <= v - cfg["sla_target"] < 0.01]
+    if tight:
+        lines += ["## Margin", "",
+                  "Attainment is within 0.01 of the " + f"{cfg['sla_target']:.2f}" + " bound on "
+                  + ", ".join(f"`{q}` ({v:.3f})" for q, v in tight)
+                  + ". The roster for that queue is close to fully used (see the weekly-hour caps in "
+                  "`data/agents/northwind.csv`); the account team should not expect headroom for extra volume "
+                  "or absence without more agents on that queue.", ""]
+    if rows:
+        lines += ["## Targets not met (SOW §2.7)", "",
+                  "Raised with the account team; see `exceptions.md`. Weekly attainment is the fraction of "
+                  "operating intervals meeting §1.2, net of breaks.", ""]
+    (out / "RUNBOOK.md").write_text("\n".join(lines) + "\n")
+    ex = ["# Exceptions (SOW §2.7)", "", "| queue | week | achievable | shortfall |", "|---|---|---|---|"]
+    ex += [f"| {' | '.join(r)} |" for r in rows]
+    if not rows:
+        ex += ["", f"No target missed in {result['week']}."]
+    (out / "exceptions.md").write_text("\n".join(ex) + "\n")
