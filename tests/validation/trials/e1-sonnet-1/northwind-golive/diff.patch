+"""Week-aware greedy scheduler (`scheduler: weekly` in a client config).
+
+Same template-placement idea as `greedy.py`, one local day at a time, with the week state the newer
+contracts need:
+
+* hours are elapsed time (a shift is measured in UTC, so a DST day is not 24 h long);
+* rest: at least `min_rest_hours` of elapsed time between one shift's end and the agent's next start;
+* split templates only for the contracts in `split_contracts` (templates.templates_for);
+* skills, weekly caps, consecutive local days and non-overlap as in `greedy.py`;
+* breaks follow the contract rule (`break_rule: surplus`): one break per long shift, starting 2-5 h
+  after the shift starts, in the planning interval with the largest gross coverage surplus
+  (agents scheduled on the queue, breaks ignored, minus agents required).
+
+Because breaks all gravitate to the same high-surplus intervals, the scheduler checks the result net
+of breaks and adds cover where an interval ends up short (`_repair`), until attainment stops improving.
+Deterministic: fixed template order, agent ids as the tie-break.
+"""
+from __future__ import annotations
+
+import math
+from collections import defaultdict
+from datetime import date, datetime, timedelta
+from zoneinfo import ZoneInfo
+
+import pandas as pd
+
+from wfm import constraints
+from wfm.ingest.loader import local_days
+from wfm.roster import Agent
+from wfm.scheduler.greedy import Shift, _covered, _would_exceed_run
+from wfm.scheduler.templates import eligible, templates_for
+
+
+def _place(req: pd.DataFrame, extra: dict, cfg: dict, agents: list[Agent], week: str,
+           pace_h: float = 1e9, pace_d: float = 7) -> list[Shift]:
+    """One pass of template placement against required + extra. `pace_h` / `pace_d` limit how far ahead of
+    an even weekly pace an agent's hours (slack in hours) / days worked (days per week) may run, so the weekend is not left without agents
+    (the 5-consecutive-day rule makes a Mon-Fri week unable to work Saturday)."""
+    tz = cfg["tz"]
+    grain_h = cfg["interval_minutes"] / 60.0
+    caps = cfg["weekly_hours"]
+    max_run = cfg["max_consecutive_days"]
+    min_rest = timedelta(hours=float(cfg.get("min_rest_hours", 0)))
+    templates = templates_for(cfg)
+    queues = list(dict.fromkeys(req["queue"]))
+    z = ZoneInfo(tz)
+    grid = sorted(set(req["interval_start_utc"]))
+
+    required = {q: dict(zip(g["interval_start_utc"], g["required"])) for q, g in req.groupby("queue")}
+    for q in queues:
+        for t, n in extra.get(q, {}).items():
+            required[q][t] += n
+    cover = {q: defaultdict(int) for q in queues}
+    cross = {q: defaultdict(int) for q in queues}
+    floors = {q: {t: constraints.floor(q, t, cfg) for t in grid} for q in queues}
+    nskills = {a.agent_id: len(a.skills & set(queues)) for a in agents}
+
+    hours_used: dict[str, float] = defaultdict(float)
+    days_worked: dict[str, list[date]] = defaultdict(list)
+    last_end: dict[str, datetime] = {}
+    shifts: list[Shift] = []
+
+    for di, day in enumerate(local_days(week, tz)):
+        day_grid = [t for t in grid if t.astimezone(z).date() == day]
+        worked_today: set[str] = set()
+        dead: set[tuple[str, str]] = set()
+        while True:
+            best, best_val, best_dens = None, 0.0, 0.0
+            for tpl in templates:
+                segs = tpl.segments_utc(day, tz)
+                ivs = _covered(segs, day_grid)
+                if not ivs:
+                    continue
+                for q in queues:
+                    if (tpl.id, q) in dead:
+                        continue
+                    val = sum(min(1, constraints.uncovered(required[q][t], floors[q][t], cover[q][t], cross[q][t], cfg))
+                              for t in ivs)
+                    dens = val / tpl.hours
+                    if dens > best_dens + 1e-9 or (abs(dens - best_dens) <= 1e-9 and val > best_val + 1e-9):
+                        best, best_val, best_dens = (tpl, q, segs, ivs), val, dens
+            if best is None or best_val * grain_h < 0.5:
+                break
+            tpl, q, segs, ivs = best
+            hours = sum((e - s).total_seconds() for s, e in segs) / 3600.0     # elapsed
+            start = segs[0][0]
+            cands = [a for a in agents
+                     if q in a.skills and eligible(tpl, a.contract) and a.agent_id not in worked_today
+                     and hours_used[a.agent_id] + hours <= min(caps[a.contract], caps[a.contract] * (di + 1) / 7 + pace_h) + 1e-9
+                     and (a.agent_id not in last_end or start - last_end[a.agent_id] >= min_rest)
+                     and len(days_worked[a.agent_id]) + 1 <= math.ceil(pace_d * (di + 1) / 7)
+                     and not _would_exceed_run(days_worked[a.agent_id], day, max_run)]
+            if not cands:
+                dead.add((tpl.id, q))
+                continue
+            # least flexible agent first (keep multi-skilled agents for where they are needed), then fewest hours
+            a = min(cands, key=lambda x: (nskills[x.agent_id], hours_used[x.agent_id], x.agent_id))
+            shifts.append(Shift(a.agent_id, q, tpl, day, segs, ivs))
+            hours_used[a.agent_id] += hours
+            days_worked[a.agent_id].append(day)
+            last_end[a.agent_id] = segs[-1][1]
+            worked_today.add(a.agent_id)
+            for t in ivs:
+                cover[q][t] += 1
+                for other in a.skills & set(queues) - {q}:
+                    cross[other][t] += 1
+    return shifts
+
+
+def place_breaks(shifts: list[Shift], req: pd.DataFrame, cfg: dict) -> None:
+    """Contract break rule: one `break.minutes` break per shift of `min_shift_hours` or more, starting
+    `window_hours` after the shift starts, in the interval with the largest gross surplus on the
+    shift's queue. Ties go to the interval holding the fewest breaks so far (any tied interval is allowed)."""
+    rule = cfg["break"]
+    length = timedelta(minutes=rule["minutes"])
+    lo, hi = rule["window_hours"]
+    step = timedelta(minutes=cfg["interval_minutes"])
+    required = {q: dict(zip(g["interval_start_utc"], g["required"])) for q, g in req.groupby("queue")}
+    gross = defaultdict(lambda: defaultdict(int))
+    for sh in shifts:
+        for t in sh.intervals:
+            gross[sh.queue][t] += 1
+    taken = defaultdict(lambda: defaultdict(int))
+    for sh in sorted(shifts, key=lambda s: (s.segments[0][0], s.agent_id)):
+        sh.break_start, sh.break_minutes = None, 0
+        if sh.hours < rule["min_shift_hours"]:
+            continue
+        start = sh.segments[0][0]
+        fits = [t for t in sh.intervals
+                if start + timedelta(hours=lo) <= t <= start + timedelta(hours=hi)
+                and any(s <= t and t + length <= e for s, e in sh.segments)]
+        if not fits:
+            continue
+        surplus = lambda t: gross[sh.queue][t] - required[sh.queue].get(t, 0)
+        sh.break_start = min(fits, key=lambda t: (-surplus(t), taken[sh.queue][t], t))
+        sh.break_minutes = rule["minutes"]
+        taken[sh.queue][sh.break_start] += 1
+
+
+def _net_deficit(shifts: list[Shift], req: pd.DataFrame, cfg: dict) -> dict:
+    """{queue: {interval: required - scheduled net of breaks}} where positive."""
+    step = timedelta(minutes=cfg["interval_minutes"])
+    net = defaultdict(lambda: defaultdict(int))
+    for sh in shifts:
+        for t in sh.intervals:
+            net[sh.queue][t] += 1
+        if sh.break_start is not None:
+            for t in sh.intervals:
+                if sh.break_start < t + step and t < sh.break_start + timedelta(minutes=sh.break_minutes):
+                    net[sh.queue][t] -= 1
+    out: dict = {}
+    for q, g in req.groupby("queue"):
+        d = {t: int(r) - net[q][t] for t, r in zip(g["interval_start_utc"], g["required"]) if r > net[q][t]}
+        out[q] = d
+    return out
+
+
+def _score(shifts, req, cfg) -> tuple:
+    """(floor gaps, queues below target attainment, summed shortfall in intervals, hours): lower is better."""
+    deficit = _net_deficit(shifts, req, cfg)
+    target = cfg["sla_target"]
+    below, short = 0, 0.0
+    for q, g in req.groupby("queue"):
+        ops = len(_operating(g, q, cfg))
+        miss = len(deficit[q])
+        if ops and 1 - miss / ops < target - 1e-9:
+            below += 1
+        short += miss
+    hours = sum(sh.hours for sh in shifts)
+    # floors (min_cover): intervals on a floor queue with fewer scheduled than the floor, breaks aside
+    gross = defaultdict(lambda: defaultdict(int))
+    for sh in shifts:
+        for t in sh.intervals:
+            gross[sh.queue][t] += 1
+    gaps = sum(1 for q in (cfg.get("min_cover") or {}) for t in set(req["interval_start_utc"])
+               if gross[q][t] < constraints.floor(q, t, cfg))
+    return (gaps, below, short, hours)
+
+
+def _operating(g: pd.DataFrame, q: str, cfg: dict) -> list:
+    """Operating intervals of a queue (local hours, per queue override in `queue_hours`)."""
+    z = ZoneInfo(cfg["tz"])
+    lo, hi = (cfg.get("queue_hours") or {}).get(q, cfg["operating_hours"])
+    out = []
+    for t in g["interval_start_utc"]:
+        l = t.astimezone(z)
+        if lo <= l.hour + l.minute / 60 < hi:
+            out.append(t)
+    return out
+
+
+PACES = [(1e9, 5), (1e9, 5.5), (8.0, 5)]
+
+
+def schedule_week(req: pd.DataFrame, cfg: dict, agents: list[Agent], week: str, max_rounds: int = 1) -> list[Shift]:
+    best, best_score = None, None
+    for pace in PACES:
+        pace_h, pace_d = pace
+        extra: dict = {}
+        for _ in range(max_rounds):
+            shifts = _place(req, extra, cfg, agents, week, pace_h, pace_d)
+            place_breaks(shifts, req, cfg)
+            score = _score(shifts, req, cfg)
+            if best is None or score < best_score:
+                best, best_score = shifts, score
+            deficit = _net_deficit(shifts, req, cfg)
+            if not any(deficit.values()):
+                break
+            # ask for what the breaks took away, in the intervals that came out short
+            for q, d in deficit.items():
+                cur = extra.setdefault(q, {})
+                for t, n in d.items():
+                    cur[t] = cur.get(t, 0) + n
+    if cfg.get("local_search", True):
+        from wfm.scheduler import search
+        for improved in search.improve_all(best, req, cfg, agents, week):
+            place_breaks(improved, req, cfg)
+            score = _score(improved, req, cfg)
+            if score < best_score:
+                best, best_score = improved, score
+    return best
