+"""Northwind (SOW): ingest on the DST week, staffing at the SOW targets, schedule rules."""
+import pandas as pd
+from zoneinfo import ZoneInfo
+
+from wfm.config import load_config
+from wfm.evaluate.metrics import contract_audit
+from wfm.ingest.loader import load_week
+from wfm.roster import load_agents
+from wfm.scheduler import weekly
+from wfm.staffing.erlang import required_agents
+from wfm.staffing.required import add_required
+
+WEEK = "2026-W44"
+
+
+def test_dst_week_is_elapsed_length_and_offsets_are_authoritative():
+    cfg = load_config("northwind")
+    df = load_week(cfg, WEEK)
+    assert df["interval_start_utc"].nunique() == 338                  # 25-hour Sunday
+    assert set(df["queue"]) == {"priority", "standard", "vip"} and len(df) == 3 * 338
+    t = df["interval_start_utc"]
+    assert t.is_unique is False and t.min() == pd.Timestamp("2026-10-26T05:00Z") and t.max() == pd.Timestamp("2026-11-02T05:30Z")
+    assert df.groupby("queue")["volume"].sum().gt(0).all()
+
+
+def test_required_uses_sow_targets_interval_aht_and_cap():
+    cfg = load_config("northwind")
+    df = pd.DataFrame({"queue": ["vip", "vip"], "interval_start_utc": pd.to_datetime(["2026-10-26T15:00Z", "2026-10-26T15:30Z"]),
+                       "volume": [10.0, 10.0], "aht_sec": [300.0, 600.0]})
+    req = add_required(df, cfg)
+    assert list(req["required"]) == [required_agents(10, 1800, 300, 0.90, 20, 0.85),
+                                     required_agents(10, 1800, 600, 0.90, 20, 0.85)]
+    assert req["required"].iloc[0] < req["required"].iloc[1]
+
+
+def test_defaults_untouched_for_other_clients():
+    assert load_config("contoso").get("enforce_occupancy_cap") is None
+    assert load_config("northwind")["sla"]["vip"] == {"target": 0.90, "seconds": 20}
+
+
+def test_week_schedule_obeys_contract_rules():
+    cfg = load_config("northwind")
+    req = add_required(load_week(cfg, WEEK), cfg)
+    agents = load_agents("northwind")
+    shifts = weekly._place(req, {}, cfg, agents, WEEK, 1e9, 5)
+    weekly.place_breaks(shifts, req, cfg)
+    from wfm.scheduler.greedy import to_frame
+    sched = to_frame(shifts)
+    sched["segment_start_utc"] = pd.to_datetime(sched["segment_start_utc"], utc=True)
+    sched["segment_end_utc"] = pd.to_datetime(sched["segment_end_utc"], utc=True)
+    sched["break_start_utc"] = pd.to_datetime(sched["break_start_utc"], utc=True)
+    v = contract_audit(sched, req, cfg, agents)
+    assert v == {"rest": 0, "split_contract": 0, "break_count": 0, "break_window": 0, "break_surplus": 0}
+    z = ZoneInfo(cfg["tz"])
+    assert all(s.template.segments[0][0] >= 6 for s in shifts)
