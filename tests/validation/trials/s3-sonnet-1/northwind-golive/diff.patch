+"""Weekly reconciliation report (Northwind SOW §3): out/<client>/RUNBOOK.md.
+
+Figures are recomputed here from the required curve and the schedule that was written to disk, not
+taken from the scheduler's own bookkeeping. Written for clients whose config sets `runbook: true`.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+from zoneinfo import ZoneInfo
+
+import pandas as pd
+
+from wfm.config import APP_DIR
+from wfm.evaluate.metrics import _parse, coverage
+
+
+def reconcile(req: pd.DataFrame, sched: pd.DataFrame, cfg: dict) -> dict[str, str]:
+    sched = _parse(sched)
+    grain = cfg["interval_minutes"]
+    h = grain / 60.0
+    grid = sorted(set(req["interval_start_utc"]))
+    gross, on_break = coverage(sched, grid, grain)
+    z = ZoneInfo(cfg["tz"])
+    open_h, close_h = cfg["operating_hours"]
+    row = {"intervals_in_week": str(len(grid))}
+    under = 0.0
+    for q in ("priority", "standard"):
+        g = req[req["queue"] == q]
+        met = ops = 0
+        for r in g.itertuples(index=False):
+            have = gross[q][r.interval_start_utc] - on_break[q][r.interval_start_utc]
+            under += max(0, r.required - have) * h
+            if open_h <= r.interval_start_utc.astimezone(z).hour < close_h:
+                ops += 1
+                met += have >= r.required
+        row[f"sla_attainment_{q}"] = f"{met / ops:.3f}" if ops else "1.000"
+    hours = ((sched["segment_end_utc"] - sched["segment_start_utc"]).dt.total_seconds() / 3600).sum()
+    row["scheduled_hours_total"] = f"{hours:.1f}"
+    row["required_hours_total"] = f"{req['required'].sum() * h:.1f}"
+    row["understaffed_interval_hours"] = f"{under:.1f}"
+    row["agents_scheduled"] = str(sched["agent_id"].nunique())
+    row["files_changed"] = ", ".join(cfg.get("runbook_files_changed", []))
+    return row
+
+
+def write_runbook(req: pd.DataFrame, sched: pd.DataFrame, cfg: dict, week: str, out_dir: Path) -> None:
+    rows = reconcile(req, sched, cfg)
+    table = "\n".join(["| key | value |", "|---|---|"] + [f"| {k} | {v} |" for k, v in rows.items()])
+    notes_file = cfg.get("runbook_notes_file")
+    notes = (APP_DIR / notes_file).read_text() if notes_file else ""
+    (out_dir / "RUNBOOK.md").write_text(
+        f"# {cfg.get('name', cfg['client'])} — weekly reconciliation, {week}\n\n{table}\n\n{notes}")
