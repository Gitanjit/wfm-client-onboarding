+from wfm.scheduler.templates import Template, templates_for
+
+MAX_REPAIR_ROUNDS = 400
+
+
+class _Week:
+    """Per-agent state for the week, so every rule can be checked against the whole schedule."""
+
+    def __init__(self, cfg: dict, tz: str):
+        self.caps = cfg["weekly_hours"]
+        self.max_run = cfg["max_consecutive_days"]
+        self.rest = timedelta(hours=float(cfg.get("min_rest_hours", 0)))
+        self.split_ok = cfg.get("split_shift_contracts")      # None: every contract
+        self.hours: dict[str, float] = defaultdict(float)
+        self.days: dict[str, set[date]] = defaultdict(set)
+        self.spans: dict[str, list[tuple[datetime, datetime]]] = defaultdict(list)
+
+    def feasible(self, a: Agent, tpl: Template, day: date, segs, queue: str) -> bool:
+        if queue not in a.skills or day in self.days[a.agent_id]:
+            return False
+        if tpl.is_split and self.split_ok is not None and a.contract not in self.split_ok:
+            return False
+        hrs = sum((e - s).total_seconds() for s, e in segs) / 3600.0
+        if self.hours[a.agent_id] + hrs > self.caps[a.contract] + 1e-9:
+            return False
+        worked = self.days[a.agent_id] | {day}
+        run, d = 1, day - timedelta(days=1)
+        while d in worked:
+            run, d = run + 1, d - timedelta(days=1)
+        d = day + timedelta(days=1)
+        while d in worked:
+            run, d = run + 1, d + timedelta(days=1)
+        if run > self.max_run:
+            return False
+        start, end = segs[0][0], segs[-1][1]
+        for s0, e0 in self.spans[a.agent_id]:
+            if e0 <= start:
+                if start - e0 < self.rest:
+                    return False
+            elif s0 >= end:
+                if s0 - end < self.rest:
+                    return False
+            else:
+                return False
