+# Litware — local-time export (Europe/London, explicit UTC offset, rows stamped with interval END),
+# 20-minute grain, three queues. Service levels, occupancy cap and rules come from docs/LITWARE_SOW.md.
+name: Litware
+interval_minutes: 20          # SOW 1.5
+tz: Europe/London
+operating_hours: [7, 21]      # SOW 1.4 (email only receives contacts 07:00-19:00; the export carries zeros)
+queues: [priority, standard, email]   # SOW 1.1
+occupancy_cap: 0.85           # SOW 1.3
+aht_smoothing: interval       # SOW 1.2: the interval's own average handle time
+sla:                          # SOW 1.2
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 30}
+  email: {target: 0.80, seconds: 300}
+sla_target: 0.95              # SOW 1.6: weekly attainment per queue
+scheduler: week_aware         # wfm/scheduler/greedy_v2.py
+min_rest_hours: 11            # SOW 2.1, elapsed time between shifts
+split_shift_contracts: [PT]   # SOW 2.2
+exclude_templates: [S44]      # no split shifts: SOW 2.3 does not say whether two 4 h segments are one shift of 8 h
+break_placement: surplus      # SOW 2.3
+min_staffed: {priority: 2}    # SOW 2.4, breaks aside
+earliest_start: {email: 9}    # SOW 2.5, local hour: no agent on email before 09:00
+exceptions: true              # SOW 2.6 / 3: list infeasible intervals instead of breaking a rule
+max_hours_ratio: 1.45         # SOW 1.6, scheduled hours / required hours
+runbook: true                 # write out/litware/RUNBOOK.md (SOW 3) with every run
+runbook_notes_file: docs/litware_runbook_notes.md
+attainment: operating         # eval.json attainment over every operating interval, as SOW 1.6 defines it
+runbook_files_changed:
+  - configs/litware.yaml
+  - wfm/ingest/loader.py
+  - wfm/staffing/required.py
+  - wfm/scheduler/greedy_v2.py
+  - wfm/scheduler/templates.py
+  - wfm/evaluate/metrics.py
+  - wfm/runbook.py
+  - tests_unit/test_litware.py
+  - docs/ARCHITECTURE.md
+  - docs/CHANGELOG.md
+  - docs/litware_runbook_notes.md
