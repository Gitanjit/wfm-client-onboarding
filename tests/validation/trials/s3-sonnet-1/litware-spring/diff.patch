+def _break_audit(sched: pd.DataFrame, cfg: dict, req: pd.DataFrame, shifts: pd.DataFrame) -> tuple[int, int]:
+    """Breaks outside the 2-5 h window, and breaks not in the interval of largest gross surplus within it."""
+    rule = cfg["break"]
+    grain = cfg["interval_minutes"]
+    step = timedelta(minutes=grain)
+    length = timedelta(minutes=rule["minutes"])
+    lo, hi = (timedelta(hours=h) for h in rule["window_hours"])
+    grid = sorted(set(req["interval_start_utc"]))
+    gross, _ = coverage(sched, grid, grain)
+    required = {(r.queue, r.interval_start_utc): r.required for r in req.itertuples(index=False)}
+    z = ZoneInfo(cfg["tz"])
+    sched = sched.assign(day=sched["segment_start_utc"].dt.tz_convert(z).dt.date)
+    out_of_window = not_max = 0
+    for (_aid, _day), g in sched.groupby(["agent_id", "day"]):
+        b = g[g["break_minutes"] > 0]
+        if b.empty:
+            continue
+        start = g["segment_start_utc"].min()
+        q = g["queue"].iloc[0]
+        t = b["break_start_utc"].iloc[0]
+        if not (start + lo <= t <= start + hi):
+            out_of_window += 1
+            continue
+        fits = [x for x in grid if start + lo <= x <= start + hi
+                and any(r.segment_start_utc <= x and x + length <= r.segment_end_utc for r in g.itertuples())]
+        surplus = lambda x: gross[q][x] - required.get((q, x), 0)
+        if fits and surplus(t) < max(surplus(x) for x in fits):
+            not_max += 1
+    return out_of_window, not_max
+
+
+def _floor_audit(sched: pd.DataFrame, cfg: dict, req: pd.DataFrame) -> int:
+    """Operating intervals with fewer agents on a queue than its `min_staffed` floor (breaks aside)."""
+    grid = sorted(set(req["interval_start_utc"]))
+    gross, _ = coverage(sched, grid, cfg["interval_minutes"])
+    z = ZoneInfo(cfg["tz"])
+    open_h, close_h = cfg["operating_hours"]
+    bad = 0
+    for q, n in cfg["min_staffed"].items():
+        for t in grid:
+            if open_h <= t.astimezone(z).hour < close_h and gross[q][t] < n:
+                bad += 1
+    return bad
