+def _floor(df: pd.DataFrame, cfg: dict) -> pd.Series:
+    """Minimum agents on a queue in every operating interval, whatever the volume (`min_staffed`, e.g.
+    Litware SOW 2.4: two on `priority`). A scheduling rule, kept apart from `required`: it is not part of
+    the Erlang C requirement that the SLA and the required-hours figures are measured against."""
+    rules = cfg.get("min_staffed") or {}
+    floor = pd.Series(0, index=df.index)
+    if not rules:
+        return floor
+    open_h, close_h = cfg["operating_hours"]
+    hour = df["interval_start_utc"].dt.tz_convert(ZoneInfo(cfg["tz"])).dt.hour
+    operating = (hour >= open_h) & (hour < close_h)
+    for q, n in rules.items():
+        floor[(df["queue"] == q) & operating] = int(n)
+    return floor
+
