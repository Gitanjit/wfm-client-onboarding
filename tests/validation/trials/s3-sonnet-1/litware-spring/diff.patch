+def structural_exceptions(df: pd.DataFrame, cfg: dict) -> set[tuple[str, pd.Timestamp]]:
+    """(queue, interval_start_utc) pairs whose target the scheduling rules make impossible to meet
+    (Litware SOW 2.6): intervals with demand that start before a queue's `earliest_start` local hour
+    (SOW 2.5, nobody may be scheduled on email before 09:00). They are reported, not covered."""
+    rules = cfg.get("earliest_start") or {}
+    if not rules or not cfg.get("exceptions"):
+        return set()
+    z = ZoneInfo(cfg["tz"])
+    out = set()
+    for q, hour in rules.items():
+        g = df[(df["queue"] == q) & (df["required"] > 0)]
+        local = g["interval_start_utc"].dt.tz_convert(z)
+        early = (local.dt.hour + local.dt.minute / 60.0) < float(hour)
+        out.update((q, t) for t in g.loc[early, "interval_start_utc"])
+    return out
