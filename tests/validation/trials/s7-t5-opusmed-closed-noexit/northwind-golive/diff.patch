-    """Intervals where a `min_cover` queue has less cover than its floor (see wfm/constraints.py)."""
+def operating_mask(times, queue: str, cfg: dict) -> list[bool]:
+    lo, hi = (cfg.get("queue_hours") or {}).get(queue, cfg["operating_hours"])
+    z = ZoneInfo(cfg["tz"])
+    out = []
+    for t in times:
+        loc = t.astimezone(z)
+        out.append(lo <= loc.hour + loc.minute / 60 < hi)
+    return out
