+# Northwind Traders — local-time export with a UTC offset per row, US Central. Go-live 2026-W44.
+# Contract: docs/NORTHWIND_SOW.md. Every key below describes what the service does for Northwind.
+name: Northwind Traders
+interval_minutes: 30                 # SOW 1.5
+tz: America/Chicago                  # SOW 1.4
+operating_hours: [6, 24]             # SOW 1.4
+queue_hours: {vip: [8, 20]}          # SOW 1.4: vip operating intervals (contacts arrive 08:00-20:00)
+sla:                                 # SOW 1.2
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 20}
+  vip: {target: 0.90, seconds: 20}
+occupancy_cap: 0.85                  # SOW 1.3
+aht_smoothing: interval              # SOW 1.2: the interval's own average handle time
+queueing: erlang                     # SOW 1.2: Erlang C, no abandonment
+sla_target: 0.95                     # SOW 1.6: weekly attainment per queue
+attainment_basis: service_level      # SOW 1.2
+attainment_intervals: operating      # SOW 1.6: denominator is operating intervals, not intervals with volume
+min_cover:                           # SOW 2.6: one agent on vip, net of breaks, 06:00-24:00
+  vip: {agents: 1, hours: [6, 24]}
+cross_skill_weight: 0                # SOW 1.2: a person counts once, on the queue they are scheduled on
+floor_net_of_breaks: true            # SOW 2.6
+scheduler: week                      # wfm/scheduler/week.py: rest, PT-only splits, SOW 2.3 breaks
+min_rest_hours: 11                   # SOW 2.1
+split_contracts: [PT]                # SOW 2.2
+break_placement: surplus             # SOW 2.3
+efficiency_cap: 1.57                 # SOW 1.6: scheduled hours <= 1.57 x required hours
+weekly_hours: {FT: 40, PT: 24}       # SOW 2.4
+max_consecutive_days: 5              # SOW 2.4
+break: {min_shift_hours: 6, minutes: 20, window_hours: [2, 5]}   # SOW 2.3
+runbook: true                        # SOW 3: out/northwind/RUNBOOK.md every run
+golive_week: 2026-W44
