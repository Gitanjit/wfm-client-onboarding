+"""Week-aware template scheduler (`scheduler: week` in a client config). Northwind is its first user.
+
+It places the same templates as `greedy.py` and writes the same `Shift`s. What it adds:
+
+* the rules are enforced while placing, for the whole week:
+  - `min_rest_hours`: elapsed rest between the end of one shift and the start of the next, both ways;
+  - `split_contracts`: only these contracts may take a split template;
+  - weekly elapsed-hour caps, `max_consecutive_days`, skills, one template per local day;
+* breaks per `break_placement: surplus`: each long shift's break starts in its break window, in the
+  interval where the queue's gross coverage surplus (agents on the queue ignoring breaks, minus
+  required agents) is largest. Gross cover does not depend on breaks, so each break is fixed by the
+  shifts alone; among tied intervals the scheduler picks the one where the break costs least;
+* cover is counted net of breaks: an agent on break during an interval does not count in it;
+* `min_cover` floors are met net of breaks when `floor_net_of_breaks` is set, with
+  `cross_skill_weight` applied as configured (0 for clients whose contract counts a person once);
+* after a greedy fill it repairs intervals that breaks left short and then drops shifts that are not
+  needed for the attainment target (`sla_target`) or the floors, so scheduled hours stay low
+  (`efficiency_cap`: scheduled hours / required hours).
+
+Deterministic: fixed template order, then agent ids, break the ties.
+"""
+from __future__ import annotations
+
+from collections import defaultdict
+from datetime import date, datetime, timedelta
+from zoneinfo import ZoneInfo
+
+import math
+import random
+
+import numpy as np
+import pandas as pd
+
+from wfm import constraints
+from wfm.ingest.loader import local_days
+from wfm.roster import Agent
+from wfm.scheduler.greedy import Shift
+from wfm.scheduler.templates import Template, templates_for
+
+ATTAINMENT_MARGIN = 0.01   # aim this far above the configured attainment target
+
+
+def operating_mask(grid, queue: str, cfg: dict) -> list[bool]:
+    """Operating intervals of a queue: `queue_hours[queue]` if set, else `operating_hours` (local)."""
+    lo, hi = (cfg.get("queue_hours") or {}).get(queue, cfg["operating_hours"])
+    z = ZoneInfo(cfg["tz"])
+    out = []
+    for t in grid:
+        loc = t.astimezone(z)
+        h = loc.hour + loc.minute / 60
+        out.append(lo <= h < hi)
+    return out
+
+
+class _Cand:
+    """A (local day, template, queue) placement."""
+    __slots__ = ("day", "tpl", "queue", "segs", "ivs", "start", "end", "hours", "windows", "edge")
+
+    def __init__(self, day, tpl, queue, segs, ivs, windows, edge=None):
+        self.day, self.tpl, self.queue, self.segs, self.ivs = day, tpl, queue, segs, ivs
+        self.start, self.end = segs[0][0], segs[-1][1]
+        self.hours = sum((e - s).total_seconds() for s, e in segs) / 3600.0
+        self.windows = windows   # interval indices where the break may start (empty: no break)
+        self.edge = edge         # the interval starting exactly at the window's far end, if on shift
+
+
+class WeekScheduler:
+    def __init__(self, req: pd.DataFrame, cfg: dict, agents: list[Agent], week: str):
+        self.cfg = cfg
+        self.agents = sorted(agents, key=lambda a: a.agent_id)
+        self.week = week
+        tz = cfg["tz"]
+        self.z = ZoneInfo(tz)
+        self.grain = cfg["interval_minutes"]
+        self.h = self.grain / 60.0
+        self.grid = [t.to_pydatetime() for t in sorted(set(req["interval_start_utc"]))]
+        self.idx = {t: i for i, t in enumerate(self.grid)}
+        self.n = len(self.grid)
+        self.queues = list(dict.fromkeys(req["queue"]))
+        self.req = {q: [0] * self.n for q in self.queues}
+        for r in req.itertuples(index=False):
+            self.req[r.queue][self.idx[r.interval_start_utc.to_pydatetime()]] = int(r.required)
+        self.floor = {q: [constraints.floor(q, t, cfg) for t in self.grid] for q in self.queues}
+        self.op = {q: operating_mask(self.grid, q, cfg) for q in self.queues}
+        self.n_op = {q: max(1, sum(self.op[q])) for q in self.queues}
+        self._req_np = {q: np.asarray(self.req[q]) for q in self.queues}
+        self._op_np = {q: np.asarray(self.op[q], dtype=bool) for q in self.queues}
+        self._floor_np = {q: np.asarray(self.floor[q]) for q in self.queues}
+        self._has_floor = {q: any(self.floor[q]) for q in self.queues}
+        self.target = float(cfg.get("sla_target", 0.0)) + ATTAINMENT_MARGIN
+        self.caps = cfg["weekly_hours"]
+        self.max_run = cfg["max_consecutive_days"]
+        self.rest = timedelta(hours=float(cfg.get("min_rest_hours", 0) or 0))
+        self.split_ok = set(cfg.get("split_contracts") or ["FT", "PT"])
+        self.cross_w = constraints.weight(cfg)
+        self.floor_net = bool(cfg.get("floor_net_of_breaks", False))
+        brk = cfg["break"]
+        self.brk_min_h = brk["min_shift_hours"]
+        self.brk_len = timedelta(minutes=brk["minutes"])
+        self.brk_lo, self.brk_hi = (timedelta(hours=x) for x in brk.get("window_hours", [2, 5]))
+        self.req_hours = sum(sum(v) for v in self.req.values()) * self.h
+        eff = cfg.get("efficiency_cap")
+        self.max_hours = eff * self.req_hours if eff else float("inf")
+        self.cands = self._candidates(templates_for(cfg))
+        # scarcity per queue: hours it needs over the hours its skilled agents can give
+        cap_h = {q: sum(self.caps[a.contract] for a in self.agents if q in a.skills) for q in self.queues}
+        need_h = {q: sum(max(r, f) for r, f in zip(self.req[q], self.floor[q])) * self.h for q in self.queues}
+        self.scarcity = {q: need_h[q] / cap_h[q] if cap_h[q] else float("inf") for q in self.queues}
+        # state
+        self.shifts: list[tuple[Agent, _Cand]] = []
+        self.gross = {q: [0] * self.n for q in self.queues}
+        self.cross = {q: [0] * self.n for q in self.queues}
+        self.agent_shifts: dict[str, list[_Cand]] = defaultdict(list)
+
+    # ---- candidates and rules -------------------------------------------------------------------
+    def _candidates(self, templates: list[Template]) -> list[_Cand]:
+        out = []
+        for day in local_days(self.week, self.cfg["tz"]):
+            for tpl in templates:
+                segs = tpl.segments_utc(day, self.cfg["tz"])
+                ivs = [self.idx[t] for s, e in segs for t in self.grid if s <= t < e]
+                if not ivs:
+                    continue
+                hours = sum((e - s).total_seconds() for s, e in segs) / 3600.0
+                windows, edge = [], None
+                if hours >= self.brk_min_h:
+                    # "starts between two and five hours after the shift starts": the break starts in
+                    # [2 h, 5 h). The interval at exactly 5 h is kept as `edge`: the scheduler never lets
+                    # it have a strictly larger surplus than the chosen one, so the placement is right
+                    # whether the window is read as closed or half-open.
+                    st = segs[0][0]
+                    fits = [i for i in ivs if any(s <= self.grid[i] and self.grid[i] + self.brk_len <= e
+                                                  for s, e in segs)]
+                    windows = [i for i in fits if st + self.brk_lo <= self.grid[i] < st + self.brk_hi]
+                    edge = next((i for i in fits if self.grid[i] == st + self.brk_hi), None)
+                for q in self.queues:
+                    out.append(_Cand(day, tpl, q, segs, ivs, windows, edge))
+        return out
+
+    def _hours(self, aid: str) -> float:
+        return sum(c.hours for c in self.agent_shifts[aid])
+
+    def can_take(self, a: Agent, c: _Cand) -> bool:
+        if c.queue not in a.skills:
+            return False
+        if c.tpl.is_split and a.contract not in self.split_ok:
+            return False
+        mine = self.agent_shifts[a.agent_id]
+        if any(o.day == c.day for o in mine):
+            return False
+        if self._hours(a.agent_id) + c.hours > self.caps[a.contract] + 1e-9:
+            return False
+        for o in mine:   # elapsed rest both ways; also rules out overlap
+            if not (o.end + self.rest <= c.start or c.end + self.rest <= o.start):
+                return False
+        days = {o.day for o in mine} | {c.day}
+        run = 1
+        d = c.day - timedelta(days=1)
+        while d in days:
+            run += 1
+            d -= timedelta(days=1)
+        d = c.day + timedelta(days=1)
+        while d in days:
+            run += 1
+            d += timedelta(days=1)
+        return run <= self.max_run
+
+    def _pick_agent(self, c: _Cand) -> Agent | None:
+        ok = [a for a in self.agents if self.can_take(a, c)]
+        if not ok:
+            return None
+        # keep agents for scarce queues free: least scarcity in their other skills, then the least-used
+        def key(a):
+            other = sum(self.scarcity[q] for q in a.skills if q in self.scarcity and q != c.queue)
+            return (round(other, 6), self._hours(a.agent_id) / self.caps[a.contract], a.agent_id)
+        return min(ok, key=key)
+
+    def _add(self, a: Agent, c: _Cand) -> None:
+        self.shifts.append((a, c))
+        self.agent_shifts[a.agent_id].append(c)
+        for i in c.ivs:
+            self.gross[c.queue][i] += 1
+            for o in a.skills & set(self.queues) - {c.queue}:
+                self.cross[o][i] += 1
+
+    def _remove(self, k: int) -> None:
+        a, c = self.shifts.pop(k)
+        self.agent_shifts[a.agent_id].remove(c)
+        for i in c.ivs:
+            self.gross[c.queue][i] -= 1
+            for o in a.skills & set(self.queues) - {c.queue}:
+                self.cross[o][i] -= 1
+
+    def total_hours(self) -> float:
+        return sum(c.hours for _, c in self.shifts)
+
+    # ---- breaks and net cover -------------------------------------------------------------------
+    def breaks(self) -> list[int | None]:
+        """Break interval per shift (None: no break): the largest gross surplus in the window;
+        among ties, the interval where the queue has most net slack so far."""
+        out: list[int | None] = [None] * len(self.shifts)
+        taken = {q: [0] * self.n for q in self.queues}
+        sur = {q: [g - r for g, r in zip(self.gross[q], self.req[q])] for q in self.queues}
+        order = sorted(range(len(self.shifts)), key=lambda k: (self.shifts[k][1].start, self.shifts[k][0].agent_id))
+        for k in order:
+            _, c = self.shifts[k]
+            if not c.windows:
+                continue
+            q, g, r, su = c.queue, self.gross[c.queue], self.req[c.queue], sur[c.queue]
+            best = max(su[i] for i in c.windows)
+            ties = [i for i in c.windows if su[i] == best]
+            if c.edge is not None and su[c.edge] > best:
+                ties = [c.edge]   # closed window: the 5 h interval has the largest surplus (see `amb`)
+            f = self.floor[q]
+            i = ties[0] if len(ties) == 1 else max(ties, key=lambda i: (g[i] - taken[q][i] - max(r[i], f[i]), -i))
+            out[k] = i
+            taken[q][i] += 1
+        return out
+
+    def net(self, brk) -> dict[str, list[int]]:
+        net = {q: list(self.gross[q]) for q in self.queues}
+        for (_, c), i in zip(self.shifts, brk):
+            if i is not None:
+                net[c.queue][i] -= 1
+        return net
+
+    def status(self):
+        """(attainment per queue, floor gaps, net cover). Also sets `self.amb`: breaks that must start
+        exactly 5 h in (largest surplus there), which a half-open reading of the window would reject."""
+        brk = self.breaks()
+        net = self.net(brk)
+        att, gaps = {}, 0
+        self.amb = sum(1 for (_, c), i in zip(self.shifts, brk) if i is not None and i == c.edge)
+        self.deficit = 0
+        for q in self.queues:
+            n_q = np.asarray(net[q])
+            r, op = self._req_np[q], self._op_np[q]
+            att[q] = int(((n_q >= r) & op).sum()) / self.n_op[q]
+            self.deficit += int((np.maximum(0, r - n_q) * op).sum())
+            if self._has_floor[q]:
+                on_q = n_q if self.floor_net else np.asarray(self.gross[q])
+                cov = on_q + self.cross_w * np.asarray(self.cross[q])
+                gaps += int((cov < self._floor_np[q]).sum())
+        return att, gaps, net
+
+    def ok(self, att, gaps) -> bool:
+        return gaps == 0 and all(v >= self.target - 1e-12 for v in att.values())
+
+    # ---- phases ---------------------------------------------------------------------------------
+    def _deficit(self, q: str, i: int, cover: list[int]) -> float:
+        on_q = cover[i]
+        return constraints.uncovered(self.req[q][i], self.floor[q][i], on_q, self.cross[q][i], self.cfg)
+
+    SCARCE = 0.5   # a queue whose skilled agents must give more than this share of their hours
+
+    def _best(self, cover: dict[str, list[int]], min_useful_h: float, queues=None):
+        """Best candidate that some agent can take. On a scarce queue agent-days are the limit, so the
+        score is useful hours; elsewhere it is useful hours per scheduled hour."""
+        scored = []
+        for c in self.cands:
+            if queues is not None and c.queue not in queues:
+                continue
+            cv = cover[c.queue]
+            useful = sum(min(1.0, self._deficit(c.queue, i, cv)) for i in c.ivs) * self.h
+            if useful + 1e-9 >= min_useful_h:
+                ratio = useful / c.hours
+                main = useful if self.scarcity[c.queue] >= self.SCARCE else ratio
+                scored.append((-main, -ratio, -useful, c.start, c.tpl.id, c.queue, c))
+        scored.sort(key=lambda s: s[:6])
+        for s in scored:
+            a = self._pick_agent(s[-1])
+            if a is not None:
+                return a, s[-1]
+        return None
+
+    def fill(self, queues=None) -> None:
+        """Greedy fill against gross cover (breaks ignored), scarcest queue first."""
+        for q in sorted(queues or self.queues, key=lambda q: -self.scarcity[q]):
+            while self.total_hours() < self.max_hours:
+                best = self._best(self.gross, min_useful_h=self.h * 2, queues={q})
+                if best is None:
+                    break
+                self._add(*best)
+
+    def repair(self, queues=None, max_steps: int = 400) -> None:
+        """Add shifts where cover net of breaks is short, until the targets and floors are met (or
+        the efficiency cap is reached)."""
+        queues = set(queues or self.queues)
+        for _ in range(max_steps):
+            att, gaps, net = self.status()
+            if self.ok({q: v for q, v in att.items() if q in queues}, gaps) or self.total_hours() >= self.max_hours:
+                return
+            best = self._best(net, min_useful_h=self.h, queues=queues)
+            if best is None:
+                return
+            self._add(*best)
+
+    def prune(self) -> None:
+        """Drop shifts (least useful first) while every queue stays at or above its attainment target
+        (or what it has now, if that is lower), the floors hold and nothing gets worse."""
+        att0, gaps0, _ = self.status()
+        amb0 = self.amb
+        floor_att = {q: min(self.target, att0[q]) for q in self.queues}
+        keeps = lambda att, gaps: gaps <= gaps0 and self.amb <= amb0 and \
+            all(att[q] >= floor_att[q] - 1e-12 for q in self.queues)
+        changed = True
+        while changed:
+            changed = False
+            att, gaps, net = self.status()
+            def spare(k):
+                a, c = self.shifts[k]
+                surplus = sum(net[c.queue][i] - max(self.req[c.queue][i], self.floor[c.queue][i]) for i in c.ivs)
+                return (-surplus / len(c.ivs), -c.hours, c.start, a.agent_id)
+            for k in sorted(range(len(self.shifts)), key=spare):
+                a, c = self.shifts[k]
+                self._remove(k)
+                att2, gaps2, _ = self.status()
+                if keeps(att2, gaps2):
+                    changed = True
+                    break
+                self._add(a, c)   # put back (appended at the end; order does not matter)
+                self.shifts.insert(k, self.shifts.pop())
+
+    # ---- local search -----------------------------------------------------------------------------
+    SHORT_W, DEFICIT_W, OVER_W, GAP_W, AMB_W = 200.0, 2.0, 1e4, 1e6, 300.0
+
+    def cost(self) -> float:
+        """Floor gaps, hours over the efficiency cap and intervals short of the attainment target
+        dominate; net agent-intervals short (a gradient) and scheduled hours break the rest."""
+        att, gaps, net = self.status()
+        short = 0.0
+        for q in self.queues:
+            need = math.ceil(self.target * self.n_op[q] - 1e-9)
+            short += max(0, need - round(att[q] * self.n_op[q]))
+        deficit = self.deficit
+        over = max(0.0, self.total_hours() - self.max_hours)
+        return self.GAP_W * gaps + self.OVER_W * over + self.SHORT_W * short + self.DEFICIT_W * deficit \
+            + self.AMB_W * self.amb \
+            + self.total_hours()
+
+    def improve(self, iters: int, seed: int = 0, t0: float = 6.0, focus: set[str] | None = None) -> None:
+        """Simulated annealing on `cost` (seeded, so deterministic) with moves: re-template, move to
+        another day, reassign to another agent, drop, or add a shift. Ends on the best state seen.
+        `focus`: only shifts on, and placements for, these queues (and agents holding one of them)."""
+        rng = random.Random(seed)
+        cands = [c for c in self.cands if focus is None or c.queue in focus]
+        agents = [a for a in self.agents if focus is None or a.skills & focus]
+        by_day = defaultdict(list)
+        for c in cands:
+            by_day[c.day].append(c)
+        days = sorted(by_day)
+        cur = best = self.cost()
+        best_state = list(self.shifts)
+        for it in range(iters):
+            temp = t0 * (1 - it / iters) + 1e-3
+            mv = rng.random()
+            undo = None
+            new_a = new_c = None
+            movable = [k for k, (_, c) in enumerate(self.shifts) if focus is None or c.queue in focus]
+            if movable and mv < 0.75:
+                k = rng.choice(movable)
+                a, c = self.shifts[k]
+                if mv < 0.35:
+                    new_a, new_c = a, rng.choice(by_day[c.day])
+                elif mv < 0.55:
+                    new_a, new_c = a, rng.choice(by_day[rng.choice(days)])
+                elif mv < 0.65:
+                    new_a, new_c = rng.choice(agents), c
+                self._remove(k)
+                undo = (a, c)
+                if new_a is not None:
+                    if not self.can_take(new_a, new_c):
+                        self._add(a, c)
+                        continue
+                    self._add(new_a, new_c)
+            else:
+                new_a, new_c = rng.choice(agents), rng.choice(cands)
+                if not self.can_take(new_a, new_c):
+                    continue
+                self._add(new_a, new_c)
+            val = self.cost()
+            if val <= cur + 1e-9 or rng.random() < math.exp(-(val - cur) / temp):
+                cur = val
+                if val < best - 1e-9:
+                    best, best_state = val, list(self.shifts)
+                continue
+            if new_a is not None:
+                self._remove(len(self.shifts) - 1)
+            if undo is not None:
+                self._add(*undo)
+        self._load(best_state)
+
+    def _load(self, state) -> None:
+        while self.shifts:
+            self._remove(len(self.shifts) - 1)
+        for a, c in state:
+            self._add(a, c)
+
+    def run(self) -> list[Shift]:
+        iters = int(self.cfg.get("search_iterations", 60000))
+        scarce = {q for q in self.queues if self.scarcity[q] >= self.SCARCE}
+        if scarce:   # the queues short of skilled agents first, while every agent is still free
+            self.fill(scarce)
+            self.repair(scarce)
+            start, best, best_cost = list(self.shifts), None, float("inf")
+            for seed in range(1, 1 + int(self.cfg.get("search_restarts", 1))):
+                self._load(start)
+                self.improve(iters // 2, seed=seed, focus=scarce)
+                c = self.cost()
+                if c < best_cost - 1e-9:
+                    best, best_cost = list(self.shifts), c
+            self._load(best)
+        self.fill()
+        self.repair()
+        self.improve(iters)
+        self.prune()
+        return self.to_shifts()
+
+    def to_shifts(self) -> list[Shift]:
+        brk = self.breaks()
+        out = []
+        for (a, c), i in zip(self.shifts, brk):
+            sh = Shift(a.agent_id, c.queue, c.tpl, c.day, list(c.segs), [self.grid[j] for j in c.ivs])
+            if i is not None:
+                sh.break_start = self.grid[i]
+                sh.break_minutes = int(self.brk_len.total_seconds() // 60)
+            out.append(sh)
+        out.sort(key=lambda s: (s.segments[0][0], s.agent_id))
+        return out
+
+
