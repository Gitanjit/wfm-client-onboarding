@@ -43,3 +43,55 @@
     """What the interval still lacks: the staffing requirement (agents on the queue) or the floor
     (cover as above), whichever is short by more."""
     return max(0.0, required - on_queue, floor_need - cover(on_queue, cross_skilled, cfg))
+
+
+def earliest_start_ok(queue: str, segments_local_hours, cfg: dict) -> bool:
+    """`queue_earliest_start: {queue: hour}`: no agent on `queue` before that local hour (Litware SOW 2.5).
+    `segments_local_hours`: the template's (start_hour, end_hour) local segments."""
+    lo = (cfg.get("queue_earliest_start") or {}).get(queue)
+    return lo is None or all(s >= lo for s, _ in segments_local_hours)
+
+
+def exceptions(req, cfg: dict, agents) -> list[tuple[str, object]]:
+    """Infeasible intervals (`exceptions: true`, Litware SOW 2.6): operating intervals with required
+    agents where the scheduling rules make the target impossible, because fewer agents than required
+    could ever be on the queue then: only skilled agents, on templates allowed for the queue and their
+    contract (split shifts, `queue_earliest_start`), covering the interval. Sorted (queue, interval
+    start UTC). Empty unless the client config sets `exceptions: true`."""
+    if not cfg.get("exceptions"):
+        return []
+    from wfm.ingest.loader import local_days
+    from wfm.scheduler.templates import templates_for
+    z = ZoneInfo(cfg["tz"])
+    split_ok = set(cfg.get("split_contracts") or ["FT", "PT"])
+    lo_op, hi_op = cfg["operating_hours"]
+    out = []
+    times = sorted(set(req["interval_start_utc"]))
+    days = sorted({t.astimezone(z).date() for t in times})
+    tpls = templates_for(cfg)
+    for q in (cfg.get("sla") or {}):
+        g = req[req["queue"] == q]
+        need = dict(zip(g["interval_start_utc"], g["required"]))
+        # per contract: interval starts some allowed template covers on q
+        covered = {}
+        for contract in ("FT", "PT"):
+            cov = set()
+            for t in tpls:
+                if t.is_split and contract not in split_ok:
+                    continue
+                if not earliest_start_ok(q, t.segments, cfg):
+                    continue
+                for d in days:
+                    for s, e in t.segments_utc(d, cfg["tz"]):
+                        cov.update(x for x in times if s <= x < e)
+            covered[contract] = cov
+        skilled = [a for a in agents if q in a.skills]
+        for x in times:
+            r = int(need.get(x, 0))
+            loc = x.astimezone(z)
+            if r <= 0 or not (lo_op <= loc.hour + loc.minute / 60 < hi_op):
+                continue
+            avail = sum(1 for a in skilled if x in covered.get(a.contract, set()))
+            if avail < r:
+                out.append((q, x))
+    return sorted(out, key=lambda p: (p[0], p[1]))
