+"""Litware go-live (2027-W11): interval-END export with per-row offsets, 20-minute grain, SOW 2.4-2.6."""
+from datetime import timedelta
+from zoneinfo import ZoneInfo
+
+import pandas as pd
+import pytest
+
+from wfm import constraints
+from wfm.config import load_config
+from wfm.evaluate.metrics import evaluate
+from wfm.ingest.loader import load_week
+from wfm.roster import load_agents
+from wfm.scheduler.greedy import to_frame
+from wfm.scheduler.week import WeekScheduler
+from wfm.staffing.required import add_required
+
+
+@pytest.fixture(scope="module")
+def w11():
+    cfg = load_config("litware")
+    return cfg, add_required(load_week(cfg, "2027-W11"), cfg), load_agents("litware")
+
+
+def test_interval_end_stamps_become_interval_starts():
+    cfg = load_config("litware")
+    df = load_week(cfg, "2027-W11")
+    assert set(df["queue"]) == {"priority", "standard", "email"}
+    assert df["interval_start_utc"].nunique() == 7 * 72
+    assert df["interval_start_utc"].min() == pd.Timestamp("2027-03-15T00:00:00Z")
+    raw = pd.read_csv("data/litware/export_2027-W11.csv")
+    first = raw[raw["volume"] > 0].iloc[0]   # stamped with its END: the interval starts 20 minutes earlier
+    end = pd.Timestamp(first["interval_end_local"] + first["utc_offset"]).tz_convert("UTC")
+    row = df[(df["queue"] == first["queue"]) & (df["interval_start_utc"] == end - timedelta(minutes=20))]
+    assert float(row["volume"].iloc[0]) == pytest.approx(first["volume"])
+
+
+def test_exceptions_are_email_before_nine(w11):
+    cfg, req, agents = w11
+    exc = constraints.exceptions(req, cfg, agents)
+    z = ZoneInfo(cfg["tz"])
+    assert exc and all(q == "email" and 7 <= t.astimezone(z).hour < 9 for q, t in exc)
+    assert constraints.exceptions(req, load_config("northwind"), agents) == []   # opt-in only
+
+
+def test_schedule_keeps_every_rule(w11):
+    cfg, req, agents = w11
+    sched = to_frame(WeekScheduler(req, cfg, agents, "2027-W11").run())
+    z = ZoneInfo(cfg["tz"])
+    email = sched[sched["queue"] == "email"]
+    assert all(t.astimezone(z).hour >= 9 for t in pd.to_datetime(email["segment_start_utc"], utc=True))
+    res = evaluate(req, sched, cfg, agents, "2027-W11")
+    assert all(v == 0 for v in res["violations"].values()), res["violations"]
+    assert res["efficiency"] <= cfg["efficiency_cap"]
+    assert all(v >= 0.95 for v in res["sla"].values())
