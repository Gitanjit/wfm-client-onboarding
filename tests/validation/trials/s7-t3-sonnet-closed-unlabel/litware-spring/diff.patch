+# Litware Support — local-time export stamped with the END of each 20-minute interval, with a UTC offset per row,
+# Europe/London (DST). Contract: docs/LITWARE_SOW.md. Everything below is Litware-specific; the service defaults
+# are untouched, and every value follows the SOW, not the legacy behaviour of the defaults (handover note:
+# docs/clients/litware.md).
+name: Litware Support
+interval_minutes: 20            # SOW 1.5
+tz: Europe/London               # SOW 1.4
+operating_hours: [7, 21]        # SOW 1.4 (email contacts arrive 07:00-19:00; 19:00-21:00 is still operating, zero volume)
+queues: [priority, standard, email]   # SOW 1.1
+queue_earliest_start: {email: 9}      # SOW 2.5: no agent on email before 09:00 local (a shift segment may not start earlier)
+queueing: erlang                # SOW 1.2: Erlang C, no abandonment
+aht_smoothing: interval         # SOW 1.2: the interval's own average handle time
+occupancy_cap: 0.85             # SOW 1.3
+enforce_occupancy_cap: true     # WFM-212: the cap is applied in required staffing for this client
+sla:                            # SOW 1.2
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 30}
+  email: {target: 0.80, seconds: 300}
+sla_target: 0.95                # SOW 1.6: weekly attainment per queue
+attainment_basis: service_level # SOW 1.2: interval met when net scheduled agents >= required
+attainment_denominator: operating   # SOW 1.6: fraction of operating intervals (zero-volume ones included), less SOW 2.6 intervals
+min_cover:                      # SOW 2.4: two priority agents (breaks aside) in every operating interval
+  priority: {agents: 2, hours: [7, 21]}
+cross_skill_weight: 0           # SOW 1.2: an agent counts once, on the queue they are scheduled on
+weekly_hours: {FT: 40, PT: 24}  # SOW 2.9
+max_consecutive_days: 5
+min_rest_hours: 11              # SOW 2.1 (elapsed)
+split_shift_contracts: [PT]     # SOW 2.2
+break:
+  min_shift_hours: 6            # SOW 2.3
+  minutes: 20
+  window_hours: [2, 5]
+  placement: surplus            # SOW 2.3: largest gross coverage surplus inside the window
+scheduler: search               # week-aware scheduler (wfm/scheduler/search.py)
+hours_bound: 1.45               # SOW 1.6: scheduled hours <= bound x required hours
+runbook: true                   # write RUNBOOK.md and exceptions.md (SOW 3, 2.7)
+runbook_exceptions: true        # SOW 3: the exception_intervals key and the ## Exceptions section (SOW 2.6)
+handover_note: docs/clients/litware.md
