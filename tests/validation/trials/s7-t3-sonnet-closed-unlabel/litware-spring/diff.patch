+def coverable(queue: str, t: datetime, cfg: dict) -> bool:
+    """True if some shift template the contract allows on `queue` covers the interval starting at `t`.
+    A client's `queue_earliest_start` (Litware SOW 2.5: nobody on email before 09:00) makes the intervals
+    before it uncoverable: where such an interval has demand it is an "infeasible interval" (SOW 2.6)."""
+    loc = t.astimezone(ZoneInfo(cfg["tz"]))
+    h = loc.hour + loc.minute / 60
+    return any(s <= h < e for tpl in templates_for(cfg, queue) for s, e in tpl.segments)
+
+
+def infeasible(queue: str, t: datetime, required: int, cfg: dict) -> bool:
+    """An operating interval with demand that the scheduling rules make impossible to staff (SOW 2.6)."""
+    return required > 0 and is_operating(queue, t, cfg) and not coverable(queue, t, cfg)
