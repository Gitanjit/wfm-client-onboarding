+def operating_hours(queue: str, cfg: dict) -> tuple[float, float]:
+    """Local operating hours of a queue: `queue_hours[queue]` if the client sets one, else `operating_hours`."""
+    lo, hi = (cfg.get("queue_hours") or {}).get(queue) or cfg["operating_hours"]
