@@ -0,0 +1,155 @@
+"""Northwind (SOW docs/NORTHWIND_SOW.md): offset-based ingest, SOW staffing, rule-aware scheduling,
+break placement, the weekly reconciliation report. The live clients keep their legacy behaviour."""
+import json
+from datetime import date, datetime, timedelta, timezone
+
+import pandas as pd
+
+from wfm import cli
+from wfm.config import load_config
+from wfm.ingest.loader import load_week, week_grid
+from wfm.report import runbook
+from wfm.roster import Agent, load_agents
+from wfm.scheduler import greedy, search
+from wfm.staffing.required import add_required, is_operating
+
+NW = load_config("northwind")
+
+
+def test_fall_back_week_has_338_intervals_and_vip():
+    df = load_week(NW, "2026-W44")
+    assert df.groupby("queue").size().to_dict() == {"priority": 338, "standard": 338, "vip": 338}
+    first = df["interval_start_utc"].min()
+    assert first == pd.Timestamp("2026-10-26 05:00", tz="UTC")           # Monday 00:00 CDT
+    assert df["interval_start_utc"].max() == pd.Timestamp("2026-11-02 05:30", tz="UTC")   # Sunday 23:30 CST
+
+
+def test_week_grid_dst_lengths():
+    assert len(week_grid("2026-W44", "America/Chicago", 30)) == 338
+    assert len(week_grid("2027-W10", "America/Chicago", 30)) == 334      # spring forward 2027-03-14
+    assert len(week_grid("2026-W43", "America/Chicago", 30)) == 336
+
+
+def test_export_row_a_minute_off_the_grid_stays_in_its_interval():
+    df = load_week(NW, "2026-W44")
+    row = df[(df["queue"] == "standard") & (df["interval_start_utc"] == pd.Timestamp("2026-10-29 15:00", tz="UTC"))]
+    assert float(row["volume"].iloc[0]) == 18.946                        # the 10:01 row, not lost
+
+
+def test_requirement_follows_the_sow():
+    df = load_week(NW, "2026-W44")
+    req = add_required(df, NW)
+    vip = req[req["queue"] == "vip"]
+    # closed outside 08:00-20:00 local
+    open_ = [is_operating("vip", t, NW) for t in vip["interval_start_utc"]]
+    assert vip.loc[[not o for o in open_], "required"].eq(0).all()
+    assert sum(open_) == 7 * 24
+    # occupancy cap: traffic / agents <= 0.85 wherever there is volume
+    for r in req[req["volume"] > 0].itertuples():
+        assert r.volume / 1800 * r.aht_sec / r.required <= 0.85 + 1e-9
+
+
+def test_interval_aht_and_cap_only_for_clients_that_ask():
+    df = pd.DataFrame({"queue": ["priority"] * 2, "interval_start_utc": pd.to_datetime(["2026-10-05T10:00Z", "2026-10-05T10:30Z"]),
+                       "volume": [10.0, 10.0], "aht_sec": [200.0, 900.0]})
+    cfg = {"interval_minutes": 30, "sla": {"priority": {"target": 0.9, "seconds": 30}}, "occupancy_cap": 0.85}
+    legacy = add_required(df, {**cfg, "aht_smoothing": "queue_mean"})["required"].tolist()
+    assert legacy[0] == legacy[1]                                         # WFM-198: one smoothed AHT
+    own = add_required(df, {**cfg, "aht_smoothing": "interval"})["required"].tolist()
+    assert own[0] < own[1]
+    capped = add_required(df, {**cfg, "aht_smoothing": "interval", "enforce_occupancy_cap": True})["required"].tolist()
+    assert capped[1] >= own[1] and 10 / 1800 * 900 / capped[1] <= 0.85
+
+
+def _req(day_hours: dict, cfg: dict) -> pd.DataFrame:
+    rows = []
+    for d, spans in day_hours.items():
+        for h in range(24):
+            n = next((k for s, e, k in spans if s <= h < e), 0)
+            for m in (0, 30):
+                t = datetime(d.year, d.month, d.day, h, m, tzinfo=timezone.utc)
+                rows.append({"queue": "priority", "interval_start_utc": t, "volume": float(n), "aht_sec": 300.0, "required": n})
+    return pd.DataFrame(rows)
+
+
+UTC_CFG = {"client": "t", "interval_minutes": 30, "tz": "UTC", "operating_hours": [6, 24],
+           "weekly_hours": {"FT": 40, "PT": 24}, "max_consecutive_days": 5, "min_rest_hours": 11,
+           "split_shift_contracts": ["PT"], "break": {"min_shift_hours": 6, "minutes": 20, "window_hours": [2, 5], "placement": "surplus"}}
+MON = date(2026, 10, 5)
+
+
+def test_rest_rule_is_kept_while_placing():
+    # Monday evening and Tuesday morning both need one agent; with 11 h rest one person cannot do both
+    agents = [Agent("A", "FT", frozenset({"priority"})), Agent("B", "FT", frozenset({"priority"}))]
+    req = _req({MON: [(16, 24, 1)], MON + timedelta(days=1): [(6, 14, 1)]}, UTC_CFG)
+    shifts = greedy.schedule_week(req, UTC_CFG, agents, "2026-W41")
+    assert len(shifts) == 2 and shifts[0].agent_id != shifts[1].agent_id
+
+
+def test_split_shifts_only_for_part_time():
+    need = {MON: [(8, 12, 1), (16, 20, 1)]}
+    ft = [Agent("F", "FT", frozenset({"priority"}))]
+    pt = [Agent("P", "PT", frozenset({"priority"}))]
+    req = _req(need, UTC_CFG)
+    assert all(not s.template.is_split for s in greedy.schedule_week(req, UTC_CFG, ft, "2026-W41"))
+    assert any(s.template.is_split for s in greedy.schedule_week(req, UTC_CFG, pt, "2026-W41"))
+
+
+def test_break_goes_where_the_gross_surplus_is_largest():
+    cfg = {**UTC_CFG, "scheduler": "search"}
+    agents = [Agent("A", "FT", frozenset({"priority"})), Agent("B", "FT", frozenset({"priority"}))]
+    # A works D8 (09-17); B works L8 (13-21); the requirement is 2 from 13:00 to 15:00
+    req = _req({MON: [(9, 13, 1), (13, 15, 2), (15, 17, 1)]}, cfg)
+    p = search.Problem(req, cfg, agents, "2026-W41")
+    plan = {(0, 0): (1, "priority"), (1, 0): (2, "priority")}           # A: D8, B: L8 (13-21)
+    shifts = {s.agent_id: s for s in p.to_shifts(plan)}
+    for s in shifts.values():
+        assert s.break_minutes == 20
+        off = (s.break_start - s.segments[0][0]).total_seconds() / 3600
+        assert 2 <= off <= 5
+    # each break sits on an interval whose gross surplus is the maximum inside the shift's window
+    gross = {}
+    for s in shifts.values():
+        t = s.segments[0][0]
+        while t < s.segments[0][1]:
+            gross[t] = gross.get(t, 0) + 1
+            t += timedelta(minutes=30)
+    r = dict(zip(req["interval_start_utc"], req["required"]))
+    a = shifts["A"]
+    window = [a.segments[0][0] + timedelta(minutes=30 * k) for k in range(4, 11)]
+    assert gross[a.break_start] - r[a.break_start] == max(gross[t] - r[t] for t in window)
+
+
+def _small(cfg_extra=None):
+    cfg = {**NW, "search_iterations": 2000, **(cfg_extra or {})}
+    return cfg
+
+
+def test_run_northwind_week_writes_a_schedule_that_obeys_the_sow(tmp_path, monkeypatch):
+    monkeypatch.setattr(cli, "OUT_DIR", tmp_path)
+    monkeypatch.setattr(cli, "load_config", lambda c: _small())
+    res = cli.run("northwind", "2026-W44")
+    assert res["intervals"] == 338
+    assert res["violations"] == {k: 0 for k in res["violations"]} and "rest" in res["violations"]
+    assert res["scheduled_hours"] <= res["hours_bound"]
+    assert res["sla"]["priority"] >= 0.95 and res["sla"]["standard"] >= 0.95
+    ev = json.loads((tmp_path / "northwind" / "eval.json").read_text())
+    assert ev == res
+    sched = pd.read_csv(tmp_path / "northwind" / "schedule.csv")
+    assert set(sched["queue"]) <= {"priority", "standard", "vip"} and len(sched) > 0
+    text = (tmp_path / "northwind" / "RUNBOOK.md").read_text()
+    for key in runbook.KEYS:
+        assert f"| {key} |" in text
+    assert "| intervals_in_week | 338 |" in text
+    assert "queue | week | achievable | shortfall" in (tmp_path / "northwind" / "exceptions.md").read_text()
+
+
+def test_exception_rows_only_for_missed_targets():
+    cfg = {"sla_target": 0.95}
+    res = {"week": "2026-W44", "sla": {"priority": 1.0, "standard": 0.951, "vip": 0.917}}
+    assert runbook.exception_rows(cfg, res) == ["| vip | 2026-W44 | 0.917 | 0.033 |"]
+
+
+def test_roster_has_the_skills_the_sow_names():
+    agents = load_agents("northwind")
+    assert sum("vip" in a.skills for a in agents) == 11 and {a.contract for a in agents} == {"FT", "PT"}
