+# Northwind Traders — local-time export with a UTC offset per row, America/Chicago (DST).
+# Contract: docs/NORTHWIND_SOW.md. Everything below is Northwind-specific; the service defaults are untouched.
+# Values here follow the SOW, not the legacy behaviour of the defaults (see the handover note in
+# out/northwind/RUNBOOK.md for the deviations this overrides).
+name: Northwind Traders
+interval_minutes: 30            # SOW 1.5
+tz: America/Chicago             # SOW 1.4
+operating_hours: [6, 24]        # SOW 1.4
+queues: [priority, standard, vip]
+queue_hours:                    # SOW 1.4: vip contacts arrive 08:00-20:00; those are vip's operating intervals
+  vip: [8, 20]
+queueing: erlang                # SOW 1.2: Erlang C, no abandonment
+aht_smoothing: interval         # SOW 1.2: the interval's own average handle time
+occupancy_cap: 0.85             # SOW 1.3
+enforce_occupancy_cap: true     # WFM-212: the cap is applied in required staffing for this client
+sla:                            # SOW 1.2
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 20}
+  vip: {target: 0.90, seconds: 20}
+sla_target: 0.95                # SOW 1.6: weekly attainment per queue
+attainment_basis: service_level # SOW 1.2: interval met when net scheduled agents >= required
+attainment_denominator: operating   # SOW 1.6 / 3: fraction of operating intervals (zero-volume ones included)
+min_cover:                      # SOW 2.6: one vip agent in every interval 06:00-24:00
+  vip: {agents: 1, hours: [6, 24]}
+cross_skill_weight: 0           # SOW 2.6 / 1.2: an agent counts once, on the queue they are scheduled on
+weekly_hours: {FT: 40, PT: 24}  # SOW 2.4
+max_consecutive_days: 5
+min_rest_hours: 11              # SOW 2.1 (elapsed)
+split_shift_contracts: [PT]     # SOW 2.2
+break:
+  min_shift_hours: 6
+  minutes: 20
+  window_hours: [2, 5]
+  placement: surplus            # SOW 2.3: largest gross coverage surplus inside the window
+scheduler: search               # week-aware scheduler (wfm/scheduler/search.py)
+hours_bound: 1.57               # SOW 1.6: scheduled hours <= bound x required hours
+runbook: true                   # write RUNBOOK.md and exceptions.md (SOW 3, 2.7)
+search_iterations: 300000
+agent_pick: specialist_first    # keep multi-skilled agents free for the queue only they can staff (vip)
+days_off_plan: true             # spread days off before placing shifts (a Monday-first fill leaves no weekend vip cover)
+files_changed:                  # SOW 3: repository-relative paths changed to deliver Northwind (RUNBOOK.md)
+  - clients/README.md
+  - clients/registry.yaml
+  - configs/northwind.yaml
+  - docs/ARCHITECTURE.md
+  - docs/CHANGELOG.md
+  - docs/clients/northwind.md
+  - tests_unit/test_cli_subcommands.py
+  - tests_unit/test_northwind.py
+  - tests_unit/test_registry.py
+  - wfm/cli.py
+  - wfm/evaluate/metrics.py
+  - wfm/ingest/loader.py
+  - wfm/report/runbook.py
+  - wfm/scheduler/greedy.py
+  - wfm/scheduler/search.py
+  - wfm/staffing/required.py
