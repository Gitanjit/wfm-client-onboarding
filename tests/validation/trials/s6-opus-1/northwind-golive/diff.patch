+def _shifts(g: pd.DataFrame, z) -> list[pd.DataFrame]:
+    """An agent's rows grouped into shifts (one template on one local day), in start order."""
+    g = g.assign(_day=[t.astimezone(z).date() for t in g["segment_start_utc"]])
+    return [s for _, s in sorted(g.groupby(["_day", "template_id"]), key=lambda kv: kv[1]["segment_start_utc"].min())]
