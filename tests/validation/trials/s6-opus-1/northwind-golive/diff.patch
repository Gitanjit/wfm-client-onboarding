+
+def contract_rules(sched: pd.DataFrame, req: pd.DataFrame, gross: dict, cfg: dict, agents: list[Agent]) -> dict[str, int]:
+    """Rules that only some contracts carry, audited when the client config sets them:
+    `min_rest_hours` (rest), `split_contracts` (split_shift), `break_placement: surplus` (breaks)."""
+    out = {}
