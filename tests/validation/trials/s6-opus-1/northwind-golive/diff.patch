+"""Northwind onboarding (go-live 2026-W44): offset-driven ingest across the DST change, SOW staffing
+switches, and the week-aware scheduler's rules on a small synthetic week."""
+from datetime import date, timedelta
+
+import pandas as pd
+
+from wfm.config import load_config
+from wfm.ingest.loader import load_week
+from wfm.roster import Agent
+from wfm.scheduler.greedy_v2 import schedule_week
+from wfm.staffing.erlang import required_agents
+from wfm.staffing.required import add_required
+
+
+def test_w44_export_uses_the_row_offsets_across_the_fall_back():
+    cfg = load_config("northwind")
+    df = load_week(cfg, "2026-W44")
+    assert set(df["queue"]) == {"priority", "standard", "vip"}
+    assert df["interval_start_utc"].nunique() == 338          # 169 elapsed hours
+    assert df.groupby("queue").size().to_dict() == {"priority": 338, "standard": 338, "vip": 338}
+    # the 10:01 row on Tue 27 Oct lands in the 10:00 (15:00Z) interval
+    t = pd.Timestamp("2026-10-27T15:00Z")
+    assert set(df.loc[df["interval_start_utc"] == t, "queue"]) == {"priority", "standard", "vip"}
+
+
+def test_northwind_staffing_uses_interval_aht_and_the_occupancy_cap():
+    cfg = load_config("northwind")
+    req = add_required(load_week(cfg, "2026-W44"), cfg)
+    r = req[req["volume"] > 0].iloc[40]
+    sla = cfg["sla"][r["queue"]]
+    assert r["required"] == required_agents(r["volume"], 1800, r["aht_sec"], sla["target"], sla["seconds"], 0.85)
+
+
+def test_live_clients_keep_the_service_staffing():
+    cfg = load_config("contoso")
+    assert not cfg.get("apply_occupancy_cap") and cfg.get("scheduler", "greedy") == "greedy"
+
+
+def _req(days, tz="UTC"):
+    rows = []
+    for d in days:
+        for h in range(24):
+            for q in ("priority", "vip"):
+                need = 1 if 6 <= h < 24 else 0
+                rows.append({"queue": q, "interval_start_utc": pd.Timestamp(d.year, d.month, d.day, h, tz="UTC"),
+                             "volume": float(need), "aht_sec": 300.0, "required": need})
+    return pd.DataFrame(rows)
+
+
+def test_week_scheduler_enforces_rest_split_and_breaks():
+    cfg = {"client": "t", "interval_minutes": 60, "tz": "UTC", "operating_hours": [6, 24],
+           "weekly_hours": {"FT": 40, "PT": 24}, "max_consecutive_days": 5, "min_rest_hours": 11,
+           "split_contracts": ["PT"], "break_placement": "surplus", "min_cover": {}, "cross_skill_weight": 0,
+           "break": {"min_shift_hours": 6, "minutes": 20, "window_hours": [2, 5]}}
+    days = [date(2026, 10, 5) + timedelta(days=i) for i in range(7)]
+    agents = [Agent(f"A-{i:03d}", "FT" if i < 8 else "PT", frozenset({"priority", "vip"})) for i in range(12)]
+    shifts = schedule_week(_req(days), cfg, agents, "2026-W41")
+    by_agent = {}
+    for sh in shifts:
+        by_agent.setdefault(sh.agent_id, []).append(sh)
+        if sh.template.is_split:
+            assert sh.agent_id >= "A-008"
+        if sh.hours >= 6:
+            start = sh.segments[0][0]
+            assert sh.break_start is not None and start + timedelta(hours=2) <= sh.break_start <= start + timedelta(hours=5)
+    for lst in by_agent.values():
+        lst.sort(key=lambda s: s.segments[0][0])
+        for a, b in zip(lst, lst[1:]):
+            assert b.segments[0][0] - a.segments[-1][1] >= timedelta(hours=11)
