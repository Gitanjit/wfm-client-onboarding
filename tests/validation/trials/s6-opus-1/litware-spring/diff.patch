+def _read_end_stamped(df: pd.DataFrame, path, cfg: dict) -> pd.DataFrame:
+    """An export stamped with each interval's END in local time plus the UTC offset in effect at that
+    moment (Litware): UTC end from the row's own offset, start = end - one grain. A stamp off the grain
+    is rounded to the nearest interval end (with a warning); a row repeated after that keeps the first."""
+    grain = timedelta(minutes=cfg["interval_minutes"])
+    label = df["interval_end_local"].astype(str).str.strip()
+    late = label.str.endswith(" 24:00")          # end of day written as 24:00
+    label = label.where(~late, label.str.slice(0, 10) + " 00:00")
+    end = pd.to_datetime(label + df["utc_offset"].astype(str).str.strip(), format="%Y-%m-%d %H:%M%z", utc=True)
+    end = end + pd.to_timedelta(late.astype(int), unit="D")
+    snapped = end.dt.round(grain)
+    off = snapped != end
+    if off.any():
+        print(f"warning: {path.name}: {int(off.sum())} row(s) stamped off the {cfg['interval_minutes']}-minute "
+              f"grain, assigned to the nearest interval end", file=sys.stderr)
+    df = df.assign(interval_start_utc=snapped - grain)[["queue", "interval_start_utc", "volume", "aht_sec"]]
+    df["queue"] = df["queue"].astype(str).str.strip()
+    dup = df.duplicated(["queue", "interval_start_utc"], keep="first")
+    if dup.any():
+        print(f"warning: {path.name}: {int(dup.sum())} repeated queue/interval row(s) ignored "
+              f"(first row kept)", file=sys.stderr)
+        df = df[~dup]
+    return df
+
