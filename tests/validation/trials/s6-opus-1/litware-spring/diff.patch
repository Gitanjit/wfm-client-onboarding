+# Litware Support — local-time 20-minute export stamped with the interval END and a UTC offset per row,
+# Europe/London. Contract: docs/LITWARE_SOW.md (go-live 2027-W11). Config schema 1 (flat).
+name: Litware Support
+interval_minutes: 20                # SOW 1.5
+tz: Europe/London
+operating_hours: [7, 21]            # SOW 1.4 (every queue; email contacts arrive 07:00-19:00)
+queues: [priority, standard, email] # SOW 1.1
+
+sla:                                # SOW 1.2
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 30}
+  email: {target: 0.80, seconds: 300}
+sla_target: 0.95                    # SOW 1.6: weekly attainment per queue
+attainment_basis: service_level
+attainment_intervals: operating     # SOW 1.6: every operating interval counts, with or without volume
+efficiency_bound: 1.45              # SOW 1.6: scheduled hours <= 1.45 x required hours
