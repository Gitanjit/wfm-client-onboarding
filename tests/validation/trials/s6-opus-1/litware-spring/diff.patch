+"""Contract reports written by `wfm run` for clients that ask for them (off for every other client).
+
+  exceptions_report: true   out/<client>/exceptions.md — targets the roster cannot meet this week
+                            (queue | week | achievable | shortfall), SOW §2.7 in Northwind's and Litware's
+                            contracts. Rewritten on every run, so it always describes the week just run.
+  runbook: {handover: <md file>, files_changed: [...]}
+                            out/<client>/RUNBOOK.md — the weekly reconciliation report (Litware SOW §3):
+                            key/value table from eval.json, `## Exceptions` (one line per §2.6 interval),
+                            then the handover note copied from the configured file.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+
+from wfm.config import APP_DIR
+from wfm.roster import Agent
+
+
+def _skill_lines(cfg: dict, result: dict, agents: list[Agent], queue: str, sched) -> list[str]:
+    holders = [a for a in agents if queue in a.skills]
+    cap = sum(cfg["weekly_hours"][a.contract] for a in holders)
+    ids = {a.agent_id for a in holders}
+    s = sched[sched["agent_id"].isin(ids)]
+    hrs = ((s["segment_end_utc"] - s["segment_start_utc"]).dt.total_seconds() / 3600)
+    on_q = float(hrs[s["queue"] == queue].sum())
+    return [f"- `{queue}`: {len(holders)} agent(s) hold the skill ({sum(a.contract == 'FT' for a in holders)} FT), "
+            f"at most {cap:.0f} agent-hours a week; this week they work {float(hrs.sum()):.1f} h, "
+            f"{on_q:.1f} h of it on `{queue}`."]
+
+
+def write_exceptions(cfg: dict, result: dict, agents: list[Agent], sched, out: Path) -> Path | None:
+    if not cfg.get("exceptions_report"):
+        return None
+    import pandas as pd
+    sched = sched.copy()
+    for c in ("segment_start_utc", "segment_end_utc"):
+        sched[c] = pd.to_datetime(sched[c], utc=True)
+    target = float(cfg["sla_target"])
+    week = result["week"]
+    missed = [(q, v) for q, v in sorted(result["sla"].items()) if v < target - 1e-12]
+    lines = [f"# {cfg.get('name', cfg['client'])} — exceptions (SOW §2.7), {week}", "",
+             (f"Targets the roster in `data/agents/{cfg['client']}.csv` does not meet in {week}." if missed else
+              f"Every target is met in {week} with the roster in `data/agents/{cfg['client']}.csv`: nothing to raise.")
+             + " Attainment as the SOW "
+             "§1 defines it (operating intervals meeting the Erlang C requirement at the interval's own volume and "
+             f"AHT, occupancy cap {cfg.get('occupancy_cap')}, agents on the queue net of breaks"
+             + (", intervals listed under Exceptions in RUNBOOK.md left out" if cfg.get("report_infeasible") else "")
+             + f"). Weekly target: {target:.3f} per queue." + (" Raise with the account team." if missed else ""), "",
+             "| queue | week | achievable | shortfall |", "|---|---|---|---|"]
+    lines += [f"| {q} | {week} | {v:.3f} | {target - v:.3f} |" for q, v in missed]
+    lines.append("")
+    if missed:
+        lines.append("Capacity behind the shortfall:")
+        for q, _ in missed:
+            lines += _skill_lines(cfg, result, agents, q, sched)
+        lines.append("")
+    else:
+        lines += [f"No target missed in {week}: every queue is at or above {target:.3f}.", ""]
+    met = [f"{q} {v:.3f}" for q, v in sorted(result["sla"].items()) if v >= target - 1e-12]
+    if met:
+        lines.append(f"Targets met: {', '.join(met)}.")
+    if "required_hours" in result:
+        lines.append(f"Scheduled hours {result['scheduled_hours']:.1f} against {result['efficiency_bound']} x "
+                     f"{result['required_hours']:.1f} required = "
+                     f"{result['efficiency_bound'] * result['required_hours']:.1f} (ratio {result['hours_ratio']:.3f}).")
+    viol = {k: v for k, v in result["violations"].items() if v}
+    lines.append("Scheduling rules: " + ("no violations." if not viol else f"violations {viol}."))
+    path = out / "exceptions.md"
+    path.write_text("\n".join(lines) + "\n")
+    return path
+
+
+def write_runbook(cfg: dict, result: dict, out: Path) -> Path | None:
+    spec = cfg.get("runbook")
+    if not spec:
+        return None
+    queues = list(cfg.get("queues") or result["sla"])
+    rows = [("intervals_in_week", str(result["intervals"]))]
+    rows += [(f"sla_attainment_{q}", f"{result['sla'][q]:.3f}") for q in queues]
+    rows += [("scheduled_hours_total", f"{result['scheduled_hours']:.1f}"),
+             ("required_hours_total", f"{result['required_hours']:.1f}"),
+             ("understaffed_interval_hours", f"{result['understaffed_interval_hours']:.1f}"),
+             ("agents_scheduled", str(result["agents_scheduled"]))]
+    if cfg.get("report_infeasible"):
+        rows.append(("exception_intervals", str(result["exception_intervals"])))
+    rows.append(("files_changed", ", ".join(spec.get("files_changed") or [])))
+    name = cfg.get("name", cfg["client"])
+    lines = [f"# {name} — weekly reconciliation, {result['week']}", "",
+             f"Produced by `cd /app && python -m wfm run --client {cfg['client']} --week {result['week']}` "
+             f"(`out/{cfg['client']}/schedule.csv`, `out/{cfg['client']}/eval.json`).", "",
+             "| key | value |", "|---|---|"]
+    lines += [f"| {k} | {v} |" for k, v in rows]
+    lines += ["", "## Exceptions", ""]
+    exc = result.get("exceptions") or []
+    lines += [f"- {e['queue']} {e['interval_start_utc']}" for e in exc] or ["None."]
+    lines.append("")
+    handover = spec.get("handover")
+    if handover:
+        lines.append((APP_DIR / handover).read_text().rstrip() + "\n")
+    path = out / "RUNBOOK.md"
+    path.write_text("\n".join(lines))
+    return path
