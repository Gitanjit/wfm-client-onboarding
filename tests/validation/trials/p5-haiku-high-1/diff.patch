@@ -0,0 +1,193 @@
+"""Northwind SOW check: recompute SOW §2 rule violations and SOW §3 reconciliation keys from outputs.
+
+Independent of configs/northwind.yaml on purpose: the SOW constants are written here.
+Usage (from /app):  python -m wfm.evaluate.sow_northwind --week 2026-W44
+"""
+from __future__ import annotations
+
+import argparse
+import math
+from collections import defaultdict
+from datetime import date, datetime, timedelta, timezone
+from pathlib import Path
+from zoneinfo import ZoneInfo
+
+import pandas as pd
+
+from wfm.config import APP_DIR, OUT_DIR
+from wfm.staffing.erlang import required_agents
+from wfm.ingest.loader import iso_week_monday
+
+TZ = ZoneInfo("America/Chicago")                    # SOW 1.4
+GRAIN = timedelta(minutes=30)                       # SOW 1.5
+SLA = {"priority": (0.90, 30), "standard": (0.80, 20)}   # SOW 1.2
+OCC_CAP = 0.85                                      # SOW 1.3
+OPEN_H, CLOSE_H = 6, 24                             # SOW 1.4
+REST_H = 11.0                                       # SOW 2.1
+BREAK_MIN, BREAK_WIN = 20, (2.0, 5.0)               # SOW 2.3
+BREAK_SHIFT_MIN_H = 6.0                             # SOW 2.3
+WEEK_CAP = {"FT": 40.0, "PT": 24.0}                 # SOW 2.4
+MAX_RUN = 5                                         # SOW 2.4
+
+ZERO = timedelta(0)
+
+
+def _utc(ts: str) -> datetime:
+    return datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
+
+
+def week_intervals(week: str) -> list[datetime]:
+    mon = iso_week_monday(week)
+    start = datetime(mon.year, mon.month, mon.day, tzinfo=TZ).astimezone(timezone.utc)
+    nxt = mon + timedelta(days=7)
+    end = datetime(nxt.year, nxt.month, nxt.day, tzinfo=TZ).astimezone(timezone.utc)
+    out, t = [], start
+    while t < end:
+        out.append(t)
+        t += GRAIN
+    return out
+
+
+def read_demand(week: str, path: Path | None = None) -> dict:
+    """(queue, interval_start_utc) -> (volume, aht_sec) from the export, using each row's utc_offset."""
+    path = path or APP_DIR / "data" / "northwind" / f"export_{week}.csv"
+    df = pd.read_csv(path, dtype={"utc_offset": str})
+    sign = df["utc_offset"].str[0].map({"+": 1, "-": -1})
+    hh = df["utc_offset"].str[1:3].astype(int)
+    mm = df["utc_offset"].str[4:6].astype(int)
+    off = pd.to_timedelta(sign * (hh * 60 + mm), unit="min")
+    utc = pd.to_datetime(df["interval_start_local"]) - off
+    out = {}
+    for q, t, v, a in zip(df["queue"], utc, df["volume"], df["aht_sec"]):
+        out[(q, t.replace(tzinfo=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))] = (float(v), float(a))
+    return out
+
+
+def read_schedule(path: Path) -> pd.DataFrame:
+    df = pd.read_csv(path, dtype=str).fillna("")
+    return df
+
+
+def check(week: str, sched_path: Path | None = None, agents_path: Path | None = None,
+          demand_path: Path | None = None) -> dict:
+    sched_path = sched_path or OUT_DIR / "northwind" / "schedule.csv"
+    agents_path = agents_path or APP_DIR / "data" / "agents" / "northwind.csv"
+    sch = read_schedule(sched_path)
+    ag = pd.read_csv(agents_path, dtype=str)
+    contract = dict(zip(ag["agent_id"], ag["contract"]))
+    skills = {r.agent_id: set(r.skills.split(";")) for r in ag.itertuples(index=False)}
+
+    segs = []
+    for r in sch.itertuples(index=False):
+        s, e = _utc(r.segment_start_utc), _utc(r.segment_end_utc)
+        ls = s.astimezone(TZ)
+        brk = _utc(r.break_start_utc) if r.break_start_utc else None
+        segs.append(dict(agent=r.agent_id, queue=r.queue, s=s, e=e, local_day=ls.date(),
+                         brk=brk, brk_min=int(r.break_minutes or 0), tpl=r.template_id))
+
+    v = defaultdict(int)
+    # ---- templates: within local day, not crossing local midnight (2.5)
+    for g in segs:
+        if g["s"].astimezone(TZ).date() != (g["e"] - ZERO - timedelta(seconds=1)).astimezone(TZ).date():
+            v["template_crosses_midnight"] += 1
+        if g["queue"] not in ("priority", "standard"):
+            v["unknown_queue"] += 1
+        if g["queue"] not in skills.get(g["agent"], set()):
+            v["skill_match"] += 1
+
+    # ---- shifts: an agent's segments on one local day form one shift (2.2, 2.3, 2.4)
+    by_shift = defaultdict(list)
+    for g in segs:
+        by_shift[(g["agent"], g["local_day"])].append(g)
+    per_agent = defaultdict(list)
+    for (agent, day), parts in by_shift.items():
+        parts.sort(key=lambda x: x["s"])
+        if len(parts) > 1:
+            if contract.get(agent) != "PT":
+                v["split_shift_not_pt"] += 1
+            for a, b in zip(parts, parts[1:]):
+                if b["s"] < a["e"]:
+                    v["overlap"] += 1
+        start, end = parts[0]["s"], parts[-1]["e"]
+        hours = sum((p["e"] - p["s"]).total_seconds() for p in parts) / 3600
+        per_agent[agent].append(dict(day=day, start=start, end=end, hours=hours, parts=parts))
+        breaks = [p for p in parts if p["brk"] is not None]
+        if hours >= BREAK_SHIFT_MIN_H:
+            if len(breaks) != 1:
+                v["break_count"] += 1
+            else:
+                b = breaks[0]
+                if b["brk_min"] != BREAK_MIN:
+                    v["break_length"] += 1
+                off_h = (b["brk"] - start).total_seconds() / 3600
+                if not (BREAK_WIN[0] <= off_h <= BREAK_WIN[1]):
+                    v["break_window"] += 1
+                if not any(p["s"] <= b["brk"] and b["brk"] + timedelta(minutes=BREAK_MIN) <= p["e"] for p in parts):
+                    v["break_outside_segment"] += 1
+        elif breaks:
+            v["break_on_short_shift"] += 1
+
+    for agent, shifts in per_agent.items():
+        shifts.sort(key=lambda x: x["start"])
+        if sum(s["hours"] for s in shifts) > WEEK_CAP[contract.get(agent, "FT")] + 1e-9:
+            v["weekly_hours"] += 1
+        for a, b in zip(shifts, shifts[1:]):
+            if (b["start"] - a["end"]).total_seconds() / 3600 < REST_H - 1e-9:
+                v["rest"] += 1
+        run = 1
+        for a, b in zip(shifts, shifts[1:]):
+            run = run + 1 if (b["day"] - a["day"]).days == 1 else 1
+            if run > MAX_RUN:
+                v["consecutive_days"] += 1
+                break
+
+    # ---- §1.2 / §3 reconciliation
+    demand = read_demand(week, demand_path)
+    ivs = week_intervals(week)
+    gross = {q: defaultdict(int) for q in SLA}
+    on_break = {q: defaultdict(int) for q in SLA}
+    for g in segs:
+        for t in ivs:
+            if g["s"] <= t < g["e"]:
+                gross[g["queue"]][t] += 1
+        if g["brk"] is not None:
+            for t in ivs:
+                if g["brk"] < t + GRAIN and t < g["brk"] + timedelta(minutes=g["brk_min"]):
+                    on_break[g["queue"]][t] += 1
+
+    operating = [t for t in ivs if OPEN_H <= t.astimezone(TZ).hour < CLOSE_H]
+    operating_set = set(operating)
+    res = {"intervals_in_week": len(ivs)}
+    under_h = 0.0
+    for q, (target, secs) in SLA.items():
+        met = 0
+        for t in ivs:
+            vol, aht = demand.get((q, t.strftime("%Y-%m-%dT%H:%M:%SZ")), (0.0, 0.0))
+            req = required_agents(vol, GRAIN.total_seconds(), aht, target, secs, occupancy_cap=OCC_CAP) if vol > 0 else 0
+            net = gross[q][t] - on_break[q][t]
+            if net >= req:
+                if t in operating_set:
+                    met += 1
+            else:
+                under_h += (req - net) * 0.5
+        res[f"sla_attainment_{q}"] = round(met / len(operating), 3)
+    res["understaffed_interval_hours"] = round(under_h, 1)
+    res["scheduled_hours_total"] = round(sum((g["e"] - g["s"]).total_seconds() for g in segs) / 3600, 1)
+    res["agents_scheduled"] = len(per_agent)
+    res["operating_intervals"] = len(operating)
+    return {"rules": dict(v), "reconciliation": res}
+
+
+def main(argv=None) -> None:
+    ap = argparse.ArgumentParser(prog="python -m wfm.evaluate.sow_northwind")
+    ap.add_argument("--week", required=True)
+    ap.add_argument("--schedule", type=Path, default=None)
+    args = ap.parse_args(argv)
+    out = check(args.week, args.schedule)
+    print("rule violations:", out["rules"] or "none")
+    for k, val in out["reconciliation"].items():
+        print(f"{k}: {val}")
+
+
+if __name__ == "__main__":
+    main()
