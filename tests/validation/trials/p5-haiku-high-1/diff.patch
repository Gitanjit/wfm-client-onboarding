+"""Northwind onboarding: DST-aware ingest and SOW §2 rules on the produced schedule."""
+from __future__ import annotations
+
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from zoneinfo import ZoneInfo
+
+import pandas as pd
+
+import wfm.ingest.loader as loader
+import wfm.roster as roster
+from wfm.config import DATA_DIR, load_config
+from wfm.evaluate.sow_northwind import check
+from wfm.ingest.loader import iso_week_monday, load_week, week_grid
+from wfm.roster import load_agents
+from wfm.scheduler.greedy import schedule_week, to_frame
+from wfm.staffing.required import add_required
+
+CHI = ZoneInfo("America/Chicago")
+
+
+def _synthetic_export(path: Path, week: str) -> None:
+    """A local-time export for a whole ISO week, labelled the way Northwind's tool writes it:
+    both copies of the repeated fall-back hour, and no label for the skipped spring-forward hour.
+    Volumes follow the real W43 profile by weekday and time of day; zero outside operating hours."""
+    real = pd.read_csv(DATA_DIR / "northwind" / "export_2026-W43.csv")
+    real["dt"] = pd.to_datetime(real["interval_start_local"])
+    prof = {(r.dt.weekday(), r.dt.strftime("%H:%M"), r.queue): (r.volume, r.aht_sec)
+            for r in real.itertuples(index=False)}
+    d0 = iso_week_monday(week)
+    rows = []
+    for day in range(7):
+        d = d0 + timedelta(days=day)
+        for half in range(48):
+            naive = datetime(d.year, d.month, d.day) + timedelta(minutes=30 * half)
+            for fold in (0, 1):
+                loc = naive.replace(tzinfo=CHI, fold=fold)
+                if loc.astimezone(timezone.utc).astimezone(CHI).replace(tzinfo=None) != naive:
+                    continue                                   # nonexistent wall-clock time
+                if fold == 1 and loc.utcoffset() == naive.replace(tzinfo=CHI, fold=0).utcoffset():
+                    continue                                   # not ambiguous: only one copy exists
+                off = loc.utcoffset()
+                mins = int(off.total_seconds() // 60)
+                label = f"{'-' if mins < 0 else '+'}{abs(mins) // 60:02d}:{abs(mins) % 60:02d}"
+                for q in ("priority", "standard"):
+                    vol, aht = prof[(naive.weekday(), naive.strftime("%H:%M"), q)]
+                    rows.append((naive.strftime("%Y-%m-%d %H:%M"), label, q, float(vol), float(aht)))
+    pd.DataFrame(rows, columns=["interval_start_local", "utc_offset", "queue", "volume", "aht_sec"]).to_csv(
+        path, index=False)
+
+
+def test_fall_back_week_grid_and_offsets():
+    cfg = load_config("northwind")
+    d = load_week(cfg, "2026-W44")                     # 2026-11-01 has 25 local hours
+    assert d["interval_start_utc"].nunique() == 338
+    assert len(week_grid("2026-W42", "America/Chicago", 30)) == 336
+    assert (d.groupby("queue")["interval_start_utc"].nunique() == 338).all()
+
+
+def test_spring_forward_week_schedules_and_passes_sow(tmp_path, monkeypatch):
+    week = "2027-W10"                                  # DST starts Sun 2027-03-14: a 23-hour day
+    data = tmp_path / "data"
+    (data / "northwind").mkdir(parents=True)
+    (data / "agents").mkdir(parents=True)
+    _synthetic_export(data / "northwind" / f"export_{week}.csv", week)
+    agents_csv = data / "agents" / "northwind.csv"
+    agents_csv.write_text((DATA_DIR / "agents" / "northwind.csv").read_text())
+    monkeypatch.setattr(loader, "DATA_DIR", data)
+    monkeypatch.setattr(roster, "DATA_DIR", data)
+
+    cfg = load_config("northwind")
+    req = add_required(load_week(cfg, week), cfg)
+    assert req["interval_start_utc"].nunique() == 334  # 167 elapsed hours
+    shifts = schedule_week(req, cfg, load_agents("northwind"), week)
+    sched = tmp_path / "schedule.csv"
+    to_frame(shifts).to_csv(sched, index=False)
+    out = check(week, sched, agents_csv, data / "northwind" / f"export_{week}.csv")
+    assert out["rules"] == {}
+    rec = out["reconciliation"]
+    assert rec["intervals_in_week"] == 334
+    assert rec["sla_attainment_priority"] == 1.0 and rec["sla_attainment_standard"] == 1.0
+
+
+def test_w44_schedule_meets_sow_rules_and_sla(tmp_path):
+    """Schedule the real W44 export without writing outputs, then audit it against SOW §2 and §1.2."""
+    cfg = load_config("northwind")
+    req = add_required(load_week(cfg, "2026-W44"), cfg)
+    shifts = schedule_week(req, cfg, load_agents("northwind"), "2026-W44")
+    sched = tmp_path / "schedule.csv"
+    to_frame(shifts).to_csv(sched, index=False)
+    out = check("2026-W44", sched)
+    assert out["rules"] == {}
+    assert out["reconciliation"]["sla_attainment_priority"] == 1.0
+    assert out["reconciliation"]["sla_attainment_standard"] == 1.0
