+# Northwind Customer Care — client overrides only (NORTHWIND_SOW.md). Service defaults apply to every key not set here.
+name: Northwind
+tz: America/Chicago              # SOW 1.4: operating hours are local (America/Chicago)
+interval_minutes: 30             # SOW 1.5: 30-minute planning interval
+operating_hours: [6, 24]         # SOW 1.4: 06:00-24:00 local, seven days a week
+aht_smoothing: interval          # SOW 1.2: each interval's own average handle time
+sla:                             # SOW 1.2: fraction answered within seconds, per queue
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 20}
+min_rest_hours: 11               # SOW 2.1: elapsed rest between shifts
+split_contracts: [PT]            # SOW 2.2: split shifts only for part-time agents
+break_placement: surplus         # SOW 2.3: break in the interval with the largest gross coverage surplus
