+def audit_week_rules(sched: pd.DataFrame, req: pd.DataFrame, cfg: dict, agents: list[Agent], gross: dict) -> dict[str, int]:
+    """Rules of the week-aware scheduler (`scheduler: week`): rest between shifts, split shifts only
+    for `split_shift_contracts`, and break placement (one break of `break.minutes` per long shift,
+    starting in the break window, in an interval with the queue's largest gross surplus)."""
+    by_id = {a.agent_id: a for a in agents}
+    z = ZoneInfo(cfg["tz"])
+    rule = cfg["break"]
+    lo, hi = rule["window_hours"]
+    step = timedelta(minutes=cfg["interval_minutes"])
+    required = {q: dict(zip(g["interval_start_utc"], g["required"])) for q, g in req.groupby("queue")}
+    grid = sorted(set(req["interval_start_utc"]))
+    min_rest = timedelta(hours=float(cfg.get("min_rest_hours") or 0))
+    splits = cfg.get("split_shift_contracts")
+    v = {"rest": 0, "split_shift": 0, "breaks": 0, "break_placement": 0}
+    for aid, g in sched.groupby("agent_id"):
+        a = by_id.get(aid)
+        g = g.assign(day=[t.astimezone(z).date() for t in g["segment_start_utc"]]).sort_values("segment_start_utc")
+        shifts = []
+        for _day, s in g.groupby("day"):
+            start, end = s["segment_start_utc"].min(), s["segment_end_utc"].max()
+            length = float(((s["segment_end_utc"] - s["segment_start_utc"]).dt.total_seconds() / 3600).sum())
+            shifts.append((start, end))
+            if len(s) > 1 and splits is not None and (a is None or a.contract not in splits):
+                v["split_shift"] += 1
+            b = s[s["break_minutes"] > 0]
+            if length < rule["min_shift_hours"] - 1e-9:
+                v["breaks"] += int(len(b) > 0)
+                continue
+            if len(b) != 1 or int(b["break_minutes"].iloc[0]) != rule["minutes"]:
+                v["breaks"] += 1
+                continue
+            bs = b["break_start_utc"].iloc[0]
+            q = s["queue"].iloc[0]
+            win = [t for t in grid if start + timedelta(hours=lo) <= t <= start + timedelta(hours=hi)
+                   and any(x <= t < y for x, y in zip(s["segment_start_utc"], s["segment_end_utc"]))]
+            slot = bs.floor(step)
+            if not win or slot not in win or bs + timedelta(minutes=rule["minutes"]) > slot + step:
+                v["break_placement"] += 1
+                continue
+            surplus = {t: gross[q][t] - required[q][t] for t in win}
+            if surplus[slot] < max(surplus.values()):
+                v["break_placement"] += 1
+        for (_s0, e0), (s1, _e1) in zip(shifts, shifts[1:]):
+            if s1 - e0 < min_rest:
+                v["rest"] += 1
+    return v
 
 
