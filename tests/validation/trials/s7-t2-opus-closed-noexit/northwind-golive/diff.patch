@@ -0,0 +1,428 @@
+"""Week-aware template placement for contracts with rest, split-shift and break-placement rules.
+
+Selected with `scheduler: week` in a client config (Northwind). Clients without it keep
+`wfm/scheduler/greedy.py`. Builds on the WFM-231 draft (`greedy_v2.py`), with its rest check fixed
+(the draft accepted a shift when rest was *shorter* than the minimum).
+
+Rules enforced while placing (each from config):
+  - weekly elapsed-hour caps per contract (`weekly_hours`), `max_consecutive_days`, one template per
+    local day, skills, no overlap;
+  - `min_rest_hours` of elapsed time between the end of one shift and the start of the next;
+  - split templates only for contracts in `split_shift_contracts` (and the template's own eligibility);
+  - `templates`: the template ids the client may use (default: every template inside operating hours);
+  - `min_cover` floors, counted on the queue only (`cross_skill_weight: 0`) and, with
+    `min_cover_net_of_breaks`, net of breaks.
+
+Breaks (`break_placement: surplus`): every shift of `break.min_shift_hours` or more gets one break of
+`break.minutes`, starting at a planning interval whose start lies `break.window_hours` after the shift
+start, in the interval where the queue's gross coverage surplus (agents on the queue ignoring breaks,
+minus required) is largest. Ties go to the interval that leaves the most net cover.
+
+Because the break rule fixes where breaks fall, the plan is built in rounds: place shifts against a
+target, place breaks, find the intervals where net cover falls short (requirement or floor), raise
+the target there and plan again. The best round that satisfies the floors wins (fewest
+understaffed intervals, then fewest hours). Deterministic: fixed template order, agent ids as the
+final tie-break, no randomness (docs/adr/0003-deterministic-scheduling.md).
+"""
+from __future__ import annotations
+
+import math
+from collections import defaultdict
+from datetime import date, datetime, timedelta
+from zoneinfo import ZoneInfo
+
+import pandas as pd
+
+from wfm import constraints
+from wfm.ingest.loader import local_days
+from wfm.roster import Agent
+from wfm.scheduler.greedy import Shift, _covered, _would_exceed_run
+from wfm.scheduler.templates import Template, eligible, templates_for
+
+IDLE_WEIGHT = 0.15   # greedy start: cost of an interval a shift adds above target
+FLOOR_WEIGHT = 4.0   # an uncovered floor interval is worth this many requirement intervals
+
+
+def _templates(cfg: dict) -> list[Template]:
+    tpls = templates_for(cfg)
+    wanted = cfg.get("templates")
+    return [t for t in tpls if wanted is None or t.id in wanted]
+
+
+def _may_take(tpl: Template, a: Agent, cfg: dict) -> bool:
+    if not eligible(tpl, a.contract):
+        return False
+    splits = cfg.get("split_shift_contracts")
+    return not tpl.is_split or splits is None or a.contract in splits
+
+
+def _elapsed_hours(segs) -> float:
+    return sum((e - s).total_seconds() for s, e in segs) / 3600.0
+
+
+class _Plan:
+    """Shift placement against a per-queue, per-interval target (required + floor + extra)."""
+
+    def __init__(self, req: pd.DataFrame, cfg: dict, agents: list[Agent], week: str):
+        self.cfg, self.agents, self.week = cfg, agents, week
+        self.tz = cfg["tz"]
+        self.z = ZoneInfo(self.tz)
+        self.grain = timedelta(minutes=cfg["interval_minutes"])
+        self.queues = list(dict.fromkeys(req["queue"]))
+        self.grid = sorted(set(req["interval_start_utc"]))
+        self.required = {q: dict(zip(g["interval_start_utc"], g["required"])) for q, g in req.groupby("queue")}
+        self.floors = {q: {t: constraints.floor(q, t, cfg) for t in self.grid} for q in self.queues}
+        self.templates = _templates(cfg)
+        self.sla_target = float(cfg.get("sla_target", 0.0))
+        self.operating = {q: {t: constraints.operating(q, t, cfg) for t in self.grid} for q in self.queues}
+        self.n_operating = {q: sum(self.operating[q].values()) for q in self.queues}
+        self.days = local_days(week, self.tz)
+        self.day_grid = {d: [t for t in self.grid if t.astimezone(self.z).date() == d] for d in self.days}
+        self.tpl_segs = {(tpl.id, d): tpl.segments_utc(d, self.tz) for tpl in self.templates for d in self.days}
+        self.tpl_ivs = {(tpl.id, d): _covered(self.tpl_segs[tpl.id, d], self.day_grid[d])
+                        for tpl in self.templates for d in self.days}
+
+        # how hard each queue is to staff: hours it needs over the hours its skilled agents can give
+        caps = cfg["weekly_hours"]
+        self.scarcity = {}
+        for q in self.queues:
+            need_h = sum(self.need(q, t) for t in self.grid) * self.grain.total_seconds() / 3600.0
+            supply = sum(caps[a.contract] for a in agents if q in a.skills)
+            self.scarcity[q] = need_h / supply if supply else 0.0
+
+    def need(self, q: str, t: datetime) -> int:
+        return max(int(self.required[q][t]), self.floors[q][t])
+
+    def place(self, extra: dict, idle_weight: float = 0.5) -> list[Shift]:
+        """Week-wide greedy: repeatedly place the (day, template, queue) that covers the most
+        uncovered target intervals, net of `idle_weight` per interval it would add above target,
+        on the best available agent. Floor intervals that are still uncovered count FLOOR_WEIGHT."""
+        cfg = self.cfg
+        caps = cfg["weekly_hours"]
+        max_run = cfg["max_consecutive_days"]
+        min_rest = timedelta(hours=float(cfg.get("min_rest_hours") or 0))
+        target = {q: {t: self.need(q, t) + extra.get((q, t), 0) for t in self.grid} for q in self.queues}
+        cover = {q: defaultdict(int) for q in self.queues}
+        hours_used: dict[str, float] = defaultdict(float)
+        worked: dict[str, dict[date, tuple[datetime, datetime]]] = defaultdict(dict)   # agent -> day -> (start, end)
+        shifts: list[Shift] = []
+        dead: set[tuple[date, str, str]] = set()
+
+        def ok(a: Agent, tpl: Template, day: date, segs) -> bool:
+            w = worked[a.agent_id]
+            if day in w or hours_used[a.agent_id] + _elapsed_hours(segs) > caps[a.contract] + 1e-9:
+                return False
+            prev, nxt = w.get(day - timedelta(days=1)), w.get(day + timedelta(days=1))
+            if prev and segs[0][0] - prev[1] < min_rest:
+                return False
+            if nxt and nxt[0] - segs[-1][1] < min_rest:
+                return False
+            run, d = 1, day - timedelta(days=1)
+            while d in w:
+                run, d = run + 1, d - timedelta(days=1)
+            d = day + timedelta(days=1)
+            while d in w:
+                run, d = run + 1, d + timedelta(days=1)
+            return run <= max_run
+
+        options = [(day, tpl, q) for day in self.days for tpl in self.templates for q in self.queues
+                   if self.tpl_ivs[tpl.id, day]]
+        while True:
+            best, best_key = None, None
+            for day, tpl, q in options:
+                if (day, tpl.id, q) in dead:
+                    continue
+                ivs = self.tpl_ivs[tpl.id, day]
+                tq, cq, fq = target[q], cover[q], self.floors[q]
+                val = 0.0
+                for t in ivs:
+                    gap = tq[t] - cq[t]
+                    if gap > 0:
+                        val += FLOOR_WEIGHT if cq[t] < fq[t] else 1.0
+                    else:
+                        val -= idle_weight
+                if val <= 0:
+                    continue
+                key = (val, -len(ivs))
+                if best_key is None or key > best_key:
+                    best, best_key = (day, tpl, q), key
+            if best is None:
+                break
+            day, tpl, q = best
+            segs = self.tpl_segs[tpl.id, day]
+            ivs = self.tpl_ivs[tpl.id, day]
+            cands = [a for a in self.agents if q in a.skills and _may_take(tpl, a, cfg) and ok(a, tpl, day, segs)]
+            if not cands:
+                dead.add((day, tpl.id, q))
+                continue
+            a = min(cands, key=lambda x: (
+                round(sum(self.scarcity.get(s, 0.0) for s in x.skills if s != q), 6),  # keep scarce skills free
+                len(x.skills),                                   # keep multi-skilled agents for later
+                hours_used[x.agent_id] / caps[x.contract],
+                x.agent_id))
+            shifts.append(Shift(a.agent_id, q, tpl, day, list(segs), list(ivs)))
+            hours_used[a.agent_id] += _elapsed_hours(segs)
+            worked[a.agent_id][day] = (segs[0][0], segs[-1][1])
+            for t in ivs:
+                cover[q][t] += 1
+        shifts.sort(key=lambda sh: (sh.day, sh.segments[0][0], sh.agent_id))
+        return shifts
+
+    # --- breaks -------------------------------------------------------------------------------
+
+    def gross(self, shifts: list[Shift]) -> dict:
+        g = {q: defaultdict(int) for q in self.queues}
+        for sh in shifts:
+            for t in sh.intervals:
+                g[sh.queue][t] += 1
+        return g
+
+    def break_window(self, sh: Shift) -> list[datetime]:
+        rule = self.cfg["break"]
+        lo, hi = rule["window_hours"]
+        length = timedelta(minutes=rule["minutes"])
+        start = sh.segments[0][0]
+        return [t for t in sh.intervals
+                if start + timedelta(hours=lo) <= t <= start + timedelta(hours=hi)
+                and any(s <= t and t + length <= e for s, e in sh.segments)]
+
+    def place_breaks(self, shifts: list[Shift]) -> None:
+        """SOW-style break rule (see module doc), queue by queue: a queue's surplus only depends on
+        the shifts on that queue."""
+        by_q = defaultdict(list)
+        for sh in shifts:
+            by_q[sh.queue].append(sh)
+        for q, shs in by_q.items():
+            self._breaks_queue(q, shs)
+
+    def _breaks_queue(self, q: str, shifts: list[Shift]) -> dict:
+        """Place the breaks of `shifts` (all on queue `q`); returns {interval: agents on break}."""
+        rule = self.cfg["break"]
+        lo_h, hi_h = rule["window_hours"]
+        req = self.required[q]
+        gross = defaultdict(int)
+        for sh in shifts:
+            for t in sh.intervals:
+                gross[t] += 1
+        breaks = defaultdict(int)
+        plans = []
+        for sh in shifts:
+            sh.break_start, sh.break_minutes = None, 0
+            if sh.hours < rule["min_shift_hours"] - 1e-9:
+                continue
+            win = self.break_window(sh)
+            if not win:
+                continue
+            surplus = {t: gross[t] - req[t] for t in win}
+            top = max(surplus.values())
+            ties = [t for t in win if surplus[t] == top]
+            hi = sh.segments[0][0] + timedelta(hours=hi_h)
+            inner = [t for t in ties if t < hi]   # prefer starts strictly inside the window
+            plans.append((sh, inner or ties))
+        # most constrained shifts first: fewest tied best intervals
+        plans.sort(key=lambda p: (len(p[1]), p[0].segments[0][0], p[0].agent_id))
+        for sh, ties in plans:
+            t = max(ties, key=lambda t: (gross[t] - breaks[t] - self.need(q, t), -t.timestamp()))
+            breaks[t] += 1
+            sh.break_start = t
+            sh.break_minutes = rule["minutes"]
+        self._last_gross = gross
+        return breaks
+
+    def score_day(self, q: str, day: date, shifts: list[Shift]) -> tuple[int, int, int]:
+        """(floor shortfalls, met operating intervals, understaffed agent-intervals) for queue `q` on
+        local `day`, after placing the breaks of `shifts` (the queue's shifts on that day). Shifts
+        never cross local midnight, so a queue-day can be scored on its own."""
+        breaks = self._breaks_queue(q, shifts)
+        gross = self._last_gross
+        net_floor = self.cfg.get("min_cover_net_of_breaks", False)
+        floor_short = met = under = 0
+        req, flo, op = self.required[q], self.floors[q], self.operating[q]
+        for t in self.day_grid[day]:
+            net = gross[t] - breaks[t]
+            if (net if net_floor else gross[t]) < flo[t]:
+                floor_short += 1
+            if op[t]:
+                if net >= req[t]:
+                    met += 1
+                under += max(0, req[t] - net)
+        return floor_short, met, under
+
+    # --- checking ------------------------------------------------------------------------------
+
+    def shortfalls(self, shifts: list[Shift]) -> tuple[list, list]:
+        """(requirement shortfalls, floor shortfalls) as (queue, interval) lists, net of breaks."""
+        gross = self.gross(shifts)
+        brk = {q: defaultdict(int) for q in self.queues}
+        for sh in shifts:
+            if sh.break_start is not None:
+                brk[sh.queue][sh.break_start] += 1
+        net_floor = self.cfg.get("min_cover_net_of_breaks", False)
+        req_short, floor_short = [], []
+        for q in self.queues:
+            for t in self.grid:
+                net = gross[q][t] - brk[q][t]
+                if net < self.required[q][t]:
+                    req_short.append((q, t))
+                if (net if net_floor else gross[q][t]) < self.floors[q][t]:
+                    floor_short.append((q, t))
+        return req_short, floor_short
+
+    # --- local search ----------------------------------------------------------------------------
+
+    def agent_ok(self, a: Agent, mine: list[Shift], tpl: Template, day: date, q: str) -> bool:
+        """Can agent `a`, already holding `mine` (other shifts), also take `tpl` on `day` on `q`?"""
+        cfg = self.cfg
+        if q not in a.skills or not _may_take(tpl, a, cfg):
+            return False
+        segs = self.tpl_segs[tpl.id, day]
+        days = {sh.day: sh for sh in mine}
+        if day in days:
+            return False
+        if sum(sh.hours for sh in mine) + _elapsed_hours(segs) > cfg["weekly_hours"][a.contract] + 1e-9:
+            return False
+        min_rest = timedelta(hours=float(cfg.get("min_rest_hours") or 0))
+        prev, nxt = days.get(day - timedelta(days=1)), days.get(day + timedelta(days=1))
+        if prev and segs[0][0] - prev.segments[-1][1] < min_rest:
+            return False
+        if nxt and nxt.segments[0][0] - segs[-1][1] < min_rest:
+            return False
+        run, d = 1, day - timedelta(days=1)
+        while d in days:
+            run, d = run + 1, d - timedelta(days=1)
+        d = day + timedelta(days=1)
+        while d in days:
+            run, d = run + 1, d + timedelta(days=1)
+        return run <= cfg["max_consecutive_days"]
+
+    def improve(self, shifts: list[Shift], hours_cap: float | None, max_sweeps: int = 20) -> list[Shift]:
+        """Deterministic first-improvement hill climb over single-shift moves: drop a shift, change
+        its template or queue on the same day, move it to another day, or add a shift for an agent
+        with spare hours. Objective, lexicographic: floor shortfalls, intervals short of the weekly
+        attainment target (`sla_target`), unmet operating intervals, understaffed agent-intervals,
+        scheduled hours. A move never takes the hours above `hours_cap`."""
+        by_id = {a.agent_id: a for a in self.agents}
+        shifts = list(shifts)
+        cell = defaultdict(list)                       # (queue, day) -> shifts
+        for sh in shifts:
+            cell[sh.queue, sh.day].append(sh)
+        dscore = {(q, d): self.score_day(q, d, cell[q, d]) for q in self.queues for d in self.days}
+        hours = sum(sh.hours for sh in shifts)
+        need_met = {q: math.ceil(self.sla_target * self.n_operating[q] - 1e-9) for q in self.queues}
+
+        def total(ds, h):
+            floor_s = under = 0
+            met = defaultdict(int)
+            for (q, _d), (f, m, u) in ds.items():
+                floor_s += f
+                met[q] += m
+                under += u
+            short = sum(max(0, need_met[q] - met[q]) for q in self.queues)
+            unmet = sum(self.n_operating[q] - met[q] for q in self.queues)
+            return floor_s, short, unmet, under, h
+
+        current = total(dscore, hours)
+
+        def mk(agent_id, q, tpl, day):
+            return Shift(agent_id, q, tpl, day, list(self.tpl_segs[tpl.id, day]), list(self.tpl_ivs[tpl.id, day]))
+
+        def try_move(old: Shift | None, new: Shift | None) -> bool:
+            nonlocal current, hours
+            h = hours - (old.hours if old else 0) + (new.hours if new else 0)
+            if hours_cap is not None and h > hours_cap + 1e-9 and h > hours:
+                return False
+            keys = {(s.queue, s.day) for s in (old, new) if s is not None}
+            cand = {}
+            for k in keys:
+                lst = [s for s in cell[k] if s is not old]
+                if new is not None and (new.queue, new.day) == k:
+                    lst.append(new)
+                cand[k] = lst
+            ds = dict(dscore)
+            for k, lst in cand.items():
+                ds[k] = self.score_day(k[0], k[1], lst)
+            score = total(ds, h)
+            if score < current:
+                cell.update(cand)
+                dscore.update(ds)
+                current, hours = score, h
+                if old is not None:
+                    shifts.remove(old)
+                if new is not None:
+                    shifts.append(new)
+                return True
+            for k in keys:   # put the breaks of the unchanged cells back
+                self._breaks_queue(k[0], cell[k])
+            return False
+
+        for _ in range(max_sweeps):
+            improved = False
+            for sh in sorted(shifts, key=lambda s: (s.day, s.segments[0][0], s.queue, s.agent_id)):
+                if sh not in shifts:
+                    continue
+                if try_move(sh, None):
+                    improved = True
+                    continue
+                a = by_id[sh.agent_id]
+                others = [s for s in shifts if s.agent_id == sh.agent_id and s is not sh]
+                moves = [(sh.day, tpl, q) for tpl in self.templates for q in self.queues]
+                moves += [(d, tpl, sh.queue) for d in self.days if d != sh.day for tpl in self.templates]
+                for day, tpl, q in moves:
+                    if (day, tpl.id, q) == (sh.day, sh.template.id, sh.queue) or not self.tpl_ivs[tpl.id, day]:
+                        continue
+                    if self.agent_ok(a, others, tpl, day, q) and try_move(sh, mk(a.agent_id, q, tpl, day)):
+                        improved = True
+                        break
+            for a in self.agents:
+                mine = [s for s in shifts if s.agent_id == a.agent_id]
+                added = True
+                while added and sum(s.hours for s in mine) < self.cfg["weekly_hours"][a.contract] - 1e-9:
+                    added = False
+                    for day in self.days:
+                        for tpl in self.templates:
+                            for q in sorted(a.skills):
+                                if q in self.queues and self.tpl_ivs[tpl.id, day] and self.agent_ok(a, mine, tpl, day, q):
+                                    new = mk(a.agent_id, q, tpl, day)
+                                    if try_move(None, new):
+                                        mine.append(new)
+                                        added = improved = True
+                                        break
+                            if added:
+                                break
+                        if added:
+                            break
+            if not improved:
+                break
+        for k, lst in cell.items():
+            self._breaks_queue(k[0], lst)
+        shifts.sort(key=lambda sh: (sh.day, sh.segments[0][0], sh.agent_id))
+        return shifts
+
+    def trim(self, shifts: list[Shift], hours_cap: float | None) -> list[Shift]:
+        """Safety net for the efficiency bound: while scheduled hours exceed `hours_cap`, drop the
+        shift whose removal costs least (never one that opens a floor gap)."""
+        shifts = list(shifts)
+        while hours_cap is not None and sum(sh.hours for sh in shifts) > hours_cap + 1e-9:
+            best, best_cost = None, None
+            for sh in shifts:
+                same = [s for s in shifts if s.queue == sh.queue and s.day == sh.day]
+                before = self.score_day(sh.queue, sh.day, same)
+                after = self.score_day(sh.queue, sh.day, [s for s in same if s is not sh])
+                cost = (after[0] - before[0], before[1] - after[1], after[2] - before[2], -sh.hours)
+                if best_cost is None or cost < best_cost:
+                    best, best_cost = sh, cost
+            if best is None or best_cost[0] > 0:
+                break
+            shifts.remove(best)
+        self.place_breaks(shifts)
+        return shifts
+
+
+def schedule_week(req: pd.DataFrame, cfg: dict, agents: list[Agent], week: str) -> list[Shift]:
+    plan = _Plan(req, cfg, agents, week)
+    required_hours = float(req["required"].sum()) * cfg["interval_minutes"] / 60.0
+    cap = cfg.get("efficiency_cap")
+    hours_cap = cap * required_hours if cap is not None else None
+    shifts = plan.place({}, idle_weight=IDLE_WEIGHT)
+    shifts = plan.improve(shifts, hours_cap)
+    return plan.trim(shifts, hours_cap)
