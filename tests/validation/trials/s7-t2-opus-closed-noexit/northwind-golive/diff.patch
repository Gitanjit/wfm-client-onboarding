+# Northwind Traders — local-time export with a UTC offset per row, 30-minute grain, US Central.
+# Contract: docs/NORTHWIND_SOW.md (go-live 2026-W44). Every key below restates a SOW term; the SOW wins.
+name: Northwind Traders
+interval_minutes: 30                 # SOW 1.5
+tz: America/Chicago                  # SOW 1.4
+operating_hours: [6, 24]             # SOW 1.4
+queues: [priority, standard, vip]    # SOW 1.1
+queue_hours: {vip: [8, 20]}          # SOW 1.4: vip contacts arrive 08:00-20:00; its operating intervals
+enforce_operating_hours: true        # SOW 1.4: outside operating hours no volume, no staff required
+week_grid: full                      # every 30-minute interval of the ISO week (DST weeks: 334 or 338)
+
+sla:                                 # SOW 1.2
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 20}
+  vip: {target: 0.90, seconds: 20}
+occupancy_cap: 0.85                  # SOW 1.3, applied in the staffing call (WFM-212 fixed)
+aht_smoothing: interval              # SOW 1.2: the interval's own average handle time
+queueing: erlang                     # SOW 1.2: Erlang C, no abandonment
+attainment_basis: service_level      # SOW 1.2: interval met when net scheduled >= required
+attainment_intervals: operating      # SOW 1.6: share of operating intervals, not of intervals with volume
+sla_target: 0.95                     # SOW 1.6: weekly attainment per queue
+efficiency_cap: 1.57                 # SOW 1.6: scheduled hours <= 1.57 x required hours
+
+min_cover: {vip: {agents: 1, hours: [6, 24]}}   # SOW 2.6, counted net of breaks
+min_cover_net_of_breaks: true
+cross_skill_weight: 0.0              # SOW 1.2: a person counts once, on the queue they are scheduled on
+
+scheduler: week                      # wfm/scheduler/week.py: rest, PT-only splits, surplus breaks
+min_rest_hours: 11                   # SOW 2.1
+split_shift_contracts: [PT]          # SOW 2.2
+templates: [E8, D8, L8, N8, P6a, P6b, P4]   # SOW 2.5 subset; S44 not planned: its 2-5 h break window spans the gap
+break_placement: surplus             # SOW 2.3
+weekly_hours: {FT: 40, PT: 24}       # SOW 2.4 (service defaults)
+max_consecutive_days: 5
