+def earliest_start(queue: str, cfg: dict) -> float | None:
+    """`queue_earliest_start[queue]`: local hour before which nobody may be scheduled on the queue
+    (Litware SOW 2.5: no agent on `email` before 09:00). None when the client sets none."""
+    h = (cfg.get("queue_earliest_start") or {}).get(queue)
+    return None if h is None else float(h)
+
+
+def template_allowed_on(tpl, queue: str, cfg: dict) -> bool:
+    """A template may be worked on `queue` unless a segment starts before the queue's earliest start."""
+    h = earliest_start(queue, cfg)
+    return h is None or all(s >= h for s, _e in tpl.segments)
+
+
+def exceptions(req, cfg: dict, agents, templates) -> list[tuple[str, datetime]]:
+    """Intervals whose target the scheduling rules make impossible (Litware SOW 2.6): an operating
+    interval with a requirement that more agents than could ever be on the queue then. An agent can
+    be on the queue at `t` only if they hold the skill and some template allowed on the queue (see
+    `template_allowed_on`) covers `t`'s local wall-clock time. Example: `email` before 09:00."""
+    z = ZoneInfo(cfg["tz"])
+    out = []
+    for r in req.itertuples(index=False):
+        if r.required <= 0 or not operating(r.queue, r.interval_start_utc, cfg):
+            continue
+        loc = r.interval_start_utc.astimezone(z)
+        h = loc.hour + loc.minute / 60
+        reachable = any(s <= h < e for tpl in templates if template_allowed_on(tpl, r.queue, cfg)
+                        for s, e in tpl.segments)
+        capacity = sum(1 for a in agents if r.queue in a.skills) if reachable else 0
+        if capacity < r.required:
+            out.append((r.queue, r.interval_start_utc))
+    return sorted(out, key=lambda x: (x[1], x[0]))
