+# Litware Support — end-stamped local-time export with a UTC offset per row, 20-minute grain, UK time.
+# Contract: docs/LITWARE_SOW.md (go-live 2027-W11). Every key below restates a SOW term; the SOW wins.
+name: Litware Support
+interval_minutes: 20                 # SOW 1.5 (export rows stamped with the interval END; see loader)
+tz: Europe/London                    # SOW 1.4
+operating_hours: [7, 21]             # SOW 1.4
+queues: [priority, standard, email]  # SOW 1.1
+# email contacts arrive 07:00-19:00 (SOW 1.4) but its operating intervals are the service hours 07:00-21:00
+enforce_operating_hours: true        # SOW 1.4: outside operating hours no volume, no staff required
+week_grid: full                      # every 20-minute interval of the ISO week (504; DST weeks 501 / 507)
+
+sla:                                 # SOW 1.2
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 30}
+  email: {target: 0.80, seconds: 300}
+occupancy_cap: 0.85                  # SOW 1.3
+aht_smoothing: interval              # SOW 1.2: the interval's own average handle time
+queueing: erlang                     # SOW 1.2: Erlang C, no abandonment
+attainment_basis: service_level      # SOW 1.2: interval met when net scheduled >= required
+attainment_intervals: operating      # SOW 1.6: share of operating intervals ...
+attainment_excludes_exceptions: true # SOW 1.6 / 2.6: ... leaving out the intervals listed under Exceptions
+sla_target: 0.95                     # SOW 1.6: weekly attainment per queue
+efficiency_cap: 1.45                 # SOW 1.6: scheduled hours <= 1.45 x required hours
+
+min_cover: {priority: {agents: 2, hours: [7, 21]}}   # SOW 2.4, counted net of breaks
+min_cover_net_of_breaks: true
+cross_skill_weight: 0.0              # SOW 1.2: a person counts once, on the queue they are scheduled on
+queue_earliest_start: {email: 9}     # SOW 2.5: nobody on email before 09:00 local
+
+scheduler: week                      # wfm/scheduler/week.py: rest, PT-only splits, surplus breaks
+min_rest_hours: 11                   # SOW 2.1
+split_shift_contracts: [PT]          # SOW 2.2
+templates: [D8, L8, P6a, P6b, P4]    # SOW 2.10 / ARCHITECTURE; S44 not planned (break window spans its gap)
+break_placement: surplus             # SOW 2.3
+break_avoid_window_end: true         # SOW 2.3: prefer breaks starting strictly inside the 2-5 h window
+weekly_hours: {FT: 40, PT: 24}       # SOW 2.9 (service defaults)
+max_consecutive_days: 5
+
+runbook: true                        # SOW 3: out/litware/RUNBOOK.md each run (wfm/report/runbook.py)
+runbook_note: docs/LITWARE_HANDOVER.md
+runbook_files_changed: [configs/litware.yaml, wfm/ingest/loader.py, wfm/constraints.py, wfm/scheduler/week.py, wfm/evaluate/metrics.py, wfm/report/runbook.py, wfm/cli.py, clients/registry.yaml, clients/README.md, docs/LITWARE_HANDOVER.md, docs/ARCHITECTURE.md, docs/CHANGELOG.md, tests_unit/test_litware.py, tests_unit/test_registry.py, tests_unit/test_cli_subcommands.py]
