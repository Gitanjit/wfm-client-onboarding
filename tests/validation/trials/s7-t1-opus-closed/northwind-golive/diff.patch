+# Northwind Traders — local-time export with a UTC offset per row, US Central. Contract: docs/NORTHWIND_SOW.md
+# (go-live 2026-W44). Every key below is the SOW's figure or rule; the service defaults are not touched.
+name: Northwind Traders
+interval_minutes: 30                 # SOW §1.5
+tz: America/Chicago
+operating_hours: [6, 24]             # SOW §1.4
+queues: [priority, standard, vip]    # SOW §1.1
+queue_hours: {vip: [8, 20]}          # SOW §1.4: vip operating intervals
+operating_hours_strict: true         # SOW §1.4: outside operating hours, no staff required
+
+sla:                                 # SOW §1.2, per interval
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 20}
+  vip: {target: 0.90, seconds: 20}
+sla_target: 0.95                     # SOW §1.6: weekly attainment per queue
+attainment_intervals: operating      # SOW §1.6: denominator is every operating interval, not intervals with volume
+aht_smoothing: interval              # SOW §1.2: each interval's own AHT
+occupancy_cap: 0.85                  # SOW §1.3
+enforce_occupancy_cap: true          # WFM-212 is still open for the service default; applied for Northwind
+max_hours_ratio: 1.57                # SOW §1.6: scheduled hours <= 1.57 x required hours
+
+scheduler: week                      # wfm/scheduler/week.py: rest, split and break rules while placing
+min_rest_hours: 11                   # SOW §2.1, elapsed
+split_shift_contracts: [PT]          # SOW §2.2
+templates: [E8, D8, L8, N8, P6a, P6b, P4]   # SOW §2.5 (ARCHITECTURE templates; S44 not used, see RUNBOOK)
+break:                               # SOW §2.3
+  min_shift_hours: 6
+  minutes: 20
+  window_hours: [2, 5]
+  placement: surplus
+min_cover: {vip: {agents: 1, hours: [6, 24]}}   # SOW §2.6
+min_cover_net: true                  # floor counted on the queue itself, net of breaks
+cross_skill_weight: 0                # SOW §1.2: a person counts once, on the queue they are scheduled on
+reconciliation_report: true          # writes RUNBOOK.md and exceptions.md (SOW §2.7, §3) next to eval.json
