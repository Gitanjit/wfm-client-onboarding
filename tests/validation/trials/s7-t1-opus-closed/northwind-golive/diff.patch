+"""Week-aware scheduler for contracts with rest, split-shift, break-placement and net-cover rules.
+
+Selected with `scheduler: week` in a client config (the service default stays `greedy`, wfm/scheduler/greedy.py).
+It supersedes the WFM-231 draft (`greedy_v2.py`) for the clients that opt in.
+
+What it enforces while placing shifts (each from the client config):
+  - one template per agent per local day; skills; weekly elapsed-hour caps (`weekly_hours`);
+    at most `max_consecutive_days` consecutive local days;
+  - `min_rest_hours`: elapsed time between the end of one shift and the start of the next, in the week;
+  - `split_shift_contracts`: contracts allowed split templates (e.g. [PT]);
+  - `templates`: the template ids the client may use (default: every template that fits its hours);
+  - `break.placement: surplus`: one break per shift of `break.min_shift_hours` or more, starting
+    `break.window_hours` after the shift start, in the interval of the window where the queue's gross
+    surplus (agents on the queue ignoring breaks, minus required) is largest; ties go to the interval with
+    the fewest breaks already placed;
+  - cover is counted net of breaks, against max(required, `min_cover` floor); one person counts once, on
+    the queue they are scheduled on (no cross-skill credit).
+
+Method (deterministic): (1) greedy construction - repeatedly add the (day, template, queue) shift that
+removes the most uncovered agent-intervals net of a waste penalty, on the most suitable free agent;
+breaks are re-placed after every addition; (2) pruning - drop shifts, then shorten them, wherever the
+uncovered total does not get worse. Several waste penalties are tried and the best week is kept
+(fewest uncovered agent-intervals, then fewest hours).
+"""
+from __future__ import annotations
+
+import time
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date, datetime, timedelta
+
+import pandas as pd
+
+from wfm import constraints
+from wfm import hours as op_hours
+from wfm.ingest.loader import local_days
+from wfm.roster import Agent
+from wfm.scheduler.greedy import Shift
+from wfm.scheduler.templates import Template, templates_for
+
+WASTE_PENALTIES = (0.25, 0.4, 0.6, 0.8, 1.0)
+
+
+@dataclass(frozen=True)
+class Slot:
+    """A template on one local day: its UTC segments, the grid intervals it covers, its break window."""
+    day: date
+    tpl: Template
+    segs: tuple[tuple[datetime, datetime], ...]
+    ivs: tuple[int, ...]             # indices into the week grid
+    window: tuple[int, ...]          # grid indices where its break may start (empty: no break)
+    hours: float                     # elapsed
+    edge: tuple[int, ...] = ()       # window indices exactly at the window's end (start + 5 h)
+
+    @property
+    def start(self) -> datetime:
+        return self.segs[0][0]
+
+    @property
+    def end(self) -> datetime:
+        return self.segs[-1][1]
+
+
+@dataclass(eq=False)
+class Placed:
+    agent: Agent
+    queue: str
+    slot: Slot
+    brk: int | None = None
+
+
+def allowed_templates(cfg: dict) -> list[Template]:
+    tpls = templates_for(cfg)
+    ids = cfg.get("templates")
+    if ids:
+        unknown = set(ids) - {t.id for t in tpls}
+        if unknown:
+            raise SystemExit(f"templates not available within operating hours: {sorted(unknown)}")
+        tpls = [t for t in tpls if t.id in ids]
+    return tpls
+
+
+def _slots(grid: list, cfg: dict, week: str) -> list[Slot]:
+    tz = cfg["tz"]
+    rule = cfg["break"]
+    grain = timedelta(minutes=cfg["interval_minutes"])
+    blen = timedelta(minutes=rule["minutes"])
+    lo, hi = (timedelta(hours=h) for h in rule["window_hours"])
+    pos = {t: i for i, t in enumerate(grid)}
+    out = []
+    for day in local_days(week, tz):
+        for tpl in allowed_templates(cfg):
+            segs = tuple(tpl.segments_utc(day, tz))
+            ivs = tuple(pos[t] for s, e in segs for t in grid if s <= t < e)
+            if not ivs:
+                continue
+            hours = sum((e - s).total_seconds() for s, e in segs) / 3600.0
+            window: tuple[int, ...] = ()
+            if hours >= rule["min_shift_hours"] - 1e-9:
+                st = segs[0][0]
+                window = tuple(i for i in ivs if st + lo <= grid[i] <= st + hi
+                               and any(s <= grid[i] and grid[i] + blen <= e for s, e in segs)
+                               and blen <= grain)
+            edge = tuple(i for i in window if grid[i] == segs[0][0] + hi)
+            out.append(Slot(day, tpl, segs, ivs, window, hours, edge))
+    return out
+
+
+class WeekState:
+    """Shifts placed so far, with per-agent week state and per-queue cover."""
+
+    def __init__(self, cfg: dict, agents: list[Agent], queues: list[str], req: dict, need: dict, n: int,
+                 floor: dict | None = None, open_: dict | None = None):
+        self.cfg = cfg
+        self.agents = agents
+        self.queues = queues
+        self.req = req          # queue -> [required agents per interval]
+        self.need = need        # queue -> [max(required, floor) per interval]
+        self.floor = floor or {q: [0] * n for q in queues}
+        self.open = open_ or {q: [1] * n for q in queues}     # operating intervals (attainment)
+        self.edge_breaks: dict[str, int] = {q: 0 for q in queues}   # breaks forced to start + 5 h
+        self.n = n
+        self.placed: list[Placed] = []
+        self.by_agent: dict[str, dict[date, Placed]] = defaultdict(dict)
+        self.hours: dict[str, float] = defaultdict(float)
+        self.gross = {q: [0] * n for q in queues}
+        self.rest = timedelta(hours=float(cfg.get("min_rest_hours") or 0))
+        self.split_ok = set(cfg.get("split_shift_contracts") or ("FT", "PT"))
+        self.caps = cfg["weekly_hours"]
+        self.max_run = cfg["max_consecutive_days"]
+
+    # --- feasibility -------------------------------------------------------------------------------
+    def can_take(self, a: Agent, q: str, s: Slot) -> bool:
+        if q not in a.skills:
+            return False
+        mine = self.by_agent[a.agent_id]
+        if s.day in mine:
+            return False
+        if s.tpl.is_split and a.contract not in self.split_ok:
+            return False
+        if self.hours[a.agent_id] + s.hours > self.caps[a.contract] + 1e-9:
+            return False
+        days = set(mine) | {s.day}
+        run, d = 1, s.day - timedelta(days=1)
+        while d in days:
+            run, d = run + 1, d - timedelta(days=1)
+        d = s.day + timedelta(days=1)
+        while d in days:
+            run, d = run + 1, d + timedelta(days=1)
+        if run > self.max_run:
+            return False
+        if self.rest:
+            before = [p.slot for dd, p in mine.items() if dd < s.day]
+            after = [p.slot for dd, p in mine.items() if dd > s.day]
+            if before and s.start - max(before, key=lambda x: x.day).end < self.rest:
+                return False
+            if after and min(after, key=lambda x: x.day).start - s.end < self.rest:
+                return False
+        return True
+
+    # --- mutation ----------------------------------------------------------------------------------
+    def add(self, a: Agent, q: str, s: Slot) -> Placed:
+        p = Placed(a, q, s)
+        self.placed.append(p)
+        self.by_agent[a.agent_id][s.day] = p
+        self.hours[a.agent_id] += s.hours
+        g = self.gross[q]
+        for i in s.ivs:
+            g[i] += 1
+        return p
+
+    def remove(self, p: Placed) -> None:
+        self.placed.remove(p)
+        del self.by_agent[p.agent.agent_id][p.slot.day]
+        self.hours[p.agent.agent_id] -= p.slot.hours
+        g = self.gross[p.queue]
+        for i in p.slot.ivs:
+            g[i] -= 1
+
+    # --- breaks and cover --------------------------------------------------------------------------
+    def place_breaks_queue(self, q: str) -> list[int]:
+        """Breaks of the shifts on `q` per the surplus rule; returns breaks per interval. Among tied
+        intervals (the rule allows any), the one with the most net cover to spare."""
+        brk = [0] * self.n
+        g, r, need = self.gross[q], self.req[q], self.need[q]
+        todo = []
+        for p in self.placed:
+            if p.queue != q:
+                continue
+            if not p.slot.window:
+                p.brk = None
+                continue
+            sur = [g[i] - r[i] for i in p.slot.window]
+            m = max(sur)
+            todo.append((p, [i for i, v in zip(p.slot.window, sur) if v == m]))
+        # fewest tied options first, so that shifts with a choice can avoid stacking on the others.
+        # A tied interval inside the window is preferred to one exactly at its end, so that the choice
+        # holds whether "between two and five hours" is read inclusive or exclusive of five.
+        todo.sort(key=lambda x: (len(x[1]), x[0].slot.start, x[0].agent.agent_id))
+        edgy = 0
+        for p, opts in todo:
+            i = min(opts, key=lambda i: (i in p.slot.edge, need[i] - (g[i] - brk[i]), i))
+            p.brk = i
+            brk[i] += 1
+            edgy += i in p.slot.edge
+        self.edge_breaks[q] = edgy
+        return brk
+
+    def place_breaks(self) -> dict[str, list[int]]:
+        return {q: self.place_breaks_queue(q) for q in self.queues}
+
+    def deficit(self) -> tuple[dict[str, list[int]], int]:
+        brk = self.place_breaks()
+        d = {q: [max(0, self.need[q][i] - (self.gross[q][i] - brk[q][i])) for i in range(self.n)]
+             for q in self.queues}
+        return d, sum(sum(v) for v in d.values())
+
+    def queue_cost(self, q: str) -> tuple[int, int, int, int]:
+        """(floor intervals short, operating intervals short of required, uncovered agent-intervals,
+        breaks that only an inclusive reading of the window's end allows)."""
+        brk = self.place_breaks_queue(q)
+        g, r, need, fl, op = self.gross[q], self.req[q], self.need[q], self.floor[q], self.open[q]
+        floor_short = fail = unc = 0
+        for i in range(self.n):
+            net = g[i] - brk[i]
+            if net < need[i]:
+                unc += need[i] - net
+                if net < fl[i]:
+                    floor_short += 1
+                if op[i] and net < r[i]:
+                    fail += 1
+        return floor_short, fail, unc, self.edge_breaks[q]
+
+    def total_hours(self) -> float:
+        return sum(p.slot.hours for p in self.placed)
+
+
+def _agent_key(a: Agent, q: str, s: Slot, st: WeekState, scarcity: dict[str, float]):
+    """Prefer agents whose other skills are least in demand, full-time agents for 8-hour shapes and
+    part-time agents for short ones, then the agent with the fewest hours so far."""
+    other = sum(scarcity.get(k, 0.0) for k in a.skills if k != q)
+    fit = 0 if (a.contract == "FT") == (s.hours >= 8 - 1e-9) else 1
+    return (round(other, 6), fit, st.hours[a.agent_id], a.agent_id)
+
+
+def _construct(st: WeekState, slots: list[Slot], alpha: float, scarcity: dict[str, float]) -> None:
+    dead: set[tuple[int, str]] = set()
+    while True:
+        d, total = st.deficit()
+        if total == 0:
+            return
+        ranked = []
+        for k, s in enumerate(slots):
+            for q in st.queues:
+                if (k, q) in dead:
+                    continue
+                dq = d[q]
+                val = sum(1 for i in s.ivs if dq[i] > 0)
+                if val == 0:
+                    continue
+                score = val - alpha * (len(s.ivs) - val)
+                ranked.append((-score, -val, s.hours, k, q))
+        if not ranked:
+            return
+        ranked.sort()
+        placed = False
+        for _, _, _, k, q in ranked:
+            s = slots[k]
+            cands = [a for a in st.agents if st.can_take(a, q, s)]
+            if not cands:
+                dead.add((k, q))      # placements only add constraints: this stays infeasible
+                continue
+            st.add(min(cands, key=lambda a: _agent_key(a, q, s, st, scarcity)), q, s)
+            placed = True
+            break
+        if not placed:
+            return
+
+
+def _prune(st: WeekState, slots: list[Slot]) -> None:
+    """Drop, then shorten, shifts wherever the uncovered total does not get worse."""
+    _, base = st.deficit()
+    changed = True
+    while changed:
+        changed = False
+        order = sorted(st.placed, key=lambda p: (-p.slot.hours, p.slot.start, p.agent.agent_id))
+        for p in order:
+            st.remove(p)
+            _, tot = st.deficit()
+            if tot <= base:
+                base, changed = tot, True
+            else:
+                st.add(p.agent, p.queue, p.slot)
+        by_day = defaultdict(list)
+        for s in slots:
+            by_day[s.day].append(s)
+        for p in sorted(st.placed, key=lambda p: (-p.slot.hours, p.slot.start, p.agent.agent_id)):
+            for s in sorted(by_day[p.slot.day], key=lambda s: (s.hours, s.tpl.id)):
+                if s.hours >= p.slot.hours - 1e-9:
+                    continue
+                st.remove(p)
+                if st.can_take(p.agent, p.queue, s):
+                    np_ = st.add(p.agent, p.queue, s)
+                    _, tot = st.deficit()
+                    if tot <= base:
+                        base, changed = tot, True
+                        break
+                    st.remove(np_)
+                p = st.add(p.agent, p.queue, p.slot)
+    st.deficit()   # leave breaks placed for the final shifts
+
+
+FLOOR_W, FAIL_W, UNC_W, HOUR_W = 1_000_000, 100, 1, 0.01
+EDGE_W = 5   # a break at exactly start + 5 h: valid as written, avoided where it costs little
+
+
+class Objective:
+    """Lexicographic-in-practice cost of a week: floor shortfalls and hours over the cap (hard), then
+    operating intervals short of required, then uncovered agent-intervals, then hours."""
+
+    def __init__(self, st: WeekState, max_hours: float | None):
+        self.st = st
+        self.max_hours = max_hours
+        self.qc = {q: st.queue_cost(q) for q in st.queues}
+
+    @staticmethod
+    def _q(c) -> float:
+        return FLOOR_W * c[0] + FAIL_W * c[1] + UNC_W * c[2] + EDGE_W * c[3]
+
+    def total(self, qc=None, hours=None) -> float:
+        qc = qc or self.qc
+        hours = self.st.total_hours() if hours is None else hours
+        over = self.max_hours is not None and hours > self.max_hours + 1e-9
+        return sum(self._q(c) for c in qc.values()) + FLOOR_W * over + HOUR_W * hours
+
+    def try_move(self, remove: list[Placed], add: list[tuple[Agent, str, Slot]]) -> bool:
+        """Apply the move if it lowers the cost; otherwise undo it. Returns True if kept."""
+        st = self.st
+        before = self.total()
+        touched = {p.queue for p in remove} | {q for _, q, _ in add}
+        for p in remove:
+            st.remove(p)
+        added = []
+        ok = True
+        for a, q, s in add:
+            if not st.can_take(a, q, s):
+                ok = False
+                break
+            added.append(st.add(a, q, s))
+        if ok:
+            qc = dict(self.qc)
+            for q in touched:
+                qc[q] = st.queue_cost(q)
+            if self.total(qc) < before - 1e-9:
+                self.qc = qc
+                return True
+        for p in added:
+            st.remove(p)
+        for p in remove:
+            st.add(p.agent, p.queue, p.slot)   # re-adds an equal shift; callers re-read st.placed
+        for q in touched:
+            st.place_breaks_queue(q)
+        return False
+
+
+def _improve(st: WeekState, slots: list[Slot], max_hours: float | None, deadline: float) -> None:
+    """Hill-climb on the Objective: add a shift, drop a shift, or move a shift to another day, template
+    or queue of the same agent, on queues that still have intervals short."""
+    obj = Objective(st, max_hours)
+    by_iv: dict[int, list[Slot]] = defaultdict(list)
+    for s in slots:
+        for i in s.ivs:
+            by_iv[i].append(s)
+    improved = True
+    while improved and time.monotonic() < deadline:
+        improved = False
+        short = {q: [i for i in range(st.n) if obj.qc[q][0] or obj.qc[q][1] or obj.qc[q][2]]
+                 for q in st.queues}
+        problem = [q for q in st.queues if any(obj.qc[q])]
+        brk = {q: st.place_breaks_queue(q) for q in problem}
+        gaps = {q: {i for i in short[q] if st.gross[q][i] - brk[q][i] < st.need[q][i]} for q in problem}
+        useful = {q: sorted({s for i in gaps[q] for s in by_iv[i]}, key=lambda s: (s.start, s.tpl.id))
+                  for q in problem}
+        # 1. add a shift on a free agent
+        for q in problem:
+            for s in useful[q]:
+                for a in st.agents:
+                    if time.monotonic() > deadline:
+                        return
+                    if st.can_take(a, q, s) and obj.try_move([], [(a, q, s)]):
+                        improved = True
+        # 2. move a shift (same agent) onto a slot that covers a gap, or drop it
+        for p in sorted(st.placed, key=lambda p: (p.slot.start, p.agent.agent_id)):
+            if p not in st.placed:
+                continue
+            if time.monotonic() > deadline:
+                return
+            if obj.try_move([p], []):
+                improved = True
+                continue
+            done = False
+            for q in problem:
+                if q not in p.agent.skills or done:
+                    continue
+                for s in useful[q]:
+                    if s is p.slot and q == p.queue:
+                        continue
+                    cur = st.by_agent[p.agent.agent_id].get(p.slot.day)
+                    if cur is None:
+                        break
+                    if obj.try_move([cur], [(p.agent, q, s)]):
+                        improved = done = True
+                        break
+        if not improved:
+            # 3. exchange the days/templates of two shifts on the same problem queue (different agents)
+            for q in problem:
+                ps = sorted([p for p in st.placed if p.queue == q], key=lambda p: (p.slot.start, p.agent.agent_id))
+                for x in range(len(ps)):
+                    for y in range(x + 1, len(ps)):
+                        if time.monotonic() > deadline:
+                            return
+                        a, b = ps[x], ps[y]
+                        if a.agent is b.agent or a.slot.tpl is b.slot.tpl and a.slot.day == b.slot.day:
+                            continue
+                        if a not in st.placed or b not in st.placed:
+                            continue
+                        if obj.try_move([a, b], [(a.agent, q, b.slot), (b.agent, q, a.slot)]):
+                            improved = True
+                            # list entries are stale now; restart the pass
+                            break
+                    if improved:
+                        break
+                if improved:
+                    break
+    st.deficit()
+
+
+def _anneal(st: WeekState, slots: list[Slot], max_hours: float | None, iterations: int, seed: int = 44) -> None:
+    """Simulated annealing on the queues still short after the hill-climb (deterministic: fixed seed and
+    iteration count). Moves: another day/template for a shift's agent, hand a shift to another agent,
+    exchange two shifts between agents, add or drop a shift. The best week seen is kept."""
+    import math
+    import random
+    rng = random.Random(seed)
+    obj = Objective(st, max_hours)
+    problem = [q for q in st.queues if obj.qc[q][0] or obj.qc[q][1] or obj.qc[q][3]]
+    if not problem or iterations <= 0:
+        return
+    by_day = defaultdict(list)
+    for s in slots:
+        by_day[s.day].append(s)
+    days = sorted(by_day)
+    pool = {q: [a for a in st.agents if q in a.skills] for q in problem}
+
+    def snapshot():
+        return [(p.agent, p.queue, p.slot) for p in st.placed]
+
+    cur = obj.total()
+    best, best_snap = cur, snapshot()
+    t0, t1 = 40.0, 0.3
+    for it in range(iterations):
+        temp = t0 * (t1 / t0) ** (it / iterations)
+        q = problem[it % len(problem)]
+        mine = [p for p in st.placed if p.queue == q]
+        kind = rng.random()
+        remove, add = [], []
+        if kind < 0.45 and mine:                      # re-slot a shift for its agent
+            p = rng.choice(mine)
+            remove, add = [p], [(p.agent, q, rng.choice(by_day[rng.choice(days)]))]
+        elif kind < 0.65 and mine:                    # hand a shift to another agent
+            p = rng.choice(mine)
+            remove, add = [p], [(rng.choice(pool[q]), q, p.slot)]
+        elif kind < 0.85 and len(mine) > 1:           # exchange two shifts
+            p1, p2 = rng.sample(mine, 2)
+            if p1.agent is p2.agent:
+                continue
+            remove, add = [p1, p2], [(p1.agent, q, p2.slot), (p2.agent, q, p1.slot)]
+        elif kind < 0.93:                             # add a shift
+            remove, add = [], [(rng.choice(pool[q]), q, rng.choice(by_day[rng.choice(days)]))]
+        elif mine:                                    # drop a shift
+            remove = [rng.choice(mine)]
+        if not remove and not add:
+            continue
+        touched = {p.queue for p in remove} | {qq for _, qq, _ in add}
+        for p in remove:
+            st.remove(p)
+        added, ok = [], True
+        for a, qq, s in add:
+            if not st.can_take(a, qq, s):
+                ok = False
+                break
+            added.append(st.add(a, qq, s))
+        if ok:
+            qc = dict(obj.qc)
+            for qq in touched:
+                qc[qq] = st.queue_cost(qq)
+            new = obj.total(qc)
+            if new <= cur or rng.random() < math.exp(-(new - cur) / temp):
+                obj.qc, cur = qc, new
+                if cur < best - 1e-9:
+                    best, best_snap = cur, snapshot()
+                continue
+        for p in added:
+            st.remove(p)
+        for p in remove:
+            st.add(p.agent, p.queue, p.slot)
+    # restore the best week seen
+    for p in list(st.placed):
+        st.remove(p)
+    for a, q, s in best_snap:
+        st.add(a, q, s)
+    st.deficit()
+
+
+def schedule_week(req: pd.DataFrame, cfg: dict, agents: list[Agent], week: str) -> list[Shift]:
+    grid = sorted(set(req["interval_start_utc"]))
+    pos = {t: i for i, t in enumerate(grid)}
+    queues = list(dict.fromkeys(req["queue"]))
+    n = len(grid)
+    required = {q: [0] * n for q in queues}
+    for r in req.itertuples(index=False):
+        required[r.queue][pos[r.interval_start_utc]] = int(r.required)
+    floor = {q: [constraints.floor(q, grid[i], cfg) for i in range(n)] for q in queues}
+    need = {q: [max(required[q][i], floor[q][i]) for i in range(n)] for q in queues}
+    open_ = {q: [int(op_hours.is_open(q, grid[i], cfg)) for i in range(n)] for q in queues}
+    slots = _slots(grid, cfg, week)
+    grain_h = cfg["interval_minutes"] / 60.0
+    ratio = cfg.get("max_hours_ratio")
+    max_hours = ratio * grain_h * sum(sum(v) for v in required.values()) if ratio else None
+
+    # how much a skill is in demand relative to the agents holding it
+    holders = {q: sum(1 for a in agents if q in a.skills) for q in queues}
+    scarcity = {q: (sum(need[q]) / holders[q] if holders[q] else 0.0) for q in queues}
+    lo = min(scarcity.values()) or 1.0
+    scarcity = {q: v / lo for q, v in scarcity.items()}
+
+    best = None
+    for alpha in cfg.get("waste_penalties", WASTE_PENALTIES):
+        st = WeekState(cfg, agents, queues, required, need, n, floor, open_)
+        _construct(st, slots, alpha, scarcity)
+        _prune(st, slots)
+        _, short = st.deficit()
+        key = (short, round(st.total_hours(), 6))
+        if best is None or key < best[0]:
+            best = (key, st)
+    st = best[1]
+    _improve(st, slots, max_hours, time.monotonic() + float(cfg.get("search_seconds", 60)))
+    for seed in range(int(cfg.get("anneal_restarts", 4))):   # reheats, each from the best week so far
+        _anneal(st, slots, max_hours, int(cfg.get("anneal_iterations", 150000)), seed=seed)
+    _improve(st, slots, max_hours, time.monotonic() + float(cfg.get("search_seconds", 60)))
+
+    minutes = cfg["break"]["minutes"]
+    shifts = []
+    for p in sorted(st.placed, key=lambda p: (p.slot.start, p.agent.agent_id)):
+        sh = Shift(p.agent.agent_id, p.queue, p.slot.tpl, p.slot.day, list(p.slot.segs),
+                   [grid[i] for i in p.slot.ivs])
+        if p.brk is not None:
+            sh.break_start = grid[p.brk]
+            sh.break_minutes = minutes
+        shifts.append(sh)
+    return shifts
