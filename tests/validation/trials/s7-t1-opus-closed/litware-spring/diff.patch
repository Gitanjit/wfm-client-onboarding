+def _end_stamped_utc(df: pd.DataFrame, path, grain_min: int) -> pd.Series:
+    """Exports that stamp each row with the local wall-clock END of its interval (Litware): UTC end from
+    the label and the row's own `utc_offset` (authoritative), then back one interval. A label of 24:00 is
+    read as 00:00 the next day. Ends off the grid go to the nearest interval end, with a warning."""
+    raw = df["interval_end_local"].astype(str).str.strip()
+    day = raw.str.slice(0, 10)
+    clock = raw.str.slice(11, 16)
+    midnight = clock == "24:00"
+    if midnight.any():
+        nxt = (pd.to_datetime(day[midnight]) + pd.Timedelta(days=1)).dt.strftime("%Y-%m-%d")
+        day = day.where(~midnight, nxt)
+        clock = clock.where(~midnight, "00:00")
+    stamp = day + " " + clock + df["utc_offset"].astype(str).str.strip()
+    end = pd.to_datetime(stamp, format="%Y-%m-%d %H:%M%z", utc=True)
+    snapped = end.dt.round(f"{grain_min}min")
+    off = raw[snapped != end]
+    if len(off):
+        _warn(f"{path.name}: {len(off)} row(s) stamped off the {grain_min}-minute grid, assigned to the "
+              f"nearest interval end: {', '.join(sorted(set(off)))}")
+    return snapped - pd.Timedelta(minutes=grain_min)
+
