+# Litware Support — local-time export stamped at interval END, with a UTC offset per row, UK time.
+# Contract: docs/LITWARE_SOW.md (go-live 2027-W11). Every key below is the SOW's figure or rule; the
+# service defaults are not touched.
+name: Litware
+interval_minutes: 20                 # SOW §1.5
+tz: Europe/London                    # SOW §1.4
+operating_hours: [7, 21]             # SOW §1.4: 07:00-21:00 local, seven days
+queues: [priority, standard, email]  # SOW §1.1
+operating_hours_strict: true         # SOW §1.4: outside operating hours, no staff required
+
+sla:                                 # SOW §1.2, per interval
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 30}
+  email: {target: 0.80, seconds: 300}
+sla_target: 0.95                     # SOW §1.6: weekly attainment per queue
+attainment_intervals: operating      # SOW §1.6: denominator is every operating interval ...
+attainment_exclude_exceptions: true  # ... leaving out the §2.6 intervals listed under Exceptions
+aht_smoothing: interval              # SOW §1.2: each interval's own AHT
+occupancy_cap: 0.85                  # SOW §1.3
+enforce_occupancy_cap: true          # WFM-212 is still open for the service default; applied for Litware
+max_hours_ratio: 1.45                # SOW §1.6: scheduled hours <= 1.45 x required hours
+
+scheduler: week                      # wfm/scheduler/week.py: rest, split and break rules while placing
+min_rest_hours: 11                   # SOW §2.1, elapsed
+split_shift_contracts: [PT]          # SOW §2.2
+templates: [D8, L8, P6a, P6b, P4]    # SOW §2.10 (ARCHITECTURE, "Templates per client")
+queue_start_hours: {email: 9}        # SOW §2.5: nobody on email before 09:00 local
+break:                               # SOW §2.3
+  min_shift_hours: 6
+  minutes: 20
+  window_hours: [2, 5]
+  placement: surplus
+min_cover: {priority: {agents: 2, hours: [7, 21]}}   # SOW §2.4
+min_cover_net: true                  # floor counted on the queue itself, net of breaks
+edge_break_weight: 60                # avoid breaks at exactly start + 5 h (holds on an exclusive reading of §2.3)
+anneal_cross_queue: true             # search also moves shifts between queues (shared priority;standard agents)
+anneal_restarts: 8                   # more search: Litware weeks run in well under a minute
+cross_skill_weight: 0                # SOW §1.2: a person counts once, on the queue they are scheduled on
+reconciliation_report: true          # RUNBOOK.md (SOW §3, with the Exceptions section) and exceptions.md (§2.7)
+reconciliation_exceptions_section: true   # SOW §2.6/§3: `## Exceptions` list in the RUNBOOK
