--- a/wfm/infeasible.py
+++ b/wfm/infeasible.py
@@ -0,0 +1,49 @@
+"""Intervals whose service-level target the contract's own scheduling rules make impossible to meet
+(Litware SOW §2.6). Switched on with `attainment_exclude_exceptions: true`.
+
+An operating interval of a queue is infeasible when it requires agents and either
+  - no shift the rules allow can put anyone on the queue in it: no allowed template (`templates`, within
+    operating hours) covers it on that queue, given `queue_start_hours` (e.g. nobody on email before
+    09:00); or
+  - more agents are required than hold the queue's skill (nobody may work a queue without the skill).
+
+Such intervals are listed under Exceptions in the weekly report, stay in the week (required hours,
+schedule) and are left out of weekly attainment and of `understaffed_interval_hours`.
+"""
+from __future__ import annotations
+
+import pandas as pd
+
+from wfm import hours as op_hours
+from wfm.ingest.loader import local_days
+
+
+def exception_intervals(req: pd.DataFrame, cfg: dict, agents, week: str) -> list[tuple[str, pd.Timestamp]]:
+    """[(queue, interval_start_utc)] in the order of the required frame (queue, then time)."""
+    if not cfg.get("attainment_exclude_exceptions"):
+        return []
+    from wfm.scheduler.week import allowed_templates
+    grain = pd.Timedelta(minutes=cfg["interval_minutes"])
+    start_hours = {q: float(h) for q, h in (cfg.get("queue_start_hours") or {}).items()}
+    tpls = allowed_templates(cfg)
+    days = local_days(week, cfg["tz"])
+    covered: dict[str, list[tuple]] = {}
+    for q in dict.fromkeys(req["queue"]):
+        spans = []
+        for t in tpls:
+            if q in start_hours and t.segments[0][0] < start_hours[q]:
+                continue
+            for d in days:
+                spans += t.segments_utc(d, cfg["tz"])
+        covered[q] = spans
+    holders = {q: sum(1 for a in agents if q in a.skills) for q in covered}
