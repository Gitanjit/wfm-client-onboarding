+def in_queue_hours(queue: str, t, cfg: dict) -> bool:
+    """True if the interval starting at `t` is inside the queue's local operating hours
+    (`queue_hours[queue]`, else `operating_hours`)."""
+    lo, hi = (cfg.get("queue_hours") or {}).get(queue, cfg["operating_hours"])
+    loc = t.astimezone(ZoneInfo(cfg["tz"]))
+    h = loc.hour + loc.minute / 60
+    return lo <= h < hi
+
