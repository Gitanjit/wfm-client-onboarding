+def week_audit(sched: pd.DataFrame, cfg: dict, agents: list[Agent], req: pd.DataFrame, gross: dict,
+               on_break: dict, grid) -> dict[str, int]:
+    """Rules enforced by the week-aware scheduler (`scheduler: week`): rest between shifts, split
+    shifts only for PT, break placement (`break_placement: max_surplus`), one template per local day,
+    and minimum cover counted on the queue net of breaks."""
+    by_id = {a.agent_id: a for a in agents}
+    z = ZoneInfo(cfg["tz"])
+    rule = cfg["break"]
+    step = timedelta(minutes=cfg["interval_minutes"])
+    lo, hi = (timedelta(hours=x) for x in rule["window_hours"])
+    rest = timedelta(hours=float(cfg.get("min_rest_hours", 0) or 0))
+    required = {q: dict(zip(g["interval_start_utc"], g["required"])) for q, g in req.groupby("queue")}
+    v = {"rest": 0, "split_shift_pt": 0, "one_shift_per_day": 0, "breaks": 0, "min_cover_net": 0}
+    for aid, g in sched.groupby("agent_id"):
+        a = by_id.get(aid)
+        shifts = []   # (local day, start, end, rows)
+        for day, d in g.groupby(g["segment_start_utc"].map(lambda t: t.astimezone(z).date())):
+            d = d.sort_values("segment_start_utc")
+            shifts.append((day, d["segment_start_utc"].min(), d["segment_end_utc"].max(), d))
+            if d["template_id"].nunique() > 1:
+                v["one_shift_per_day"] += 1
+            if len(d) > 1 and (a is None or a.contract != "PT"):
+                v["split_shift_pt"] += 1
+            hours = ((d["segment_end_utc"] - d["segment_start_utc"]).dt.total_seconds() / 3600).sum()
+            breaks = d[d["break_minutes"] > 0]
+            if hours < rule["min_shift_hours"] - 1e-9:
+                v["breaks"] += int(len(breaks) > 0)
+                continue
+            if len(breaks) != 1 or int(breaks["break_minutes"].iloc[0]) != int(rule["minutes"]):
+                v["breaks"] += 1
+                continue
+            b = breaks.iloc[0]
+            start, q = d["segment_start_utc"].min(), b["queue"]
+            bt = b["break_start_utc"]
+            slot = bt.floor(f"{cfg['interval_minutes']}min")
+            window = [t for t in grid if start + lo <= t <= start + hi
+                      and any(r.segment_start_utc <= t and t + timedelta(minutes=int(rule["minutes"])) <= r.segment_end_utc
+                              for r in d.itertuples(index=False))]
+            inside = b["segment_start_utc"] <= bt and bt + timedelta(minutes=int(b["break_minutes"])) <= b["segment_end_utc"]
+            surplus = {t: gross[q][t] - int(required[q].get(t, 0)) for t in window}
+            if not (inside and start + lo <= bt <= start + hi) or not window or slot not in surplus \
+                    or surplus[slot] < max(surplus.values()):
+                v["breaks"] += 1
+        shifts.sort(key=lambda s: s[1])
+        v["rest"] += sum(1 for p, n in zip(shifts, shifts[1:]) if n[1] - p[2] < rest)
+    for q, rule_q in (cfg.get("min_cover") or {}).items():
+        v["min_cover_net"] += sum(1 for t in grid
+                                  if gross[q][t] - on_break[q][t] < constraints.floor(q, t, cfg))
+    return v
