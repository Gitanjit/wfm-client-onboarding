@@ -0,0 +1,330 @@
+"""Week-aware template placement (WFM-231), for clients with `scheduler: week` (Northwind first).
+
+Supersedes the draft in `greedy_v2.py`. Differences from `greedy.py`:
+
+* Placement is over the whole week, not one local day at a time: each step places the
+  (day, template, queue) with the most uncovered requirement per scheduled hour.
+* Rules are enforced while placing: weekly elapsed-hour caps, at most one template per local day,
+  `max_consecutive_days` (both directions, since days are not filled in order), `min_rest_hours`
+  between the end of one shift and the start of the next (elapsed), split templates only for PT,
+  skills.
+* Minimum cover (`min_cover`) is counted on the queue itself, net of breaks.
+* Breaks follow `break_placement: max_surplus`: one break per shift of `break.min_shift_hours` or
+  more, starting `break.window_hours` after shift start, in the planning interval of that window
+  where the queue's gross coverage surplus (agents on the queue ignoring breaks, minus required) is
+  largest. Among tied intervals the one with the fewest breaks already placed is taken.
+* Because breaks depend on the finished schedule, placement and break assignment alternate: after
+  each round, intervals still short net of breaks raise their target and placement resumes.
+* Total scheduled hours stay within `efficiency_cap` x required agent-hours, and shifts that cover
+  nothing short are dropped at the end.
+
+Deterministic: fixed template order, agent ids as the final tie-break.
+"""
+from __future__ import annotations
+
+from collections import defaultdict
+from datetime import date, datetime, timedelta
+from zoneinfo import ZoneInfo
+
+import pandas as pd
+
+from wfm import constraints
+from wfm.ingest.loader import local_days
+from wfm.roster import Agent
+from wfm.scheduler.greedy import Shift, _covered
+from wfm.scheduler.templates import Template, eligible, templates_for
+
+MAX_ROUNDS = 40
+
+
+def _allowed(tpl: Template, contract: str) -> bool:
+    return eligible(tpl, contract) and (not tpl.is_split or contract == "PT")
+
+
+class _Week:
+    def __init__(self, req: pd.DataFrame, cfg: dict, agents: list[Agent], week: str):
+        self.cfg = cfg
+        self.tz = cfg["tz"]
+        self.z = ZoneInfo(self.tz)
+        self.step = timedelta(minutes=cfg["interval_minutes"])
+        self.grain_h = cfg["interval_minutes"] / 60.0
+        self.caps = cfg["weekly_hours"]
+        self.max_run = cfg["max_consecutive_days"]
+        self.rest = timedelta(hours=float(cfg.get("min_rest_hours", 0) or 0))
+        self.agents = sorted(agents, key=lambda a: a.agent_id)
+        self.queues = list(dict.fromkeys(req["queue"]))
+        self.grid = sorted(set(req["interval_start_utc"]))
+        self.required = {q: dict(zip(g["interval_start_utc"], g["required"])) for q, g in req.groupby("queue")}
+        floors = {q: {t: constraints.floor(q, t, self.cfg) for t in self.grid} for q in self.queues}
+        # what each interval must have on the queue net of breaks: the staffing requirement or the floor
+        self.base = {q: {t: max(int(self.required[q][t]), floors[q][t]) for t in self.grid} for q in self.queues}
+        self.extra = {q: defaultdict(int) for q in self.queues}   # raised by the repair rounds
+        self.active = {q: [t for t in self.grid if self.base[q][t] > 0] for q in self.queues}
+        self._windows: dict = {}
+        self.days = local_days(week, self.tz)
+        self.options = []   # (day, template, segments, intervals, hours)
+        for day in self.days:
+            day_grid = [t for t in self.grid if t.astimezone(self.z).date() == day]
+            for tpl in templates_for(cfg):
+                segs = tpl.segments_utc(day, self.tz)
+                hours = sum((e - s).total_seconds() for s, e in segs) / 3600.0
+                self.options.append((day, tpl, segs, _covered(segs, day_grid), hours))
+        req_hours = float(req["required"].sum()) * self.grain_h
+        cap = cfg.get("efficiency_cap")
+        self.hour_budget = cap * req_hours if cap else float("inf")
+        self.shifts: list[Shift] = []
+        self.cover = {q: defaultdict(int) for q in self.queues}
+        self.by_agent: dict[str, list[Shift]] = defaultdict(list)
+
+    # -- agent state ------------------------------------------------------------------------------
+    def hours(self, aid: str) -> float:
+        return sum(s.hours for s in self.by_agent[aid])
+
+    def total_hours(self) -> float:
+        return sum(s.hours for s in self.shifts)
+
+    def can_take(self, a: Agent, day: date, tpl: Template, segs, hours: float) -> bool:
+        if not _allowed(tpl, a.contract):
+            return False
+        mine = self.by_agent[a.agent_id]
+        if any(s.day == day for s in mine):
+            return False
+        if self.hours(a.agent_id) + hours > self.caps[a.contract] + 1e-9:
+            return False
+        start, end = segs[0][0], segs[-1][1]
+        for s in mine:
+            s_start, s_end = s.segments[0][0], s.segments[-1][1]
+            if s.day < day and start - s_end < self.rest:
+                return False
+            if s.day > day and s_start - end < self.rest:
+                return False
+        worked = {s.day for s in mine} | {day}
+        run, d = 1, day - timedelta(days=1)
+        while d in worked:
+            run, d = run + 1, d - timedelta(days=1)
+        d = day + timedelta(days=1)
+        while d in worked:
+            run, d = run + 1, d + timedelta(days=1)
+        return run <= self.max_run
+
+    def pick(self, q: str, day: date, tpl: Template, segs, hours: float) -> Agent | None:
+        cands = [a for a in self.agents if q in a.skills and self.can_take(a, day, tpl, segs, hours)]
+        if not cands:
+            return None
+        # keep cross-skilled agents for the queues only they can serve; then spread hours
+        return min(cands, key=lambda a: (len(a.skills), self.hours(a.agent_id), a.agent_id))
+
+    def add(self, a: Agent, q: str, day: date, tpl: Template, segs, ivs) -> None:
+        sh = Shift(a.agent_id, q, tpl, day, segs, list(ivs))
+        self.shifts.append(sh)
+        self.by_agent[a.agent_id].append(sh)
+        for t in ivs:
+            self.cover[q][t] += 1
+
+    def remove(self, sh: Shift) -> None:
+        self.shifts.remove(sh)
+        self.by_agent[sh.agent_id].remove(sh)
+        for t in sh.intervals:
+            self.cover[sh.queue][t] -= 1
+
+    # -- placement --------------------------------------------------------------------------------
+    def target(self, q: str, t: datetime) -> int:
+        return self.base[q][t] + self.extra[q][t]
+
+    def fill(self) -> None:
+        dead: set = set()
+        while True:
+            best, best_key = None, None
+            for i, (day, tpl, segs, ivs, hours) in enumerate(self.options):
+                for q in self.queues:
+                    if (i, q) in dead:
+                        continue
+                    val = sum(min(1, max(0, self.target(q, t) - self.cover[q][t])) for t in ivs)
+                    if val * self.grain_h < 0.5 - 1e-9:
+                        continue
+                    key = (val / hours, val)
+                    if best_key is None or key > best_key:
+                        best, best_key = (i, q), key
+            if best is None:
+                return
+            i, q = best
+            day, tpl, segs, ivs, hours = self.options[i]
+            if self.total_hours() + hours > self.hour_budget + 1e-9:
+                dead.add(best)
+                continue
+            a = self.pick(q, day, tpl, segs, hours)
+            if a is None:
+                dead.add(best)
+                continue
+            self.add(a, q, day, tpl, segs, ivs)
+
+    # -- breaks and net cover ---------------------------------------------------------------------
+    def place_breaks(self) -> dict:
+        rule = self.cfg["break"]
+        length = timedelta(minutes=rule["minutes"])
+        lo, hi = (timedelta(hours=h) for h in rule["window_hours"])
+        on_break = {q: defaultdict(int) for q in self.queues}
+        for sh in sorted(self.shifts, key=lambda s: (s.segments[0][0], s.agent_id)):
+            sh.break_start, sh.break_minutes = None, 0
+            if sh.hours < rule["min_shift_hours"] - 1e-9:
+                continue
+            start = sh.segments[0][0]
+            window = [t for t in sh.intervals if start + lo <= t <= start + hi
+                      and any(s <= t and t + length <= e for s, e in sh.segments)]
+            if not window:
+                continue
+            q = sh.queue
+            surplus = {t: self.cover[q][t] - int(self.required[q][t]) for t in window}
+            top = max(surplus.values())
+            tied = [t for t in window if surplus[t] == top]
+            t = min(tied, key=lambda t: (on_break[q][t], t))
+            sh.break_start, sh.break_minutes = t, int(rule["minutes"])
+            on_break[q][t] += 1
+        return on_break
+
+    def shortfalls(self, on_break: dict) -> dict:
+        return {(q, t): self.base[q][t] - (self.cover[q][t] - on_break[q][t])
+                for q in self.queues for t in self.grid
+                if self.cover[q][t] - on_break[q][t] < self.base[q][t]}
+
+    def prune(self) -> None:
+        """Drop shifts whose removal leaves no new interval short (net of breaks)."""
+        for sh in sorted(self.shifts, key=lambda s: (-s.hours, s.segments[0][0], s.agent_id), reverse=False):
+            before = len(self.shortfalls(self.place_breaks()))
+            self.remove(sh)
+            if len(self.shortfalls(self.place_breaks())) > before:
+                self.add(next(a for a in self.agents if a.agent_id == sh.agent_id), sh.queue, sh.day,
+                         sh.template, sh.segments, sh.intervals)
+
+
+    # -- local search -----------------------------------------------------------------------------
+    def window(self, sh: Shift) -> list:
+        """Planning intervals where the shift's break may start (cached per day and template)."""
+        key = (sh.day, sh.template.id)
+        if key not in self._windows:
+            rule = self.cfg["break"]
+            length = timedelta(minutes=rule["minutes"])
+            lo, hi = (timedelta(hours=h) for h in rule["window_hours"])
+            start = sh.segments[0][0]
+            self._windows[key] = [t for t in sh.intervals if start + lo <= t <= start + hi
+                                  and any(s <= t and t + length <= e for s, e in sh.segments)]
+        return self._windows[key]
+
+    def queue_breaks(self, q: str) -> dict:
+        """Breaks of the shifts on `q` (they depend on that queue's cover only); returns on-break counts."""
+        rule = self.cfg["break"]
+        on_break = defaultdict(int)
+        cover, required = self.cover[q], self.required[q]
+        for sh in sorted((s for s in self.shifts if s.queue == q), key=lambda s: (s.segments[0][0], s.agent_id)):
+            sh.break_start, sh.break_minutes = None, 0
+            if sh.hours < rule["min_shift_hours"] - 1e-9:
+                continue
+            window = self.window(sh)
+            if not window:
+                continue
+            surplus = {t: cover[t] - int(required[t]) for t in window}
+            top = max(surplus.values())
+            t = min((t for t in window if surplus[t] == top), key=lambda t: (on_break[t], t))
+            sh.break_start, sh.break_minutes = t, int(rule["minutes"])
+            on_break[t] += 1
+        return on_break
+
+    def queue_score(self, q: str) -> tuple:
+        """(weighted misses net of breaks, hours on the queue): floor misses weigh 100, staffing misses 1."""
+        ob = self.queue_breaks(q)
+        miss = 0
+        for t in self.active[q]:
+            net = self.cover[q][t] - ob[t]
+            if net < self.base[q][t]:
+                miss += 100 if net < self.base[q][t] - int(self.required[q][t]) or net < 1 and self.base[q][t] > 0 \
+                    and int(self.required[q][t]) == 0 else 1
+        return miss, sum(s.hours for s in self.shifts if s.queue == q)
+
+    def improve(self, deadline: float) -> None:
+        import time
+        ids = {a.agent_id: a for a in self.agents}
+        opts_by_day = defaultdict(list)
+        for o in self.options:
+            opts_by_day[o[0]].append(o)
+        changed = True
+        while changed and time.monotonic() < deadline:
+            changed = False
+            for q in self.queues:
+                score = self.queue_score(q)
+                # 1) re-template or drop each shift on q
+                for sh in sorted((s for s in self.shifts if s.queue == q), key=lambda s: (s.day, s.agent_id)):
+                    if time.monotonic() > deadline:
+                        return
+                    a = ids[sh.agent_id]
+                    self.remove(sh)
+                    best = None
+                    cand = [None] + [o for o in opts_by_day[sh.day] if o[1].id != sh.template.id]
+                    for o in cand:
+                        if o is not None:
+                            day, tpl, segs, ivs, hours = o
+                            if not self.can_take(a, day, tpl, segs, hours) or \
+                                    self.total_hours() + hours > self.hour_budget + 1e-9:
+                                continue
+                            self.add(a, q, day, tpl, segs, ivs)
+                        sc = self.queue_score(q)
+                        if o is not None:
+                            self.remove(self.by_agent[a.agent_id][-1])
+                        if sc < score and (best is None or sc < best[0]):
+                            best = (sc, o)
+                    if best is None:
+                        self.add(a, q, sh.day, sh.template, sh.segments, sh.intervals)
+                    else:
+                        score, o = best
+                        if o is not None:
+                            self.add(a, q, *o[:4])
+                        changed = True
+                # 2) add a shift for an agent with hours left
+                for a in self.agents:
+                    if q not in a.skills or time.monotonic() > deadline:
+                        continue
+                    best = None
+                    for o in self.options:
+                        day, tpl, segs, ivs, hours = o
+                        if not self.can_take(a, day, tpl, segs, hours) or \
+                                self.total_hours() + hours > self.hour_budget + 1e-9:
+                            continue
+                        self.add(a, q, day, tpl, segs, ivs)
+                        sc = self.queue_score(q)
+                        self.remove(self.by_agent[a.agent_id][-1])
+                        if sc[0] < score[0] and (best is None or sc < best[0]):
+                            best = (sc, o)
+                    if best is not None:
+                        score, o = best
+                        self.add(a, q, *o[:4])
+                        changed = True
+
+
+def schedule_week(req: pd.DataFrame, cfg: dict, agents: list[Agent], week: str) -> list[Shift]:
+    w = _Week(req, cfg, agents, week)
+    best = None
+    for _ in range(MAX_ROUNDS):
+        w.fill()
+        short = w.shortfalls(w.place_breaks())
+        score = len(short)
+        if best is None or score < best[0]:
+            best = (score, [(s.agent_id, s.queue, s.day, s.template, s.segments, s.intervals) for s in w.shifts])
+        if not short:
+            break
+        raised = False
+        for (q, t), gap in short.items():
+            if w.extra[q][t] < 4:
+                w.extra[q][t] += 1
+                raised = True
+        if not raised:
+            break
+    # restore the best round, then drop shifts that cover nothing short
+    for sh in list(w.shifts):
+        w.remove(sh)
+    ids = {a.agent_id: a for a in w.agents}
+    for aid, q, day, tpl, segs, ivs in best[1]:
+        w.add(ids[aid], q, day, tpl, segs, ivs)
+    w.prune()
+    import time
+    w.improve(time.monotonic() + float(cfg.get("search_seconds", 60)))
