+# Litware Support — local-time export stamped at the END of each 20-minute interval, with a per-row UTC
+# offset; Europe/London. Contract: docs/LITWARE_SOW.md (go-live 2027-W11). Keys below describe what the
+# service does for Litware; the SOW, not this file, sets what the contract requires.
+name: Litware Support
+interval_minutes: 20              # SOW 1.5
+export_interval_minutes: 20       # data/litware/README.txt: rows stamped with the interval END
+tz: Europe/London
+operating_hours: [7, 21]          # SOW 1.4
+queues: [priority, standard, email]
+
+# SOW 1.2 / 1.3: Erlang C, no abandonment, each interval's own AHT, occupancy cap applied.
+queueing: erlang
+aht_smoothing: interval
+occupancy_cap: 0.85
+apply_occupancy_cap: true
+sla:
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 30}
+  email:    {target: 0.80, seconds: 300}
+sla_target: 0.95                  # SOW 1.6: weekly attainment per queue
+attainment_basis: service_level
+attainment_intervals: operating   # SOW 1.6: every operating interval (07:00-21:00), less SOW 2.6 exceptions
+exceptions: true                  # SOW 2.6: list infeasible intervals, leave them out of attainment
+
+# SOW 2.4: at least two agents on priority, net of breaks, in every operating interval. SOW 1.2: a person
+# counts once, on the queue they are scheduled on.
+min_cover:
+  priority: {agents: 2, hours: [7, 21]}
+cross_skill_weight: 0.0
+
+# SOW 2.5: nobody on email before 09:00 local (local hours a queue may be staffed; default operating_hours).
+queue_staff_hours:
+  email: [9, 21]
+
+# SOW 2: week-aware scheduler (rest, PT-only splits, break placement by surplus).
+scheduler: week
+min_rest_hours: 11
+efficiency_cap: 1.45              # SOW 1.6
+search_seconds: 120
+break_placement: max_surplus      # SOW 2.3
+weekly_hours: {FT: 40, PT: 24}    # SOW 2.9
+max_consecutive_days: 5
+break:
+  min_shift_hours: 6
+  minutes: 20
+  window_hours: [2, 5]
+
+# Litware's own templates (local wall-clock, inside 07:00-21:00, none crosses midnight).
+extra_templates:
+  - {id: LW-A8, segments: [[7, 15]]}
+  - {id: LW-B8, segments: [[10, 18]]}
+  - {id: LW-C8, segments: [[11, 19]]}
+  - {id: LW-F8, segments: [[12, 20]]}
+  - {id: LW-H6, segments: [[9, 15]]}
+  - {id: LW-J6, segments: [[13, 19]]}
+  - {id: LW-K6, segments: [[11, 17]]}
+  - {id: LW-E4, segments: [[7, 11]]}
+  - {id: LW-L4, segments: [[17, 21]]}
+  - {id: LW-M4, segments: [[14, 18]]}
+  - {id: LW-E10, segments: [[7, 17]]}
+  - {id: LW-D10, segments: [[9, 19]]}
+  - {id: LW-N10, segments: [[11, 21]]}
+  - {id: LW-S, segments: [[7, 11], [17, 21]], eligibility: PT}
+
+runbook:
+  handover: docs/clients/litware_handover.md
+  exceptions: true
+  files_changed:
