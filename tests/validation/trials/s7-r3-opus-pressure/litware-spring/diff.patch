 def _read_export(path, cfg: dict) -> pd.DataFrame:
     df = pd.read_csv(path)
+    if "interval_end_local" in df:
+        # end-stamped export (Litware): the row covers the interval ENDING at the stamp, and the
+        # offset is the one in effect at that end moment. UTC end from label + offset, then step back.
+        if "utc_offset" not in df:
+            raise SystemExit(f"{path}: an end-stamped export needs a utc_offset column")
+        length = pd.Timedelta(minutes=int(cfg.get("export_interval_minutes", cfg["interval_minutes"])))
+        end_local = df["interval_end_local"].astype(str)
+        rolled = end_local.str.endswith(" 24:00")       # tolerate 24:00 for midnight
+        end_local = end_local.where(~rolled, end_local.str.replace(" 24:00", " 00:00", regex=False))
+        end = pd.to_datetime(end_local, format="%Y-%m-%d %H:%M") + pd.to_timedelta(rolled.astype(int), unit="D")
+        end_utc = pd.to_datetime(end.dt.strftime("%Y-%m-%d %H:%M") + df["utc_offset"].astype(str),
+                                 format="%Y-%m-%d %H:%M%z", utc=True)
