+def staff_hours_audit(sched: pd.DataFrame, cfg: dict) -> int:
+    """Segments on a queue outside its `queue_staff_hours` (local), e.g. email before 09:00."""
+    z = ZoneInfo(cfg["tz"])
+    n = 0
+    for r in sched.itertuples(index=False):
+        lo, hi = constraints.staff_hours(r.queue, cfg)
+        s, e = r.segment_start_utc.astimezone(z), r.segment_end_utc.astimezone(z)
+        sh = s.hour + s.minute / 60
+        eh = (e.hour + e.minute / 60) or (24.0 if e.date() > s.date() else 0.0)
+        n += int(not (lo <= sh and eh <= hi))
+    return n
 
 
