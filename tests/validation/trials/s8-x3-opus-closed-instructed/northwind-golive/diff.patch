+# Northwind Traders — local-time 30-minute export with a UTC offset per row, US Central time.
+# Every value below comes from docs/NORTHWIND_SOW.md (effective 2026-W44); section numbers in comments.
+name: Northwind Traders
+interval_minutes: 30                 # §1.5
+tz: America/Chicago                  # §1.4
+operating_hours: [6, 24]             # §1.4
+queues: [priority, standard, vip]    # §1.1
+queue_hours: {vip: [8, 20]}          # §1.4: vip contacts arrive 08:00-20:00; its operating intervals
+enforce_operating_hours: true        # §1.4: outside operating hours no staff is required
+full_week_grid: true                 # every 30-minute interval of the local week (§3 intervals_in_week)
+
+sla:                                 # §1.2, per queue, per interval
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 20}
+  vip: {target: 0.90, seconds: 20}
+queueing: erlang                     # §1.2: Erlang C, no abandonment
+aht_smoothing: interval              # §1.2: each interval's own AHT
+occupancy_cap: 0.85                  # §1.3
+apply_occupancy_cap: true            # §1.3 (WFM-212 is open for the service default)
+attainment_basis: service_level      # §1.2/§2.7: interval met when net agents >= Erlang C requirement
+attainment_intervals: operating      # §1.6: denominator is every operating interval of the queue
+sla_target: 0.95                     # §1.6: weekly attainment per queue
+max_hours_ratio: 1.57                # §1.6: scheduled hours <= 1.57 x required hours
+
+min_cover:                           # §2.6: one agent on vip, net of breaks, 06:00-24:00
+  vip: {agents: 1, hours: [6, 24]}
+cross_skill_weight: 0                # §1.2: a person counts once, on the queue they are scheduled on
+floor_net_of_breaks: true            # §2.6 "breaks aside"
+
+scheduler: week                      # wfm/scheduler/week.py: rules below enforced while placing
+min_rest_hours: 11                   # §2.1
+split_shift_contracts: [PT]          # §2.2
+templates: [E8, D8, L8, N8, P6a, P6b, P4, S44]   # §2.5: the ARCHITECTURE templates
+break:                               # §2.3
+  min_shift_hours: 6
+  minutes: 20
+  window_hours: [2, 5]
+  placement: max_surplus
+weekly_hours: {FT: 40, PT: 24}       # §2.4
+max_consecutive_days: 5              # §2.4
+reconciliation: true                 # §3: write RUNBOOK.md and exceptions.md next to eval.json
