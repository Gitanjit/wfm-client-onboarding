+"""Week-aware template placement (`scheduler: week` in a client config). Used for Northwind.
+
+The per-day greedy (`greedy.py`) schedules each local day on its own and audits the rules afterwards.
+This planner places shifts over the whole ISO week and enforces the contract rules while placing:
+
+- one template per agent per local day; weekly elapsed-hour caps per contract; at most
+  `max_consecutive_days` consecutive local days; skills;
+- `min_rest_hours` of elapsed time between the end of a shift and the start of the agent's next one;
+- split templates only for the contracts in `split_shift_contracts`; only the templates in `templates`;
+- one break per shift of `break.min_shift_hours` or more, starting `break.window_hours` after the shift
+  start, in the planning interval of the window where the queue's gross coverage surplus (agents on
+  the queue, breaks ignored, minus agents required) is largest (`break.placement: max_surplus`);
+- per-queue floors (`min_cover`), counted net of breaks and only on the queue itself when
+  `cross_skill_weight` is 0.
+
+Phases: (1) greedy — repeatedly place the (day, template, queue) that covers the most uncovered
+interval-requirement per hour, on the feasible agent who is least needed elsewhere; breaks are
+re-placed after every placement; (2) prune — drop shifts whose removal uncovers nothing; (3) shrink —
+swap a shift for a shorter template on the same day when that uncovers nothing; (4) if the client sets
+`max_hours_ratio`, drop the least useful shifts until scheduled hours are within ratio x required hours.
+
+Deterministic (ADR 0003): fixed template and queue order, agent ids as the final tie-break.
+"""
+from __future__ import annotations
+
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date, datetime, timedelta, timezone
+from zoneinfo import ZoneInfo
+
+import pandas as pd
+
+from wfm import constraints
+from wfm.ingest.loader import local_days
+from wfm.roster import Agent
+from wfm.scheduler.greedy import Shift
+from wfm.scheduler.templates import Template, templates_for
+
+FLOOR_WEIGHT = 1000.0     # a floor gap (a §2 rule) outweighs any number of missed SLA intervals
+
+
+@dataclass(frozen=True)
+class Option:
+    """A (local day, template, queue) placement: its UTC segments and the grid intervals it covers."""
+    day: date
+    tpl: Template
+    queue: str
+    segs: tuple[tuple[datetime, datetime], ...]
+    ivs: tuple[int, ...]
+    hours: float
+
+
+def _allowed_templates(cfg: dict) -> list[Template]:
+    ids = cfg.get("templates")
+    tpls = templates_for(cfg)
+    return [t for t in tpls if ids is None or t.id in ids]
+
+
+def _split_ok(tpl: Template, agent: Agent, cfg: dict) -> bool:
+    allowed = cfg.get("split_shift_contracts")
+    if not tpl.is_split:
+        return True
+    return allowed is None or agent.contract in allowed
+
+
+class Planner:
+    def __init__(self, req: pd.DataFrame, cfg: dict, agents: list[Agent], week: str):
+        self.cfg = cfg
+        self.agents = sorted(agents, key=lambda a: a.agent_id)
+        self.tz = cfg["tz"]
+        z = ZoneInfo(self.tz)
+        self.grain = timedelta(minutes=cfg["interval_minutes"])
+        self.grid = [t.to_pydatetime() if hasattr(t, "to_pydatetime") else t
+                     for t in sorted(set(req["interval_start_utc"]))]
+        self.idx = {t: i for i, t in enumerate(self.grid)}
+        self.queues = list(dict.fromkeys(req["queue"]))
+        n = len(self.grid)
+        self.req = {q: [0] * n for q in self.queues}
+        for r in req.itertuples(index=False):
+            self.req[r.queue][self.idx[r.interval_start_utc.to_pydatetime()]] = int(r.required)
+        self.floor = {q: [constraints.floor(q, t, cfg) for t in self.grid] for q in self.queues}
+        # what an interval must have on the queue, net of breaks
+        self.target = {q: [max(self.req[q][i], self.floor[q][i]) for i in range(n)] for q in self.queues}
+        self.brk = cfg["break"]
+        self.min_rest = timedelta(hours=float(cfg.get("min_rest_hours") or 0))
+        self.caps = cfg["weekly_hours"]
+        self.max_run = cfg["max_consecutive_days"]
+        self.days = local_days(week, self.tz)
+        day_of = [t.astimezone(z).date() for t in self.grid]
+        self.options: list[Option] = []
+        for d in self.days:
+            for tpl in _allowed_templates(cfg):
+                segs = tuple(tpl.segments_utc(d, self.tz))
+                ivs = tuple(i for i, t in enumerate(self.grid) if day_of[i] == d and any(s <= t < e for s, e in segs))
+                hours = sum((e - s).total_seconds() for s, e in segs) / 3600.0
+                for q in self.queues:
+                    self.options.append(Option(d, tpl, q, segs, ivs, hours))
+        self.shifts: list[Shift] = []
+        self.gross = {q: [0] * n for q in self.queues}
+        self.onbrk = {q: [0] * n for q in self.queues}
+        self.by_agent: dict[str, list[Shift]] = defaultdict(list)
+
+    # ---------------------------------------------------------------- agent rules
+
+    def _hours(self, aid: str) -> float:
+        return sum(s.hours for s in self.by_agent[aid])
+
+    def feasible(self, a: Agent, opt: Option, ignore: Shift | None = None) -> bool:
+        if opt.queue not in a.skills or not _split_ok(opt.tpl, a, self.cfg):
+            return False
+        mine = [s for s in self.by_agent[a.agent_id] if s is not ignore]
+        if any(s.day == opt.day for s in mine):
+            return False
+        if sum(s.hours for s in mine) + opt.hours > self.caps[a.contract] + 1e-9:
+            return False
+        days = {s.day for s in mine} | {opt.day}
+        run = best = 0
+        d = min(days)
+        while d <= max(days):
+            run = run + 1 if d in days else 0
+            best = max(best, run)
+            d += timedelta(days=1)
+        if best > self.max_run:
+            return False
+        start, end = opt.segs[0][0], opt.segs[-1][1]
+        for s in mine:
+            s_start, s_end = s.segments[0][0], s.segments[-1][1]
+            if s_end <= start and start - s_end < self.min_rest:
+                return False
+            if end <= s_start and s_start - end < self.min_rest:
+                return False
+            if s_start < end and start < s_end:
+                return False
+        return True
+
+    # ---------------------------------------------------------------- coverage and breaks
+
+    def _add(self, sh: Shift) -> None:
+        self.shifts.append(sh)
+        self.by_agent[sh.agent_id].append(sh)
+        for i in sh.ivs:
+            self.gross[sh.queue][i] += 1
+
+    def _remove(self, sh: Shift) -> None:
+        self.shifts.remove(sh)
+        self.by_agent[sh.agent_id].remove(sh)
+        for i in sh.ivs:
+            self.gross[sh.queue][i] -= 1
+
+    def _window(self, sh: Shift) -> list[int]:
+        """Grid intervals where this shift's break may start (window_hours after the shift start, the
+        break inside one segment)."""
+        if sh.hours < self.brk["min_shift_hours"] - 1e-9:
+            return []
+        lo, hi = (timedelta(hours=h) for h in self.brk["window_hours"])
+        length = timedelta(minutes=self.brk["minutes"])
+        start = sh.segments[0][0]
+        return [i for i in sh.ivs
+                if lo <= self.grid[i] - start <= hi
+                and any(s <= self.grid[i] and self.grid[i] + length <= e for s, e in sh.segments)]
+
+    def place_breaks(self) -> None:
+        """Re-place every break from scratch (max gross surplus in the window; ties to the interval
+        with the most net cover to spare, then the earliest)."""
+        for q in self.queues:
+            self.onbrk[q] = [0] * len(self.grid)
+        plan = []
+        for sh in self.shifts:
+            win = self._window(sh)
+            if not win:
+                sh.break_idx = None
+                continue
+            surplus = {i: self.gross[sh.queue][i] - self.req[sh.queue][i] for i in win}
+            top = max(surplus.values())
+            ties = [i for i in win if surplus[i] == top]
+            plan.append((len(ties), sh.segments[0][0], sh.agent_id, sh, ties))
+        plan.sort(key=lambda p: p[:3])
+        for _n, _s, _a, sh, ties in plan:
+            q = sh.queue
+            i = max(ties, key=lambda i: (self.gross[q][i] - self.onbrk[q][i] - self.target[q][i], -i))
+            sh.break_idx = i
+            self.onbrk[q][i] += 1
+
+    def net(self, q: str, i: int) -> int:
+        return self.gross[q][i] - self.onbrk[q][i]
+
+    def deficit(self, q: str, i: int) -> int:
+        return max(0, self.target[q][i] - self.net(q, i))
+
+    def badness(self) -> float:
+        """Missed SLA intervals plus heavily weighted floor gaps (net cover below the floor)."""
+        bad = 0.0
+        for q in self.queues:
+            for i in range(len(self.grid)):
+                n = self.net(q, i)
+                if n < self.req[q][i]:
+                    bad += 1
+                if n < self.floor[q][i]:
+                    bad += FLOOR_WEIGHT
+        return bad
+
+    # ---------------------------------------------------------------- phases
+
+    def _own_break(self, opt: Option) -> int | None:
+        """Where a new shift on `opt` would take its break, given current cover."""
+        probe = Shift("", opt.queue, opt.tpl, opt.day, list(opt.segs), list(opt.ivs))
+        probe.ivs = opt.ivs
+        win = self._window(probe)
+        if not win:
+            return None
+        q = opt.queue
+        surplus = {i: self.gross[q][i] + 1 - self.req[q][i] for i in win}
+        top = max(surplus.values())
+        ties = [i for i in win if surplus[i] == top]
+        return max(ties, key=lambda i: (self.gross[q][i] + 1 - self.onbrk[q][i] - self.target[q][i], -i))
+
+    def _pick_agent(self, opt: Option) -> Agent | None:
+        cands = [a for a in self.agents if self.feasible(a, opt)]
+        if not cands:
+            return None
+        # keep scarce skills free: fewest other skills first, weighted by how short those queues are
+        def other_need(a: Agent) -> float:
+            return sum(self.scarcity[s] for s in a.skills if s != opt.queue and s in self.scarcity)
+        return min(cands, key=lambda a: (other_need(a), -(self.caps[a.contract] - self._hours(a.agent_id)),
+                                         a.agent_id))
+
+    def greedy(self) -> None:
+        dead: set[Option] = set()
+        while True:
+            best, best_key = None, None
+            for opt in self.options:
+                if opt in dead:
+                    continue
+                b = self._own_break(opt)
+                val = sum(min(1, self.deficit(opt.queue, i)) * (FLOOR_WEIGHT if self.net(opt.queue, i) < self.floor[opt.queue][i] else 1)
+                          for i in opt.ivs if i != b)
+                if val <= 0:
+                    continue
+                key = (val, -opt.hours)     # most uncovered requirement; shorter template on a tie
+                if best_key is None or key > best_key:
+                    best, best_key = opt, key
+            if best is None:
+                return
+            a = self._pick_agent(best)
+            if a is None:
+                dead.add(best)
+                continue
+            sh = Shift(a.agent_id, best.queue, best.tpl, best.day, list(best.segs), list(best.ivs))
+            sh.ivs = best.ivs
+            self._add(sh)
+            self.place_breaks()
+
+    def prune(self) -> None:
+        changed = True
+        while changed:
+            changed = False
+            base = self.badness()
+            for sh in sorted(self.shifts, key=lambda s: (-s.hours, s.segments[0][0], s.agent_id)):
+                self._remove(sh)
+                self.place_breaks()
+                if self.badness() <= base:
+                    changed = True
+                    base = self.badness()
+                    continue
+                self._add(sh)
+                self.place_breaks()
+
+    def shrink(self) -> None:
+        by_id = {a.agent_id: a for a in self.agents}
+        base = self.badness()
+        for sh in sorted(self.shifts, key=lambda s: (s.segments[0][0], s.agent_id)):
+            a = by_id[sh.agent_id]
+            shorter = sorted((o for o in self.options
+                              if o.day == sh.day and o.queue == sh.queue and o.hours < sh.hours - 1e-9),
+                             key=lambda o: (o.hours, o.tpl.id))
+            for opt in shorter:
+                if not self.feasible(a, opt, ignore=sh):
+                    continue
+                self._remove(sh)
+                new = Shift(a.agent_id, opt.queue, opt.tpl, opt.day, list(opt.segs), list(opt.ivs))
+                new.ivs = opt.ivs
+                self._add(new)
+                self.place_breaks()
+                if self.badness() <= base:
+                    sh = new
+                    break
+                self._remove(new)
+                self._add(sh)
+                self.place_breaks()
+
+    def _new(self, a: Agent, opt: Option) -> Shift:
+        sh = Shift(a.agent_id, opt.queue, opt.tpl, opt.day, list(opt.segs), list(opt.ivs))
+        sh.ivs = opt.ivs
+        return sh
+
+    def _score(self) -> tuple[float, float]:
+        return (self.badness(), sum(s.hours for s in self.shifts))
+
+    def _limit(self) -> float:
+        ratio = self.cfg.get("max_hours_ratio")
+        return ratio * self.required_hours() if ratio else float("inf")
+
+    def improve(self, max_rounds: int = 20) -> None:
+        """Hill-climb on (missed intervals + floor gaps, hours): re-template a shift; add a shift for an
+        uncovered interval, if need be after handing one of the agent's shifts to another agent; drop a
+        shift. A move is kept only if it lowers the score and keeps hours within the limit."""
+        by_id = {a.agent_id: a for a in self.agents}
+        limit = self._limit()
+        for _ in range(max_rounds):
+            improved = False
+            # 1. re-template on the same day and queue; on a queue that still has gaps, any day
+            short = {q for q in self.queues if any(self.deficit(q, i) for i in range(len(self.grid)))}
+            for sh in sorted(self.shifts, key=lambda s: (s.segments[0][0], s.agent_id)):
+                if sh not in self.shifts:
+                    continue
+                base = self._score()
+                a = by_id[sh.agent_id]
+                for opt in self.options:
+                    if opt.queue != sh.queue or (opt.day == sh.day and opt.tpl.id == sh.template.id):
+                        continue
+                    if opt.day != sh.day and sh.queue not in short:
+                        continue
+                    if base[1] - sh.hours + opt.hours > limit + 1e-9 or not self.feasible(a, opt, ignore=sh):
+                        continue
+                    self._remove(sh)
+                    new = self._new(a, opt)
+                    self._add(new)
+                    self.place_breaks()
+                    sc = self._score()
+                    if sc < base:
+                        improved, sh, base = True, new, sc
+                        continue
+                    self._remove(new)
+                    self._add(sh)
+                    self.place_breaks()
+            # 2. add a shift where something is uncovered (with one hand-over if needed)
+            gaps = {(q, i) for q in self.queues for i in range(len(self.grid)) if self.deficit(q, i) > 0}
+            for opt in self.options:
+                if not any((opt.queue, i) in gaps for i in opt.ivs):
+                    continue
+                base = self._score()
+                if base[1] + opt.hours > limit + 1e-9:
+                    continue
+                done = False
+                for a in self.agents:
+                    if opt.queue not in a.skills:
+                        continue
+                    if self.feasible(a, opt):
+                        new = self._new(a, opt)
+                        self._add(new)
+                        self.place_breaks()
+                        if self._score() < base:
+                            improved = done = True
+                            break
+                        self._remove(new)
+                        self.place_breaks()
+                        continue
+                    # hand one of a's shifts that blocks opt to another agent b
+                    for x in list(self.by_agent[a.agent_id]):
+                        xopt = next(o for o in self.options
+                                    if o.day == x.day and o.tpl.id == x.template.id and o.queue == x.queue)
+                        if not self.feasible(a, opt, ignore=x):
+                            continue
+                        self._remove(x)
+                        moved = None
+                        for b in self.agents:
+                            if b.agent_id != a.agent_id and self.feasible(b, xopt):
+                                moved = self._new(b, xopt)
+                                break
+                        if moved is None:
+                            self._add(x)
+                            continue
+                        self._add(moved)
+                        new = self._new(a, opt)
+                        self._add(new)
+                        self.place_breaks()
+                        if self._score() < base:
+                            improved = done = True
+                            break
+                        self._remove(new)
+                        self._remove(moved)
+                        self._add(x)
+                        self.place_breaks()
+                    if done:
+                        break
+                if done:
+                    gaps = {(q, i) for q in self.queues for i in range(len(self.grid)) if self.deficit(q, i) > 0}
+            # 3. drop what is not needed
+            before = len(self.shifts)
+            self.prune()
+            improved = improved or len(self.shifts) < before
+            if not improved:
+                return
+
+    def required_hours(self) -> float:
+        h = self.grain.total_seconds() / 3600.0
+        return sum(sum(v) for v in self.req.values()) * h
+
+    def enforce_ratio(self) -> None:
+        ratio = self.cfg.get("max_hours_ratio")
+        if not ratio:
+            return
+        limit = ratio * self.required_hours()
+        while sum(s.hours for s in self.shifts) > limit + 1e-9 and self.shifts:
+            base = self.badness()
+            best, best_key = None, None
+            for sh in self.shifts:
+                self._remove(sh)
+                self.place_breaks()
+                key = ((self.badness() - base) / sh.hours, sh.segments[0][0], sh.agent_id)
+                self._add(sh)
+                if best_key is None or key < best_key:
+                    best, best_key = sh, key
+            self._remove(best)
+            self.place_breaks()
+
+    def run(self) -> list[Shift]:
+        need = {q: sum(self.target[q]) * self.grain.total_seconds() / 3600.0 for q in self.queues}
+        supply = {q: sum(self.caps[a.contract] for a in self.agents if q in a.skills) for q in self.queues}
+        self.scarcity = {q: need[q] / supply[q] if supply[q] else 1e9 for q in self.queues}
+        self.greedy()
+        self.prune()
+        self.shrink()
+        self.prune()
+        self.enforce_ratio()
+        self.improve()
+        self.place_breaks()
+        for sh in self.shifts:
+            if sh.break_idx is None:
+                sh.break_start, sh.break_minutes = None, 0
+            else:
+                sh.break_start = self.grid[sh.break_idx]
+                sh.break_minutes = self.brk["minutes"]
+            sh.intervals = [self.grid[i] for i in sh.ivs]
+        return sorted(self.shifts, key=lambda s: (s.segments[0][0], s.agent_id))
+
+
+def schedule_week(req: pd.DataFrame, cfg: dict, agents: list[Agent], week: str) -> list[Shift]:
+    return Planner(req, cfg, agents, week).run()
