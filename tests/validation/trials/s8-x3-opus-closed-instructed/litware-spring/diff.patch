+def exception_lines(ev: dict) -> list[str]:
+    """The `## Exceptions` section (Litware SOW §3): one line per §2.6 interval, `- <queue> <UTC start>`."""
+    lines = ["## Exceptions", ""]
+    lines += [f"- {e['queue']} {e['interval_start_utc']}" for e in ev.get("exception_intervals", [])]
+    if not ev.get("exception_intervals"):
+        lines.append("None this week.")
+    return lines + [""]
 
 
