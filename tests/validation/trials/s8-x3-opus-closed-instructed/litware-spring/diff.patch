+# Litware Support — local-time 20-minute export, Europe/London, rows stamped with the END of their
+# interval and a UTC offset per row (data/litware/README.txt).
+# Every value below comes from docs/LITWARE_SOW.md (effective 2027-W11); section numbers in comments.
+name: Litware
+interval_minutes: 20                 # §1.5
+tz: Europe/London                    # §1.4
+operating_hours: [7, 21]             # §1.4 (also limits templates to those inside 07:00-21:00)
+queues: [priority, standard, email]  # §1.1
+enforce_operating_hours: true        # §1.4: outside operating hours no staff is required
+full_week_grid: true                 # every 20-minute interval of the local week (§3 intervals_in_week)
+
+sla:                                 # §1.2, per queue, per interval
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 30}
+  email: {target: 0.80, seconds: 300}
+queueing: erlang                     # §1.2: Erlang C, no abandonment
+aht_smoothing: interval              # §1.2: each interval's own AHT
+occupancy_cap: 0.85                  # §1.3
+apply_occupancy_cap: true            # §1.3 (WFM-212 is open for the service default)
+attainment_basis: service_level      # §1.2: interval met when net agents >= Erlang C requirement
+attainment_intervals: operating      # §1.6: denominator is every operating interval of the queue
+sla_target: 0.95                     # §1.6: weekly attainment per queue
+max_hours_ratio: 1.45                # §1.6: scheduled hours <= 1.45 x required hours
+
+min_cover:                           # §2.4: two agents on priority, breaks aside, every operating interval
+  priority: {agents: 2, hours: [7, 21]}
+cross_skill_weight: 0                # §1.2: a person counts once, on the queue they are scheduled on
+floor_net_of_breaks: true            # §2.4 "breaks aside"
+queue_earliest_start: {email: 9}     # §2.5: no agent on email before 09:00 local
+exception_intervals: true            # §2.6: intervals the rules make infeasible are listed, not covered
+                                     #       by breaking a rule, and left out of attainment (§1.6)
+
+scheduler: week                      # wfm/scheduler/week.py: rules below enforced while placing
+min_rest_hours: 11                   # §2.1
+split_shift_contracts: [PT]          # §2.2
+templates: [D8, L8, P6a, P6b, P4, S44]   # §2.10: the ARCHITECTURE templates inside 07:00-21:00
+break:                               # §2.3
+  min_shift_hours: 6
+  minutes: 20
+  window_hours: [2, 5]
+  placement: max_surplus
+weekly_hours: {FT: 40, PT: 24}       # §2.9
+max_consecutive_days: 5              # §2.9
+reconciliation: true                 # §3: write RUNBOOK.md (and exceptions.md, §2.7) next to eval.json
