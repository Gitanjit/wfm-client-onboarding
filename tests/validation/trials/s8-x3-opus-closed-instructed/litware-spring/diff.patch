+def _parse_local(labels: pd.Series) -> pd.Series:
+    """Wall-clock labels -> naive datetimes. An end stamp may be written `24:00` (the next day's 00:00)."""
+    text = labels.astype(str).str.strip()
+    late = text.str.endswith(" 24:00")
+    out = pd.to_datetime(text.where(~late, text.str[:-5] + "00:00"))
+    return out.where(~late, out + pd.Timedelta(days=1))
+
+
