+def _shift_rules(sched: pd.DataFrame, cfg: dict, by_id: dict) -> dict[str, int]:
+    """Shift-level rules (one shift = one agent's segments on one local day): rest between shifts,
+    split shifts by contract, and the break (SOW §2.1-2.3). Rest and split are counted only when the
+    client config sets them."""
+    z = ZoneInfo(cfg["tz"])
+    rest_h = float(cfg.get("min_rest_hours") or 0)
+    split_ok = cfg.get("split_contracts")
+    rule = cfg.get("break")
+    v = {"break": 0} if rule else {}
+    if rest_h:
+        v["rest"] = 0
+    if split_ok is not None:
+        v["split_contract"] = 0
+    for aid, g in sched.groupby("agent_id"):
+        g = g.sort_values("segment_start_utc")
+        g = g.assign(_day=g["segment_start_utc"].map(lambda t: t.astimezone(z).date()))
+        shifts = []
+        for _, sg in g.groupby("_day", sort=True):
+            start, end = sg["segment_start_utc"].min(), sg["segment_end_utc"].max()
+            hours = float(((sg["segment_end_utc"] - sg["segment_start_utc"]).dt.total_seconds() / 3600).sum())
+            brk = sg[sg["break_minutes"] > 0]
+            shifts.append((start, end, hours, len(sg), brk))
+        a = by_id.get(aid)
+        for prev, cur in zip(shifts, shifts[1:]):
+            if rest_h and cur[0] - prev[1] < timedelta(hours=rest_h):
+                v["rest"] += 1
+        for start, end, hours, nseg, brk in shifts:
+            if split_ok is not None and nseg > 1 and (a is None or a.contract not in split_ok):
+                v["split_contract"] += 1
+            if rule is None:
+                continue
+            lo, hi = (timedelta(hours=h) for h in rule["window_hours"])
+            if hours >= rule["min_shift_hours"]:
+                ok = len(brk) == 1 and int(brk["break_minutes"].iloc[0]) == rule["minutes"] \
+                    and lo <= brk["break_start_utc"].iloc[0] - start <= hi
+                if not ok:
+                    v["break"] += 1
+            elif len(brk):
+                v["break"] += 1
+    return v
