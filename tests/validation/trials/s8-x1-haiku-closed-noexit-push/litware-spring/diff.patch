+def _prune(shifts: list[Shift], required: dict, floors: dict, cover: dict) -> list[Shift]:
+    """Drop a shift when every interval it covers keeps its need (and floor) without it. Fewer agent
+    hours; removing a shift only relaxes rest, weekly hours and consecutive days."""
