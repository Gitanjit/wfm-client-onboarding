+# Litware Support — 20-minute grain, Europe/London (DST). Config schema 2.
+# Every value here comes from docs/LITWARE_SOW.md; the service defaults are not changed for it.
+schema: 2
+name: Litware Support
+service:
+  interval_minutes: 20                # SOW §1.5
+  tz: Europe/London                   # SOW §1.4 (local)
+  operating_hours: [7, 21]            # SOW §1.4: 07:00-21:00, seven days; all queues
+targets:
+  sla:                                # SOW §1.2: fraction answered within seconds, per queue
+    priority: {target: 0.90, seconds: 30}
+    standard: {target: 0.80, seconds: 30}
+    email: {target: 0.80, seconds: 300}
+  sla_target: 0.95                    # SOW §1.6: weekly attainment on each queue
+  attainment_basis: service_level     # SOW §1.2: scheduled (net of breaks) >= required
+  attainment_intervals: operating     # SOW §1.6: fraction of operating intervals (§2.6 intervals left out)
+  hours_bound: 1.45                   # SOW §1.6: scheduled hours <= 1.45 x required hours
+  infeasible_exceptions: true         # SOW §2.6: intervals the rules make impossible are listed, not covered
+staffing:
+  queueing: erlang                    # SOW §1.2: Erlang C, no caller abandonment
+  occupancy_cap: 0.85                 # SOW §1.3
+  aht_smoothing: interval             # SOW §1.2: each interval's own volume and handle time
+scheduling:
+  weekly_hours: {FT: 40, PT: 24}      # SOW §2.9
+  max_consecutive_days: 5             # SOW §2.9
+  min_rest_hours: 11                  # SOW §2.1
+  split_contracts: [PT]               # SOW §2.2
+  queue_earliest: {email: 9}          # SOW §2.5: no agent on email before 09:00
+  break:                              # SOW §2.3
+    min_shift_hours: 6
+    minutes: 20
+    window_hours: [2, 5]
+    placement: surplus
+  min_cover:                          # SOW §2.4: at least two agents on priority in every operating interval
+    priority: {agents: 2, hours: [7, 21]}
+  cross_skill_weight: 0               # SOW §1.2: a person counts once, on the queue scheduled
+  trim_shifts: true                   # SOW §1.6 headroom: shorter templates, and drop shifts the need does not use
+  cover_gaps: true                    # SOW §1.2: intervals still short of need after a day's placement get a shift
+  schedule_search: 32                 # deterministic tie-break seeds 0-31; the first schedule meeting §1.2, §1.6, §2 is kept
