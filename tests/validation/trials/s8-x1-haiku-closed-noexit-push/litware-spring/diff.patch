+"""Intervals the rules make impossible to staff (SOW §2.6).
+
+An interval is infeasible when no shift the rules allow can cover it for its queue: no agent holds the
+queue's skill, or every template that covers the interval is barred for the queue (`queue_earliest`,
+e.g. Litware's "no email before 09:00"), or no agent holding the skill may take such a template. Only
+these provable cases are listed. An interval that is feasible but left short is a scheduling miss,
+not an exception.
+"""
+from __future__ import annotations
+
+from datetime import date, datetime
+from zoneinfo import ZoneInfo
+
+import pandas as pd
+
+from wfm.roster import Agent
+from wfm.scheduler.templates import eligible, queue_start_ok, templates_for
+
+
+def infeasible_intervals(req: pd.DataFrame, cfg: dict, agents: list[Agent]) -> set[tuple[str, datetime]]:
+    """(queue, interval start UTC) for every interval with a requirement that no permitted shift covers."""
+    tz = cfg["tz"]
+    z = ZoneInfo(tz)
+    split_ok = cfg.get("split_contracts")
+    templates = templates_for(cfg)
+    out: set[tuple[str, datetime]] = set()
+    for q, g in req.groupby("queue"):
+        staffed = [a for a in agents if q in a.skills]
+        usable = [t for t in templates if queue_start_ok(t, q, cfg) and any(
+            eligible(t, a.contract) and (not t.is_split or split_ok is None or a.contract in split_ok)
+            for a in staffed)]
+        for r in g.itertuples(index=False):
+            if r.required <= 0:
+                continue
+            t = r.interval_start_utc
+            if not any(_covers(tpl, t, z, tz) for tpl in usable):
+                out.add((q, t))
+    return out
+
+
+def exceptions(req: pd.DataFrame, cfg: dict, agents: list[Agent]) -> set[tuple[str, datetime]]:
+    """The §2.6 exceptions a client's SOW allows (`infeasible_exceptions: true`). Other clients have no
+    such clause: none of their intervals is excluded from attainment."""
+    return infeasible_intervals(req, cfg, agents) if cfg.get("infeasible_exceptions") else set()
+
+
+def _covers(tpl, t: datetime, z: ZoneInfo, tz: str) -> bool:
+    day: date = t.astimezone(z).date()
+    return any(s <= t < e for s, e in tpl.segments_utc(day, tz))
