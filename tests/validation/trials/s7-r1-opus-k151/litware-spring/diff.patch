+# Litware Support — local-time export stamped with the END of each 20-minute interval and a UTC offset
+# per row (data/litware/README.txt), Europe/London. Contract: docs/LITWARE_SOW.md (go-live 2027-W11).
+# Every value below is the SOW's; none of them relaxes a contractual target.
+name: Litware Support
+interval_minutes: 20              # SOW 1.5
+tz: Europe/London                 # SOW 1.4
+operating_hours: [7, 21]          # SOW 1.4, every queue (email contacts arrive 07:00-19:00; 19:00-21:00 carry no volume)
+queues: [priority, standard, email]   # SOW 1.1
+
+# Staffing (SOW 1.2-1.3): Erlang C, no abandonment, each interval's own volume and AHT, occupancy cap 0.85
+queueing: erlang
+aht_smoothing: interval
+occupancy_cap: 0.85
+sla:
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 30}
+  email: {target: 0.80, seconds: 300}
+sla_target: 0.95                  # SOW 1.6: weekly attainment per queue
+attainment_basis: service_level   # SOW 1.2: met when agents net of breaks >= required
+attainment_intervals: operating   # SOW 1.6: fraction of operating intervals ...
+infeasible_intervals: report      # ... leaving out the SOW 2.6 intervals, which RUNBOOK.md lists under Exceptions
+
+# Scheduling (SOW 2)
+scheduler: week                   # wfm/scheduler/greedy_v2.py
+max_hours_ratio: 1.45             # SOW 1.6: scheduled hours <= 1.45 x required agent-hours
+min_rest_hours: 11                # SOW 2.1
+split_contracts: [PT]             # SOW 2.2
+break:                            # SOW 2.3
+  min_shift_hours: 6
+  minutes: 20
+  window_hours: [2, 5]
+  placement: surplus
+min_cover:                        # SOW 2.4: two agents on priority in every operating interval, breaks aside
+  priority: {agents: 2, hours: [7, 21]}
+cross_skill_weight: 0             # SOW 1.2: a person counts once, on the queue they are scheduled on
+queue_staff_hours:                # SOW 2.5: nobody on email before 09:00 local
+  email: [9, 21]
+weekly_hours: {FT: 40, PT: 24}    # SOW 2.9
+max_consecutive_days: 5           # SOW 2.9
+
