+        self.by_agent[aid][c.day] = c
+        self.hours[aid] += c.hours
+        self._apply(aid, c, +1)
+
+    def remove(self, k: int) -> tuple[str, _Cand]:
+        aid, c = self.shifts.pop(k)
+        del self.by_agent[aid][c.day]
+        self.hours[aid] -= c.hours
+        self._apply(aid, c, -1)
+        return aid, c
+
+    def total_hours(self) -> float:
+        return sum(c.hours for _, c in self.shifts)
+
+    # ---- requirement on gross cover (build pass) ------------------------------------------------
+    def short(self, q: str, i: int, on_queue: float) -> float:
+        return constraints.uncovered(self.required[q][i], self.floor[q][i], on_queue, self.cross[q][i], self.cfg)
+
+    # ---- breaks and net cover -------------------------------------------------------------------
+    def breaks(self, queue: str | None = None) -> dict[int, int | None]:
+        """Break slot per shift (index into self.shifts), by the configured placement rule; only the
+        shifts on `queue` if given (breaks on one queue do not depend on another queue's)."""
+        rule = self.cfg["break"]
+        if rule.get("placement", "midpoint") != "surplus":
+            return self._breaks_midpoint(rule)
+        length = timedelta(minutes=rule["minutes"])
+        lo, hi = (timedelta(hours=h) for h in rule["window_hours"])
+        taken = {q: [0] * self.n for q in self.queues}
+        out: dict[int, int | None] = {}
+        ks = [k for k in range(len(self.shifts)) if queue is None or self.shifts[k][1].queue == queue]
+        order = sorted(ks, key=lambda k: (self.shifts[k][1].segs[0][0], self.shifts[k][0]))
+        for k in order:
+            aid, c = self.shifts[k]
+            out[k] = None
+            if c.hours < rule["min_shift_hours"]:
+                continue
+            start = c.segs[0][0]
+            fits = [i for i in c.slots
+                    if start + lo <= self.grid[i] <= start + hi
+                    and any(s <= self.grid[i] and self.grid[i] + length <= e for s, e in c.segs)]
+            if not fits:
+                continue
+            q = c.queue
+            best = max(self.gross[q][i] - self.required[q][i] for i in fits)
+            tied = [i for i in fits if self.gross[q][i] - self.required[q][i] == best]
+            i = max(tied, key=lambda j: (self.gross[q][j] - taken[q][j] - self.required[q][j], -j))
+            taken[q][i] += 1
+            out[k] = i
+        return out
+
+    def _breaks_midpoint(self, rule: dict) -> dict[int, int | None]:
+        out = {}
+        length = timedelta(minutes=rule["minutes"])
+        for k, (aid, c) in enumerate(self.shifts):
+            out[k] = None
+            if c.hours < rule["min_shift_hours"]:
+                continue
+            fits = [i for i in c.slots if any(s <= self.grid[i] and self.grid[i] + length <= e for s, e in c.segs)]
+            if fits:
+                mid = c.segs[0][0] + timedelta(hours=c.hours / 2)
+                out[k] = min(fits, key=lambda i: (abs((self.grid[i] - mid).total_seconds()), i))
+        return out
+
+    def net(self, brk: dict[int, int | None]) -> dict[str, list[int]]:
+        net = {q: list(self.gross[q]) for q in self.queues}
+        for k, i in brk.items():
+            if i is not None:
+                net[self.shifts[k][1].queue][i] -= 1
+        return net
+
+    def met_q(self, q: str) -> int:
+        """Operating intervals on `q` met net of breaks."""
+        net = list(self.gross[q])
+        for k, i in self.breaks(q).items():
+            if i is not None:
+                net[i] -= 1
+        req, op = self.required[q], self.operating[q]
+        return sum(1 for i in range(self.n) if op[i] and net[i] >= req[i])
+
+    def gaps(self) -> int:
+        return sum(1 for q in self.queues for i in range(self.n)
+                   if self.floor[q][i] and constraints.cover(self.gross[q][i], self.cross[q][i], self.cfg) < self.floor[q][i])
+
+    def goal(self, q: str, margin: float = 0.0) -> int:
+        """Intervals on `q` needed for the weekly attainment target (`sla_target`) plus `margin`."""
+        import math
+        target = min(1.0, float(self.cfg.get("sla_target", 1.0)) + margin)
+        return math.ceil(target * sum(self.operating[q]) - 1e-9)
+
+    def score(self) -> tuple[dict[str, int], int]:
+        """(intervals met net of breaks per queue, interval-floors broken on gross cover)."""
+        net = self.net(self.breaks())
+        met = {q: sum(1 for i in range(self.n) if self.operating[q][i] and net[q][i] >= self.required[q][i])
+               for q in self.queues}
+        gaps = sum(1 for q in self.queues for i in range(self.n)
+                   if constraints.cover(self.gross[q][i], self.cross[q][i], self.cfg) < self.floor[q][i])
+        return met, gaps
+
+
+def _build(w: _Week, grain_h: float) -> None:
+    dead: set[_Cand] = set()
+    while True:
+        best, best_key = None, None
+        for c in w.cands:
+            if c in dead:
+                continue
+            val = sum(min(1.0, w.short(c.queue, i, w.gross[c.queue][i])) for i in c.slots)
+            if val * grain_h < 0.5:
+                continue
+            key = (val * val / len(c.slots), val)   # uncovered slots, weighted by the share of the shift they fill
+            if best_key is None or key > best_key:
+                best, best_key = c, key
+        if best is None:
+            return
+        a = w.pick_agent(best)
+        if a is None:
+            dead.add(best)
+            continue
+        w.add(a.agent_id, best)
+
+
+def _repair(w: _Week, limit: float) -> None:
+    """Add shifts while they recover intervals that are short net of breaks."""
+    met, gaps = w.score()
+    dead: set[_Cand] = set()
+    while True:
+        net = w.net(w.breaks())
+        ranked = []
+        for c in w.cands:
+            if c in dead or w.total_hours() + c.hours > limit + 1e-9:
+                continue
+            q = c.queue
+            val = sum(1 for i in c.slots if w.operating[q][i] and net[q][i] < w.required[q][i]
+                      and net[q][i] + 1 >= w.required[q][i])
+            val += sum(1 for i in c.slots if w.floor[q][i] and w.gross[q][i] < w.floor[q][i])
+            if val > 0:
+                ranked.append((val / len(c.slots), val, c))
+        ranked.sort(key=lambda x: (-x[0], -x[1]))
+        placed = False
+        for _, _, c in ranked[:12]:
+            a = w.pick_agent(c)
+            if a is None:
+                dead.add(c)
+                continue
+            w.add(a.agent_id, c)
+            m2, g2 = w.score()
+            if g2 < gaps or (g2 == gaps and sum(m2.values()) > sum(met.values())):
+                met, gaps, placed = m2, g2, True
+                break
+            w.remove(len(w.shifts) - 1)
+        if not placed:
+            return
+
+
+def _restore(w: _Week, k: int, aid: str, c: _Cand) -> None:
+    w.shifts.insert(k, (aid, c))
+    w.by_agent[aid][c.day] = c
+    w.hours[aid] += c.hours
+    w._apply(aid, c, +1)
+
+
+def _prune(w: _Week, limit: float) -> None:
+    met, gaps = w.score()
+    changed = True
+    while changed:
+        changed = False
+        # longest shifts first, latest first among equals
+        for item in sorted(w.shifts, key=lambda x: (-x[1].hours, -x[1].segs[0][0].timestamp(), x[0])):
+            k = w.shifts.index(item)
+            aid, c = w.remove(k)
+            m2, g2 = w.score()
+            if g2 <= gaps and all(m2[q] >= met[q] for q in w.queues):
+                met, gaps, changed = m2, g2, True
+            else:
+                _restore(w, k, aid, c)
+    # still above the efficiency bound: drop the shifts that cost the fewest intervals
+    while w.total_hours() > limit + 1e-9 and w.shifts:
+        best = None
+        for k in range(len(w.shifts)):
+            aid, c = w.remove(k)
+            m2, g2 = w.score()
+            key = (g2, -min(m2[q] / max(1, sum(w.operating[q])) for q in w.queues), -sum(m2.values()))
+            if best is None or key < best[0]:
+                best = (key, k)
+            _restore(w, k, aid, c)
+        w.remove(best[1])
+
+
+def _improve(w: _Week, limit: float, rounds: int = 8) -> bool:
+    """Local search on queues below their attainment goal plus a small margin: move a shift on such a queue to another
+    template and/or local day for the same agent when that meets more intervals on the queue (floors
+    kept, total hours within the bound)."""
+    any_change = False
+    for _ in range(rounds):
+        improved = False
+        for q in w.queues:
+            cur = w.met_q(q)
+            if cur >= w.goal(q, margin=0.02):
+                continue
+            gaps = w.gaps()
+            for item in sorted([x for x in w.shifts if x[1].queue == q], key=lambda x: (x[1].segs[0][0], x[0])):
+                if item not in w.shifts:
+                    continue
+                k = w.shifts.index(item)
+                aid, c = w.remove(k)
+                a = w.by_id[aid]
+                best = (cur, -c.hours, None)
+                for c2 in w.cands:
+                    if c2.queue != q or c2 == c or not w.feasible(a, c2):
+                        continue
+                    if w.total_hours() + c2.hours > limit + 1e-9:
+                        continue
+                    w.add(aid, c2)
+                    if w.gaps() <= gaps:
+                        m = w.met_q(q)
+                        if (m, -c2.hours) > best[:2]:
+                            best = (m, -c2.hours, c2)
+                    w.remove(len(w.shifts) - 1)
+                if best[2] is None:
+                    _restore(w, k, aid, c)
+                else:
+                    w.add(aid, best[2])
+                    cur, improved = best[0], True
+        if not improved:
+            return any_change
+        any_change = True
+    return any_change
 
 
