+    """True if the interval starting at `t` (UTC) lies inside the queue's local operating hours."""
+    loc = t.astimezone(ZoneInfo(cfg["tz"]))
+    h = loc.hour + loc.minute / 60
+    lo, hi = queue_hours(cfg, queue)
+    return lo <= h < hi
