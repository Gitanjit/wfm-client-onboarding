+# Northwind Traders — local-time export with a UTC offset per row (data/northwind/README.txt),
+# 30-minute grain, US Central. Contract: docs/NORTHWIND_SOW.md (go-live 2026-W44).
+# Every value below is the SOW's; none of them relaxes a contractual target.
+name: Northwind Traders
+interval_minutes: 30              # SOW 1.5
+tz: America/Chicago               # SOW 1.4
+operating_hours: [6, 24]          # SOW 1.4
+queues: [priority, standard, vip] # SOW 1.1
+queue_hours: {vip: [8, 20]}       # SOW 1.4: vip contacts arrive 08:00-20:00; those are vip's operating intervals
+
+# Staffing (SOW 1.2-1.3): Erlang C, no abandonment, each interval's own volume and AHT, occupancy cap 0.85
+queueing: erlang
+aht_smoothing: interval
+occupancy_cap: 0.85
+sla:
+  priority: {target: 0.90, seconds: 30}
+  standard: {target: 0.80, seconds: 20}
+  vip: {target: 0.90, seconds: 20}
+sla_target: 0.95                  # SOW 1.6: weekly attainment per queue
+attainment_basis: service_level   # SOW 1.2: met when agents net of breaks >= required
+attainment_intervals: operating   # SOW 1.6: fraction of operating intervals (per queue_hours)
+
+# Scheduling (SOW 2)
+scheduler: week                   # wfm/scheduler/greedy_v2.py (WFM-231)
+max_hours_ratio: 1.51             # SOW 1.6: scheduled hours <= 1.51 x required agent-hours
+min_rest_hours: 11                # SOW 2.1
+split_contracts: [PT]             # SOW 2.2
+break:                            # SOW 2.3
+  min_shift_hours: 6
+  minutes: 20
+  window_hours: [2, 5]
+  placement: surplus
+weekly_hours: {FT: 40, PT: 24}    # SOW 2.4
+max_consecutive_days: 5           # SOW 2.4
+min_cover:                        # SOW 2.6: one agent on vip 06:00-24:00, breaks aside
+  vip: {agents: 1, hours: [6, 24]}
+cross_skill_weight: 0             # SOW 1.2: a person counts once, on the queue they are scheduled on
+
+# Client templates (wfm/scheduler/templates.py: client_templates), alongside the service set:
+# 8-hour and 6-hour shifts on every local hour that the service set does not already start on.
+# Local wall-clock, inside operating hours, never across midnight (SOW 2.5).
+extra_templates:
